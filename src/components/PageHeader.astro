---
interface Props {
  title: string;
  description?: string;
  helpLink?: string;
  icon?: string;
}

const { title, description, helpLink, icon } = Astro.props;
---

<div class="page-header">
  <div class="page-header-content">
    {icon && (
      <div class="page-header-icon" aria-hidden="true">
        {icon}
      </div>
    )}
    <div class="page-header-text">
      <h1 class="page-title">{title}</h1>
      {description && (
        <p class="page-description">{description}</p>
      )}
    </div>
  </div>
  {helpLink && (
    <a href={helpLink} class="help-link" target="_blank" rel="noopener noreferrer">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
      <span>Help</span>
    </a>
  )}
</div>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color, #e2e8f0);
  }

  .page-header-content {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    flex: 1;
  }

  .page-header-icon {
    font-size: 2rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .page-header-text {
    flex: 1;
  }

  .page-title {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary, #1a202c);
    line-height: 1.2;
  }

  .page-description {
    margin: 0.5rem 0 0 0;
    font-size: 1rem;
    color: var(--text-secondary, #718096);
    line-height: 1.5;
    max-width: 65ch;
  }

  .help-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--primary-color, #3182ce);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.2s;
    white-space: nowrap;
  }

  .help-link:hover {
    background-color: var(--hover-bg, #ebf8ff);
  }

  .help-link svg {
    flex-shrink: 0;
  }

  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    .page-header {
      border-bottom-color: #2d3748;
    }

    .page-title {
      color: #f7fafc;
    }

    .page-description {
      color: #a0aec0;
    }

    .help-link {
      color: #63b3ed;
    }

    .help-link:hover {
      background-color: #2c5282;
    }
  }

  /* Responsive */
  @media (max-width: 640px) {
    .page-header {
      flex-direction: column;
      gap: 1rem;
    }

    .page-title {
      font-size: 1.5rem;
    }

    .page-description {
      font-size: 0.9375rem;
    }

    .help-link {
      align-self: flex-start;
    }
  }
</style>
