---
import { getDb } from "../lib/db";

const db = getDb();
const rawDb = (db as any).$client;

// Get all discovered hosts with stack info
const hosts = rawDb.prepare(`
  SELECT
    h.id, h.ip_address, h.hostname, h.mac_address, h.vendor,
    s.name as stack_name, s.id as stack_id
  FROM discovered_hosts h
  LEFT JOIN stacks s ON h.stack_id = s.id
  ORDER BY h.ip_address
`).all();

// Classify devices into tiers for hierarchical layout
function getTier(host: any): number {
  const ip = host.ip_address;

  // Tier 0: Gateways (typically .1 addresses)
  if (ip.endsWith('.1')) return 0;

  // Tier 1: All other discovered hosts
  return 1;
}

// Build hierarchical nodes
const nodes = hosts.map((h: any) => ({
  id: h.id,
  ip: h.ip_address,
  hostname: h.hostname || h.ip_address,
  type: "host", // All discovered hosts are generic hosts for now
  stack: h.stack_name,
  tier: getTier(h),
  mac: h.mac_address,
  vendor: h.vendor,
}));

// Sort by tier
nodes.sort((a, b) => a.tier - b.tier);

// Build connections
const links: Array<{ source: string; target: string; label?: string }> = [];
const gateway = nodes.find(n => n.tier === 0);

if (gateway) {
  // Gateway connects to all tier 1 and 2 devices
  for (const node of nodes) {
    if (node.id !== gateway.id && node.tier <= 2) {
      links.push({ source: gateway.id, target: node.id });
    }
  }
  // Tier 2 devices connect to tier 3 (containers)
  const tier2 = nodes.filter(n => n.tier === 2);
  const tier3 = nodes.filter(n => n.tier === 3);
  for (const t3 of tier3) {
    const host = tier2[Math.floor(Math.random() * tier2.length)];
    if (host) {
      links.push({ source: host.id, target: t3.id });
    }
  }
}

const diagramData = { nodes, links };
---

<div class="topology-diagram">
  <div class="diagram-header">
    <h3>Network Topology</h3>
    <div class="diagram-controls">
      <button id="fit-view" class="btn-sm">Fit to View</button>
      <button id="reset-zoom" class="btn-sm">Reset Zoom</button>
    </div>
  </div>

  <svg id="network-diagram" width="100%" height="700"></svg>

  <div class="diagram-legend">
    <div class="legend-item"><span class="icon gateway"></span> Gateway/Router</div>
    <div class="legend-item"><span class="icon switch"></span> Switch</div>
    <div class="legend-item"><span class="icon server"></span> Server</div>
    <div class="legend-item"><span class="icon container"></span> Container</div>
    <div class="legend-item"><span class="icon workstation"></span> Workstation</div>
  </div>
</div>

<script define:vars={{ diagramData }}>
  window.addEventListener('DOMContentLoaded', () => {
    if (typeof d3 === 'undefined') {
      console.error('D3 not loaded - topology diagram cannot render');
      return;
    }

    const { nodes, links } = diagramData;

  const svgElement = document.getElementById('network-diagram');
  const width = svgElement.clientWidth || svgElement.parentElement.clientWidth || 1200;
  const height = 700;

  const svg = d3.select('#network-diagram')
    .attr('viewBox', [0, 0, width, height]);

  // Create hierarchical layout with multi-row support
  const tierHeight = height / 5;
  const tiers = d3.group(nodes, d => d.tier);

  // Position nodes in hierarchical layout with multi-row grid for crowded tiers
  nodes.forEach(node => {
    const tier = node.tier;
    const nodesInTier = tiers.get(tier) || [];
    const index = nodesInTier.indexOf(node);

    // For tiers with many nodes (>15), use multi-row grid
    const maxPerRow = 15;
    const nodeCount = nodesInTier.length;

    if (nodeCount > maxPerRow) {
      const rows = Math.ceil(nodeCount / maxPerRow);
      const row = Math.floor(index / maxPerRow);
      const col = index % maxPerRow;
      const nodesInRow = Math.min(maxPerRow, nodeCount - (row * maxPerRow));
      const spacing = width / (nodesInRow + 1);
      const rowHeight = tierHeight / (rows + 1);

      node.x = spacing * (col + 1);
      node.y = tierHeight * tier + rowHeight * (row + 1);
    } else {
      const spacing = width / (nodeCount + 1);
      node.x = spacing * (index + 1);
      node.y = tierHeight * (tier + 1);
    }

    node.fx = node.x; // Fix positions
    node.fy = node.y;
  });

  // Device type to icon mapping
  const deviceIcons = {
    'router': '⬡',
    'gateway': '⬡',
    'switch': '▦',
    'web-server': '▢',
    'database-server': '▦',
    'docker': '◐',
    'workstation': '○',
    'unknown': '◯'
  };

  // Vendor colors
  const vendorColors = {
    'cisco': '#049fd9',
    'juniper': '#ff6600',
    'arista': '#00c853',
    'docker': '#2496ed',
    'default': '#64748b'
  };

  function getColor(node) {
    if (node.vendor) {
      const v = node.vendor.toLowerCase();
      for (const [key, color] of Object.entries(vendorColors)) {
        if (v.includes(key)) return color;
      }
    }
    if (node.type === 'docker') return vendorColors.docker;
    return vendorColors.default;
  }

  // Draw connections first (so they're behind nodes)
  const linkGroup = svg.append('g').attr('class', 'links');

  const link = linkGroup.selectAll('line')
    .data(links)
    .join('line')
    .attr('class', 'link')
    .attr('x1', d => nodes.find(n => n.id === d.source).x)
    .attr('y1', d => nodes.find(n => n.id === d.source).y)
    .attr('x2', d => nodes.find(n => n.id === d.target).x)
    .attr('y2', d => nodes.find(n => n.id === d.target).y)
    .attr('stroke', '#334155')
    .attr('stroke-width', 2)
    .attr('stroke-dasharray', d => d.label ? '5,5' : 'none')
    .attr('opacity', 0)
    .transition()
    .duration(800)
    .delay((d, i) => i * 50)
    .attr('opacity', 0.3);

  // Draw nodes
  const nodeGroup = svg.append('g').attr('class', 'nodes');

  const node = nodeGroup.selectAll('g')
    .data(nodes)
    .join('g')
    .attr('class', 'node')
    .attr('transform', d => `translate(${d.x},${d.y})`)
    .style('cursor', 'pointer')
    .on('click', (event, d) => {
      window.location.href = `/app/devices/${d.id}`;
    });

  // Node circles (animated entrance)
  node.append('circle')
    .attr('r', d => d.tier === 0 ? 32 : d.tier === 3 ? 20 : 26)
    .attr('fill', d => getColor(d))
    .attr('stroke', '#fff')
    .attr('stroke-width', 2)
    .attr('opacity', 0)
    .attr('transform', 'scale(0)')
    .transition()
    .duration(600)
    .delay((d, i) => i * 80)
    .attr('opacity', 1)
    .attr('transform', 'scale(1)');

  // Device icons
  node.append('text')
    .attr('class', 'device-icon')
    .attr('text-anchor', 'middle')
    .attr('dy', 6)
    .attr('font-size', d => d.tier === 0 ? 28 : d.tier === 3 ? 16 : 22)
    .attr('fill', '#fff')
    .attr('opacity', 0)
    .text(d => deviceIcons[d.type] || deviceIcons.unknown)
    .transition()
    .duration(400)
    .delay((d, i) => i * 80 + 200)
    .attr('opacity', 1);

  // Labels
  node.append('text')
    .attr('class', 'node-label')
    .attr('text-anchor', 'middle')
    .attr('dy', d => d.tier === 0 ? 50 : d.tier === 3 ? 35 : 42)
    .attr('font-size', 11)
    .attr('fill', '#e2e8f0')
    .attr('opacity', 0)
    .text(d => d.hostname.length > 20 ? d.hostname.slice(0, 18) + '...' : d.hostname)
    .transition()
    .duration(400)
    .delay((d, i) => i * 80 + 400)
    .attr('opacity', 1);

  // IP labels
  node.append('text')
    .attr('class', 'ip-label')
    .attr('text-anchor', 'middle')
    .attr('dy', d => d.tier === 0 ? 65 : d.tier === 3 ? 48 : 57)
    .attr('font-size', 9)
    .attr('font-family', 'monospace')
    .attr('fill', '#94a3b8')
    .attr('opacity', 0)
    .text(d => d.ip)
    .transition()
    .duration(400)
    .delay((d, i) => i * 80 + 600)
    .attr('opacity', 1);

  // Zoom behavior
  const zoom = d3.zoom()
    .scaleExtent([0.3, 3])
    .on('zoom', (event) => {
      svg.selectAll('g.nodes, g.links').attr('transform', event.transform);
    });

  svg.call(zoom);

  // Controls
  document.getElementById('fit-view')?.addEventListener('click', () => {
    svg.transition().duration(750).call(
      zoom.transform,
      d3.zoomIdentity.translate(0, 0).scale(1)
    );
  });

  document.getElementById('reset-zoom')?.addEventListener('click', () => {
    svg.transition().duration(750).call(
      zoom.transform,
      d3.zoomIdentity
    );
  });
  }); // End DOMContentLoaded
</script>

<style>
  .topology-diagram { background: #0f172a; border-radius: var(--radius); padding: 20px; position: relative; }
  .diagram-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
  .diagram-header h3 { font-size: 16px; color: #e2e8f0; margin: 0; }
  .diagram-controls { display: flex; gap: 8px; }
  .btn-sm { font-size: 11px; padding: 6px 12px; background: rgba(100,116,139,0.2); border: 1px solid rgba(148,163,184,0.3); border-radius: 4px; color: #e2e8f0; cursor: pointer; transition: all 150ms; }
  .btn-sm:hover { background: rgba(100,116,139,0.3); border-color: rgba(148,163,184,0.5); }

  #network-diagram { background: #1e293b; border-radius: 8px; }

  .diagram-legend { display: flex; gap: 20px; margin-top: 16px; padding: 12px; background: rgba(30,41,59,0.5); border-radius: 6px; flex-wrap: wrap; }
  .legend-item { display: flex; align-items: center; gap: 8px; font-size: 11px; color: #94a3b8; }
  .legend-item .icon { display: inline-block; width: 24px; height: 24px; border-radius: 50%; border: 2px solid #fff; display: flex; align-items: center; justify-content: center; font-size: 14px; }
  .legend-item .icon.gateway { background: #049fd9; }
  .legend-item .icon.switch { background: #64748b; }
  .legend-item .icon.server { background: #8b5cf6; }
  .legend-item .icon.container { background: #2496ed; }
  .legend-item .icon.workstation { background: #64748b; }

  .node:hover circle { stroke-width: 3; filter: brightness(1.2); }
  .link { transition: opacity 200ms; }
  .links:hover .link { opacity: 0.1; }
  .links .link:hover { opacity: 0.8 !important; stroke-width: 3; }
</style>
