---
import { getDb } from "../lib/db";

const db = getDb();
const rawDb = (db as any).$client;

// Get all discovered hosts with stack info
const hosts = rawDb.prepare(`
  SELECT
    h.id, h.ip_address, h.hostname, h.mac_address, h.vendor, h.parent_host_id,
    s.name as stack_name, s.id as stack_id
  FROM discovered_hosts h
  LEFT JOIN stacks s ON h.stack_id = s.id
  ORDER BY h.ip_address
`).all();

// Generate Mermaid flowchart syntax
function generateMermaidDiagram(hosts: any[]): string {
  if (hosts.length === 0) {
    return 'graph TD\n  empty["No hosts discovered yet"]';
  }

  const lines: string[] = ['graph TD'];

  // Classify hosts by role
  const gateways = hosts.filter(h => h.ip_address.endsWith('.1'));
  const physicalHosts = hosts.filter(h => !h.parent_host_id && !h.ip_address.endsWith('.1'));
  const containers = hosts.filter(h => h.parent_host_id);

  // Add gateway nodes (routers)
  gateways.forEach(gw => {
    const label = gw.hostname || gw.ip_address;
    const safeid = gw.id.replace(/-/g, '_');
    lines.push(`  ${safeid}["🌐 ${label}<br/><small>${gw.ip_address}</small>"]`);
    lines.push(`  style ${safeid} fill:#049fd9,stroke:#fff,stroke-width:2px,color:#fff`);
  });

  // Add physical host nodes
  physicalHosts.forEach(host => {
    const label = host.hostname || host.ip_address;
    const safeid = host.id.replace(/-/g, '_');
    const icon = host.stack_name ? '🖥️' : '💻';
    lines.push(`  ${safeid}["${icon} ${label}<br/><small>${host.ip_address}</small>"]`);
    lines.push(`  style ${safeid} fill:#8b5cf6,stroke:#fff,stroke-width:2px,color:#fff`);
  });

  // Add container nodes
  containers.forEach(cont => {
    const label = cont.hostname || cont.ip_address;
    const safeid = cont.id.replace(/-/g, '_');
    lines.push(`  ${safeid}["🐳 ${label}<br/><small>${cont.ip_address}</small>"]`);
    lines.push(`  style ${safeid} fill:#2496ed,stroke:#fff,stroke-width:2px,color:#fff`);
  });

  // Add connections
  // Gateway → All physical hosts
  if (gateways.length > 0) {
    const gw = gateways[0];
    const gwId = gw.id.replace(/-/g, '_');
    physicalHosts.forEach(host => {
      const hostId = host.id.replace(/-/g, '_');
      lines.push(`  ${gwId} --> ${hostId}`);
    });
  }

  // Physical hosts → Their containers
  containers.forEach(cont => {
    if (cont.parent_host_id) {
      const parentId = cont.parent_host_id.replace(/-/g, '_');
      const contId = cont.id.replace(/-/g, '_');
      lines.push(`  ${parentId} --> ${contId}`);
    }
  });

  return lines.join('\n');
}

const mermaidCode = generateMermaidDiagram(hosts);
---

<div class="mermaid-topology-diagram">
  <div class="diagram-header">
    <h3>Network Topology</h3>
    <div class="diagram-controls">
      <button id="toggleMermaidView" class="btn-sm">Toggle View</button>
      <button id="downloadMermaidSvg" class="btn-sm">Download SVG</button>
    </div>
  </div>

  <div class="mermaid-container">
    <pre class="mermaid" id="topologyMermaid">{mermaidCode}</pre>
  </div>

  <div class="diagram-legend">
    <div class="legend-item"><span class="icon gateway">🌐</span> Gateway/Router</div>
    <div class="legend-item"><span class="icon server">🖥️</span> Physical Host</div>
    <div class="legend-item"><span class="icon workstation">💻</span> Workstation</div>
    <div class="legend-item"><span class="icon container">🐳</span> Container</div>
  </div>
</div>

<script>
  // Load Mermaid library
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';

  mermaid.initialize({
    startOnLoad: true,
    theme: 'dark',
    flowchart: {
      curve: 'basis',
      padding: 20
    }
  });

  // Toggle between Mermaid and raw code view
  document.getElementById('toggleMermaidView')?.addEventListener('click', () => {
    const pre = document.querySelector('.mermaid');
    if (pre) {
      pre.classList.toggle('show-code');
    }
  });

  // Download as SVG
  document.getElementById('downloadMermaidSvg')?.addEventListener('click', () => {
    const svg = document.querySelector('.mermaid svg');
    if (svg) {
      const svgData = new XMLSerializer().serializeToString(svg);
      const blob = new Blob([svgData], { type: 'image/svg+xml;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'network-topology.svg';
      link.click();
      URL.revokeObjectURL(url);
    }
  });
</script>

<style>
  .mermaid-topology-diagram {
    background: #0f172a;
    border-radius: var(--radius);
    padding: 20px;
    position: relative;
  }

  .diagram-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .diagram-header h3 {
    font-size: 16px;
    color: #e2e8f0;
    margin: 0;
  }

  .diagram-controls {
    display: flex;
    gap: 8px;
  }

  .btn-sm {
    font-size: 11px;
    padding: 6px 12px;
    background: rgba(100,116,139,0.2);
    border: 1px solid rgba(148,163,184,0.3);
    border-radius: 4px;
    color: #e2e8f0;
    cursor: pointer;
    transition: all 150ms;
  }

  .btn-sm:hover {
    background: rgba(100,116,139,0.3);
    border-color: rgba(148,163,184,0.5);
  }

  .mermaid-container {
    background: #1e293b;
    border-radius: 8px;
    padding: 20px;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mermaid {
    width: 100%;
    display: block;
  }

  .mermaid.show-code {
    white-space: pre;
    font-family: monospace;
    font-size: 12px;
    color: #94a3b8;
  }

  .diagram-legend {
    display: flex;
    gap: 20px;
    margin-top: 16px;
    padding: 12px;
    background: rgba(30,41,59,0.5);
    border-radius: 6px;
    flex-wrap: wrap;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: #94a3b8;
  }

  .legend-item .icon {
    font-size: 18px;
  }
</style>
