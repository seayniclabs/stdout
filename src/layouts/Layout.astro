---
import '../styles/global.css';
import { getTenantDb, tenantSchema } from '../lib/db';
import { getUserWorkspaces } from '../lib/rbac';
import { eq } from 'drizzle-orm';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'StdOut', description = 'AI incident companion for solo developers and self-hosters.' } = Astro.props;
const path = Astro.url.pathname;
const csrfToken = Astro.locals.csrfToken;
const canonicalURL = Astro.url;
const nav = [
  { href: '/app', label: 'Incidents' },
  { href: '/app/hud', label: 'HUD' },
  { href: '/app/stacks', label: 'Stacks' },
  { href: '/app/docs', label: 'Docs' },
  { href: '/app/search', label: 'Search' },
  { href: '/app/settings', label: 'Settings' },
];

// Load tenant branding — use workspace owner's DB if in a team workspace
let workspaceName = 'StdOut';
let accentOverride = '';
let logoOverride = '';
const user = Astro.locals.user;
const ws = Astro.locals.workspace;
const wsOwnerId = ws?.ownerId || user?.id;

// Workspace switcher data
let workspaces: { own: any; teams: any[] } = { own: null, teams: [] };

if (user) {
  try {
    const dbOwnerId = wsOwnerId || user.id;
    const db = getTenantDb(dbOwnerId);
    const prefs = db.select().from(tenantSchema.tenantPreferences)
      .where(eq(tenantSchema.tenantPreferences.userId, dbOwnerId)).get();
    if (prefs?.workspaceName) workspaceName = prefs.workspaceName;
    if (prefs?.accentColor && /^#[0-9a-fA-F]{3,8}$/.test(prefs.accentColor)) {
      accentOverride = prefs.accentColor;
    }
    if (prefs?.logoUrl) logoOverride = prefs.logoUrl;
    workspaces = getUserWorkspaces(user.id);
  } catch {}
}
const hasMultipleWorkspaces = workspaces.teams.length > 0;
const currentWsId = ws?.ownerId || user?.id;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#F97316" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>@import '../styles/fonts.css';</style>
  {accentOverride && <style set:html={`:root { --accent: ${accentOverride}; --accent-light: ${accentOverride}; --accent-dim: ${accentOverride}1f; --accent-glow: ${accentOverride}40; }`}></style>}
  <meta name="csrf-token" content={csrfToken} />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>

  <nav class="topnav" aria-label="Main navigation">
    <a href="/app" class="topnav-brand">
      {logoOverride ? (
        <img src={logoOverride} alt={workspaceName} width="24" height="24" style="border-radius: 4px;" />
      ) : (
        <img src="/logo.svg" alt={workspaceName} width="24" height="24" />
      )}
      {workspaceName}
    </a>
    <div class="topnav-links">
      {nav.map(({ href, label }) => (
        <a
          href={href}
          class:list={[{
            active: href === '/app' ? path === '/app' || path === '/app/' : path.startsWith(href)
          }]}
        >{label}</a>
      ))}
    </div>
    {hasMultipleWorkspaces && (
      <div class="ws-switcher">
        <select id="wsSwitcher" class="ws-select" aria-label="Switch workspace">
          {workspaces.own && (
            <option value={workspaces.own.id} selected={currentWsId === workspaces.own.id}>
              {workspaces.own.name} (yours)
            </option>
          )}
          {workspaces.teams.map(t => (
            <option value={t.id} selected={currentWsId === t.id}>
              {t.name} ({t.role})
            </option>
          ))}
        </select>
      </div>
    )}
    {ws && !ws.isOwnWorkspace && (
      <div class="ws-badge" title={`Viewing as ${ws.role}`}>
        {ws.role}
      </div>
    )}
    <div class="topnav-auth" id="authNav">
      <a href="/app/login" class="topnav-auth-link">Log in</a>
    </div>

    <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <div class="nav-mobile" id="navMobile">
    {nav.map(({ href, label }) => (
      <a
        href={href}
        class:list={['nav-mobile-link', {
          active: href === '/app' ? path === '/app' || path === '/app/' : path.startsWith(href)
        }]}
      >{label}</a>
    ))}
    <div class="nav-mobile-divider"></div>
    <div class="nav-mobile-auth" id="mobileAuthNav">
      <a href="/app/login" class="nav-mobile-link">Log in</a>
    </div>
  </div>

  <main class="main" id="main-content">
    <slot />
  </main>

  <footer style="text-align:center; padding:2rem 1rem 3rem; opacity:0.4;">
    <div style="display:flex; justify-content:center; gap:16px; margin-bottom:6px;">
      <a href="/privacy" style="font-family:var(--font-mono); font-size:0.65rem; color:var(--text-muted); text-decoration:none;">Privacy</a>
      <a href="/terms" style="font-family:var(--font-mono); font-size:0.65rem; color:var(--text-muted); text-decoration:none;">Terms</a>
    </div>
    <div style="font-family:var(--font-mono); font-size:0.65rem; color:var(--text-muted);">
      Built by Seaynic Labs LLC
    </div>
  </footer>

  <div id="toastContainer" aria-live="polite" style="position:fixed; bottom:1.5rem; right:1.5rem; z-index:9999; display:flex; flex-direction:column; gap:0.5rem; pointer-events:none;"></div>

  <script>
    // Toast system
    window.showToast = function(message: string, type: 'error' | 'success' | 'info' = 'error') {
      const container = document.getElementById('toastContainer');
      if (!container) return;
      const toast = document.createElement('div');
      toast.style.cssText = `
        pointer-events:auto; padding:0.75rem 1.25rem; border-radius:6px; font-size:0.85rem;
        font-family:var(--font-ui); max-width:360px; opacity:0; transform:translateY(0.5rem);
        transition:opacity 0.3s, transform 0.3s;
      `;
      const colors = {
        error: 'background:#2d1215; color:#e74c3c; border:1px solid #5c2428;',
        success: 'background:#122d15; color:#2ecc71; border:1px solid #245c28;',
        info: 'background:#15202d; color:#3498db; border:1px solid #28405c;',
      };
      toast.style.cssText += colors[type];
      toast.textContent = message;
      container.appendChild(toast);
      requestAnimationFrame(() => { toast.style.opacity = '1'; toast.style.transform = 'translateY(0)'; });
      setTimeout(() => {
        toast.style.opacity = '0'; toast.style.transform = 'translateY(0.5rem)';
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    };

    // Auth-aware fetch
    window.stdoutFetch = async function(url: string, options?: RequestInit) {
      const res = await fetch(url, options);
      if (res.status === 401) {
        window.showToast('Session expired. Redirecting to login...', 'info');
        setTimeout(() => { window.location.href = '/app/login?redirect=' + encodeURIComponent(window.location.pathname); }, 1500);
        throw new Error('Session expired');
      }
      if (!res.ok) {
        window.showToast('Something went wrong. Please try again.', 'error');
        throw new Error(`HTTP ${res.status}`);
      }
      return res;
    };

    // Auth state check
    const csrfMeta = document.querySelector('meta[name="csrf-token"]');
    const csrf = csrfMeta?.getAttribute('content') || '';

    fetch('/app/api/me').then(r => r.json()).then(user => {
      const authNav = document.getElementById('authNav');
      if (user && authNav) {
        authNav.textContent = '';

        // Avatar initial
        const name = user.displayName || user.email || '?';
        const initial = name.charAt(0).toUpperCase();
        const avatar = document.createElement('span');
        avatar.className = 'topnav-avatar';
        avatar.textContent = initial;
        avatar.title = user.email || '';

        // Display name
        const nameEl = document.createElement('a');
        nameEl.href = '/app/account';
        nameEl.className = 'topnav-user-name';
        nameEl.textContent = user.displayName || user.email.split('@')[0];

        // Log out form
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/app/logout';
        form.style.display = 'inline';
        const csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = '_csrf';
        csrfInput.value = csrf;
        form.appendChild(csrfInput);
        const btn = document.createElement('button');
        btn.type = 'submit';
        btn.className = 'topnav-auth-link';
        btn.textContent = 'Log out';
        btn.style.cssText = 'background:none; border:none; cursor:pointer; font:inherit; color:inherit;';
        form.appendChild(btn);
        authNav.append(avatar, nameEl, form);
      }
    }).catch(() => {});

    // Workspace switcher
    const wsSwitcher = document.getElementById('wsSwitcher') as HTMLSelectElement;
    wsSwitcher?.addEventListener('change', () => {
      const url = new URL(window.location.href);
      url.searchParams.set('ws', wsSwitcher.value);
      window.location.href = url.toString();
    });

    // Mobile nav toggle
    const navToggle = document.getElementById('navToggle');
    const navMobile = document.getElementById('navMobile');
    if (navToggle && navMobile) {
      navToggle.addEventListener('click', () => {
        const isOpen = navMobile.classList.toggle('open');
        navToggle.classList.toggle('active', isOpen);
        navToggle.setAttribute('aria-expanded', String(isOpen));
      });
    }

    // Mirror auth state into mobile nav
    fetch('/app/api/me').then(r => r.json()).then(mobileUser => {
      const mobileAuth = document.getElementById('mobileAuthNav');
      if (mobileUser && mobileAuth) {
        const name = mobileUser.displayName || mobileUser.email?.split('@')[0] || 'User';
        mobileAuth.innerHTML = '';

        const userInfo = document.createElement('div');
        userInfo.className = 'nav-mobile-user';
        const avatar = document.createElement('span');
        avatar.className = 'topnav-avatar';
        avatar.textContent = name.charAt(0).toUpperCase();
        const nameSpan = document.createElement('span');
        nameSpan.textContent = name;
        userInfo.append(avatar, nameSpan);
        mobileAuth.appendChild(userInfo);

        const accountLink = document.createElement('a');
        accountLink.href = '/app/account';
        accountLink.className = 'nav-mobile-link';
        accountLink.textContent = 'Account';
        mobileAuth.appendChild(accountLink);

        const logoutForm = document.createElement('form');
        logoutForm.method = 'POST';
        logoutForm.action = '/app/logout';
        const csrfIn = document.createElement('input');
        csrfIn.type = 'hidden';
        csrfIn.name = '_csrf';
        csrfIn.value = csrf;
        logoutForm.appendChild(csrfIn);
        const logoutBtn = document.createElement('button');
        logoutBtn.type = 'submit';
        logoutBtn.className = 'nav-mobile-link nav-mobile-logout';
        logoutBtn.textContent = 'Log out';
        logoutForm.appendChild(logoutBtn);
        mobileAuth.appendChild(logoutForm);
      }
    }).catch(() => {});
  </script>

  <style>
    .topnav {
      display: flex;
      align-items: center;
      gap: 24px;
      padding: 12px 20px;
      border-bottom: 1px solid var(--border);
      background: rgba(14, 14, 24, 0.85);
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(16px) saturate(180%);
      -webkit-backdrop-filter: blur(16px) saturate(180%);
      box-shadow: 0 1px 8px rgba(0,0,0,0.3);
    }
    .topnav-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      font-size: 15px;
      color: var(--text);
      text-decoration: none;
    }
    .logo-icon {
      width: 26px; height: 26px;
      background: var(--accent-dim);
      border: 1px solid rgba(249, 115, 22, 0.2);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 700;
      color: var(--accent-light);
    }
    .topnav-links {
      display: flex;
      gap: 20px;
      flex: 1;
    }
    .topnav-links a {
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 500;
      text-decoration: none;
      transition: color 150ms;
    }
    .topnav-links a:hover { color: var(--text); }
    .topnav-links a.active { color: var(--accent-light); }
    .topnav-auth {
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .topnav-auth-link {
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 500;
      text-decoration: none;
      transition: color 150ms;
    }
    .topnav-auth-link:hover { color: var(--text); }
    .ws-switcher { margin-left: auto; margin-right: 8px; }
    .ws-select {
      background: var(--bg-surface); border: 1px solid var(--border); border-radius: 4px;
      color: var(--text-secondary); font-size: 11px; padding: 4px 8px;
      font-family: var(--font-mono); cursor: pointer;
    }
    .ws-badge {
      font-size: 10px; padding: 2px 6px; border-radius: 4px;
      background: #DBEAFE; color: #1E40AF; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.04em; margin-right: 8px;
    }
    .topnav-avatar {
      width: 26px; height: 26px;
      background: var(--accent);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-ui);
      font-size: 12px;
      font-weight: 700;
      color: var(--bg);
      flex-shrink: 0;
    }
    .topnav-user-name {
      color: var(--text);
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: color 150ms;
    }
    .topnav-user-name:hover { color: var(--accent-light); }
    .main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 24px 20px;
    }

    /* ── Mobile hamburger toggle ─────────────────── */
    .nav-toggle {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px;
      min-height: 44px;
      min-width: 44px;
      align-items: center;
      justify-content: center;
      margin-left: auto;
    }
    .nav-toggle span {
      display: block;
      width: 20px;
      height: 2px;
      background: var(--text-secondary);
      border-radius: 1px;
      transition: all 0.25s ease;
    }
    .nav-toggle.active span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }
    .nav-toggle.active span:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle.active span:nth-child(3) {
      transform: rotate(-45deg) translate(5px, -5px);
    }

    /* ── Mobile nav panel ────────────────────────── */
    .nav-mobile {
      display: none;
      flex-direction: column;
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 49px; /* below topnav */
      z-index: 99;
    }
    .nav-mobile.open {
      display: flex;
    }
    .nav-mobile-link {
      display: block;
      padding: 14px 20px;
      color: var(--text-secondary);
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      border-bottom: 1px solid var(--border);
      transition: color 150ms, background 150ms;
    }
    .nav-mobile-link:hover {
      color: var(--text);
      background: var(--bg-hover);
    }
    .nav-mobile-link.active {
      color: var(--accent-light);
    }
    .nav-mobile-divider {
      height: 1px;
      background: var(--accent-dim);
      margin: 0;
    }
    .nav-mobile-auth {
      padding: 0;
    }
    .nav-mobile-user {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 20px;
      color: var(--text);
      font-size: 14px;
      font-weight: 600;
      border-bottom: 1px solid var(--border);
    }
    .nav-mobile-logout {
      width: 100%;
      text-align: left;
      background: none;
      border: none;
      border-bottom: none;
      cursor: pointer;
      font-family: var(--font-ui);
      color: var(--accent-light);
    }

    /* ── Responsive breakpoint (AFTER base styles) ─ */
    @media (max-width: 768px) {
      .topnav-links {
        display: none;
      }
      .topnav-auth {
        display: none;
      }
      .ws-switcher {
        display: none;
      }
      .ws-badge {
        display: none;
      }
      .nav-toggle {
        display: flex;
      }
    }
  </style>
</body>
</html>
