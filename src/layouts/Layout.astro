---
import '../styles/global.css';
import { getDb, schema } from '../lib/db';
import { getUserLimits } from '../lib/tiers';
import { eq } from 'drizzle-orm';
import AgentPanel from '../components/AgentPanel.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'StdOut', description = 'AI incident companion for solo developers and self-hosters.' } = Astro.props;
const path = Astro.url.pathname;
const csrfToken = Astro.locals.csrfToken;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://stdout.seayniclabs.com');
const nav = [
  { href: '/app', label: 'Dashboard' },
  { href: '/app/incidents', label: 'Incidents' },
  { href: '/app/observatory', label: 'Observatory' },
  { href: '/app/infrastructure', label: 'Infrastructure' },
  { href: '/app/alerts', label: 'Alerts' },
  { href: '/docs', label: 'Docs' },
  { href: '/app/settings', label: 'Settings' },
];
const mobileNav = [
  ...nav,
  { href: '/app/search', label: 'Search' },
  { href: '/app/settings', label: 'Settings' },
];

const user = Astro.locals.user;

// Load tenant branding
let workspaceName = 'StdOut';
let accentOverride = '';
let logoOverride = '';

// Build accent override CSS
let accentOverrideCSS = '';

if (user) {
  try {
    const db = getDb();
    const prefs = db.select().from(schema.systemSettings).get();
    if (prefs?.workspaceName) workspaceName = prefs.workspaceName;
    if (prefs?.accentColor && /^#[0-9a-fA-F]{3,8}$/.test(prefs.accentColor)) {
      accentOverride = prefs.accentColor;
      // Build CSS string in frontmatter where template literals work
      accentOverrideCSS = `:root{--accent-override:${accentOverride};--accent-light-override:color-mix(in srgb,${accentOverride} 85%,white);--accent-bright-override:color-mix(in srgb,${accentOverride} 120%,white);--accent-dim-override:${accentOverride}1f;--accent-glow-override:${accentOverride}40;--accent-btn-override:${accentOverride};--color-primary:${accentOverride};--color-primary-hover:color-mix(in srgb,${accentOverride} 85%,black);--color-primary-light:color-mix(in srgb,${accentOverride} 10%,white);}`;
      console.log('[Layout] accentOverrideCSS built:', accentOverrideCSS.substring(0, 100));
    }
    if (prefs?.logoUrl) logoOverride = prefs.logoUrl;
  } catch (err) {
    console.error('[Layout] Failed to load branding:', err);
  }
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={new URL('/og-image.png', Astro.site || 'https://stdout.seayniclabs.com').href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content={accentOverride || '#F97316'} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="StdOut" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <style>@import '../styles/fonts.css';</style>
  <meta name="csrf-token" content={csrfToken} />

  <!-- D3.js for topology diagram -->
  <script
    src="https://d3js.org/d3.v7.min.js"
    integrity="sha384-CjloA8y00+1SDAUkjs099PVfnY2KmDC2BZnws9kh8D/lX1s46w6EPhpXdqMfjK6i"
    crossorigin="anonymous"></script>

  <!-- Branding color override via JS -->
  {accentOverride && (
    <script is:inline define:vars={{ brandColor: accentOverride }}>
      const style = document.createElement('style');
      style.textContent = `:root{--accent:${brandColor};--accent-light:color-mix(in srgb,${brandColor} 85%,white);--accent-btn:${brandColor};--color-primary:${brandColor};}`;
      document.head.appendChild(style);
    </script>
  )}

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>

  <nav class="topnav" aria-label="Main navigation">
    <a href="/app" class="topnav-brand">
      {logoOverride ? (
        <img src={logoOverride} alt={workspaceName} width="24" height="24" style="border-radius: 4px;" />
      ) : (
        <img src="/logo.svg" alt={workspaceName} width="24" height="24" />
      )}
      <span class="topnav-brand-name">{workspaceName}</span>
    </a>
    <div class="topnav-links">
      {nav.map(({ href, label }) => (
        <a
          href={href}
          class:list={[{
            active: href === '/app' ? path === '/app' || path === '/app/' : path.startsWith(href)
          }]}
        >{label}</a>
      ))}
    </div>

    <form class="nav-search" action="/app/search" method="get" role="search">
      <svg class="nav-search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="8.5" cy="8.5" r="5.5" /><line x1="13" y1="13" x2="18" y2="18" />
      </svg>
      <input type="text" name="q" class="nav-search-input" placeholder="Search..." autocomplete="off" id="navSearchInput" />
      <kbd class="nav-search-kbd mono">/</kbd>
      <div class="nav-search-dropdown" id="navSearchDropdown"></div>
    </form>

    <button class="nav-search-toggle" id="mobileSearchToggle" aria-label="Search" type="button">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
        <circle cx="8.5" cy="8.5" r="5.5" /><line x1="13" y1="13" x2="18" y2="18" />
      </svg>
    </button>


    <div class="topnav-auth" id="authNav">
      <a href="/app/login" class="topnav-auth-link">Log in</a>
    </div>

    <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <div class="nav-mobile" id="navMobile">
    {mobileNav.map(({ href, label }) => (
      <a
        href={href}
        class:list={['nav-mobile-link', {
          active: href === '/app' ? path === '/app' || path === '/app/' : path.startsWith(href)
        }]}
      >{label}</a>
    ))}
    <div class="nav-mobile-divider"></div>
    <div class="nav-mobile-auth" id="mobileAuthNav">
      <a href="/app/login" class="nav-mobile-link">Log in</a>
    </div>
  </div>

  <main class="main" id="main-content">
    <slot />
  </main>

  <!-- Observatory Agent Panel -->
  <AgentPanel />

  <!-- Floating Agent Toggle Button -->
  <button
    id="agentToggle"
    class="agent-toggle"
    aria-label="Open Observatory Agent (Steer)"
    type="button"
    title="Ask Steer"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  </button>

  <footer style="text-align:center; padding:2rem 1rem 3rem; opacity:0.4;">
    <div style="display:flex; justify-content:center; gap:16px; margin-bottom:6px;">
      <a href="/privacy" style="font-family:var(--font-mono); font-size:0.65rem; color:var(--text-muted); text-decoration:none;">Privacy</a>
      <a href="/terms" style="font-family:var(--font-mono); font-size:0.65rem; color:var(--text-muted); text-decoration:none;">Terms</a>
    </div>
    <div style="font-family:var(--font-mono); font-size:0.65rem; color:var(--text-muted);">
      Built by Seaynic Labs LLC
    </div>
  </footer>

  <div id="toastContainer" aria-live="polite" style="position:fixed; bottom:1.5rem; right:1.5rem; z-index:9999; display:flex; flex-direction:column; gap:0.5rem; pointer-events:none;"></div>

  <script>
    // Toast system
    window.showToast = function(message: string, type: 'error' | 'success' | 'info' = 'error') {
      const container = document.getElementById('toastContainer');
      if (!container) return;
      const toast = document.createElement('div');
      toast.style.cssText = `
        pointer-events:auto; padding:0.75rem 1.25rem; border-radius:6px; font-size:0.85rem;
        font-family:var(--font-ui); max-width:360px; opacity:0; transform:translateY(0.5rem);
        transition:opacity 0.3s, transform 0.3s;
      `;
      const colors = {
        error: 'background:#2d1215; color:#e74c3c; border:1px solid #5c2428;',
        success: 'background:#122d15; color:#2ecc71; border:1px solid #245c28;',
        info: 'background:#15202d; color:#3498db; border:1px solid #28405c;',
      };
      toast.style.cssText += colors[type];
      toast.textContent = message;
      container.appendChild(toast);
      requestAnimationFrame(() => { toast.style.opacity = '1'; toast.style.transform = 'translateY(0)'; });
      setTimeout(() => {
        toast.style.opacity = '0'; toast.style.transform = 'translateY(0.5rem)';
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    };

    // Auth-aware fetch
    window.stdoutFetch = async function(url: string, options?: RequestInit) {
      const res = await fetch(url, options);
      if (res.status === 401) {
        window.showToast('Session expired. Redirecting to login...', 'info');
        setTimeout(() => { window.location.href = '/app/login?redirect=' + encodeURIComponent(window.location.pathname); }, 1500);
        throw new Error('Session expired');
      }
      if (!res.ok) {
        window.showToast('Something went wrong. Please try again.', 'error');
        throw new Error(`HTTP ${res.status}`);
      }
      return res;
    };

    // Auth state check
    const csrfMeta = document.querySelector('meta[name="csrf-token"]');
    const csrf = csrfMeta?.getAttribute('content') || '';

    fetch('/app/api/me').then(r => r.json()).then(user => {
      const authNav = document.getElementById('authNav');
      const settingsGear = document.getElementById('settingsGear');
      if (user && authNav) {
        authNav.textContent = '';

        // Avatar initial
        const name = user.displayName || user.email || '?';
        const initial = name.charAt(0).toUpperCase();
        const avatar = document.createElement('span');
        avatar.className = 'topnav-avatar';
        avatar.textContent = initial;
        avatar.title = user.email || '';

        // Display name
        const nameEl = document.createElement('a');
        nameEl.href = '/app/account';
        nameEl.className = 'topnav-user-name';
        nameEl.textContent = user.displayName || user.email.split('@')[0];

        // Log out form
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/app/logout';
        form.style.display = 'inline';
        const csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = '_csrf';
        csrfInput.value = csrf;
        form.appendChild(csrfInput);
        const btn = document.createElement('button');
        btn.type = 'submit';
        btn.className = 'topnav-auth-link';
        btn.textContent = 'Log out';
        btn.style.cssText = 'background:none; border:none; cursor:pointer; font:inherit; color:inherit;';
        form.appendChild(btn);
        authNav.append(avatar, nameEl, form);

        // Show gear icon when authenticated
        if (settingsGear) settingsGear.style.display = '';
      }
    }).catch(() => {});



    // Nav search inline dropdown
    const navSearchInput = document.getElementById('navSearchInput') as HTMLInputElement;
    const navSearchDropdown = document.getElementById('navSearchDropdown');
    let navSearchDebounce: any;
    let navDropdownIndex = -1;

    function escapeNavHtml(s: string) {
      return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function typeToHref(r: any): string {
      if (r.type === 'incident') return `/app/incidents/${r.incidentId}`;
      if (r.type === 'resolution') return `/app/incidents/${r.incidentId}`;
      if (r.type === 'doc') return `/app/docs/${r.docId}`;
      if (r.type === 'stack') return `/app/stacks`;
      if (r.type === 'monitor') return `/app/hud/${r.monitorId}`;
      return '/app/search';
    }

    navSearchInput?.addEventListener('input', () => {
      const q = navSearchInput.value.trim();
      if (q.length < 2) {
        if (navSearchDropdown) navSearchDropdown.classList.remove('open');
        return;
      }
      clearTimeout(navSearchDebounce);
      navSearchDebounce = setTimeout(async () => {
        try {
          const res = await fetch(`/app/api/search?q=${encodeURIComponent(q)}`);
          if (!res.ok || !navSearchDropdown) return;
          const data = await res.json();
          const results = (data.results || []).slice(0, 6);
          navDropdownIndex = -1;

          if (results.length === 0) {
            navSearchDropdown.innerHTML = `<div class="nav-dropdown-empty">No results for &lsquo;${escapeNavHtml(q)}&rsquo;</div>
              <a href="/app/search?q=${encodeURIComponent(q)}" class="nav-dropdown-footer">Full search &rarr;</a>`;
          } else {
            let html = results.map((r: any) => {
              const typeLabel = r.type === 'resolution' ? 'fix' : r.type;
              return `<a href="${typeToHref(r)}" class="nav-dropdown-item" data-nav-result>
                <span class="nav-dropdown-type ${r.type}">${escapeNavHtml(typeLabel)}</span>
                <span class="nav-dropdown-title">${escapeNavHtml(r.title || '')}</span>
              </a>`;
            }).join('');
            html += `<a href="/app/search?q=${encodeURIComponent(q)}" class="nav-dropdown-footer">View all results &rarr;</a>`;
            navSearchDropdown.innerHTML = html;
          }
          navSearchDropdown.classList.add('open');
        } catch {}
      }, 250);
    });

    // Keyboard nav for dropdown
    navSearchInput?.addEventListener('keydown', (e) => {
      if (!navSearchDropdown?.classList.contains('open')) return;
      const items = navSearchDropdown.querySelectorAll('[data-nav-result]');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        navDropdownIndex = Math.min(navDropdownIndex + 1, items.length - 1);
        items.forEach((el, i) => el.classList.toggle('selected', i === navDropdownIndex));
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        navDropdownIndex = Math.max(navDropdownIndex - 1, -1);
        items.forEach((el, i) => el.classList.toggle('selected', i === navDropdownIndex));
      } else if (e.key === 'Enter' && navDropdownIndex >= 0) {
        e.preventDefault();
        const selected = items[navDropdownIndex] as HTMLAnchorElement;
        if (selected) window.location.href = selected.href;
      } else if (e.key === 'Escape') {
        navSearchDropdown.classList.remove('open');
      }
    });

    // Close dropdown on outside click
    document.addEventListener('click', (e) => {
      if (navSearchDropdown && !navSearchDropdown.contains(e.target as Node) && e.target !== navSearchInput) {
        navSearchDropdown.classList.remove('open');
      }
    });

    // "/" keyboard shortcut to focus search
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
        e.preventDefault();
        navSearchInput?.focus();
      }
    });

    // Mobile nav toggle
    const navToggle = document.getElementById('navToggle');
    const navMobile = document.getElementById('navMobile');
    if (navToggle && navMobile) {
      navToggle.addEventListener('click', () => {
        const isOpen = navMobile.classList.toggle('open');
        navToggle.classList.toggle('active', isOpen);
        navToggle.setAttribute('aria-expanded', String(isOpen));
      });
    }

    // Mobile search toggle
    const mobileSearchToggle = document.getElementById('mobileSearchToggle');
    const navSearch = document.querySelector('.nav-search') as HTMLElement;
    if (mobileSearchToggle && navSearch) {
      mobileSearchToggle.addEventListener('click', () => {
        navSearch.classList.toggle('mobile-open');
        if (navSearch.classList.contains('mobile-open')) {
          const input = navSearch.querySelector('.nav-search-input') as HTMLInputElement;
          input?.focus();
        }
      });
      // Close mobile search on outside click
      document.addEventListener('click', (e) => {
        if (!navSearch.contains(e.target as Node) && e.target !== mobileSearchToggle && !mobileSearchToggle.contains(e.target as Node)) {
          navSearch.classList.remove('mobile-open');
        }
      });
    }

    // Mirror auth state into mobile nav
    fetch('/app/api/me').then(r => r.json()).then(mobileUser => {
      const mobileAuth = document.getElementById('mobileAuthNav');
      if (mobileUser && mobileAuth) {
        const name = mobileUser.displayName || mobileUser.email?.split('@')[0] || 'User';
        mobileAuth.innerHTML = '';

        const userInfo = document.createElement('div');
        userInfo.className = 'nav-mobile-user';
        const avatar = document.createElement('span');
        avatar.className = 'topnav-avatar';
        avatar.textContent = name.charAt(0).toUpperCase();
        const nameSpan = document.createElement('span');
        nameSpan.textContent = name;
        userInfo.append(avatar, nameSpan);
        mobileAuth.appendChild(userInfo);

        const accountLink = document.createElement('a');
        accountLink.href = '/app/account';
        accountLink.className = 'nav-mobile-link';
        accountLink.textContent = 'Account';
        mobileAuth.appendChild(accountLink);

        const logoutForm = document.createElement('form');
        logoutForm.method = 'POST';
        logoutForm.action = '/app/logout';
        const csrfIn = document.createElement('input');
        csrfIn.type = 'hidden';
        csrfIn.name = '_csrf';
        csrfIn.value = csrf;
        logoutForm.appendChild(csrfIn);
        const logoutBtn = document.createElement('button');
        logoutBtn.type = 'submit';
        logoutBtn.className = 'nav-mobile-link nav-mobile-logout';
        logoutBtn.textContent = 'Log out';
        logoutForm.appendChild(logoutBtn);
        mobileAuth.appendChild(logoutForm);
      }
    }).catch(() => {});
  </script>

  <style>
    .topnav {
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 12px 24px;
      border-bottom: 1px solid var(--border);
      background: rgba(14, 14, 24, 0.85);
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(16px) saturate(180%);
      -webkit-backdrop-filter: blur(16px) saturate(180%);
      box-shadow: 0 2px 12px rgba(0,0,0,0.4), inset 0 -1px 0 rgba(255,255,255,0.03);
    }
    .topnav-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 700;
      font-size: 15px;
      color: var(--text);
      text-decoration: none;
      flex-shrink: 0;
      white-space: nowrap;
    }
    .topnav-brand-name {
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 180px;
    }
    .logo-icon {
      width: 26px; height: 26px;
      background: var(--accent-dim);
      border: 1px solid rgba(249, 115, 22, 0.2);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 700;
      color: var(--accent-light);
    }
    .topnav-links {
      display: flex;
      gap: 24px;
      flex: 1;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .topnav-links::-webkit-scrollbar {
      display: none;
    }
    .topnav-links a {
      color: var(--text-secondary);
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      transition: color 150ms;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .topnav-links a:hover { color: var(--text); }
    .topnav-links a.active { color: var(--accent-light); }
    .topnav-auth {
      display: flex;
      gap: 12px;
      align-items: center;
      flex-shrink: 0;
      white-space: nowrap;
    }
    .topnav-auth-link {
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 500;
      text-decoration: none;
      transition: color 150ms;
    }
    .topnav-auth-link:hover { color: var(--text); }

    .topnav-avatar {
      width: 26px; height: 26px;
      background: var(--accent);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-ui);
      font-size: 12px;
      font-weight: 700;
      color: var(--bg);
      flex-shrink: 0;
    }
    .topnav-user-name {
      color: var(--text);
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: color 150ms;
    }
    .topnav-user-name:hover { color: var(--accent-light); }
    .main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 24px 20px;
      animation: fadeIn 0.4s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Smooth transitions for all interactive elements */
    button, a, input, select, textarea {
      transition: all 0.2s ease;
    }

    button:hover:not(:disabled), .btn:hover:not(:disabled) {
      transform: translateY(-1px);
    }

    button:active:not(:disabled), .btn:active:not(:disabled) {
      transform: translateY(0);
    }

    /* ── Nav search bar ───────────────────────────── */
    .nav-search {
      display: flex;
      align-items: center;
      position: relative;
      max-width: 280px;
      min-width: 180px;
      flex-shrink: 0;
    }
    .nav-search-icon {
      position: absolute;
      left: 10px;
      width: 14px;
      height: 14px;
      color: var(--text-muted);
      pointer-events: none;
      flex-shrink: 0;
    }
    .nav-search-input {
      width: 140px;
      padding: 6px 10px 6px 30px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text);
      font-size: 12px;
      font-family: var(--font-ui);
      transition: width 200ms ease, border-color 150ms, background 150ms;
      outline: none;
    }
    .nav-search-input::placeholder {
      color: var(--text-muted);
      font-size: 12px;
    }
    .nav-search-input:focus {
      width: 240px;
      border-color: var(--border-hover);
      background: rgba(14, 14, 24, 0.95);
    }
    .nav-search-kbd {
      position: absolute;
      right: 8px;
      padding: 1px 6px;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 3px;
      color: var(--text-muted);
      font-size: 10px;
      pointer-events: none;
      opacity: 0.6;
    }
    .nav-search-input:focus ~ .nav-search-kbd {
      display: none;
    }

    /* ── Nav search dropdown ──────────────────────── */
    .nav-search-dropdown {
      display: none;
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      right: 0;
      min-width: 320px;
      max-height: 400px;
      overflow-y: auto;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow-lg);
      z-index: 200;
    }
    .nav-search-dropdown.open {
      display: block;
    }
    .nav-dropdown-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 14px;
      text-decoration: none;
      color: var(--text);
      font-size: 13px;
      transition: background 150ms;
      border-bottom: 1px solid var(--border);
    }
    .nav-dropdown-item:last-child {
      border-bottom: none;
    }
    .nav-dropdown-item:hover,
    .nav-dropdown-item.selected {
      background: var(--bg-hover);
    }
    .nav-dropdown-type {
      font-size: 9px;
      font-weight: 600;
      font-family: var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 1px 5px;
      border-radius: 3px;
      flex-shrink: 0;
    }
    .nav-dropdown-type.incident { color: var(--critical); background: var(--critical-dim); }
    .nav-dropdown-type.resolution { color: var(--low); background: var(--low-dim); }
    .nav-dropdown-type.doc { color: var(--high); background: var(--high-dim); }
    .nav-dropdown-type.stack { color: #38bdf8; background: rgba(56, 189, 248, 0.1); }
    .nav-dropdown-type.monitor { color: #a78bfa; background: rgba(167, 139, 250, 0.1); }
    .nav-dropdown-title {
      flex: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .nav-dropdown-footer {
      display: block;
      padding: 8px 14px;
      text-align: center;
      font-size: 11px;
      font-weight: 500;
      color: var(--accent-light);
      text-decoration: none;
      border-top: 1px solid var(--border);
      transition: background 150ms;
    }
    .nav-dropdown-footer:hover {
      background: var(--accent-dim);
    }
    .nav-dropdown-empty {
      padding: 16px 14px;
      text-align: center;
      font-size: 12px;
      color: var(--text-muted);
    }

    /* ── Mobile search toggle button ─────────────── */
    .nav-search-toggle {
      display: none;
      background: none;
      border: none;
      color: var(--text-secondary);
      cursor: pointer;
      padding: 8px;
      min-height: 44px;
      min-width: 44px;
      align-items: center;
      justify-content: center;
      transition: color 150ms;
    }
    .nav-search-toggle:hover { color: var(--text); }

    /* ── Gear icon ────────────────────────────────── */
    .topnav-gear {
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-secondary);
      transition: color 150ms;
      padding: 4px;
      flex-shrink: 0;
    }
    .topnav-gear:hover { color: var(--accent-light); }

    /* ── Mobile hamburger toggle ─────────────────── */
    .nav-toggle {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px;
      min-height: 44px;
      min-width: 44px;
      align-items: center;
      justify-content: center;
      margin-left: auto;
    }
    .nav-toggle span {
      display: block;
      width: 20px;
      height: 2px;
      background: var(--text-secondary);
      border-radius: 1px;
      transition: all 0.25s ease;
    }
    .nav-toggle.active span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }
    .nav-toggle.active span:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle.active span:nth-child(3) {
      transform: rotate(-45deg) translate(5px, -5px);
    }

    /* ── Mobile nav panel ────────────────────────── */
    .nav-mobile {
      display: none;
      flex-direction: column;
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 49px; /* below topnav */
      z-index: 99;
    }
    .nav-mobile.open {
      display: flex;
    }
    .nav-mobile-link {
      display: block;
      padding: 14px 20px;
      color: var(--text-secondary);
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      border-bottom: 1px solid var(--border);
      transition: color 150ms, background 150ms;
    }
    .nav-mobile-link:hover {
      color: var(--text);
      background: var(--bg-hover);
    }
    .nav-mobile-link.active {
      color: var(--accent-light);
    }
    .nav-mobile-divider {
      height: 1px;
      background: var(--accent-dim);
      margin: 0;
    }
    .nav-mobile-auth {
      padding: 0;
    }
    .nav-mobile-user {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 20px;
      color: var(--text);
      font-size: 14px;
      font-weight: 600;
      border-bottom: 1px solid var(--border);
    }
    .nav-mobile-logout {
      width: 100%;
      text-align: left;
      background: none;
      border: none;
      border-bottom: none;
      cursor: pointer;
      font-family: var(--font-ui);
      color: var(--accent-light);
    }

    /* ── Responsive breakpoint (AFTER base styles) ─ */
    @media (max-width: 768px) {
      .topnav-links {
        display: none;
      }
      .topnav-auth {
        display: none;
      }
      .topnav-gear {
        display: none !important;
      }
      .ws-switcher {
        display: none;
      }
      .ws-badge {
        display: none;
      }
      .nav-search {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        max-width: none;
        padding: 8px 12px;
        background: rgba(14, 14, 24, 0.98);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        z-index: 101;
        border-bottom: 1px solid var(--border);
      }
      .nav-search.mobile-open {
        display: flex;
      }
      .nav-search.mobile-open .nav-search-input {
        width: 100%;
        font-size: 16px;
        padding: 10px 10px 10px 34px;
      }
      .nav-search.mobile-open .nav-search-kbd {
        display: none;
      }
      .nav-search.mobile-open .nav-search-dropdown {
        min-width: unset;
        left: 0;
        right: 0;
      }
      .nav-search-toggle {
        display: flex;
      }
      .nav-toggle {
        display: flex;
      }
    }

    /* Observatory Agent Toggle Button */
    .agent-toggle {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: var(--accent);
      color: white;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 12px rgba(249, 115, 22, 0.4),
                  0 2px 6px rgba(0, 0, 0, 0.3);
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 999;
    }

    .agent-toggle:hover {
      background: var(--accent-light);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(249, 115, 22, 0.5),
                  0 4px 8px rgba(0, 0, 0, 0.4);
    }

    .agent-toggle:active {
      transform: translateY(0);
    }

    @media (max-width: 768px) {
      .agent-toggle {
        bottom: 1rem;
        right: 1rem;
        width: 52px;
        height: 52px;
      }
    }
  </style>

  <!-- Load active skin on page load -->
  <script>
    import { loadSavedSkin } from '../lib/skins/apply-skin';
    import { defaultSkins } from '../lib/skins/default-skins';

    // Apply saved skin or default (Obsidian) on page load
    loadSavedSkin(defaultSkins[0], defaultSkins);
  </script>

  <!-- Observatory Agent Toggle -->
  <script>
    const agentToggle = document.getElementById('agentToggle');

    agentToggle?.addEventListener('click', () => {
      if (typeof (window as any).toggleAgentPanel === 'function') {
        (window as any).toggleAgentPanel();
      }
    });
  </script>
</body>
</html>
