---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'StdOut Setup', description = 'AI incident companion for solo developers and self-hosters.' } = Astro.props;
const csrfToken = Astro.locals.csrfToken;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://stdout.seayniclabs.com');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={new URL('/og-image.png', Astro.site || 'https://stdout.seayniclabs.com').href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#F97316" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="StdOut" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="csrf-token" content={csrfToken} />
  <script nonce={Astro.locals.nonce} defer src="https://analytics.seaynicroute.com/data" data-website-id="6794355e-d87a-4022-9062-4d473bdc4716"></script>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>

  <!-- Minimal header with just logo -->
  <nav class="setup-nav">
    <div class="setup-nav-content">
      <div class="setup-logo">
        <img src="/logo.svg" alt="StdOut" width="24" height="24" />
        <span>StdOut</span>
      </div>
    </div>
  </nav>

  <main class="main" id="main-content">
    <slot />
  </main>

  <footer style="text-align:center; padding:2rem 1rem 3rem; opacity:0.4;">
    <div style="display:flex; justify-content:center; gap:16px; margin-bottom:6px;">
      <a href="/privacy" style="font-family:var(--font-mono); font-size:0.65rem; color:var(--text-muted); text-decoration:none;">Privacy</a>
      <a href="/terms" style="font-family:var(--font-mono); font-size:0.65rem; color:var(--text-muted); text-decoration:none;">Terms</a>
    </div>
    <div style="font-family:var(--font-mono); font-size:0.65rem; color:var(--text-muted);">
      Built by Seaynic Labs LLC
    </div>
  </footer>

  <div id="toastContainer" aria-live="polite" style="position:fixed; bottom:1.5rem; right:1.5rem; z-index:9999; display:flex; flex-direction:column; gap:0.5rem; pointer-events:none;"></div>

  <script nonce={Astro.locals.nonce} type="module">
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>
</body>
</html>

<style>
  .setup-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
  }

  .setup-nav-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .setup-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 1.125rem;
  }

  .main {
    min-height: calc(100vh - 200px);
    padding: 2rem 1.5rem;
  }
</style>
