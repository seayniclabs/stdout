---
export const prerender = true;

import '../../styles/global.css';
import { useCases, getRelatedUseCases, categoryLabels } from '../../data/use-cases';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return useCases.map(uc => ({ params: { slug: uc.slug }, props: { useCase: uc } }));
};

const { useCase } = Astro.props;
const related = getRelatedUseCases(useCase.slug);
const canonicalUrl = `https://stdout.seayniclabs.com/use-cases/${useCase.slug}`;

const featureIcons = [
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" stroke="#FB923C" stroke-width="2" stroke-linecap="round"/></svg>',
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l.146.146A2 2 0 0116 19H8a2 2 0 01-1.414-.586l.146-.146z" stroke="#FB923C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" stroke="#FB923C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="1" stroke="#FB923C" stroke-width="2"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="#FB923C" stroke-width="2"/><rect x="3" y="14" width="7" height="7" rx="1" stroke="#FB923C" stroke-width="2"/><rect x="14" y="14" width="7" height="7" rx="1" stroke="#FB923C" stroke-width="2"/></svg>',
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="#FB923C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2h1a2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke="#FB923C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
];

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "StdOut",
      "description": useCase.metaDescription,
      "url": "https://stdout.seayniclabs.com",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Docker / Linux / macOS",
      "offers": {
        "@type": "Offer",
        "price": "149",
        "priceCurrency": "USD",
        "description": "One-time purchase, self-hosted"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is StdOut?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "StdOut is a self-hosted incident companion for homelab builders and solo DevOps engineers. It provides AI diagnosis, living runbooks, stack auto-discovery, and full-text search across your incident history."
          }
        },
        {
          "@type": "Question",
          "name": "How much does StdOut cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "StdOut is a one-time purchase of $149 for the self-hosted version. A free cloud tier is also available with limited features."
          }
        },
        {
          "@type": "Question",
          "name": "Is StdOut self-hosted?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. StdOut ships as a Docker image that you deploy on your own hardware. Your data stays on your infrastructure. A free cloud option is also available."
          }
        }
      ]
    }
  ]
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={useCase.metaDescription} />
  <title>{useCase.title}</title>
  <meta property="og:title" content={useCase.title} />
  <meta property="og:description" content={useCase.metaDescription} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#F97316" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>@import '../../styles/fonts.css';</style>
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
</head>
<body>
  <!-- Nav -->
  <nav class="ln">
    <a href="/" class="ln-brand">
      <img src="/logo.svg" alt="StdOut" width="28" height="28" />
      <span>StdOut</span>
    </a>
    <div class="ln-links">
      <a href="/#how" class="ln-link">How it works</a>
      <a href="/#features" class="ln-link">Features</a>
      <a href="/use-cases" class="ln-link">Use Cases</a>
      <a href="/#pricing" class="ln-link">Pricing</a>
      <a href="/docs/scanner" class="ln-link">Docs</a>
      <a href="/app/login" class="ln-link">Log in</a>
      <a href="/app/register" class="btn btn-primary btn-sm">Self-Host $149</a>
    </div>
    <button class="ln-toggle" id="lnToggle" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <div class="ln-mobile" id="lnMobile">
    <a href="/#how" class="ln-mobile-link">How it works</a>
    <a href="/#features" class="ln-mobile-link">Features</a>
    <a href="/use-cases" class="ln-mobile-link">Use Cases</a>
    <a href="/#pricing" class="ln-mobile-link">Pricing</a>
    <a href="/docs/scanner" class="ln-mobile-link">Docs</a>
    <a href="/app/login" class="ln-mobile-link">Log in</a>
    <a href="/app/register" class="ln-mobile-link ln-mobile-cta">Self-Host $149</a>
  </div>

  <!-- Breadcrumb -->
  <div class="breadcrumb">
    <a href="/">StdOut</a>
    <span class="bc-sep">/</span>
    <a href="/use-cases">Use Cases</a>
    <span class="bc-sep">/</span>
    <span class="bc-current">{categoryLabels[useCase.category]}</span>
  </div>

  <!-- Hero -->
  <section class="uc-hero">
    <div class="uc-category mono">{categoryLabels[useCase.category].toUpperCase()}</div>
    <h1>{useCase.headline}</h1>
    <p class="uc-sub">{useCase.subheadline}</p>
    <div class="uc-cta">
      <a href="/app/register" class="btn btn-primary btn-lg btn-glow">Self-Host for $149</a>
      <a href="/app/register" class="btn btn-ghost">Try Free on Cloud</a>
    </div>
  </section>

  <!-- Problem -->
  <section class="uc-section">
    <div class="uc-section-inner">
      <div class="uc-label mono">THE PROBLEM</div>
      <h2>Why this matters</h2>
      <p class="uc-body">{useCase.problem}</p>
    </div>
  </section>

  <!-- Solution -->
  <section class="uc-section uc-solution">
    <div class="uc-section-inner">
      <div class="uc-label mono" style="color: var(--accent-light);">THE SOLUTION</div>
      <h2>How StdOut helps</h2>
      <p class="uc-body">{useCase.solution}</p>
    </div>
  </section>

  <!-- Features -->
  <section class="uc-features">
    <h2>What you get</h2>
    <div class="uc-feat-grid">
      {useCase.features.map((feat, i) => (
        <div class="uc-feat">
          <div class="uc-feat-icon" set:html={featureIcons[i % featureIcons.length]} />
          <p>{feat}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Related -->
  {related.length > 0 && (
    <section class="uc-related">
      <h2>Related use cases</h2>
      <div class="uc-related-grid">
        {related.map(r => (
          <a href={`/use-cases/${r.slug}`} class="uc-related-card">
            <span class="uc-related-cat mono">{categoryLabels[r.category]}</span>
            <span class="uc-related-title">{r.headline}</span>
            <span class="uc-related-desc">{r.subheadline}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Pricing CTA -->
  <section class="bottom-cta">
    <div class="cta-inner">
      <img src="/logo.svg" alt="" width="48" height="48" style="margin-bottom: 20px; opacity: 0.8;" />
      <h2>Stop solving the same incident twice.</h2>
      <p class="mono" style="color: var(--text-muted); margin-bottom: 24px;">$149 one-time. Docker image. Your infra, your data, forever.</p>
      <div class="cta-buttons">
        <a href="/app/register" class="btn btn-primary btn-lg btn-glow">Self-Host for $149</a>
        <a href="/app/register" class="btn btn-ghost">Or try free on cloud</a>
      </div>
    </div>
  </section>

  <footer class="lf">
    <div class="lf-links">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/docs/scanner">Docs</a>
      <a href="/use-cases">Use Cases</a>
      <a href="mailto:hello@seayniclabs.com">Contact</a>
    </div>
    <span class="mono" style="font-size: 11px; color: var(--text-muted);">StdOut by <a href="https://seayniclabs.com" style="color: var(--text-secondary);">Seaynic Labs</a></span>
  </footer>
</body>
</html>

<style>
  /* ── Nav (same as index) ─────────────────────── */
  .ln { display: flex; justify-content: space-between; align-items: center; padding: 14px 24px; max-width: 1100px; margin: 0 auto; }
  .ln-brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 17px; color: var(--text); text-decoration: none; }
  .ln-links { display: flex; align-items: center; gap: 20px; }
  .ln-link { font-size: 13px; color: var(--text-muted); text-decoration: none; font-family: var(--font-mono); }
  .ln-link:hover { color: var(--text); }
  .btn-sm { padding: 7px 16px; font-size: 12px; }
  .btn-lg { padding: 14px 32px; font-size: 15px; }
  .btn-glow { box-shadow: 0 0 20px var(--accent-glow), var(--shadow-sm); }
  .btn-glow:hover { box-shadow: 0 0 40px var(--accent-glow), 0 0 80px rgba(249, 115, 22, 0.1), var(--shadow-md); }
  .btn-ghost {
    background: transparent; color: var(--text-secondary); border: 1px solid var(--border);
    padding: 10px 20px; border-radius: var(--radius-sm); font-size: 13px; font-weight: 600;
    font-family: var(--font-ui); cursor: pointer; transition: all 0.15s ease; text-decoration: none;
    display: inline-flex; align-items: center; gap: 8px;
  }
  .btn-ghost:hover { color: var(--text); border-color: var(--border-hover); background: var(--bg-surface); transform: translateY(-1px); }

  .ln-toggle {
    display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer;
    padding: 8px; min-height: 44px; min-width: 44px; align-items: center; justify-content: center;
  }
  .ln-toggle span { display: block; width: 20px; height: 2px; background: var(--text-secondary); border-radius: 1px; transition: all 0.25s ease; }
  .ln-toggle.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
  .ln-toggle.active span:nth-child(2) { opacity: 0; }
  .ln-toggle.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

  .ln-mobile {
    display: none; flex-direction: column; background: var(--bg-surface); border-bottom: 1px solid var(--border);
    position: sticky; top: 0; z-index: 99;
  }
  .ln-mobile.open { display: flex; }
  .ln-mobile-link {
    display: block; padding: 14px 24px; color: var(--text-secondary); font-size: 14px; font-weight: 500;
    font-family: var(--font-mono); text-decoration: none; border-bottom: 1px solid var(--border);
    transition: color 150ms, background 150ms;
  }
  .ln-mobile-link:hover { color: var(--text); background: var(--bg-hover); }
  .ln-mobile-cta { color: var(--accent-light); font-weight: 600; }

  /* ── Breadcrumb ──────────────────────────────── */
  .breadcrumb {
    max-width: 1100px; margin: 0 auto; padding: 12px 24px;
    font-size: 12px; font-family: var(--font-mono); color: var(--text-muted);
  }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--text-secondary); }
  .bc-sep { margin: 0 8px; opacity: 0.4; }
  .bc-current { color: var(--text-secondary); }

  /* ── Hero ─────────────────────────────────────── */
  .uc-hero {
    text-align: center; padding: 60px 24px 48px; max-width: 780px; margin: 0 auto;
    animation: fadeInUp 0.5s ease-out both;
  }
  .uc-category {
    font-size: 11px; letter-spacing: 0.14em; color: var(--accent-light);
    margin-bottom: 16px; font-weight: 700;
  }
  .uc-hero h1 {
    font-size: clamp(28px, 4.5vw, 42px); font-weight: 800; line-height: 1.15;
    letter-spacing: -0.03em; margin-bottom: 16px;
  }
  .uc-sub {
    font-size: 16px; line-height: 1.7; color: var(--text-secondary);
    max-width: 600px; margin: 0 auto 28px;
  }
  .uc-cta {
    display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap;
  }

  /* ── Sections ────────────────────────────────── */
  .uc-section {
    max-width: 780px; margin: 0 auto; padding: 48px 24px;
  }
  .uc-section-inner {
    background: var(--bg-surface); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 36px 32px;
    box-shadow: var(--shadow-md);
    animation: fadeIn 0.4s ease-out both;
  }
  .uc-solution .uc-section-inner {
    border-color: rgba(249, 115, 22, 0.15);
    box-shadow: 0 0 40px rgba(249, 115, 22, 0.04), var(--shadow-md);
  }
  .uc-label {
    font-size: 10px; letter-spacing: 0.12em; color: var(--text-muted);
    margin-bottom: 8px; font-weight: 600;
  }
  .uc-section h2 {
    font-size: 22px; font-weight: 700; margin-bottom: 16px;
  }
  .uc-body {
    font-size: 15px; line-height: 1.75; color: var(--text-secondary);
  }

  /* ── Features grid ───────────────────────────── */
  .uc-features {
    max-width: 900px; margin: 0 auto; padding: 48px 24px;
  }
  .uc-features h2 {
    text-align: center; font-size: 24px; font-weight: 700; margin-bottom: 32px;
  }
  .uc-feat-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;
  }
  .uc-feat {
    display: flex; align-items: flex-start; gap: 14px;
    background: var(--bg-surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 20px;
    transition: all 0.2s ease;
  }
  .uc-feat:hover {
    border-color: var(--border-hover); transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .uc-feat-icon {
    flex-shrink: 0; width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    background: var(--accent-dim); border-radius: var(--radius-sm);
    border: 1px solid rgba(249, 115, 22, 0.1);
  }
  .uc-feat p { font-size: 14px; color: var(--text-secondary); line-height: 1.55; }

  /* ── Related ─────────────────────────────────── */
  .uc-related {
    max-width: 900px; margin: 0 auto; padding: 32px 24px 48px;
  }
  .uc-related h2 {
    text-align: center; font-size: 20px; font-weight: 700; margin-bottom: 24px;
    color: var(--text-secondary);
  }
  .uc-related-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
  }
  .uc-related-card {
    display: flex; flex-direction: column; gap: 6px;
    background: var(--bg-surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 20px;
    text-decoration: none; transition: all 0.2s ease;
  }
  .uc-related-card:hover {
    border-color: var(--border-hover); transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .uc-related-cat { font-size: 10px; color: var(--accent-light); letter-spacing: 0.08em; font-weight: 600; }
  .uc-related-title { font-size: 14px; font-weight: 600; color: var(--text); line-height: 1.3; }
  .uc-related-desc { font-size: 12px; color: var(--text-muted); line-height: 1.5; }

  /* ── Bottom CTA (same as index) ──────────────── */
  .bottom-cta { padding: 0 24px 80px; }
  .cta-inner {
    text-align: center; max-width: 560px; margin: 0 auto; padding: 48px 32px;
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    background: var(--bg-surface); box-shadow: var(--shadow-lg);
    position: relative; overflow: hidden;
  }
  .cta-inner::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-dim), var(--accent-glow), var(--accent-dim), transparent);
  }
  .cta-inner h2 { font-size: 22px; font-weight: 700; margin-bottom: 4px; }
  .cta-buttons { display: flex; flex-direction: column; align-items: center; gap: 12px; }

  /* ── Footer ──────────────────────────────────── */
  .lf { text-align: center; padding: 24px; border-top: 1px solid var(--border); }
  .lf-links { display: flex; justify-content: center; gap: 20px; margin-bottom: 8px; }
  .lf-links a { font-size: 12px; color: var(--text-muted); text-decoration: none; font-family: var(--font-mono); }
  .lf-links a:hover { color: var(--text-secondary); }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 700px) {
    .ln-link { display: none; }
    .ln-links .btn-sm { display: none; }
    .ln-toggle { display: flex; }
    .uc-hero { padding: 40px 16px 32px; }
    .uc-hero h1 { font-size: clamp(24px, 6vw, 32px); }
    .uc-section { padding: 32px 16px; }
    .uc-section-inner { padding: 24px 20px; }
    .uc-feat-grid { grid-template-columns: 1fr; }
    .uc-related-grid { grid-template-columns: 1fr; }
    .uc-features, .uc-related { padding: 32px 16px; }
    .bottom-cta { padding: 0 16px 60px; }
  }
  @media (min-width: 701px) and (max-width: 950px) {
    .uc-related-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  const lnToggle = document.getElementById('lnToggle');
  const lnMobile = document.getElementById('lnMobile');
  function closeMobileNav() {
    lnMobile?.classList.remove('open');
    lnToggle?.classList.remove('active');
    lnToggle?.setAttribute('aria-expanded', 'false');
  }
  if (lnToggle && lnMobile) {
    lnToggle.addEventListener('click', () => {
      const isOpen = lnMobile.classList.toggle('open');
      lnToggle.classList.toggle('active', isOpen);
      lnToggle.setAttribute('aria-expanded', String(isOpen));
    });
    lnMobile.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMobileNav);
    });
    document.addEventListener('click', (e) => {
      if (lnMobile.classList.contains('open') &&
          !lnMobile.contains(e.target as Node) &&
          !lnToggle.contains(e.target as Node)) {
        closeMobileNav();
      }
    });
  }
</script>
