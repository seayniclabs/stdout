---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';

const meta = {
  title: 'MSP Billing Portal - StdOut White-Label',
  description: 'White-label billing portal for MSPs. Manage client subscriptions, invoicing, and payment collection. Stripe integration for automated recurring billing.',
  canonical: 'https://stdout.app/msp/billing'
};
---

<Layout {meta}>
  <main class="msp-billing">
    <header class="billing-header">
      <h1>MSP Billing Portal</h1>
      <p class="lede">Manage client subscriptions, invoicing, and payment collection. Fully white-labeled under your brand.</p>
    </header>

    <section class="billing-stats">
      <div class="stat-card">
        <span class="stat-value">$12,847</span>
        <span class="stat-label">MRR (Monthly Recurring Revenue)</span>
      </div>
      <div class="stat-card">
        <span class="stat-value">23</span>
        <span class="stat-label">Active Subscriptions</span>
      </div>
      <div class="stat-card">
        <span class="stat-value">$847</span>
        <span class="stat-label">Pending Invoices</span>
      </div>
      <div class="stat-card">
        <span class="stat-value">98.2%</span>
        <span class="stat-label">Collection Rate</span>
      </div>
    </section>

    <section class="subscriptions-list">
      <h2>Active Subscriptions</h2>
      <table class="subscriptions-table">
        <thead>
          <tr>
            <th>Client</th>
            <th>Plan</th>
            <th>MRR</th>
            <th>Next Invoice</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Acme Corp</td>
            <td>Pro (50 monitors)</td>
            <td>$299/mo</td>
            <td>Jul 28, 2026</td>
            <td><span class="status-badge active">Active</span></td>
            <td><a href="/msp/clients/acme" class="btn-link">Manage</a></td>
          </tr>
          <tr>
            <td>TechStart LLC</td>
            <td>Starter (20 monitors)</td>
            <td>$99/mo</td>
            <td>Aug 3, 2026</td>
            <td><span class="status-badge active">Active</span></td>
            <td><a href="/msp/clients/techstart" class="btn-link">Manage</a></td>
          </tr>
          <tr>
            <td>HealthHub Medical</td>
            <td>Enterprise (200 monitors)</td>
            <td>$899/mo</td>
            <td>Jul 22, 2026</td>
            <td><span class="status-badge past-due">Past Due</span></td>
            <td><a href="/msp/clients/healthhub" class="btn-link">Manage</a></td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="billing-config">
      <h2>Billing Configuration</h2>
      <div class="config-grid">
        <div class="config-card">
          <h3>Stripe Integration</h3>
          <p>Connect your Stripe account to automate invoicing and payment collection.</p>
          <button class="btn-primary">Connect Stripe</button>
          <p class="config-note">Status: <strong class="text-warning">Not Connected</strong></p>
        </div>

        <div class="config-card">
          <h3>White-Label Settings</h3>
          <ul class="config-list">
            <li><strong>Company Name:</strong> Your MSP Name</li>
            <li><strong>Logo URL:</strong> https://yourmsp.com/logo.png</li>
            <li><strong>Invoice Footer:</strong> Custom footer text</li>
            <li><strong>Support Email:</strong> billing@yourmsp.com</li>
          </ul>
          <button class="btn-secondary">Edit Branding</button>
        </div>

        <div class="config-card">
          <h3>Pricing Plans</h3>
          <ul class="config-list">
            <li><strong>Starter:</strong> $99/mo (up to 20 monitors)</li>
            <li><strong>Pro:</strong> $299/mo (up to 100 monitors)</li>
            <li><strong>Enterprise:</strong> $899/mo (200+ monitors)</li>
          </ul>
          <button class="btn-secondary">Edit Plans</button>
        </div>

        <div class="config-card">
          <h3>Invoice Schedule</h3>
          <p>Invoices generated on the 1st of each month. Payment due within 15 days.</p>
          <button class="btn-secondary">Edit Schedule</button>
        </div>
      </div>
    </section>

    <section class="recent-invoices">
      <h2>Recent Invoices</h2>
      <table class="invoices-table">
        <thead>
          <tr>
            <th>Invoice #</th>
            <th>Client</th>
            <th>Amount</th>
            <th>Issued</th>
            <th>Due</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>INV-2026-07-001</td>
            <td>Acme Corp</td>
            <td>$299.00</td>
            <td>Jul 1, 2026</td>
            <td>Jul 16, 2026</td>
            <td><span class="status-badge paid">Paid</span></td>
          </tr>
          <tr>
            <td>INV-2026-07-002</td>
            <td>TechStart LLC</td>
            <td>$99.00</td>
            <td>Jul 1, 2026</td>
            <td>Jul 16, 2026</td>
            <td><span class="status-badge paid">Paid</span></td>
          </tr>
          <tr>
            <td>INV-2026-07-003</td>
            <td>HealthHub Medical</td>
            <td>$899.00</td>
            <td>Jul 1, 2026</td>
            <td>Jul 16, 2026</td>
            <td><span class="status-badge past-due">Past Due</span></td>
          </tr>
        </tbody>
      </table>
    </section>

    <footer class="billing-footer">
      <p>Powered by <a href="https://stripe.com" target="_blank">Stripe</a> | <a href="/docs/msp-billing">Billing Documentation</a></p>
    </footer>
  </main>
</Layout>

<style>
  .msp-billing {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px 80px;
    color: #F0F0F8;
  }

  .billing-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .billing-header h1 {
    font-size: 42px;
    font-weight: 700;
    margin: 0 0 16px;
  }

  .lede {
    font-size: 18px;
    color: #C0C0D8;
    max-width: 700px;
    margin: 0 auto;
  }

  .billing-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 60px;
  }

  .stat-card {
    background: #0E0E18;
    border: 1px solid #1F1F35;
    border-radius: 8px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stat-value {
    font-size: 32px;
    font-weight: 700;
    font-family: monospace;
    color: #22C55E;
  }

  .stat-label {
    font-size: 13px;
    color: #9090A8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .subscriptions-list,
  .billing-config,
  .recent-invoices {
    margin-bottom: 60px;
  }

  .subscriptions-list h2,
  .billing-config h2,
  .recent-invoices h2 {
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 24px;
    padding-bottom: 12px;
    border-bottom: 2px solid #1F1F35;
  }

  .subscriptions-table,
  .invoices-table {
    width: 100%;
    border-collapse: collapse;
    background: #0E0E18;
    border: 1px solid #1F1F35;
    border-radius: 8px;
    overflow: hidden;
  }

  .subscriptions-table thead,
  .invoices-table thead {
    background: #1F1F35;
  }

  .subscriptions-table th,
  .invoices-table th,
  .subscriptions-table td,
  .invoices-table td {
    padding: 14px 16px;
    text-align: left;
    border-bottom: 1px solid #1F1F35;
  }

  .subscriptions-table th,
  .invoices-table th {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #9090A8;
  }

  .subscriptions-table td,
  .invoices-table td {
    font-size: 14px;
    color: #C0C0D8;
  }

  .subscriptions-table tr:last-child td,
  .invoices-table tr:last-child td {
    border-bottom: none;
  }

  .status-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status-badge.active {
    background: #22C55E20;
    color: #22C55E;
  }

  .status-badge.paid {
    background: #60a5fa20;
    color: #60a5fa;
  }

  .status-badge.past-due {
    background: #EF444420;
    color: #EF4444;
  }

  .btn-link {
    color: #60a5fa;
    text-decoration: none;
    font-weight: 600;
  }

  .btn-link:hover {
    text-decoration: underline;
  }

  .config-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }

  .config-card {
    background: #0E0E18;
    border: 1px solid #1F1F35;
    border-radius: 8px;
    padding: 24px;
  }

  .config-card h3 {
    font-size: 18px;
    font-weight: 600;
    color: #FB923C;
    margin: 0 0 12px;
  }

  .config-card p {
    font-size: 14px;
    color: #C0C0D8;
    margin: 0 0 16px;
  }

  .config-list {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
  }

  .config-list li {
    font-size: 13px;
    color: #C0C0D8;
    padding: 6px 0;
    border-bottom: 1px solid #1F1F35;
  }

  .config-list li:last-child {
    border-bottom: none;
  }

  .config-note {
    font-size: 13px;
    color: #9090A8;
    margin: 12px 0 0;
  }

  .text-warning {
    color: #FB923C;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-block;
    padding: 10px 24px;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-primary {
    background: #C2410C;
    color: #fff;
  }

  .btn-primary:hover {
    background: #EA580C;
  }

  .btn-secondary {
    background: transparent;
    border: 2px solid #FB923C;
    color: #FB923C;
  }

  .btn-secondary:hover {
    background: #FB923C;
    color: #07070C;
  }

  .billing-footer {
    text-align: center;
    margin-top: 80px;
    padding-top: 40px;
    border-top: 2px solid #1F1F35;
    font-size: 14px;
    color: #9090A8;
  }

  .billing-footer a {
    color: #60a5fa;
    text-decoration: none;
  }

  .billing-footer a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .billing-header h1 {
      font-size: 32px;
    }

    .billing-stats {
      grid-template-columns: 1fr 1fr;
    }

    .config-grid {
      grid-template-columns: 1fr;
    }

    .subscriptions-table,
    .invoices-table {
      font-size: 12px;
    }

    .subscriptions-table th,
    .invoices-table th,
    .subscriptions-table td,
    .invoices-table td {
      padding: 10px 8px;
    }
  }
</style>
