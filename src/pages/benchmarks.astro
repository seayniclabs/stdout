---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import benchmarks from '../data/benchmarks.json';

const meta = {
  title: 'Industry Benchmarks - StdOut vs Traditional Monitoring',
  description: 'Real-world MTTR, uptime, and cost metrics across 5 industries. See how StdOut AI-powered monitoring compares to Datadog, Rootly, and manual ops.',
  canonical: 'https://stdout.app/benchmarks'
};
---

<Layout {meta}>
  <main class="benchmarks-page">
    <header class="benchmarks-hero">
      <h1>Industry Benchmarks</h1>
      <p class="lede">Real-world monitoring metrics across 5 industries. See how AI-powered incident management compares to traditional tools + manual processes.</p>
    </header>

    <section class="benchmark-cards">
      {benchmarks.map((benchmark) => (
        <article class="benchmark-card">
          <div class="benchmark-header">
            <h2>{benchmark.industry}</h2>
            <span class="company-size">{benchmark.companySize}</span>
          </div>

          <div class="infrastructure-info">
            <strong>Infrastructure:</strong> {benchmark.infrastructure}
          </div>

          <div class="metrics-grid">
            <div class="metric">
              <span class="metric-label">MTTR</span>
              <span class="metric-value">{benchmark.metrics.mttrMinutes} min</span>
              <span class="metric-improvement">→ {benchmark.stdoutImprovement.mttrMinutes} min with StdOut</span>
            </div>

            <div class="metric">
              <span class="metric-label">Uptime</span>
              <span class="metric-value">{benchmark.metrics.uptimePercent}%</span>
            </div>

            <div class="metric">
              <span class="metric-label">Auto-Remediation</span>
              <span class="metric-value">{benchmark.metrics.autoRemediationRate}%</span>
              <span class="metric-improvement">→ {benchmark.stdoutImprovement.autoRemediationRate}% with StdOut</span>
            </div>

            <div class="metric">
              <span class="metric-label">Cost/Incident</span>
              <span class="metric-value">${benchmark.metrics.costPerIncident}</span>
            </div>
          </div>

          <div class="tools-used">
            <h4>Current Tools</h4>
            <ul>
              {benchmark.tools.map((tool) => <li>{tool}</li>)}
            </ul>
          </div>

          <div class="pain-points">
            <h4>Pain Points</h4>
            <ul>
              {benchmark.painPoints.map((pain) => <li>{pain}</li>)}
            </ul>
          </div>

          <div class="stdout-impact">
            <h4>StdOut Impact</h4>
            <div class="impact-metrics">
              <div class="impact-item">
                <span class="impact-label">MTTR Reduction</span>
                <span class="impact-value">-{Math.round((1 - benchmark.stdoutImprovement.mttrMinutes / benchmark.metrics.mttrMinutes) * 100)}%</span>
              </div>
              <div class="impact-item">
                <span class="impact-label">Auto-Remediation Gain</span>
                <span class="impact-value">+{benchmark.stdoutImprovement.autoRemediationRate - benchmark.metrics.autoRemediationRate}pp</span>
              </div>
              <div class="impact-item">
                <span class="impact-label">Cost Savings</span>
                <span class="impact-value">{benchmark.stdoutImprovement.costSavings}%</span>
              </div>
            </div>
            {benchmark.note && <p class="impact-note">{benchmark.note}</p>}
          </div>
        </article>
      ))}
    </section>

    <footer class="benchmarks-footer">
      <h2>Run Your Own Benchmark</h2>
      <p>Deploy StdOut alongside your existing monitoring stack and measure the impact over 30 days. Track MTTR, auto-remediation rate, and time-to-diagnosis improvements.</p>

      <div class="cta-buttons">
        <a href="/download" class="btn-primary">Download StdOut</a>
        <a href="/docs/benchmarking" class="btn-secondary">Benchmarking Guide</a>
      </div>

      <p class="footnote">Benchmark data collected Q4 2024 across 78 SMB deployments. Methodology: <a href="/docs/benchmark-methodology">See full methodology</a></p>
    </footer>
  </main>
</Layout>

<style>
  .benchmarks-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px 80px;
    color: #F0F0F8;
  }

  .benchmarks-hero {
    text-align: center;
    margin-bottom: 60px;
  }

  .benchmarks-hero h1 {
    font-size: 42px;
    font-weight: 700;
    margin: 0 0 16px;
    color: #F0F0F8;
  }

  .lede {
    font-size: 18px;
    color: #C0C0D8;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .benchmark-cards {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .benchmark-card {
    background: #0E0E18;
    border: 1px solid #1F1F35;
    border-radius: 8px;
    padding: 32px;
  }

  .benchmark-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid #1F1F35;
  }

  .benchmark-header h2 {
    font-size: 24px;
    font-weight: 700;
    color: #F0F0F8;
    margin: 0;
  }

  .company-size {
    font-size: 13px;
    color: #9090A8;
    background: #1F1F35;
    padding: 4px 12px;
    border-radius: 4px;
    font-family: monospace;
  }

  .infrastructure-info {
    font-size: 14px;
    color: #C0C0D8;
    margin-bottom: 24px;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #5A5A72;
  }

  .metric-value {
    font-size: 24px;
    font-weight: 700;
    font-family: monospace;
    color: #FB923C;
  }

  .metric-improvement {
    font-size: 12px;
    color: #22C55E;
    font-family: monospace;
  }

  .tools-used,
  .pain-points,
  .stdout-impact {
    margin-top: 24px;
  }

  .tools-used h4,
  .pain-points h4,
  .stdout-impact h4 {
    font-size: 14px;
    font-weight: 600;
    color: #FB923C;
    margin: 0 0 12px;
  }

  .tools-used ul,
  .pain-points ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tools-used li {
    font-size: 13px;
    color: #9090A8;
    padding: 6px 0;
    border-bottom: 1px solid #1F1F35;
  }

  .tools-used li:last-child {
    border-bottom: none;
  }

  .pain-points li {
    font-size: 13px;
    color: #EF4444;
    padding: 8px 0;
    padding-left: 20px;
    position: relative;
  }

  .pain-points li::before {
    content: "⚠";
    position: absolute;
    left: 0;
    color: #EAB308;
  }

  .impact-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
    background: linear-gradient(135deg, #22C55E15, #22C55E08);
    border: 1px solid #22C55E40;
    border-radius: 6px;
    padding: 20px;
    margin-bottom: 12px;
  }

  .impact-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .impact-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #5A5A72;
  }

  .impact-value {
    font-size: 22px;
    font-weight: 700;
    font-family: monospace;
    color: #22C55E;
  }

  .impact-note {
    font-size: 12px;
    color: #9090A8;
    font-style: italic;
    margin: 0;
  }

  .benchmarks-footer {
    text-align: center;
    margin-top: 80px;
    padding: 40px 0;
    border-top: 2px solid #1F1F35;
  }

  .benchmarks-footer h2 {
    font-size: 32px;
    margin-bottom: 16px;
    color: #F0F0F8;
  }

  .benchmarks-footer > p {
    font-size: 16px;
    color: #C0C0D8;
    margin-bottom: 30px;
  }

  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-block;
    padding: 14px 32px;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background: #C2410C;
    color: #fff;
  }

  .btn-primary:hover {
    background: #EA580C;
  }

  .btn-secondary {
    background: transparent;
    border: 2px solid #FB923C;
    color: #FB923C;
  }

  .btn-secondary:hover {
    background: #FB923C;
    color: #07070C;
  }

  .footnote {
    font-size: 13px;
    color: #9090A8;
  }

  .footnote a {
    color: #60a5fa;
    text-decoration: none;
  }

  .footnote a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .benchmarks-page {
      padding: 20px 16px 60px;
    }

    .benchmarks-hero h1 {
      font-size: 32px;
    }

    .lede {
      font-size: 16px;
    }

    .metrics-grid {
      grid-template-columns: 1fr 1fr;
    }

    .impact-metrics {
      grid-template-columns: 1fr;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
