---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { nanoid } from 'nanoid';
import { getCentralDb, getTenantDb, centralSchema } from '../../lib/db';
import { createSession, SESSION_COOKIE, sessionCookieOptions, hashPassword, getUserCount } from '../../lib/auth';
import { eq } from 'drizzle-orm';
import { validateCsrf } from '../../middleware';
import { logAudit, getClientIp } from '../../lib/audit';
import { sendVerificationEmail } from '../../lib/email';

const MAX_USERS_BUILTIN = 10;

let error = '';
let email = '';
let displayName = '';

const rawRedirect = Astro.url.searchParams.get('redirect') || '';
const redirectTo = (rawRedirect.startsWith('/') && !rawRedirect.startsWith('//')) ? rawRedirect : '/app';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const csrfToken = form.get('_csrf') as string || '';

  if (!validateCsrf(csrfToken, Astro.cookies)) {
    error = 'Invalid form submission. Please try again.';
  } else {
    email = (form.get('email') as string || '').trim().toLowerCase();
    displayName = (form.get('displayName') as string || '').trim();
    const password = form.get('password') as string || '';
    const confirm = form.get('confirm') as string || '';
    const formRedirect = (form.get('redirect') as string || '').trim();
    const destination = (formRedirect.startsWith('/') && !formRedirect.startsWith('//')) ? formRedirect : '/app';

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (!email || !password || !displayName) {
      error = 'Email, display name, and password are required.';
    } else if (!emailRegex.test(email)) {
      error = 'Please enter a valid email address.';
    } else if (password.length < 8) {
      error = 'Password must be at least 8 characters.';
    } else if (password !== confirm) {
      error = "Passwords don't match.";
    } else if (getUserCount() >= MAX_USERS_BUILTIN) {
      error = 'Maximum user limit reached (10 users for builtin authentication). Contact your administrator or use OIDC.';
    } else {
      const existing = getCentralDb()
        .select()
        .from(centralSchema.users)
        .where(eq(centralSchema.users.email, email))
        .get();

      if (existing) {
        error = 'An account with that email already exists.';
      } else {
        const id = nanoid();
        const now = new Date();
        const passwordHash = await hashPassword(password);
        getCentralDb().insert(centralSchema.users).values({
          id,
          email,
          passwordHash,
          displayName,
          role: 'member',
          createdAt: now,
          updatedAt: now,
        }).run();

        getTenantDb(id);
        logAudit('register', { userId: id, ip: getClientIp(Astro.request) });
        sendVerificationEmail(email, id).catch(() => {});

        const sessionId = await createSession(id);
        Astro.cookies.set(SESSION_COOKIE, sessionId, sessionCookieOptions(30 * 24 * 60 * 60));
        return Astro.redirect(destination);
      }
    }
  }
}

if (Astro.locals.user) return Astro.redirect('/app');
---
<Layout title="Register — StdOut">
  <div class="auth-page">
    <h1>Create an account</h1>
    <p class="auth-subtitle">Start logging incidents and building your runbook.</p>

    {error && <div class="auth-error">{error}</div>}

    <form method="POST" class="auth-form">
      <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
      <input type="hidden" name="redirect" value={redirectTo} />
      <label>
        <span>Email</span>
        <input type="email" name="email" value={email} required autocomplete="email" />
      </label>
      <label>
        <span>Display name</span>
        <input type="text" name="displayName" value={displayName} required autocomplete="name" />
      </label>
      <label>
        <span>Password</span>
        <input type="password" name="password" required minlength="8" autocomplete="new-password" />
      </label>
      <label>
        <span>Confirm password</span>
        <input type="password" name="confirm" required minlength="8" autocomplete="new-password" />
      </label>
      <button type="submit">Create account</button>
    </form>

    <p class="auth-switch">Already have an account? <a href={`/app/login${redirectTo !== '/app' ? `?redirect=${encodeURIComponent(redirectTo)}` : ''}`}>Log in</a></p>
  </div>
</Layout>
