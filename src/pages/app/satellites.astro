---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
if (!Astro.locals.user) return Astro.redirect('/app/login');
---

<Layout title="Satellite Nodes">
  <div class="page-header">
    <div class="header-left">
      <h1>Satellite Nodes</h1>
      <p class="page-subtitle">Remote agents pushing telemetry from outside your network</p>
    </div>
    <button class="btn-primary" id="addNodeBtn">+ Add Node</button>
  </div>

  <div id="nodeGrid" class="node-grid">
    <div class="loading-state">Loading nodes…</div>
  </div>

  <!-- Add Node Modal -->
  <div id="addNodeModal" class="modal-overlay" style="display:none">
    <div class="modal">
      <div class="modal-header">
        <h2>Register Satellite Node</h2>
        <button class="modal-close" id="closeModal">&times;</button>
      </div>
      <div class="modal-body">
        <label for="nodeName">Node Name <span class="required">*</span></label>
        <input type="text" id="nodeName" placeholder="centaur-n8n-1" autocomplete="off" />

        <label for="nodeDesc">Description</label>
        <input type="text" id="nodeDesc" autocomplete="off" placeholder="Hetzner VPS — Talos bidding workflows" />

        <label for="nodeTags">Tags (comma-separated)</label>
        <input type="text" id="nodeTags" autocomplete="off" placeholder="hetzner, talos, production" />
      </div>
      <div class="modal-footer">
        <button class="btn-ghost" id="cancelModal">Cancel</button>
        <button class="btn-primary" id="registerBtn">Register Node</button>
      </div>
    </div>
  </div>

  <!-- Token Display Modal -->
  <div id="tokenModal" class="modal-overlay" style="display:none">
    <div class="modal">
      <div class="modal-header">
        <h2>Node Registered</h2>
      </div>
      <div class="modal-body">
        <p class="token-warning">Copy this token now — it will not be shown again.</p>
        <div class="token-block">
          <code id="tokenValue"></code>
          <button class="copy-btn" id="copyToken">Copy</button>
        </div>
        <p class="install-label">One-liner install (run on the remote server):</p>
        <div class="token-block install-cmd">
          <code id="installCmd"></code>
          <button class="copy-btn" id="copyInstall">Copy</button>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-primary" id="closeTokenModal">Done</button>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 2rem;
    gap: 1rem;
  }

  .node-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.25rem;
  }

  .loading-state {
    color: var(--text-muted);
    padding: 2rem 0;
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 2rem;
    border: 1px dashed var(--border);
    border-radius: 12px;
    color: var(--text-muted);
  }

  .empty-state h3 {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  /* Node Card */
  .node-card {
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: all 0.2s ease;
  }

  .node-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.4);
    transform: translateY(-2px);
  }

  .node-card.alert-warning { border-color: rgba(245, 188, 6, 0.4); }
  .node-card.alert-critical { border-color: rgba(240, 72, 72, 0.4); }
  .node-card.alert-stale { border-color: rgba(160, 160, 184, 0.3); }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .node-name {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text);
  }

  .node-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }

  .alert-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .badge-ok { background: var(--low-dim); color: var(--low); }
  .badge-warning { background: var(--high-dim); color: var(--high); }
  .badge-critical { background: var(--critical-dim); color: var(--critical); }
  .badge-stale { background: rgba(90, 90, 114, 0.2); color: var(--text-muted); }
  .badge-never { background: rgba(90, 90, 114, 0.15); color: var(--text-muted); }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 20px;
    color: var(--text-secondary);
  }

  .metrics-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .metric {
    background: var(--bg-elevated);
    border-radius: 8px;
    padding: 0.5rem 0.6rem;
    text-align: center;
  }

  .metric-label {
    font-size: 0.65rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metric-value {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    margin-top: 0.1rem;
  }

  .metric-value.warn { color: var(--high); }
  .metric-value.crit { color: var(--critical); }

  .failed-units {
    background: var(--critical-dim);
    border: 1px solid rgba(240, 72, 72, 0.2);
    border-radius: 8px;
    padding: 0.5rem 0.75rem;
    font-size: 0.8rem;
    color: var(--critical);
  }

  .failed-units strong { display: block; margin-bottom: 0.25rem; }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }

  .last-seen {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .card-actions {
    display: flex;
    gap: 0.5rem;
  }

  .btn-ghost-sm {
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s;
  }

  .btn-ghost-sm:hover { border-color: var(--border-hover); color: var(--text); }

  .btn-danger-sm {
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    background: transparent;
    border: 1px solid rgba(240, 72, 72, 0.3);
    border-radius: 6px;
    color: var(--critical);
    cursor: pointer;
    transition: all 0.15s;
  }

  .btn-danger-sm:hover { background: var(--critical-dim); }

  /* Modal */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(7, 7, 12, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    backdrop-filter: blur(4px);
  }

  .modal {
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 24px;
    width: 100%;
    max-width: 480px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .modal-header h2 { font-size: 1.1rem; }

  .modal-close {
    background: none;
    border: none;
    font-size: 1.4rem;
    color: var(--text-muted);
    cursor: pointer;
    line-height: 1;
    padding: 0.1rem 0.3rem;
  }

  .modal-close:hover { color: var(--text); }

  .modal-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .modal-body label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: -0.25rem;
  }

  .required { color: var(--critical); }

  .modal-body input {
    width: 100%;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.6rem 0.85rem;
    color: var(--text);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.15s;
  }

  .modal-body input:focus { border-color: var(--accent); }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .btn-ghost {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.55rem 1.1rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.15s;
  }

  .btn-ghost:hover { border-color: var(--border-hover); color: var(--text); }

  .token-warning {
    background: var(--high-dim);
    border: 1px solid rgba(245, 188, 6, 0.3);
    border-radius: 8px;
    padding: 0.6rem 0.85rem;
    font-size: 0.85rem;
    color: var(--high);
  }

  .token-block {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.6rem 0.85rem;
  }

  .token-block code {
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    color: var(--text-secondary);
    word-break: break-all;
    flex: 1;
  }

  .install-cmd code { font-size: 0.72rem; }

  .install-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .copy-btn {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.25rem 0.6rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.15s;
  }

  .copy-btn:hover { border-color: var(--accent); color: var(--accent); }
  .copy-btn.copied { color: var(--low); border-color: var(--low); }
</style>

<script>
  const COLLECTOR_URL = window.location.origin;

  // --- Utilities ---
  function relativeTime(unixTs) {
    if (!unixTs) return 'never';
    const diff = Math.floor(Date.now() / 1000) - unixTs;
    if (diff < 60) return `${diff}s ago`;
    if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
    if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
    return `${Math.floor(diff / 86400)}d ago`;
  }

  function diskPct(report) {
    const s = report?.system;
    if (!s || !s.disk_total_gb || s.disk_total_gb === 0) return null;
    return Math.round((s.disk_used_gb / s.disk_total_gb) * 100);
  }

  function badgeClass(state) {
    return { ok: 'badge-ok', warning: 'badge-warning', critical: 'badge-critical', stale: 'badge-stale' }[state] || 'badge-never';
  }

  function metricClass(val, warnAt, critAt) {
    if (val >= critAt) return 'crit';
    if (val >= warnAt) return 'warn';
    return '';
  }

  // --- Render ---
  function renderCard(node) {
    const r = node.lastReport;
    const sys = r?.system;
    const proc = r?.processes;
    const docker = r?.docker;

    const cpu = sys ? Math.round(sys.cpu_percent ?? 0) : null;
    const memPct = sys && sys.mem_total_mb ? Math.round((sys.mem_used_mb / sys.mem_total_mb) * 100) : null;
    const disk = diskPct(r);

    const failedUnits = proc?.failed_units ?? r?.failedUnits ?? [];
    const tags = node.tags || [];

    const metricsHTML = (cpu !== null || memPct !== null || disk !== null) ? `
      <div class="metrics-row">
        ${cpu !== null ? `<div class="metric"><div class="metric-label">CPU</div><div class="metric-value ${metricClass(cpu, 80, 90)}">${cpu}%</div></div>` : ''}
        ${memPct !== null ? `<div class="metric"><div class="metric-label">Memory</div><div class="metric-value ${metricClass(memPct, 85, 95)}">${memPct}%</div></div>` : ''}
        ${disk !== null ? `<div class="metric"><div class="metric-label">Disk</div><div class="metric-value ${metricClass(disk, 85, 90)}">${disk}%</div></div>` : ''}
      </div>` : '';

    const dockerHTML = docker?.present ? `
      <div class="metric-row" style="font-size:0.8rem;color:var(--text-secondary)">
        Docker: <strong style="color:var(--low)">${docker.running ?? 0} running</strong>${docker.stopped ? ` · <strong style="color:var(--high)">${docker.stopped} stopped</strong>` : ''}
      </div>` : '';

    const failedHTML = failedUnits.length ? `
      <div class="failed-units">
        <strong>Failed units</strong>
        ${failedUnits.join(', ')}
      </div>` : '';

    const tagsHTML = tags.length ? `<div class="tags">${tags.map(t => `<span class="tag">${t}</span>`).join('')}</div>` : '';

    return `
      <div class="node-card alert-${node.alertState}" data-id="${node.id}">
        <div class="card-header">
          <div>
            <div class="node-name">${node.name}</div>
            ${node.description ? `<div class="node-desc">${node.description}</div>` : ''}
          </div>
          <span class="alert-badge ${badgeClass(node.alertState)}">${node.alertState || 'never'}</span>
        </div>
        ${tagsHTML}
        ${metricsHTML}
        ${dockerHTML}
        ${failedHTML}
        <div class="card-footer">
          <span class="last-seen">Last seen: ${relativeTime(node.lastSeen)}</span>
          <div class="card-actions">
            <button class="btn-danger-sm" data-action="remove" data-id="${node.id}" data-name="${node.name}">Remove</button>
          </div>
        </div>
      </div>`;
  }

  async function loadNodes() {
    const grid = document.getElementById('nodeGrid');
    try {
      const res = await fetch('/app/api/satellite/nodes');
      const { nodes } = await res.json();
      if (!nodes.length) {
        grid.innerHTML = `<div class="empty-state"><h3>No satellite nodes yet</h3><p>Click "+ Add Node" to register a remote server.</p></div>`;
        return;
      }
      grid.innerHTML = nodes.map(renderCard).join('');
      attachCardListeners();
    } catch (e) {
      grid.innerHTML = `<div class="loading-state" style="color:var(--critical)">Failed to load nodes</div>`;
    }
  }

  function attachCardListeners() {
    document.querySelectorAll('[data-action="remove"]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const { id, name } = btn.dataset;
        if (!confirm(`Remove satellite node "${name}"? This cannot be undone.`)) return;
        await fetch('/app/api/satellite/nodes', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id }),
        });
        loadNodes();
      });
    });
  }

  // --- Add Node flow ---
  const addBtn = document.getElementById('addNodeBtn');
  const modal = document.getElementById('addNodeModal');
  const closeModal = document.getElementById('closeModal');
  const cancelModal = document.getElementById('cancelModal');
  const registerBtn = document.getElementById('registerBtn');
  const tokenModal = document.getElementById('tokenModal');
  const closeTokenModal = document.getElementById('closeTokenModal');

  addBtn.addEventListener('click', () => { modal.style.display = 'flex'; document.getElementById('nodeName').focus(); });
  closeModal.addEventListener('click', () => { modal.style.display = 'none'; });
  cancelModal.addEventListener('click', () => { modal.style.display = 'none'; });

  registerBtn.addEventListener('click', async () => {
    const name = document.getElementById('nodeName').value.trim();
    if (!name) { document.getElementById('nodeName').focus(); return; }

    const desc = document.getElementById('nodeDesc').value.trim();
    const tagsRaw = document.getElementById('nodeTags').value.trim();
    const tags = tagsRaw ? tagsRaw.split(',').map(t => t.trim()).filter(Boolean) : [];

    registerBtn.disabled = true;
    registerBtn.textContent = 'Registering…';

    try {
      const res = await fetch('/app/api/satellite/nodes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, description: desc, tags }),
      });
      const data = await res.json();
      if (!res.ok) { alert(data.error || 'Registration failed'); return; }

      modal.style.display = 'none';
      document.getElementById('nodeName').value = '';
      document.getElementById('nodeDesc').value = '';
      document.getElementById('nodeTags').value = '';

      document.getElementById('tokenValue').textContent = data.api_token;
      const installCmd = `curl -fsSL ${COLLECTOR_URL}/install/satellite.sh | STDOUT_URL=${COLLECTOR_URL} STDOUT_TOKEN=${data.api_token} STDOUT_NODE_ID=${data.node_id} bash`;
      document.getElementById('installCmd').textContent = installCmd;
      tokenModal.style.display = 'flex';

      loadNodes();
    } finally {
      registerBtn.disabled = false;
      registerBtn.textContent = 'Register Node';
    }
  });

  closeTokenModal.addEventListener('click', () => { tokenModal.style.display = 'none'; });

  function makeCopyBtn(btnId, sourceId) {
    document.getElementById(btnId).addEventListener('click', () => {
      const text = document.getElementById(sourceId).textContent;
      navigator.clipboard.writeText(text).then(() => {
        const btn = document.getElementById(btnId);
        btn.textContent = 'Copied!';
        btn.classList.add('copied');
        setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
      });
    });
  }

  makeCopyBtn('copyToken', 'tokenValue');
  makeCopyBtn('copyInstall', 'installCmd');

  // Load on mount
  loadNodes();
  // Refresh every 30s
  setInterval(loadNodes, 30_000);
</script>
