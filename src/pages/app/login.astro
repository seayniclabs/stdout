---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getCentralDb, getTenantDb, centralSchema } from '../../lib/db';
import { verifyPassword, createSession, SESSION_COOKIE } from '../../lib/auth';
import { isAccountLocked, recordFailedLogin, resetLoginAttempts, validateCsrf } from '../../middleware';
import { logAudit, getClientIp } from '../../lib/audit';
import { eq } from 'drizzle-orm';

const rawRedirect = Astro.url.searchParams.get('redirect') || '';
const redirectTo = (rawRedirect.startsWith('/') && !rawRedirect.startsWith('//')) ? rawRedirect : '/app';

if (Astro.locals.user) return Astro.redirect(redirectTo);

let error = '';
let emailVal = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const csrfToken = form.get('_csrf') as string || '';

  if (!validateCsrf(csrfToken, Astro.cookies)) {
    error = 'Invalid form submission. Please try again.';
  } else {
    const email = (form.get('email') as string || '').trim().toLowerCase();
    const password = form.get('password') as string || '';
    const formRedirect = (form.get('redirect') as string || '').trim();
    const destination = (formRedirect.startsWith('/') && !formRedirect.startsWith('//')) ? formRedirect : '/app';
    emailVal = email;

    if (!email || !password) {
      error = 'Email and password are required.';
    } else {
      const lockout = isAccountLocked(email);
      if (lockout.locked) {
        const mins = Math.ceil((lockout.retryAfterSec || 0) / 60);
        error = `Too many failed attempts. Try again in ${mins} minute${mins !== 1 ? 's' : ''}.`;
      } else {
        const user = getCentralDb().select().from(centralSchema.users).where(eq(centralSchema.users.email, email)).get();

        if (!user || !user.passwordHash || !(await verifyPassword(user.passwordHash, password))) {
          recordFailedLogin(email);
          error = 'Invalid email or password.';
        } else {
          resetLoginAttempts(email);
          getTenantDb(user.id);
          const sessionId = await createSession(user.id);
          logAudit('login', { userId: user.id, ip: getClientIp(Astro.request), details: { method: 'password' } });
          Astro.cookies.set(SESSION_COOKIE, sessionId, {
            path: '/',
            httpOnly: true,
            secure: true,
            sameSite: 'lax',
            maxAge: 30 * 24 * 60 * 60,
          });
          return Astro.redirect(destination);
        }
      }
    }
  }
}
---
<Layout title="Sign in — StdOut">
  <div class="auth-page">
    <h1>Welcome back</h1>
    <p class="auth-subtitle">Log in to your incident companion.</p>

    {error && <div class="auth-error">{error}</div>}

    <form method="POST" class="auth-form">
      <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
      <input type="hidden" name="redirect" value={redirectTo} />
      <label>
        <span>Email</span>
        <input type="email" name="email" value={emailVal} required autocomplete="email" />
      </label>
      <label>
        <span>Password</span>
        <input type="password" name="password" required autocomplete="current-password" />
      </label>
      <button type="submit">Sign in</button>
    </form>

    <p class="auth-switch"><a href="/app/forgot-password">Forgot your password?</a></p>
    <p class="auth-switch">Don't have an account? <a href="/app/register">Create one</a></p>
  </div>
</Layout>
