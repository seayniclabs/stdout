---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getDb, schema } from '../../lib/db';
import { createSession, SESSION_COOKIE, sessionCookieOptions, verifyPassword } from '../../lib/auth';
import { isAccountLocked, recordFailedLogin, resetLoginAttempts, validateCsrf } from '../../middleware';
import { logAudit, getClientIp } from '../../lib/audit';
import { eq } from 'drizzle-orm';

const rawRedirect = Astro.url.searchParams.get('redirect') || '';
const redirectTo = (rawRedirect.startsWith('/') && !rawRedirect.startsWith('//')) ? rawRedirect : '/app';

if (Astro.locals.user) return Astro.redirect(redirectTo);

let error = '';
let emailVal = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const csrfToken = form.get('_csrf') as string || '';

  if (!validateCsrf(csrfToken, Astro.cookies)) {
    error = 'Invalid form submission. Please try again.';
  } else {
    const email = (form.get('email') as string || '').trim().toLowerCase();
    const password = form.get('password') as string || '';
    const formRedirect = (form.get('redirect') as string || '').trim();
    const destination = (formRedirect.startsWith('/') && !formRedirect.startsWith('//')) ? formRedirect : '/app';
    emailVal = email;

    if (!email || !password) {
      error = 'Email and password are required.';
    } else {
      // SECURITY FIX (2026-08-16): Re-enabled account lockout check
      const lockout = isAccountLocked(email);
      if (lockout.locked) {
        const mins = Math.ceil((lockout.retryAfterSec || 0) / 60);
        error = `Too many failed attempts. Try again in ${mins} minute${mins !== 1 ? 's' : ''}.`;
      } else {
        const localUser = getDb()
          .select()
          .from(schema.users)
          .where(eq(schema.users.email, email))
          .get();

        if (!localUser) {
          recordFailedLogin(email);
          error = 'Invalid email or password.';
        } else if (localUser.passwordHash === 'store-auth') {
          error = 'This account was created via the hosted service. Please reset your password to continue.';
        } else {
          console.log('[login.astro] POST email:', email, 'localUser:', localUser ? localUser.id : 'NONE');
          console.log('[login.astro] password length:', password.length, 'hash:', localUser.passwordHash.substring(0, 30));
          const valid = await verifyPassword(localUser.passwordHash, password);
          console.log('[login.astro] password valid:', valid);
          if (!valid) {
            recordFailedLogin(email);
            error = 'Invalid email or password.';
          } else {
            resetLoginAttempts(email);
            const sessionId = await createSession(localUser.id);
            logAudit('login', { userId: localUser.id, ip: getClientIp(Astro.request), details: { method: 'local' } });

            // Set cookie manually in redirect response to ensure it's included
            const cookieOpts = sessionCookieOptions(30 * 24 * 60 * 60);
            const cookieValue = [
              `${SESSION_COOKIE}=${sessionId}`,
              `Path=${cookieOpts.path}`,
              `Max-Age=${cookieOpts.maxAge}`,
              cookieOpts.httpOnly ? 'HttpOnly' : '',
              cookieOpts.secure ? 'Secure' : '',
              cookieOpts.sameSite ? `SameSite=${cookieOpts.sameSite}` : ''
            ].filter(Boolean).join('; ');

            return new Response(null, {
              status: 302,
              headers: {
                'Location': destination,
                'Set-Cookie': cookieValue
              }
            });
          }
        }
      }
    }
  }
}
---
<Layout title="Sign in — StdOut">
  <div class="auth-page">
    <h1>Welcome back</h1>
    <p class="auth-subtitle">Log in to your incident companion.</p>

    {error && <div class="auth-error">{error}</div>}

    <form method="POST" action="/app/login" class="auth-form">
      <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
      <input type="hidden" name="redirect" value={redirectTo} />
      <label>
        <span>Email</span>
        <input type="email" name="email" value={emailVal} required autocomplete="email" />
      </label>
      <label>
        <span>Password</span>
        <input type="password" name="password" required autocomplete="current-password" />
      </label>
      <button type="submit">Sign in</button>
    </form>

    <p class="auth-switch"><a href="/app/forgot-password">Forgot your password?</a></p>
    <p class="auth-switch">Don't have an account? <a href="/app/register">Create one</a></p>
  </div>
</Layout>
