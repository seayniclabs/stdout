---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getCentralDb, centralSchema } from '../../lib/db';
import { verifyPassword, createSession, SESSION_COOKIE } from '../../lib/auth';
import { isOIDCEnabled } from '../../lib/oidc';
import { isAccountLocked, recordFailedLogin, resetLoginAttempts, validateCsrf } from '../../middleware';
import { logAudit, getClientIp } from '../../lib/audit';
import { eq } from 'drizzle-orm';

let error = '';
let email = '';

const rawRedirect = Astro.url.searchParams.get('redirect') || '';
const redirectTo = (rawRedirect.startsWith('/') && !rawRedirect.startsWith('//')) ? rawRedirect : '/app';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const csrfToken = form.get('_csrf') as string || '';

  if (!validateCsrf(csrfToken, Astro.cookies)) {
    error = 'Invalid form submission. Please try again.';
  } else {
    email = (form.get('email') as string || '').trim().toLowerCase();
    const password = form.get('password') as string || '';
    const formRedirect = (form.get('redirect') as string || '').trim();
    const destination = (formRedirect.startsWith('/') && !formRedirect.startsWith('//')) ? formRedirect : '/app';

    if (!email || !password) {
      error = 'Email and password are required.';
    } else {
      const lockout = isAccountLocked(email);
      if (lockout.locked) {
        const minutes = Math.ceil((lockout.retryAfterSec || 0) / 60);
        error = `Account temporarily locked. Try again in ${minutes} minute${minutes !== 1 ? 's' : ''}.`;
      } else {
        const user = getCentralDb().select().from(centralSchema.users).where(eq(centralSchema.users.email, email)).get();
        if (!user) {
          recordFailedLogin(email);
          error = 'Invalid email or password.';
        } else {
          const valid = await verifyPassword(user.passwordHash, password);
          if (!valid) {
            recordFailedLogin(email);
            logAudit('login_failed', { userId: user.id, ip: getClientIp(Astro.request) });
            error = 'Invalid email or password.';
          } else {
            resetLoginAttempts(email);
            const sessionId = await createSession(user.id);
            logAudit('login', { userId: user.id, ip: getClientIp(Astro.request) });
            Astro.cookies.set(SESSION_COOKIE, sessionId, {
              path: '/',
              httpOnly: true,
              secure: true,
              sameSite: 'lax',
              maxAge: 30 * 24 * 60 * 60,
              domain: undefined,
            });
            return Astro.redirect(destination);
          }
        }
      }
    }
  }
}

if (Astro.locals.user) return Astro.redirect('/app');

const oidcEnabled = isOIDCEnabled();
---
<Layout title="Log in — StdOut">
  <div class="auth-page">
    <h1>Welcome back</h1>
    <p class="auth-subtitle">Log in to your incident companion.</p>

    {error && <div class="auth-error">{error}</div>}

    {oidcEnabled && (
      <div class="oidc-section">
        <a href="/app/auth/oidc" class="btn-oidc">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          Sign in with Seaynic Labs
        </a>
        <div class="oidc-divider">
          <span>or use email</span>
        </div>
      </div>
    )}

    <form method="POST" class="auth-form">
      <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
      <input type="hidden" name="redirect" value={redirectTo} />
      <label>
        <span>Email</span>
        <input type="email" name="email" value={email} required autocomplete="email" />
      </label>
      <label>
        <span>Password</span>
        <input type="password" name="password" required autocomplete="current-password" />
      </label>
      <button type="submit">Log in</button>
    </form>

    <p class="auth-forgot"><a href="/app/forgot-password">Forgot your password?</a></p>
    <p class="auth-switch">Don't have an account? <a href={`/app/register${redirectTo !== '/app' ? `?redirect=${encodeURIComponent(redirectTo)}` : ''}`}>Register</a></p>
  </div>
</Layout>

<style>
  .oidc-section { margin-bottom: 8px; }
  .btn-oidc {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 12px 20px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
    cursor: pointer;
  }
  .btn-oidc:hover {
    border-color: var(--accent);
    background: var(--bg-hover);
    color: var(--text);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }
  .oidc-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 16px 0;
    color: var(--text-muted);
    font-size: 12px;
  }
  .oidc-divider::before, .oidc-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }
</style>
