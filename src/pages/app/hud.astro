  .modal-form label { display: flex; flex-direction: column; gap: 4px; }
  .modal-form label span { font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .modal-input { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text); font-size: 13px; padding: 8px 10px; font-family: var(--font-ui); transition: border-color 200ms, box-shadow 200ms; }
  .modal-input:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px var(--accent-dim); }
