---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getTenantDb, tenantSchema } from '../../lib/db';
import { eq, desc, gt, and } from 'drizzle-orm';
import { getRecentChecks, getUptimeStats, startMonitor } from '../../lib/hud';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

const db = getTenantDb(Astro.locals.workspace?.ownerId || user.id);
const allMonitors = db.select().from(tenantSchema.monitors)
  .where(eq(tenantSchema.monitors.userId, user.id))
  .orderBy(desc(tenantSchema.monitors.createdAt))
  .all();

// Ensure monitors are running
for (const m of allMonitors) {
  if (!m.paused && !m.maintenance) {
    startMonitor(user.id, m.id);
  }
}

// Build data for template
const monitorsData = allMonitors.map(m => {
  const sparkline = getRecentChecks(user.id, m.id, 30);
  const uptime = getUptimeStats(user.id, m.id, 30);
  return { ...m, sparkline, uptimePercent: uptime.uptimePercent, avgResponse: uptime.avgResponse };
});

const healthy = monitorsData.filter(m => m.currentStatus === 'healthy').length;
const degraded = monitorsData.filter(m => m.currentStatus === 'degraded').length;
const down = monitorsData.filter(m => m.currentStatus === 'down').length;

// Aggregate 30d uptime across all monitors
const totalUptime = monitorsData.length > 0
  ? monitorsData.reduce((sum, m) => sum + m.uptimePercent, 0) / monitorsData.length
  : 0;

// 7d incident count
const sevenDaysAgo = new Date();
sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);
const recentIncidents = db.select().from(tenantSchema.incidents)
  .where(and(
    eq(tenantSchema.incidents.userId, user.id),
    gt(tenantSchema.incidents.createdAt, sevenDaysAgo),
  ))
  .orderBy(desc(tenantSchema.incidents.createdAt))
  .all();
const incidentCount7d = recentIncidents.length;

// Gauge fill percentage helpers
function gaugePercent(value: number, max: number) {
  return Math.min(100, Math.max(0, (value / max) * 100));
}

const stacks = db.select().from(tenantSchema.stacks)
  .where(eq(tenantSchema.stacks.userId, user.id)).all();

// Scanner schedule data
const schedule = db.select().from(tenantSchema.scannerSchedule)
  .where(eq(tenantSchema.scannerSchedule.userId, user.id))
  .limit(1).all();
const scannerScheduleData = schedule.length > 0 ? schedule[0] : null;

// Last scan time from stack imports
const recentImports = db.select().from(tenantSchema.stackImports)
  .orderBy(desc(tenantSchema.stackImports.createdAt))
  .limit(1).all();
const lastScanTime = recentImports.length > 0 ? recentImports[0].createdAt : null;

// Calculate next scan time based on schedule
function getNextScanTime(sched: typeof scannerScheduleData, lastScan: Date | null): string | null {
  if (!sched || !sched.enabled) return null;
  const now = new Date();
  let next: Date;

  if (sched.interval === 'hourly') {
    next = new Date(now);
    next.setMinutes(sched.minute, 0, 0);
    if (next <= now) next.setHours(next.getHours() + 1);
  } else if (sched.interval === 'daily') {
    next = new Date(now);
    next.setHours(sched.hour, sched.minute, 0, 0);
    if (next <= now) next.setDate(next.getDate() + 1);
  } else if (sched.interval === 'weekly') {
    next = new Date(now);
    next.setHours(sched.hour, sched.minute, 0, 0);
    const daysUntil = (sched.weekday - now.getDay() + 7) % 7 || 7;
    if (next > now && now.getDay() === sched.weekday) {
      // Today is the day, and time hasn't passed
    } else {
      next.setDate(next.getDate() + daysUntil);
    }
  } else {
    return null;
  }
  return next.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
}

const nextScan = getNextScanTime(scannerScheduleData, lastScanTime);
const intervalLabels: Record<string, string> = { hourly: 'Every hour', daily: 'Daily', weekly: 'Weekly' };
const weekdayLabels = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

function timeAgo(date: Date) {
  const ms = Date.now() - date.getTime();
  const mins = Math.floor(ms / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  const days = Math.floor(hrs / 24);
  return `${days}d ago`;
}
---
<Layout title="HUD — StdOut">
  <div class="hud-page">
    <div class="hud-header">
      <div class="hud-header-left">
        <h1>HUD</h1>
        <p class="page-subtitle">Real-time health monitoring for your infrastructure. Track uptime, response times, and service status.</p>
      </div>
      <div class="hud-actions">
        <a href="/app/hud/map" class="btn btn-ghost btn-sm">Service Map</a>
        <button id="populateBtn" class="btn btn-ghost btn-sm">Populate from scanner</button>
        <button id="addMonitorBtn" class="btn btn-primary btn-sm">
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 2v10M2 7h10"/></svg>
          Add monitor
        </button>
      </div>
    </div>

    {/* Scanner Schedule Banner */}
    {(lastScanTime || scannerScheduleData) && (
      <div class="scanner-schedule-bar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <div class="scanner-schedule-info">
          {lastScanTime && (
            <span class="scanner-detail">
              <span class="scanner-label">Last scan:</span>
              <span class="scanner-value mono">{timeAgo(lastScanTime)}</span>
            </span>
          )}
          {scannerScheduleData && (
            <span class="scanner-detail">
              <span class="scanner-label">Frequency:</span>
              <span class="scanner-value mono">
                {intervalLabels[scannerScheduleData.interval] || scannerScheduleData.interval}
                {scannerScheduleData.interval === 'weekly' && ` (${weekdayLabels[scannerScheduleData.weekday]})`}
                {scannerScheduleData.interval !== 'hourly' && ` at ${String(scannerScheduleData.hour).padStart(2, '0')}:${String(scannerScheduleData.minute).padStart(2, '0')}`}
                {scannerScheduleData.interval === 'hourly' && ` at :${String(scannerScheduleData.minute).padStart(2, '0')}`}
              </span>
            </span>
          )}
          {nextScan && (
            <span class="scanner-detail">
              <span class="scanner-label">Next scan:</span>
              <span class="scanner-value mono">{nextScan}</span>
            </span>
          )}
          {scannerScheduleData && !scannerScheduleData.enabled && (
            <span class="scanner-detail scanner-paused">
              <span class="scanner-value">Scanner paused</span>
            </span>
          )}
        </div>
        <a href="/app/settings" class="scanner-settings-link">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          Settings
        </a>
      </div>
    )}

    {allMonitors.length === 0 ? (
      <div class="empty-state">
        <div class="empty-icon">HUD</div>
        <h3>No monitors yet</h3>
        <p>The HUD tracks your services in real-time with uptime percentages, response time sparklines, and instant alerts when something goes down. Add an HTTP or TCP monitor to get started.</p>
        <div class="empty-actions">
          <button id="addMonitorBtnEmpty" class="btn btn-primary">Add your first monitor</button>
          <a href="/app/stacks" class="btn btn-ghost">Import from stacks</a>
        </div>
        <p class="empty-hint">Monitors check your endpoints on a schedule and show status on the dashboard. You can also auto-populate from scanner results.</p>
      </div>
    ) : (
      <Fragment>
        <div class="hud-dashboard">
          <!-- Left: Gauge dials -->
          <div class="gauges">
            <div class="gauge-card">
              <div class="gauge-ring">
                <svg viewBox="0 0 120 70" class="gauge-svg">
                  <path d="M 15 60 A 45 45 0 1 1 105 60" fill="none" stroke="var(--border)" stroke-width="8" stroke-linecap="round" />
                  <path d="M 15 60 A 45 45 0 1 1 105 60" fill="none" stroke="var(--low)" stroke-width="8" stroke-linecap="round"
                    stroke-dasharray={`${gaugePercent(healthy, allMonitors.length) * 2.2} 999`} />
                </svg>
                <span class="gauge-value" style="color: var(--low);">{healthy}</span>
              </div>
              <div class="gauge-label">Services Up</div>
            </div>

            <div class="gauge-card">
              <div class="gauge-ring">
                <svg viewBox="0 0 120 70" class="gauge-svg">
                  <path d="M 15 60 A 45 45 0 1 1 105 60" fill="none" stroke="var(--border)" stroke-width="8" stroke-linecap="round" />
                  <path d="M 15 60 A 45 45 0 1 1 105 60" fill="none" stroke="#F97316" stroke-width="8" stroke-linecap="round"
                    stroke-dasharray={`${gaugePercent(degraded, Math.max(allMonitors.length, 1)) * 2.2} 999`} />
                </svg>
                <span class="gauge-value" style="color: #F97316;">{degraded}</span>
              </div>
              <div class="gauge-label">Warnings</div>
            </div>

            <div class="gauge-card">
              <div class="gauge-ring">
                <svg viewBox="0 0 120 70" class="gauge-svg">
                  <path d="M 15 60 A 45 45 0 1 1 105 60" fill="none" stroke="var(--border)" stroke-width="8" stroke-linecap="round" />
                  <path d="M 15 60 A 45 45 0 1 1 105 60" fill="none" stroke="#60A5FA" stroke-width="8" stroke-linecap="round"
                    stroke-dasharray={`${totalUptime * 2.2 / 100 * 100} 999`} />
                </svg>
                <span class="gauge-value" style="color: #60A5FA;">{totalUptime > 0 ? `${totalUptime.toFixed(1)}%` : '—'}</span>
              </div>
              <div class="gauge-label">30d Uptime</div>
            </div>

            <div class="gauge-card">
              <div class="gauge-ring">
                <svg viewBox="0 0 120 70" class="gauge-svg">
                  <path d="M 15 60 A 45 45 0 1 1 105 60" fill="none" stroke="var(--border)" stroke-width="8" stroke-linecap="round" />
                  <path d="M 15 60 A 45 45 0 1 1 105 60" fill="none" stroke="var(--critical)" stroke-width="8" stroke-linecap="round"
                    stroke-dasharray={`${gaugePercent(incidentCount7d, Math.max(incidentCount7d + 5, 10)) * 2.2} 999`} />
                </svg>
                <span class="gauge-value" style={`color: ${incidentCount7d > 0 ? 'var(--critical)' : 'var(--low)'};`}>{incidentCount7d}</span>
              </div>
              <div class="gauge-label">Incidents (7d)</div>
            </div>
          </div>

          <!-- Right: Service list + Incidents -->
          <div class="right-panel">
            <div class="service-list">
              {monitorsData.map(m => {
                const statusClass = m.maintenance ? 'maintenance' : m.currentStatus;
                const uptimeText = m.uptimePercent > 0 ? `${m.uptimePercent.toFixed(1)}%` : '—';
                const respText = m.lastResponseMs ? `${m.lastResponseMs}ms` : '—';

                // Build SVG sparkline path from check history
                const points = m.sparkline.map((c: any, i: number) => {
                  const x = (i / Math.max(m.sparkline.length - 1, 1)) * 200;
                  const ms = c.ms || 0;
                  const maxMs = Math.max(...m.sparkline.map((s: any) => s.ms || 0), 1);
                  const y = 26 - Math.min(24, (ms / maxMs) * 24);
                  return `${x},${y}`;
                });
                const linePath = points.length > 1 ? `M${points.join(' L')}` : '';
                const areaPath = points.length > 1 ? `M${points.join(' L')} L200,28 L0,28 Z` : '';
                const sparkColor = m.currentStatus === 'degraded' ? 'yellow' : m.currentStatus === 'down' ? 'red' : 'green';

                return (
                  <a href={`/app/hud/${m.id}`} class="service-row">
                    <span class={`svc-dot ${statusClass}`}></span>
                    <span class="svc-name">{m.name}</span>
                    <div class="svc-sparkline">
                      {linePath && (
                        <svg viewBox="0 0 200 28" preserveAspectRatio="none">
                          <path class={`spark-area ${sparkColor}`} d={areaPath} />
                          <path class={`spark-line ${sparkColor}`} d={linePath} />
                        </svg>
                      )}
                    </div>
                    <span class={`svc-uptime mono ${m.uptimePercent >= 99.9 ? 'uptime-great' : m.uptimePercent >= 99 ? 'uptime-ok' : 'uptime-bad'}`}>{uptimeText}</span>
                    <span class="svc-latency mono">{respText}</span>
                  </a>
                );
              })}
            </div>

            <!-- Recent incidents -->
            {recentIncidents.length > 0 && (
              <div class="incidents-panel">
                <div class="incidents-title">Recent Incidents</div>
                {recentIncidents.slice(0, 5).map(inc => {
                  const isResolved = inc.status === 'resolved';
                  const ago = Math.round((Date.now() - inc.createdAt.getTime()) / 3600000);
                  const agoText = ago < 1 ? 'just now' : ago < 24 ? `${ago}h ago` : `${Math.round(ago / 24)}d ago`;
                  return (
                    <div class="incident-item">
                      <span class={`inc-dot ${isResolved ? 'resolved' : 'active'}`}></span>
                      <span class="inc-text">{inc.title}</span>
                      <span class="inc-time mono">{agoText}</span>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        </div>
      </Fragment>
    )}

    <!-- Add Monitor Modal -->
    <div id="addMonitorModal" class="modal" style="display:none;">
      <div class="modal-backdrop" id="modalBackdrop"></div>
      <div class="modal-content">
        <h2>Add Monitor</h2>
        <div class="modal-form">
          <label>
            <span>Name</span>
            <input type="text" id="monName" placeholder="e.g. n8n, Plex, Homepage" class="modal-input" />
          </label>
          <div class="modal-row">
            <label style="flex:0 0 120px;">
              <span>Type</span>
              <select id="monType" class="modal-input">
                <option value="http">HTTP(S)</option>
                <option value="tcp">TCP</option>
              </select>
            </label>
            <label style="flex:1;">
              <span>Target</span>
              <input type="text" id="monTarget" placeholder="https://example.com or host:port" class="modal-input" />
            </label>
          </div>
          <div class="modal-row">
            <label>
              <span>Interval (sec)</span>
              <input type="number" id="monInterval" value="60" min="30" max="3600" class="modal-input" style="width:80px;" />
            </label>
            <label>
              <span>Timeout (ms)</span>
              <input type="number" id="monTimeout" value="5000" min="1000" max="30000" class="modal-input" style="width:100px;" />
            </label>
            <label id="monExpectedLabel">
              <span>Expected status</span>
              <input type="number" id="monExpected" value="200" class="modal-input" style="width:80px;" />
            </label>
            <label>
              <span>Retries</span>
              <input type="number" id="monRetries" value="3" min="1" max="10" class="modal-input" style="width:60px;" />
            </label>
          </div>
          {stacks.length > 0 && (
            <label>
              <span>Link to stack</span>
              <select id="monStack" class="modal-input">
                <option value="">None</option>
                {stacks.map(s => <option value={s.id}>{s.name}</option>)}
              </select>
            </label>
          )}
          <div class="modal-actions">
            <button id="saveMonitorBtn" class="btn btn-primary">Create monitor</button>
            <button id="cancelMonitorBtn" class="btn btn-ghost">Cancel</button>
          </div>
          <div id="monitorStatus" class="backup-status"></div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const modal = document.getElementById('addMonitorModal')!;
  const addBtns = document.querySelectorAll('#addMonitorBtn, #addMonitorBtnEmpty');
  const cancelBtn = document.getElementById('cancelMonitorBtn')!;
  const backdrop = document.getElementById('modalBackdrop')!;
  const saveBtn = document.getElementById('saveMonitorBtn')!;
  const statusEl = document.getElementById('monitorStatus')!;
  const typeSelect = document.getElementById('monType') as HTMLSelectElement;
  const expectedLabel = document.getElementById('monExpectedLabel')!;

  addBtns.forEach(btn => btn?.addEventListener('click', () => { modal.style.display = 'flex'; }));
  cancelBtn?.addEventListener('click', () => { modal.style.display = 'none'; });
  backdrop?.addEventListener('click', () => { modal.style.display = 'none'; });

  typeSelect?.addEventListener('change', () => {
    expectedLabel.style.display = typeSelect.value === 'http' ? '' : 'none';
  });

  saveBtn?.addEventListener('click', async () => {
    const name = (document.getElementById('monName') as HTMLInputElement).value.trim();
    const type = typeSelect.value;
    const target = (document.getElementById('monTarget') as HTMLInputElement).value.trim();
    const interval = (document.getElementById('monInterval') as HTMLInputElement).value;
    const timeout = (document.getElementById('monTimeout') as HTMLInputElement).value;
    const expectedStatus = (document.getElementById('monExpected') as HTMLInputElement).value;
    const retries = (document.getElementById('monRetries') as HTMLInputElement).value;
    const stackId = (document.getElementById('monStack') as HTMLSelectElement)?.value || '';

    if (!name || !target) {
      statusEl.textContent = 'Name and target are required.';
      statusEl.className = 'backup-status error';
      return;
    }

    saveBtn.setAttribute('disabled', '');
    statusEl.textContent = 'Creating...';
    statusEl.className = 'backup-status';

    try {
      const res = await fetch('/app/api/monitors', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'create', name, type, target, interval, timeout, expectedStatus, retries, stackId }),
      });
      const data = await res.json();
      if (data.id) {
        window.location.reload();
      } else {
        statusEl.textContent = data.error || 'Failed.';
        statusEl.className = 'backup-status error';
        saveBtn.removeAttribute('disabled');
      }
    } catch {
      statusEl.textContent = 'Network error.';
      statusEl.className = 'backup-status error';
      saveBtn.removeAttribute('disabled');
    }
  });

  // Populate from scanner
  document.getElementById('populateBtn')?.addEventListener('click', async () => {
    const btn = document.getElementById('populateBtn')!;
    btn.setAttribute('disabled', '');
    btn.textContent = 'Scanning...';

    try {
      const res = await fetch('/app/api/monitors/suggest');
      const data = await res.json();

      if (!data.suggestions || data.suggestions.length === 0) {
        btn.textContent = 'No new services found';
        setTimeout(() => { btn.textContent = 'Populate from scanner'; btn.removeAttribute('disabled'); }, 3000);
        return;
      }

      // Show confirmation
      const names = data.suggestions.map((s: any) => s.name).join(', ');
      if (!confirm(`Create ${data.suggestions.length} monitors?\n\n${names}`)) {
        btn.textContent = 'Populate from scanner';
        btn.removeAttribute('disabled');
        return;
      }

      const createRes = await fetch('/app/api/monitors/suggest', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ monitors: data.suggestions }),
      });
      const createData = await createRes.json();

      if (createData.created) {
        window.location.reload();
      } else {
        btn.textContent = createData.error || 'Failed';
        btn.removeAttribute('disabled');
      }
    } catch {
      btn.textContent = 'Error';
      setTimeout(() => { btn.textContent = 'Populate from scanner'; btn.removeAttribute('disabled'); }, 3000);
    }
  });

  // Auto-refresh every 30 seconds
  setTimeout(() => window.location.reload(), 30000);
</script>

<style>
  .hud-page { max-width: 1100px; margin: 0 auto; }
  .hud-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; gap: 16px; }
  .hud-header-left { flex: 1; }
  .hud-header h1 { font-size: 20px; font-weight: 700; letter-spacing: 0.08em; font-family: var(--font-mono); }
  .page-subtitle { font-size: 13px; color: var(--text-muted); margin-top: 4px; }
  .hud-actions { display: flex; gap: 8px; flex-shrink: 0; }

  /* Scanner schedule bar */
  .scanner-schedule-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 16px;
    box-shadow: var(--shadow-sm);
    color: var(--text-secondary);
  }
  .scanner-schedule-bar > svg { flex-shrink: 0; color: var(--accent-light); opacity: 0.7; }
  .scanner-schedule-info {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    flex: 1;
  }
  .scanner-detail {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
  }
  .scanner-label { color: var(--text-muted); font-size: 11px; }
  .scanner-value { color: var(--text-secondary); font-size: 12px; }
  .scanner-paused .scanner-value { color: var(--high); }
  .scanner-settings-link {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 150ms;
    flex-shrink: 0;
  }
  .scanner-settings-link:hover { color: var(--accent-light); }

  /* Dashboard layout: gauges left, services right */
  .hud-dashboard { display: flex; gap: 24px; height: calc(100vh - 120px); }

  /* Gauge dials — 2x2 grid, sticky */
  .gauges { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; flex-shrink: 0; width: 280px; align-content: start; position: sticky; top: 0; }
  .gauge-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px 12px 12px; text-align: center; }
  .gauge-ring { position: relative; width: 100%; display: flex; flex-direction: column; align-items: center; }
  .gauge-svg { width: 100px; height: 58px; }
  .gauge-value { font-family: var(--font-heading, var(--font-ui)); font-size: 22px; font-weight: 700; margin-top: -4px; }
  .gauge-label { font-family: var(--font-mono); font-size: 10px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-top: 6px; }

  /* Right panel — scrollable */
  .right-panel { flex: 1; display: flex; flex-direction: column; gap: 12px; min-width: 0; overflow-y: auto; padding-right: 4px; }

  /* Service rows */
  .service-list { display: flex; flex-direction: column; gap: 4px; }
  .service-row { display: flex; align-items: center; gap: 10px; padding: 8px 14px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-sm, 6px); text-decoration: none; color: inherit; transition: background 150ms, transform 150ms; cursor: pointer; }
