    (aiSaveBtn as HTMLElement).textContent = 'Saving...';
    const res = await window.stdoutFetch('/app/api/settings/ai-providers', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'save', provider, apiKey, diagnosticsModel: diagModel, autofixModel: autofixModelVal || null }),
    });
    if (res?.ok) {
      window.showToast?.('API key saved', 'success');
      if (aiForm) aiForm.style.display = 'none';
      if (aiAddBtn) aiAddBtn.style.display = '';
      (document.getElementById('aiKeyInput') as HTMLInputElement).value = '';
      loadAIProviders();
    } else {
      const data = await res?.json().catch(() => ({}));
      window.showToast?.(data?.error || 'Save failed', 'error');
    }
    (aiSaveBtn as HTMLElement).textContent = 'Save Key';
  });

  loadAIProviders();

  // ── Data Sources ──
  const dsList = document.getElementById('dsList')!;
