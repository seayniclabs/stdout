  // ── Feedback (Feature Requests) ──
  async function loadFeatureRequests() {
    const list = document.getElementById('featureRequestList');
    if (!list) return;
    const res = await window.stdoutFetch('/app/api/feature-requests');
    if (!res?.ok) { list.innerHTML = '<div class="empty-hint">Failed to load</div>'; return; }
    const { requests } = await res.json();
    if (!requests || requests.length === 0) {
      list.innerHTML = '<div class="empty-hint">No feedback submitted yet.</div>';
      return;
    }
    const statusColors: Record<string, string> = {
      submitted: '#94a3b8', reviewing: '#60A5FA', planned: '#A855F7',
      in_progress: '#F97316', shipped: '#4ade80', declined: '#EF4444',
    };
    list.innerHTML = requests.map((r: any) => {
      const color = statusColors[r.status] || '#94a3b8';
      const date = new Date(r.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      return `<div style="display:flex;justify-content:space-between;align-items:flex-start;padding:10px 12px;border:1px solid rgba(255,255,255,0.08);border-radius:8px;margin-bottom:6px;gap:8px;">
        <div style="flex:1;">
          <div style="font-weight:600;font-size:13px;">${r.title}</div>
          <div style="font-size:11px;color:#94a3b8;margin-top:2px;">${r.description.slice(0, 100)}${r.description.length > 100 ? '...' : ''}</div>
          ${r.responseToUser ? `<div style="font-size:11px;color:#60A5FA;margin-top:4px;padding:4px 8px;background:rgba(96,165,250,0.08);border-radius:4px;">Response: ${r.responseToUser}</div>` : ''}
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0;">
          <span style="font-size:10px;padding:2px 6px;border-radius:3px;background:${color}22;color:${color};font-weight:600;text-transform:uppercase;">${r.status.replace('_', ' ')}</span>
          <span style="font-size:10px;color:#64748b;">${date}</span>
        </div>
      </div>`;
    }).join('');
  }

