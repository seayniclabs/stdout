  const dsAddBtn = document.getElementById('dsAddBtn')!;
  const dsFormCancel = document.getElementById('dsFormCancel')!;
  const dsName = document.getElementById('dsName') as HTMLInputElement;
  const dsType = document.getElementById('dsType') as HTMLSelectElement;
  const dsUrl = document.getElementById('dsUrl') as HTMLInputElement;
  const dsToken = document.getElementById('dsToken') as HTMLInputElement;
  const dsOrg = document.getElementById('dsOrg') as HTMLInputElement;
  const dsBucket = document.getElementById('dsBucket') as HTMLInputElement;
  const dsInfluxFields = document.getElementById('dsInfluxFields')!;
