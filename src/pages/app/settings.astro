---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');
---
<Layout title="Settings — StdOut">
  <div class="settings-page">
    <h1>Account Settings</h1>

    <!-- Profile -->
    <section class="section">
      <h2>Profile</h2>
      <div class="profile-info">
        <div class="profile-row">
          <span class="label">Email</span>
          <span class="value mono">{user.email}</span>
        </div>
        <div class="profile-row">
          <span class="label">Display name</span>
          <span class="value">{user.displayName || '—'}</span>
        </div>
        <div class="profile-row">
          <span class="label">Plan</span>
          <span class="value">{user.subscriptionStatus === 'active' ? 'Solo' : 'Free'}</span>
        </div>
      </div>
    </section>

    <!-- Branding (Solo+) -->
    <section class="section">
      <h2>Workspace Branding</h2>
      <p class="section-desc">Customize how StdOut looks for your workspace. Solo tier and above.</p>
      <div class="brand-form">
        <label>
          <span>Workspace name</span>
          <input type="text" id="brandName" placeholder="e.g. My Lab" class="settings-input" />
        </label>
        <label>
          <span>Accent color</span>
          <div class="color-row">
            <input type="color" id="brandColor" value="#F97316" class="color-picker" />
            <input type="text" id="brandColorHex" value="#F97316" class="settings-input mono" style="width: 100px;" />
          </div>
        </label>
        <button id="saveBrandingBtn" class="btn btn-primary btn-sm">Save branding</button>
        <div id="brandingStatus" class="backup-status"></div>
      </div>
    </section>

    <!-- Notifications -->
    <section class="section">
      <h2>Notifications</h2>
      <p class="section-desc">Get notified when incidents are created or diagnoses complete.</p>

      <div id="notifList" class="backup-list">
        <div class="loading mono">Loading...</div>
      </div>

      <div class="notif-add">
        <select id="notifChannel" class="settings-input" style="width: 120px;">
          <option value="email">Email</option>
          <option value="webhook">Webhook</option>
        </select>
        <input type="text" id="notifDest" placeholder="email@example.com or https://..." class="settings-input" style="flex:1;" />
        <button id="addNotifBtn" class="btn btn-primary btn-sm">Add</button>
      </div>
      <div class="notif-events mono" style="font-size: 11px; color: var(--text-muted); margin-top: 6px;">
        Events: incident_created, diagnosis_complete, severity_critical, backup_complete
      </div>
      <div id="notifStatus" class="backup-status"></div>
    </section>

    <!-- Scanner Schedule -->
    <section class="section">
      <h2>Scanner Schedule</h2>
      <p class="section-desc">Control how often the scanner runs and what it discovers. The scanner polls this configuration automatically.</p>

      <div class="scanner-form">
        <div class="scanner-row">
          <label>
            <span>Frequency</span>
            <select id="scanInterval" class="settings-input">
              <option value="hourly">Hourly</option>
              <option value="daily" selected>Daily</option>
              <option value="weekly">Weekly</option>
            </select>
          </label>

          <label id="scanWeekdayLabel" style="display:none;">
            <span>Day</span>
            <select id="scanWeekday" class="settings-input">
              <option value="0">Sunday</option>
              <option value="1">Monday</option>
              <option value="2">Tuesday</option>
              <option value="3">Wednesday</option>
              <option value="4">Thursday</option>
              <option value="5">Friday</option>
              <option value="6">Saturday</option>
            </select>
          </label>

          <label id="scanTimeLabel">
            <span>Time</span>
            <div class="time-row">
              <input type="number" id="scanHour" min="0" max="23" value="3" class="settings-input time-input" />
              <span class="time-sep">:</span>
              <input type="number" id="scanMinute" min="0" max="59" value="0" class="settings-input time-input" />
            </div>
          </label>
        </div>

        <div class="scanner-modules">
          <span class="module-label">Modules</span>
          <label class="module-check"><input type="checkbox" id="modDocker" checked disabled /> Docker containers</label>
          <label class="module-check"><input type="checkbox" id="modMetrics" checked /> Resource metrics</label>
          <label class="module-check"><input type="checkbox" id="modNetwork" /> Network devices</label>
          <label class="module-check"><input type="checkbox" id="modDns" /> DNS &amp; services</label>
          <label class="module-check"><input type="checkbox" id="modAuth" /> Auth detection</label>
        </div>

        <label>
          <span>Subnets <span style="font-weight:400;color:var(--text-muted)">(leave empty for auto-detect)</span></span>
          <input type="text" id="scanSubnets" placeholder="e.g. 192.168.0.0/24, 10.0.0.0/24" class="settings-input" />
        </label>

        <div class="scanner-actions">
          <label class="scanner-toggle">
            <input type="checkbox" id="scanEnabled" checked />
            <span>Scanning enabled</span>
          </label>
          <button id="saveScannerBtn" class="btn btn-primary btn-sm">Save schedule</button>
        </div>
        <div id="scannerStatus" class="backup-status"></div>
      </div>
    </section>

    <!-- Public Status Page -->
    <section class="section">
      <h2>Public Status Page</h2>
      <p class="section-desc">Share a public URL showing your service health. No login required for visitors.</p>

      <div class="status-page-form">
        <div class="sp-row">
          <label style="flex:1;">
            <span>URL slug</span>
            <div class="slug-preview">
              <span class="slug-base mono">/status/</span>
              <input type="text" id="spSlug" placeholder="my-lab" class="settings-input mono" style="flex:1;" />
            </div>
          </label>
          <label>
            <span>Page title</span>
            <input type="text" id="spTitle" placeholder="Service Status" class="settings-input" />
          </label>
        </div>

        <label>
          <span>Description <span style="font-weight:400;color:var(--text-muted)">(optional)</span></span>
          <input type="text" id="spDesc" placeholder="Current status of my homelab services" class="settings-input" />
        </label>

        <div class="sp-monitors">
          <span class="module-label">Monitors to display</span>
          <div id="spMonitorList" class="sp-monitor-checks">
            <div class="loading mono">Loading monitors...</div>
          </div>
        </div>

        <div class="sp-options">
          <label class="module-check"><input type="checkbox" id="spShowResp" checked /> Show response times</label>
          <label class="module-check"><input type="checkbox" id="spShowUptime" checked /> Show uptime percentage</label>
          <label class="scanner-toggle"><input type="checkbox" id="spEnabled" checked /> <span>Page enabled</span></label>
        </div>

        <div class="scanner-actions">
          <button id="saveStatusPageBtn" class="btn btn-primary btn-sm">Save status page</button>
          <a id="statusPageLink" href="#" target="_blank" class="btn btn-ghost btn-sm" style="display:none;">View page</a>
        </div>
        <div id="statusPageStatus" class="backup-status"></div>
      </div>
    </section>

    <!-- Backups -->
    <section class="section">
      <h2>Backups</h2>
      <p class="section-desc">Encrypted snapshots of your data. Up to 3 kept automatically.</p>

      <div id="backupList" class="backup-list">
        <div class="loading mono">Loading backups...</div>
      </div>

      <div class="backup-actions">
        <button id="createBackupBtn" class="btn btn-primary">Create backup now</button>
        <div id="backupStatus" class="backup-status"></div>
      </div>
    </section>

    <!-- API Tokens -->
    <section class="section">
      <h2>API Tokens</h2>
      <p class="section-desc">Tokens for the stack discovery scanner. The raw token is shown once at creation.</p>

      <div id="tokenList" class="backup-list">
        <div class="loading mono">Loading tokens...</div>
      </div>

      <div class="token-create">
        <input type="text" id="tokenNameInput" placeholder="Token name (e.g. Scanner)" class="token-input" />
        <button id="createTokenBtn" class="btn btn-primary btn-sm">Generate token</button>
      </div>
      <div id="tokenStatus" class="backup-status"></div>
      <div id="tokenReveal" class="token-reveal" style="display:none;">
        <p class="token-warning">Copy this token now — it won't be shown again.</p>
        <code id="tokenValue" class="token-value"></code>
        <div id="scannerCmd" class="scanner-cmd-block">
          <p class="scanner-cmd-label">Quick start — run this on your server:</p>
          <pre class="scanner-cmd-pre"><code id="scannerCmdValue"></code></pre>
        </div>
      </div>
    </section>

    <!-- Danger Zone -->
    <section class="section danger-zone">
      <h2>Danger Zone</h2>
      <p class="section-desc">These actions are irreversible.</p>
      <div class="danger-actions">
        <a href="/app/api/export" class="btn btn-ghost">Export all data (JSON)</a>
      </div>
      <div class="delete-zone">
        <p class="delete-warning">Deleting your account deactivates it immediately. Your data is kept for 14 days in case you need recovery (contact support). After 14 days, all data is permanently purged.</p>
        <label class="delete-confirm-label">
          <span>Type <strong>DELETE</strong> to confirm</span>
          <input type="text" id="deleteConfirmInput" placeholder="DELETE" class="settings-input" autocomplete="off" />
        </label>
        <button id="deleteAccountBtn" class="btn btn-danger" disabled>Delete account</button>
        <div id="deleteStatus" class="backup-status"></div>
      </div>
    </section>
  </div>
</Layout>

<script>
  const backupList = document.getElementById('backupList')!;
  const createBtn = document.getElementById('createBackupBtn')!;
  const statusEl = document.getElementById('backupStatus')!;

  // --- Branding ---
  const brandName = document.getElementById('brandName') as HTMLInputElement;
  const brandColor = document.getElementById('brandColor') as HTMLInputElement;
  const brandColorHex = document.getElementById('brandColorHex') as HTMLInputElement;
  const saveBrandingBtn = document.getElementById('saveBrandingBtn')!;
  const brandingStatusEl = document.getElementById('brandingStatus')!;

  brandColor?.addEventListener('input', () => { brandColorHex.value = brandColor.value; });
  brandColorHex?.addEventListener('input', () => { if (/^#[0-9a-fA-F]{6}$/.test(brandColorHex.value)) brandColor.value = brandColorHex.value; });

  async function loadPreferences() {
    try {
      const res = await fetch('/app/api/preferences');
      const data = await res.json();
      if (data.branding) {
        if (data.branding.workspace_name || data.branding.workspaceName) brandName.value = data.branding.workspace_name || data.branding.workspaceName || '';
        if (data.branding.accent_color || data.branding.accentColor) {
          const c = data.branding.accent_color || data.branding.accentColor;
          brandColor.value = c; brandColorHex.value = c;
        }
      }
      // Notifications
      const notifListEl = document.getElementById('notifList')!;
      if (!data.notifications || data.notifications.length === 0) {
        notifListEl.innerHTML = '<div class="empty mono">No notifications configured.</div>';
      } else {
        notifListEl.innerHTML = data.notifications.map((n: any) => {
          const events = (() => { try { return JSON.parse(n.events).join(', '); } catch { return n.events; } })();
          return `
          <div class="backup-row">
            <div class="backup-info">
              <span class="backup-date">${n.channel}: ${escapeHtml(n.destination.substring(0, 40))}</span>
              <span class="backup-size mono">${events}</span>
            </div>
            <div style="display:flex;gap:4px;">
              <button class="btn btn-ghost btn-sm notif-toggle" data-id="${n.id}" data-enabled="${n.enabled}">${n.enabled ? 'Disable' : 'Enable'}</button>
              <button class="btn btn-danger btn-sm notif-delete" data-id="${n.id}">Remove</button>
            </div>
          </div>`;
        }).join('');

        document.querySelectorAll('.notif-toggle').forEach(btn => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            const enabled = btn.getAttribute('data-enabled') === 'true' ? false : true;
            await fetch('/app/api/preferences', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'toggle_notification', id, enabled }) });
            loadPreferences();
          });
        });
        document.querySelectorAll('.notif-delete').forEach(btn => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            await fetch('/app/api/preferences', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete_notification', id }) });
            loadPreferences();
          });
        });
      }
    } catch {}
  }

  saveBrandingBtn?.addEventListener('click', async () => {
    brandingStatusEl.textContent = 'Saving...';
    try {
      await fetch('/app/api/preferences', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'update_branding', workspaceName: brandName.value, accentColor: brandColorHex.value }),
      });
      brandingStatusEl.textContent = 'Saved. Reload to see changes.';
      brandingStatusEl.className = 'backup-status success';
    } catch {
      brandingStatusEl.textContent = 'Failed.';
      brandingStatusEl.className = 'backup-status error';
    }
  });

  // Add notification
  const addNotifBtn = document.getElementById('addNotifBtn')!;
  const notifChannel = document.getElementById('notifChannel') as HTMLSelectElement;
  const notifDest = document.getElementById('notifDest') as HTMLInputElement;
  const notifStatusEl = document.getElementById('notifStatus')!;

  addNotifBtn?.addEventListener('click', async () => {
    const channel = notifChannel.value;
    const destination = notifDest.value.trim();
    if (!destination) { notifStatusEl.textContent = 'Enter a destination.'; notifStatusEl.className = 'backup-status error'; return; }
    try {
      await fetch('/app/api/preferences', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'add_notification', channel, destination, events: ['incident_created', 'diagnosis_complete', 'severity_critical'] }),
      });
      notifDest.value = '';
      notifStatusEl.textContent = 'Added.';
      notifStatusEl.className = 'backup-status success';
      loadPreferences();
    } catch {
      notifStatusEl.textContent = 'Failed.';
      notifStatusEl.className = 'backup-status error';
    }
  });

  loadPreferences();

  // --- Scanner Schedule ---
  const scanInterval = document.getElementById('scanInterval') as HTMLSelectElement;
  const scanWeekday = document.getElementById('scanWeekday') as HTMLSelectElement;
  const scanWeekdayLabel = document.getElementById('scanWeekdayLabel')!;
  const scanTimeLabel = document.getElementById('scanTimeLabel')!;
  const scanHour = document.getElementById('scanHour') as HTMLInputElement;
  const scanMinute = document.getElementById('scanMinute') as HTMLInputElement;
  const scanSubnets = document.getElementById('scanSubnets') as HTMLInputElement;
  const scanEnabled = document.getElementById('scanEnabled') as HTMLInputElement;
  const saveScannerBtn = document.getElementById('saveScannerBtn')!;
  const scannerStatusEl = document.getElementById('scannerStatus')!;
  const modDocker = document.getElementById('modDocker') as HTMLInputElement;
  const modMetrics = document.getElementById('modMetrics') as HTMLInputElement;
  const modNetwork = document.getElementById('modNetwork') as HTMLInputElement;
  const modDns = document.getElementById('modDns') as HTMLInputElement;
  const modAuth = document.getElementById('modAuth') as HTMLInputElement;

  scanInterval?.addEventListener('change', () => {
    scanWeekdayLabel.style.display = scanInterval.value === 'weekly' ? '' : 'none';
    scanTimeLabel.style.display = scanInterval.value === 'hourly' ? 'none' : '';
  });

  async function loadScannerSchedule() {
    try {
      const res = await fetch('/app/api/scanner/schedule');
      const data = await res.json();
      scanInterval.value = data.interval || 'daily';
      scanHour.value = String(data.hour ?? 3);
      scanMinute.value = String(data.minute ?? 0);
      scanWeekday.value = String(data.weekday ?? 0);
      scanEnabled.checked = data.enabled !== false;
      scanWeekdayLabel.style.display = data.interval === 'weekly' ? '' : 'none';
      scanTimeLabel.style.display = data.interval === 'hourly' ? 'none' : '';

      const mods = data.modules || ['docker', 'metrics'];
      modMetrics.checked = mods.includes('metrics');
      modNetwork.checked = mods.includes('network');
      modDns.checked = mods.includes('dns');
      modAuth.checked = mods.includes('auth');

      if (data.subnets && Array.isArray(data.subnets)) {
        scanSubnets.value = data.subnets.join(', ');
      }
    } catch {}
  }

  saveScannerBtn?.addEventListener('click', async () => {
    scannerStatusEl.textContent = 'Saving...';
    scannerStatusEl.className = 'backup-status';

    const modules = ['docker'];
    if (modMetrics.checked) modules.push('metrics');
    if (modNetwork.checked) modules.push('network');
    if (modDns.checked) modules.push('dns');
    if (modAuth.checked) modules.push('auth');

    const subnetsRaw = scanSubnets.value.trim();
    const subnets = subnetsRaw ? subnetsRaw.split(',').map((s: string) => s.trim()).filter(Boolean) : null;

    try {
      const res = await fetch('/app/api/scanner/schedule', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          interval: scanInterval.value,
          hour: parseInt(scanHour.value) || 3,
          minute: parseInt(scanMinute.value) || 0,
          weekday: parseInt(scanWeekday.value) || 0,
          enabled: scanEnabled.checked,
          modules,
          subnets,
        }),
      });
      const data = await res.json();
      if (data.updated) {
        scannerStatusEl.textContent = 'Schedule saved. Scanner will pick up changes on next poll.';
        scannerStatusEl.className = 'backup-status success';
      } else {
        scannerStatusEl.textContent = data.error || 'Failed.';
        scannerStatusEl.className = 'backup-status error';
      }
    } catch {
      scannerStatusEl.textContent = 'Network error.';
      scannerStatusEl.className = 'backup-status error';
    }
  });

  loadScannerSchedule();

  // --- Status Page ---
  const spSlug = document.getElementById('spSlug') as HTMLInputElement;
  const spTitle = document.getElementById('spTitle') as HTMLInputElement;
  const spDesc = document.getElementById('spDesc') as HTMLInputElement;
  const spShowResp = document.getElementById('spShowResp') as HTMLInputElement;
  const spShowUptime = document.getElementById('spShowUptime') as HTMLInputElement;
  const spEnabled = document.getElementById('spEnabled') as HTMLInputElement;
  const spMonitorList = document.getElementById('spMonitorList')!;
  const saveStatusPageBtn = document.getElementById('saveStatusPageBtn')!;
  const statusPageStatusEl = document.getElementById('statusPageStatus')!;
  const statusPageLink = document.getElementById('statusPageLink') as HTMLAnchorElement;

  let allMonitorIds: string[] = [];

  async function loadStatusPage() {
    // Load monitors for checkboxes
    try {
      const mRes = await fetch('/app/api/monitors');
      const mData = await mRes.json();
      if (mData.monitors && mData.monitors.length > 0) {
        spMonitorList.innerHTML = mData.monitors.map((m: any) => {
          allMonitorIds.push(m.id);
          return `<label class="module-check"><input type="checkbox" value="${m.id}" class="sp-mon-check" /> ${escapeHtml(m.name)}</label>`;
        }).join('');
      } else {
        spMonitorList.innerHTML = '<div class="empty mono">No monitors yet. Add monitors in HUD first.</div>';
      }
    } catch {}

    // Load existing config
    try {
      const res = await fetch('/app/api/status-page');
      const data = await res.json();
      if (data.page) {
        spSlug.value = data.page.slug || '';
        spTitle.value = data.page.title || data.page.workspace_name || '';
        spDesc.value = data.page.description || '';
        spShowResp.checked = data.page.show_response_time !== false && data.page.showResponseTime !== false;
        spShowUptime.checked = data.page.show_uptime !== false && data.page.showUptime !== false;
        spEnabled.checked = data.page.enabled !== false;

        // Check the right monitors
        let ids: string[] = [];
        try { ids = JSON.parse(data.page.monitor_ids || data.page.monitorIds || '[]'); } catch {}
        document.querySelectorAll('.sp-mon-check').forEach((cb: any) => {
          cb.checked = ids.includes(cb.value);
        });

        // Show link
        statusPageLink.href = `/status/${data.page.slug}`;
        statusPageLink.style.display = '';
      }
    } catch {}
  }

  saveStatusPageBtn?.addEventListener('click', async () => {
    const monitorIds: string[] = [];
    document.querySelectorAll('.sp-mon-check:checked').forEach((cb: any) => monitorIds.push(cb.value));

    statusPageStatusEl.textContent = 'Saving...';
    statusPageStatusEl.className = 'backup-status';

    try {
      const res = await fetch('/app/api/status-page', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          slug: spSlug.value,
          title: spTitle.value,
          description: spDesc.value,
          monitorIds,
          showResponseTime: spShowResp.checked,
          showUptime: spShowUptime.checked,
          enabled: spEnabled.checked,
        }),
      });
      const data = await res.json();
      if (data.updated) {
        statusPageStatusEl.textContent = 'Saved.';
        statusPageStatusEl.className = 'backup-status success';
        statusPageLink.href = `/status/${data.slug}`;
        statusPageLink.style.display = '';
      } else {
        statusPageStatusEl.textContent = data.error || 'Failed.';
        statusPageStatusEl.className = 'backup-status error';
      }
    } catch {
      statusPageStatusEl.textContent = 'Network error.';
      statusPageStatusEl.className = 'backup-status error';
    }
  });

  loadStatusPage();

  // --- Backups ---
  async function loadBackups() {
    try {
      const res = await fetch('/app/api/backups');
      const data = await res.json();
      if (!data.backups || data.backups.length === 0) {
        backupList.innerHTML = '<div class="empty mono">No backups yet.</div>';
        return;
      }
      backupList.innerHTML = data.backups.map((b: any) => `
        <div class="backup-row">
          <div class="backup-info">
            <span class="backup-date">${formatDate(b.createdAt)}</span>
            <span class="backup-size mono">${formatSize(b.sizeBytes)}</span>
          </div>
          <button class="btn btn-ghost btn-sm restore-btn" data-filename="${escapeAttr(b.filename)}">Restore</button>
        </div>
      `).join('');

      // Attach restore handlers
      document.querySelectorAll('.restore-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const filename = btn.getAttribute('data-filename');
          if (!confirm('Restore this backup? This will replace your current data.')) return;
          statusEl.textContent = 'Restoring...';
          statusEl.className = 'backup-status';
          try {
            const res = await fetch('/app/api/backups', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'restore', filename }),
            });
            const data = await res.json();
            if (data.restored) {
              statusEl.textContent = 'Restored successfully. Reloading...';
              statusEl.className = 'backup-status success';
              setTimeout(() => window.location.reload(), 1000);
            } else {
              statusEl.textContent = data.error || 'Restore failed.';
              statusEl.className = 'backup-status error';
            }
          } catch {
            statusEl.textContent = 'Network error.';
            statusEl.className = 'backup-status error';
          }
        });
      });
    } catch {
      backupList.innerHTML = '<div class="empty mono">Failed to load backups.</div>';
    }
  }

  createBtn.addEventListener('click', async () => {
    createBtn.setAttribute('disabled', '');
    statusEl.textContent = 'Creating backup...';
    statusEl.className = 'backup-status';
    try {
      const res = await fetch('/app/api/backups', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'create' }),
      });
      const data = await res.json();
      if (data.backup) {
        statusEl.textContent = 'Backup created.';
        statusEl.className = 'backup-status success';
        loadBackups();
      } else {
        statusEl.textContent = data.error || 'Backup failed.';
        statusEl.className = 'backup-status error';
      }
    } catch {
      statusEl.textContent = 'Network error.';
      statusEl.className = 'backup-status error';
    }
    createBtn.removeAttribute('disabled');
  });

  function formatDate(iso: string) {
    try { return new Date(iso).toLocaleString(); } catch { return iso; }
  }
  function formatSize(bytes: number) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1048576).toFixed(1) + ' MB';
  }
  function escapeAttr(s: string) {
    return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
  }

  // Tokens
  const tokenList = document.getElementById('tokenList')!;
  const tokenNameInput = document.getElementById('tokenNameInput') as HTMLInputElement;
  const createTokenBtn = document.getElementById('createTokenBtn')!;
  const tokenStatusEl = document.getElementById('tokenStatus')!;
  const tokenReveal = document.getElementById('tokenReveal')!;
  const tokenValue = document.getElementById('tokenValue')!;

  async function loadTokens() {
    try {
      const res = await fetch('/app/api/tokens');
      const data = await res.json();
      if (!data.tokens || data.tokens.length === 0) {
        tokenList.innerHTML = '<div class="empty mono">No tokens.</div>';
        return;
      }
      tokenList.innerHTML = data.tokens.map((t: any) => `
        <div class="backup-row">
          <div class="backup-info">
            <span class="backup-date">${escapeHtml(t.name)}</span>
            <span class="backup-size mono">${t.lastUsedAt ? 'Last used: ' + formatDate(t.lastUsedAt) : 'Never used'}</span>
          </div>
          <button class="btn btn-danger btn-sm revoke-btn" data-id="${t.id}">Revoke</button>
        </div>
      `).join('');

      document.querySelectorAll('.revoke-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-id');
          if (!confirm('Revoke this token?')) return;
          await fetch('/app/api/tokens', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) });
          loadTokens();
        });
      });
    } catch {
      tokenList.innerHTML = '<div class="empty mono">Failed to load tokens.</div>';
    }
  }

  createTokenBtn.addEventListener('click', async () => {
    const name = tokenNameInput.value.trim();
    if (!name) { tokenStatusEl.textContent = 'Enter a token name.'; tokenStatusEl.className = 'backup-status error'; return; }
    try {
      const res = await fetch('/app/api/tokens', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name }) });
      const data = await res.json();
      if (data.token) {
        tokenValue.textContent = data.token;
        const cmdEl = document.getElementById('scannerCmdValue')!;
        cmdEl.textContent = `docker run --rm \\\n  -v /var/run/docker.sock:/var/run/docker.sock:ro \\\n  ghcr.io/charlieseay/stdout-scanner scan \\\n  --token ${data.token} \\\n  --url ${window.location.origin}`;
        tokenReveal.style.display = 'block';
        tokenNameInput.value = '';
        loadTokens();
      } else {
        tokenStatusEl.textContent = data.error || 'Failed.';
        tokenStatusEl.className = 'backup-status error';
      }
    } catch {
      tokenStatusEl.textContent = 'Network error.';
      tokenStatusEl.className = 'backup-status error';
    }
  });

  loadTokens();

  // Delete account
  const deleteBtn = document.getElementById('deleteAccountBtn') as HTMLButtonElement;
  const deleteInput = document.getElementById('deleteConfirmInput') as HTMLInputElement;
  const deleteStatusEl = document.getElementById('deleteStatus')!;

  deleteInput?.addEventListener('input', () => {
    deleteBtn.disabled = deleteInput.value !== 'DELETE';
  });

  deleteBtn?.addEventListener('click', async () => {
    if (deleteInput.value !== 'DELETE') return;
    deleteBtn.disabled = true;
    deleteStatusEl.textContent = 'Deactivating account...';
    deleteStatusEl.className = 'backup-status';
    try {
      const res = await fetch('/app/api/account', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ confirmation: 'DELETE' }),
      });
      const data = await res.json();
      if (data.deleted) {
        deleteStatusEl.textContent = 'Account deactivated. Data retained for 14 days. Redirecting...';
        deleteStatusEl.className = 'backup-status success';
        setTimeout(() => window.location.href = '/app/login', 2000);
      } else {
        deleteStatusEl.textContent = data.error || 'Delete failed.';
        deleteStatusEl.className = 'backup-status error';
        deleteBtn.disabled = false;
      }
    } catch {
      deleteStatusEl.textContent = 'Network error.';
      deleteStatusEl.className = 'backup-status error';
      deleteBtn.disabled = false;
    }
  });

  loadBackups();
</script>

