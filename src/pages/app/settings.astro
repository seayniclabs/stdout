  const dsPassword = document.getElementById('dsPassword') as HTMLInputElement;
  const dsTokenLabel = document.getElementById('dsTokenLabel')!;
  const dsTokenLabelText = document.getElementById('dsTokenLabelText')!;
  const dsTestBtn = document.getElementById('dsTestBtn')!;
  const dsSaveBtn = document.getElementById('dsSaveBtn')!;
  const dsTestResult = document.getElementById('dsTestResult')!;
  const dsStatusEl = document.getElementById('dsStatus')!;
  const dsFormTitle = document.getElementById('dsFormTitle')!;
  const dsRecommendations = document.getElementById('dsRecommendations')!;
  let editingDsId: string | null = null;

  function updateDataSourceFormByType() {
    const t = dsType.value;
    const isInflux = t === 'influxdb';
    const isGraylog = t === 'graylog';
    const isCrowdSec = t === 'crowdsec';
    const needsToken = ['influxdb', 'prometheus', 'loki', 'crowdsec'].includes(t);
    dsInfluxFields.style.display = isInflux ? '' : 'none';
    dsOrg.disabled = !isInflux;
    dsBucket.disabled = !isInflux;
    if (!isInflux) { dsOrg.value = ''; dsBucket.value = ''; }
    dsGraylogFields.style.display = isGraylog ? '' : 'none';
    dsUsername.disabled = !isGraylog;
    dsPassword.disabled = !isGraylog;
    if (!isGraylog) { dsUsername.value = ''; dsPassword.value = ''; }
    dsTokenLabel.style.display = needsToken || isGraylog ? '' : 'none';
    dsToken.disabled = !needsToken && !isGraylog;
    if (isCrowdSec) {
      dsTokenLabelText.textContent = 'API Key';
      dsToken.placeholder = 'CrowdSec bouncer API key';
    } else if (isGraylog) {
      dsTokenLabelText.textContent = 'Session Token (optional)';
      dsToken.placeholder = 'Graylog session token (or use username/password)';
    } else {
      dsTokenLabelText.textContent = 'API Token';
      dsToken.placeholder = 'API token';
    }
  }

  async function loadDataSources() {
    try {
      const res = await fetch('/app/api/data-sources');
      const data = await res.json();
      if (!data.sources || data.sources.length === 0) {
        dsList.innerHTML = '<div class="empty mono">No data sources configured. Add monitoring, security, or observability tools to enrich incidents.</div>';
        return;
      }
      dsList.innerHTML = data.sources.map((s: any) => {
        const statusIcon = s.lastTestStatus === 'ok'
          ? '<span class="ds-status-dot ds-ok"></span>'
          : s.lastTestStatus
            ? '<span class="ds-status-dot ds-error"></span>'
            : '<span class="ds-status-dot ds-unknown"></span>';
        return `
          <div class="backup-row">
            <div class="backup-info">
              <span class="backup-date">${statusIcon} ${escapeHtml(s.name)}</span>
              <span class="backup-size mono">${s.type} &middot; ${escapeHtml(s.url)}</span>
            </div>
            <div style="display:flex;gap:4px;">
              <button class="btn btn-ghost btn-sm ds-edit-btn" data-id="${s.id}">Edit</button>
              <button class="btn btn-ghost btn-sm ds-toggle-btn" data-id="${s.id}" data-enabled="${s.enabled}">${s.enabled ? 'Disable' : 'Enable'}</button>
              <button class="btn btn-danger btn-sm ds-delete-btn" data-id="${s.id}">Remove</button>
            </div>
          </div>`;
      }).join('');

      dsList.querySelectorAll('.ds-edit-btn').forEach((btn: any) => {
        btn.addEventListener('click', () => {
          const ds = data.sources.find((s: any) => s.id === btn.dataset.id);
          if (!ds) return;
          editingDsId = ds.id;
          dsFormTitle.textContent = 'Edit Data Source';
          dsType.value = ds.type || 'influxdb';
          dsName.value = ds.name || '';
          dsUrl.value = ds.url || '';
          dsToken.value = ds.hasToken ? '********' : '';
          dsOrg.value = ds.org || '';
          dsBucket.value = ds.bucket || '';
          dsUsername.value = ds.username || '';
          dsPassword.value = ds.hasPassword ? '********' : '';
          updateDataSourceFormByType();
          dsAddForm.style.display = '';
          dsAddBtn.style.display = 'none';
          dsTestResult.textContent = '';
        });
      });

      dsList.querySelectorAll('.ds-toggle-btn').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          const enabled = btn.dataset.enabled === 'true' ? false : true;
          await fetch('/app/api/data-sources', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'update', id: btn.dataset.id, enabled }) });
          loadDataSources();
        });
      });

      dsList.querySelectorAll('.ds-delete-btn').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          if (!confirm('Remove this data source?')) return;
          await fetch('/app/api/data-sources', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id: btn.dataset.id }) });
          loadDataSources();
        });
      });
    } catch { dsList.innerHTML = '<div class="empty mono">Failed to load data sources.</div>'; }
  }

  async function loadDataSourceRecommendations() {
    if (!dsRecommendations) return;
    try {
      const res = await fetch('/app/api/data-sources/recommendations');
      const data = await res.json();
      const recs = Array.isArray(data.recommendations) ? data.recommendations : [];
      if (recs.length === 0) { dsRecommendations.innerHTML = ''; return; }
      dsRecommendations.innerHTML = `
        <div class="backup-row" style="display:block;">
          <div class="backup-info" style="margin-bottom:8px;">
            <span class="backup-date">Suggested Integrations From Latest Scanner Run</span>
          </div>
          ${recs.map((r: any) => `
            <div class="ds-rec-row">
              <span class="mono ds-rec-type">${escapeHtml(r.type || 'unknown')}</span>
              <span class="ds-rec-text">${escapeHtml(r.reason || '')}</span>
              <span class="mono ds-rec-reco">Try: ${escapeHtml(r.recommendation || 'n/a')}</span>
            </div>
          `).join('')}
        </div>
      `;
    } catch { dsRecommendations.innerHTML = ''; }
  }

  dsAddBtn?.addEventListener('click', () => {
    editingDsId = null;
    dsFormTitle.textContent = 'Add Data Source';
    dsType.value = 'influxdb';
    dsName.value = ''; dsUrl.value = ''; dsToken.value = ''; dsOrg.value = ''; dsBucket.value = '';
    dsUsername.value = ''; dsPassword.value = '';
    updateDataSourceFormByType();
    dsAddForm.style.display = '';
    dsAddBtn.style.display = 'none';
    dsTestResult.textContent = '';
  });

  dsFormCancel?.addEventListener('click', () => { dsAddForm.style.display = 'none'; dsAddBtn.style.display = ''; editingDsId = null; });
  dsType?.addEventListener('change', updateDataSourceFormByType);

  dsTestBtn?.addEventListener('click', async () => {
    dsTestResult.textContent = 'Testing...';
    dsTestResult.className = 'backup-status';
    try {
      const res = await fetch('/app/api/data-sources', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'test', id: editingDsId, type: dsType.value, url: dsUrl.value, token: dsToken.value, org: dsOrg.value, bucket: dsBucket.value, username: dsUsername.value, password: dsPassword.value }),
      });
      const data = await res.json();
      if (data.ok) { dsTestResult.textContent = 'Connected successfully.'; dsTestResult.className = 'backup-status success'; }
      else { dsTestResult.textContent = `Connection failed: ${data.error || 'unknown error'}`; dsTestResult.className = 'backup-status error'; }
    } catch { dsTestResult.textContent = 'Network error.'; dsTestResult.className = 'backup-status error'; }
  });

  dsSaveBtn?.addEventListener('click', async () => {
    const name = dsName.value.trim();
    const url = dsUrl.value.trim();
    if (!name || !url) { dsStatusEl.textContent = 'Name and URL are required.'; dsStatusEl.className = 'backup-status error'; return; }
    dsStatusEl.textContent = 'Saving...';
    dsStatusEl.className = 'backup-status';
    try {
      const payload: any = { action: editingDsId ? 'update' : 'create', name, type: dsType.value, url, token: dsToken.value, org: dsOrg.value, bucket: dsBucket.value, username: dsUsername.value, password: dsPassword.value };
      if (editingDsId) payload.id = editingDsId;
      const res = await fetch('/app/api/data-sources', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      const data = await res.json();
      if (data.id || data.updated) {
        dsAddForm.style.display = 'none'; dsAddBtn.style.display = '';
        dsStatusEl.textContent = editingDsId ? 'Updated.' : 'Added.';
        dsStatusEl.className = 'backup-status success';
        editingDsId = null; loadDataSources();
      } else { dsStatusEl.textContent = data.error || 'Failed.'; dsStatusEl.className = 'backup-status error'; }
    } catch { dsStatusEl.textContent = 'Network error.'; dsStatusEl.className = 'backup-status error'; }
  });

  updateDataSourceFormByType();
  loadDataSources();
  loadDataSourceRecommendations();

  // ── Windlass ──
  const windlassEndpointUrl = document.getElementById('windlassEndpointUrl') as HTMLInputElement;
  const windlassSyncInterval = document.getElementById('windlassSyncInterval') as HTMLSelectElement;
  const windlassEnabled = document.getElementById('windlassEnabled') as HTMLInputElement;
  const saveWindlassBtn = document.getElementById('saveWindlassBtn');
  const windlassStatusEl = document.getElementById('windlassStatus')!;

  async function loadWindlassConfig() {
    try {
      const res = await fetch('/app/api/windlass/config');
      const data = await res.json();
      if (data.config) {
        windlassEndpointUrl.value = data.config.endpointUrl || '';
        const interval = String(data.config.syncIntervalSeconds || 60);
        const opt = windlassSyncInterval.querySelector(`option[value="${interval}"]`) as HTMLOptionElement | null;
        if (opt) opt.selected = true;
        windlassEnabled.checked = data.config.enabled !== false;
      }
    } catch {}
  }

  saveWindlassBtn?.addEventListener('click', async () => {
    const endpointUrl = windlassEndpointUrl.value.trim();
    if (!endpointUrl) { windlassStatusEl.textContent = 'Endpoint URL is required.'; windlassStatusEl.className = 'backup-status error'; return; }
    windlassStatusEl.textContent = 'Saving...';
    try {
      const res = await fetch('/app/api/windlass/config', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          endpointUrl,
          syncIntervalSeconds: parseInt(windlassSyncInterval.value, 10),
          enabled: windlassEnabled.checked,
        }),
      });
      if (res.ok) {
        windlassStatusEl.textContent = 'Saved.';
        windlassStatusEl.className = 'backup-status success';
      } else {
        const data = await res.json().catch(() => ({}));
        windlassStatusEl.textContent = data.error || 'Save failed.';
        windlassStatusEl.className = 'backup-status error';
      }
    } catch {
      windlassStatusEl.textContent = 'Save failed.';
      windlassStatusEl.className = 'backup-status error';
    }
  });

  loadWindlassConfig();

  // ── Scanner Schedule ──
  const scanInterval = document.getElementById('scanInterval') as HTMLSelectElement;
  const scanWeekday = document.getElementById('scanWeekday') as HTMLSelectElement;
  const scanWeekdayLabel = document.getElementById('scanWeekdayLabel')!;
  const scanTimeLabel = document.getElementById('scanTimeLabel')!;
  const scanHour = document.getElementById('scanHour') as HTMLInputElement;
  const scanMinute = document.getElementById('scanMinute') as HTMLInputElement;
  const scanSubnets = document.getElementById('scanSubnets') as HTMLInputElement;
  const scanEnabled = document.getElementById('scanEnabled') as HTMLInputElement;
  const saveScannerBtn = document.getElementById('saveScannerBtn')!;
  const scannerStatusEl = document.getElementById('scannerStatus')!;
  const modMetrics = document.getElementById('modMetrics') as HTMLInputElement;
  const modNetwork = document.getElementById('modNetwork') as HTMLInputElement;
  const modDns = document.getElementById('modDns') as HTMLInputElement;
  const modAuth = document.getElementById('modAuth') as HTMLInputElement;

  scanInterval?.addEventListener('change', () => {
    scanWeekdayLabel.style.display = scanInterval.value === 'weekly' ? '' : 'none';
    scanTimeLabel.style.display = scanInterval.value === 'hourly' ? 'none' : '';
  });

  async function loadScannerSchedule() {
    try {
      const res = await fetch('/app/api/scanner/schedule');
      const data = await res.json();
      scanInterval.value = data.interval || 'daily';
      scanHour.value = String(data.hour ?? 3);
      scanMinute.value = String(data.minute ?? 0);
      scanWeekday.value = String(data.weekday ?? 0);
      scanEnabled.checked = data.enabled !== false;
      scanWeekdayLabel.style.display = data.interval === 'weekly' ? '' : 'none';
      scanTimeLabel.style.display = data.interval === 'hourly' ? 'none' : '';
      const mods = data.modules || ['docker', 'metrics'];
      modMetrics.checked = mods.includes('metrics');
      modNetwork.checked = mods.includes('network');
      modDns.checked = mods.includes('dns');
      modAuth.checked = mods.includes('auth');
      if (data.subnets && Array.isArray(data.subnets)) scanSubnets.value = data.subnets.join(', ');
    } catch {}
  }

  saveScannerBtn?.addEventListener('click', async () => {
    scannerStatusEl.textContent = 'Saving...';
    scannerStatusEl.className = 'backup-status';
    const modules = ['docker'];
    if (modMetrics.checked) modules.push('metrics');
    if (modNetwork.checked) modules.push('network');
    if (modDns.checked) modules.push('dns');
    if (modAuth.checked) modules.push('auth');
    const subnetsRaw = scanSubnets.value.trim();
    const subnets = subnetsRaw ? subnetsRaw.split(',').map((s: string) => s.trim()).filter(Boolean) : null;
    try {
      const res = await fetch('/app/api/scanner/schedule', {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ interval: scanInterval.value, hour: parseInt(scanHour.value) || 3, minute: parseInt(scanMinute.value) || 0, weekday: parseInt(scanWeekday.value) || 0, enabled: scanEnabled.checked, modules, subnets }),
      });
      const data = await res.json();
      if (data.updated) { scannerStatusEl.textContent = 'Schedule saved.'; scannerStatusEl.className = 'backup-status success'; }
      else { scannerStatusEl.textContent = data.error || 'Failed.'; scannerStatusEl.className = 'backup-status error'; }
    } catch { scannerStatusEl.textContent = 'Network error.'; scannerStatusEl.className = 'backup-status error'; }
  });

  loadScannerSchedule();

  // ── Status Page ──
  const spSlug = document.getElementById('spSlug') as HTMLInputElement;
  const spTitle = document.getElementById('spTitle') as HTMLInputElement;
  const spDesc = document.getElementById('spDesc') as HTMLInputElement;
  const spShowResp = document.getElementById('spShowResp') as HTMLInputElement;
  const spShowUptime = document.getElementById('spShowUptime') as HTMLInputElement;
  const spEnabled = document.getElementById('spEnabled') as HTMLInputElement;
  const spMonitorList = document.getElementById('spMonitorList')!;
  const saveStatusPageBtn = document.getElementById('saveStatusPageBtn')!;
  const statusPageStatusEl = document.getElementById('statusPageStatus')!;
  const statusPageLink = document.getElementById('statusPageLink') as HTMLAnchorElement;

  async function loadStatusPage() {
    try {
      const mRes = await fetch('/app/api/monitors');
      const mData = await mRes.json();
      if (mData.monitors && mData.monitors.length > 0) {
        spMonitorList.innerHTML = mData.monitors.map((m: any) =>
          `<label class="module-check"><input type="checkbox" value="${m.id}" class="sp-mon-check" /> ${escapeHtml(m.name)}</label>`
        ).join('');
      } else {
        spMonitorList.innerHTML = '<div class="empty mono">No monitors yet. Add monitors in HUD first.</div>';
      }
    } catch {}
    try {
      const res = await fetch('/app/api/status-page');
      const data = await res.json();
      if (data.page) {
        spSlug.value = data.page.slug || '';
        spTitle.value = data.page.title || data.page.workspace_name || '';
        spDesc.value = data.page.description || '';
        spShowResp.checked = data.page.show_response_time !== false && data.page.showResponseTime !== false;
        spShowUptime.checked = data.page.show_uptime !== false && data.page.showUptime !== false;
        spEnabled.checked = data.page.enabled !== false;
        let ids: string[] = [];
        try { ids = JSON.parse(data.page.monitor_ids || data.page.monitorIds || '[]'); } catch {}
        document.querySelectorAll('.sp-mon-check').forEach((cb: any) => { cb.checked = ids.includes(cb.value); });
        statusPageLink.href = `/status/${data.page.slug}`;
        statusPageLink.style.display = '';
      }
    } catch {}
  }

  saveStatusPageBtn?.addEventListener('click', async () => {
    const monitorIds: string[] = [];
    document.querySelectorAll('.sp-mon-check:checked').forEach((cb: any) => monitorIds.push(cb.value));
    statusPageStatusEl.textContent = 'Saving...';
    statusPageStatusEl.className = 'backup-status';
    try {
      const res = await fetch('/app/api/status-page', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug: spSlug.value, title: spTitle.value, description: spDesc.value, monitorIds, showResponseTime: spShowResp.checked, showUptime: spShowUptime.checked, enabled: spEnabled.checked }),
      });
      const data = await res.json();
      if (data.updated) {
        statusPageStatusEl.textContent = 'Saved.'; statusPageStatusEl.className = 'backup-status success';
        statusPageLink.href = `/status/${data.slug}`; statusPageLink.style.display = '';
      } else { statusPageStatusEl.textContent = data.error || 'Failed.'; statusPageStatusEl.className = 'backup-status error'; }
    } catch { statusPageStatusEl.textContent = 'Network error.'; statusPageStatusEl.className = 'backup-status error'; }
  });

  loadStatusPage();

  // ── Backups ──
  const backupList = document.getElementById('backupList')!;
  const createBtn = document.getElementById('createBackupBtn')!;
  const statusEl = document.getElementById('backupStatus')!;

  async function loadBackups() {
    try {
      const res = await fetch('/app/api/backups');
      const data = await res.json();
      if (!data.backups || data.backups.length === 0) { backupList.innerHTML = '<div class="empty mono">No backups yet.</div>'; return; }
      backupList.innerHTML = data.backups.map((b: any) => `
        <div class="backup-row">
          <div class="backup-info">
            <span class="backup-date">${formatDate(b.createdAt)}</span>
            <span class="backup-size mono">${formatSize(b.sizeBytes)}</span>
          </div>
          <button class="btn btn-ghost btn-sm restore-btn" data-filename="${escapeAttr(b.filename)}">Restore</button>
        </div>
      `).join('');
      document.querySelectorAll('.restore-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const filename = btn.getAttribute('data-filename');
          if (!confirm('Restore this backup? This will replace your current data.')) return;
          statusEl.textContent = 'Restoring...'; statusEl.className = 'backup-status';
          try {
            const res = await fetch('/app/api/backups', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'restore', filename }) });
            const data = await res.json();
            if (data.restored) { statusEl.textContent = 'Restored. Reloading...'; statusEl.className = 'backup-status success'; setTimeout(() => window.location.reload(), 1000); }
            else { statusEl.textContent = data.error || 'Restore failed.'; statusEl.className = 'backup-status error'; }
          } catch { statusEl.textContent = 'Network error.'; statusEl.className = 'backup-status error'; }
        });
      });
    } catch { backupList.innerHTML = '<div class="empty mono">Failed to load backups.</div>'; }
  }

  createBtn.addEventListener('click', async () => {
    createBtn.setAttribute('disabled', '');
    statusEl.textContent = 'Creating backup...'; statusEl.className = 'backup-status';
    try {
      const res = await fetch('/app/api/backups', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'create' }) });
      const data = await res.json();
      if (data.backup) { statusEl.textContent = 'Backup created.'; statusEl.className = 'backup-status success'; loadBackups(); }
      else { statusEl.textContent = data.error || 'Backup failed.'; statusEl.className = 'backup-status error'; }
    } catch { statusEl.textContent = 'Network error.'; statusEl.className = 'backup-status error'; }
    createBtn.removeAttribute('disabled');
  });

  // ── API Tokens ──
  const tokenList = document.getElementById('tokenList')!;
  const tokenNameInput = document.getElementById('tokenNameInput') as HTMLInputElement;
  const createTokenBtn = document.getElementById('createTokenBtn')!;
  const tokenStatusEl = document.getElementById('tokenStatus')!;
  const tokenReveal = document.getElementById('tokenReveal')!;
  const tokenValue = document.getElementById('tokenValue')!;

  async function loadTokens() {
    try {
      const res = await fetch('/app/api/tokens');
      const data = await res.json();
      if (!data.tokens || data.tokens.length === 0) { tokenList.innerHTML = '<div class="empty mono">No tokens.</div>'; return; }
      tokenList.innerHTML = data.tokens.map((t: any) => `
        <div class="backup-row">
          <div class="backup-info">
            <span class="backup-date">${escapeHtml(t.name)}</span>
            <span class="backup-size mono">${t.lastUsedAt ? 'Last used: ' + formatDate(t.lastUsedAt) : 'Never used'}</span>
          </div>
          <button class="btn btn-danger btn-sm revoke-btn" data-id="${t.id}">Revoke</button>
        </div>
      `).join('');
      document.querySelectorAll('.revoke-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-id');
          if (!confirm('Revoke this token?')) return;
          await fetch('/app/api/tokens', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) });
          loadTokens();
        });
      });
    } catch { tokenList.innerHTML = '<div class="empty mono">Failed to load tokens.</div>'; }
  }

  createTokenBtn.addEventListener('click', async () => {
    const name = tokenNameInput.value.trim();
    if (!name) { tokenStatusEl.textContent = 'Enter a token name.'; tokenStatusEl.className = 'backup-status error'; return; }
    try {
      const res = await fetch('/app/api/tokens', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name }) });
      const data = await res.json();
      if (data.token) {
        tokenValue.textContent = data.token;
        const cmdEl = document.getElementById('scannerCmdValue')!;
        cmdEl.textContent = `docker run --rm \\\n  -v /var/run/docker.sock:/var/run/docker.sock:ro \\\n  ghcr.io/charlieseay/stdout-scanner scan \\\n  --token ${data.token} \\\n  --url ${window.location.origin}`;
        tokenReveal.style.display = 'block';
        tokenNameInput.value = '';
        loadTokens();
      } else { tokenStatusEl.textContent = data.error || 'Failed.'; tokenStatusEl.className = 'backup-status error'; }
    } catch { tokenStatusEl.textContent = 'Network error.'; tokenStatusEl.className = 'backup-status error'; }
  });

  loadTokens();
  loadBackups();

  // ── Delete account ──
  const deleteBtn = document.getElementById('deleteAccountBtn') as HTMLButtonElement;
  const deleteInput = document.getElementById('deleteConfirmInput') as HTMLInputElement;
  const deleteStatusEl = document.getElementById('deleteStatus')!;

  deleteInput?.addEventListener('input', () => { deleteBtn.disabled = deleteInput.value !== 'DELETE'; });

  deleteBtn?.addEventListener('click', async () => {
    if (deleteInput.value !== 'DELETE') return;
    deleteBtn.disabled = true;
    deleteStatusEl.textContent = 'Deactivating account...'; deleteStatusEl.className = 'backup-status';
    try {
      const res = await fetch('/app/api/account', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ confirmation: 'DELETE' }) });
      const data = await res.json();
      if (data.deleted) {
        deleteStatusEl.textContent = 'Account deactivated. Data retained for 14 days. Redirecting...'; deleteStatusEl.className = 'backup-status success';
        setTimeout(() => window.location.href = '/app/login', 2000);
      } else { deleteStatusEl.textContent = data.error || 'Delete failed.'; deleteStatusEl.className = 'backup-status error'; deleteBtn.disabled = false; }
    } catch { deleteStatusEl.textContent = 'Network error.'; deleteStatusEl.className = 'backup-status error'; deleteBtn.disabled = false; }
  });

  // ── Helpers ──
  function formatDate(iso: string) { try { return new Date(iso).toLocaleString(); } catch { return iso; } }
  function formatSize(bytes: number) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1048576).toFixed(1) + ' MB';
  }
  function escapeAttr(s: string) { return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;'); }
</script>

<style>
  /* ── Page layout ── */
  .settings-page { max-width: 680px; margin: 0 auto; padding-bottom: 4rem; }
  .settings-header { display: flex; align-items: center; gap: 12px; margin-bottom: 1rem; flex-wrap: wrap; }
  .settings-header h1 { font-size: 1.4rem; font-weight: 700; margin: 0; }
  .version-label { font-size: 11px; color: var(--text-muted); font-family: var(--font-mono); }

  /* ── Update banner ── */
  .update-banner { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; background: rgba(34,211,238,0.08); border: 1px solid rgba(34,211,238,0.25); border-radius: var(--radius); font-size: 12px; color: #22d3ee; text-decoration: none; transition: background 150ms; margin-bottom: 1rem; }
  .update-banner:hover { background: rgba(34,211,238,0.14); }

  /* ── Tab bar ── */
  .settings-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.75rem;
  }
  .tab-btn {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0.6rem 1.1rem;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    margin-bottom: -1px;
    transition: color 0.15s, border-color 0.15s;
    letter-spacing: 0.01em;
  }
  .tab-btn:hover { color: var(--text); }
  .tab-btn.active { color: var(--text); border-bottom-color: var(--accent); }

  /* ── Tab panels ── */
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* ── Sections ── */
  .section { margin-bottom: 2rem; }
  .section h2 { font-size: 13px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
  .section-desc { font-size: 13px; color: var(--text-muted); margin-bottom: 14px; }
  .section-link { color: var(--accent); text-decoration: none; font-size: 12px; }
  .section-link:hover { text-decoration: underline; }

  /* ── Profile ── */
  .profile-info { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .profile-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; border-bottom: 1px solid var(--border); }
  .profile-row:last-child { border-bottom: none; }
  .label { font-size: 12px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.04em; }
  .value { font-size: 13px; }

  /* ── Billing ── */
  .billing-info { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .tier-card { padding: 20px; }
  .tier-header { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .tier-name { font-size: 18px; font-weight: 700; }
  .tier-badge { font-size: 11px; padding: 2px 8px; border-radius: 4px; font-weight: 600; }
  .tier-badge.warning { background: rgba(245,158,11,0.15); color: #f59e0b; }
  .tier-badge.success { background: rgba(34,197,94,0.15); color: #22c55e; }
  .tier-badge.muted { background: var(--bg-surface); color: var(--text-muted); }
  .tier-limits { display: grid; }
  .limit-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 13px; }
  .limit-row:last-child { border-bottom: none; }
  .limit-row span:first-child { color: var(--text-secondary); }
  .limit-row span:last-child { font-weight: 600; }
  .tier-upgrade { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border); }
  .tier-upgrade p { font-size: 13px; color: var(--text-secondary); margin-bottom: 12px; }
  .upgrade-buttons { display: flex; gap: 8px; flex-wrap: wrap; }
  .btn-secondary { background: var(--bg-surface); border: 1px solid var(--border); color: var(--text); padding: 8px 16px; border-radius: var(--radius-sm); font-size: 13px; text-decoration: none; cursor: pointer; }
  .btn-secondary:hover { background: var(--bg-hover); }

  /* ── Team ── */
  .team-section { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; }
  .team-list { margin-bottom: 16px; }
