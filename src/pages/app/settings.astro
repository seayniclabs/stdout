    const provider = aiProvidersData.find((p: any) => p.id === providerId);
    if (!provider || !aiDiagModel) return;
    const diagModels = provider.models.filter((m: any) => m.capability === 'diagnostics' || m.capability === 'both');
    const fixModels = provider.models.filter((m: any) => m.capability === 'autofix' || m.capability === 'both');
    aiDiagModel.innerHTML = diagModels.map((m: any) => `<option value="${m.id}">${m.name}</option>`).join('');
    if (aiAutofixModel && aiAutofixSection) {
      if (provider.canAutofix && fixModels.length > 0) {
        aiAutofixSection.style.display = 'block';
        aiAutofixModel.innerHTML = fixModels.map((m: any) => `<option value="${m.id}">${m.name}</option>`).join('');
