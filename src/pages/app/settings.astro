---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getUserLimits } from '../../lib/tiers';
import { getLicenseNotice } from '../../lib/update-check';
import { checkForUpdate, type UpdateCheckResult } from '../../lib/update-check';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

let updateInfo: UpdateCheckResult | null = null;
try {
  updateInfo = await checkForUpdate();
} catch {}
const currentVersion = updateInfo?.currentVersion ?? '1.2.0';
const hasUpdate = updateInfo?.hasUpdate ?? false;
const { limits } = getUserLimits(user);
const licenseNotice = getLicenseNotice();
---
<Layout title="Settings — StdOut">
  <div class="settings-page">

    <div class="settings-header">
      <h1>Settings</h1>
      <span class="version-label mono">v{currentVersion}</span>
    </div>

    {hasUpdate && updateInfo && (
      <a href={updateInfo.releaseUrl} class="update-banner" target="_blank" rel="noopener">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>Update available: <strong>v{updateInfo.currentVersion}</strong> &rarr; <strong>v{updateInfo.latestVersion}</strong></span>
      </a>
    )}

    <!-- Tab bar -->
    <div class="settings-tabs" role="tablist" aria-label="Settings sections">
      <button class="tab-btn active" data-tab="account" role="tab" aria-selected="true" aria-controls="tab-account">Account</button>
      <button class="tab-btn" data-tab="integrations" role="tab" aria-selected="false" aria-controls="tab-integrations">Integrations</button>
      <button class="tab-btn" data-tab="data" role="tab" aria-selected="false" aria-controls="tab-data">Data</button>
    </div>

    <!-- ── TAB 1: ACCOUNT ── -->
    <div id="tab-account" class="tab-panel active" role="tabpanel">

      <!-- Profile -->
      <section class="section">
        <h2>Profile</h2>
        <div class="profile-info">
          <div class="profile-row">
            <span class="label">Email</span>
            <span class="value mono">{user.email}</span>
          </div>
          <div class="profile-row">
            <span class="label">Display name</span>
            <span class="value">{user.displayName || '—'}</span>
          </div>
          <div class="profile-row">
            <span class="label">Edition</span>
            <span class="value">Self-Hosted</span>
          </div>
        </div>
      </section>

      <section class="section" id="license">
        <h2>License</h2>
        <p class="section-desc">Enter your self-host license key from store.seayniclabs.com (order confirmation). Optional during evaluation.</p>
        <div class="brand-form">
          <label>
            <span>License key</span>
            <input type="text" id="licenseKey" placeholder="SL-..." class="settings-input mono" autocomplete="off" />
          </label>
          <button type="button" id="saveLicenseBtn" class="btn btn-primary btn-sm">Save license</button>
          <div id="licenseStatus" class="backup-status"></div>
        </div>
      </section>

      {licenseNotice && !licenseNotice.valid && (
        <section class="section">
          <p class="section-desc" style="color: var(--warning);">{licenseNotice.message}</p>
        </section>
      )}

      <!-- Team -->
      {limits.rbacEnabled && (
        <section class="section">
          <h2>Team Members</h2>
          <p class="section-desc">Invite team members with role-based access. <a href="/app/team" class="section-link">Open Team panel &rarr;</a></p>
          <div class="team-section">
            <div id="teamList" class="team-list">
              <div class="team-loading">Loading team...</div>
            </div>
            <div class="team-invite">
              <input type="email" id="inviteEmail" placeholder="Email address" class="settings-input" />
              <select id="inviteRole" class="settings-input">
                <option value="viewer">Viewer</option>
                <option value="editor">Editor</option>
                <option value="admin">Admin</option>
              </select>
              <button id="inviteBtn" class="btn btn-primary btn-sm">Invite</button>
            </div>
            <div id="teamStatus" class="backup-status"></div>
          </div>
        </section>
      )}

      <!-- Workspace Branding -->
      <section class="section">
        <h2>Workspace Branding</h2>
        <p class="section-desc">Customize how StdOut looks for your workspace. Solo tier and above.</p>
        <div class="brand-form">
          <label>
            <span>Workspace name</span>
            <input type="text" id="brandName" placeholder="e.g. My Lab" class="settings-input" />
          </label>
          <label>
            <span>Accent color</span>
            <div class="color-row">
              <input type="color" id="brandColor" value="#F97316" class="color-picker" />
              <input type="text" id="brandColorHex" value="#F97316" class="settings-input mono" style="width: 100px;" />
            </div>
          </label>
          <label>
            <span>Logo URL <span style="font-weight:400;color:var(--text-muted)">(optional)</span></span>
            <input type="text" id="brandLogo" placeholder="https://example.com/logo.png" class="settings-input" />
          </label>
          <button id="saveBrandingBtn" class="btn btn-primary btn-sm">Save branding</button>
          <div id="brandingStatus" class="backup-status"></div>
        </div>
      </section>

      <!-- Notifications -->
      <section class="section">
        <h2>Notifications</h2>
        <p class="section-desc">Get notified when incidents are created or diagnoses complete.</p>
        <div id="notifList" class="backup-list">
          <div class="loading mono">Loading...</div>
        </div>
        <div class="notif-add">
          <select id="notifChannel" class="settings-input" style="width: 120px;">
            <option value="email">Email</option>
            <option value="webhook">Webhook</option>
          </select>
          <input type="text" id="notifDest" placeholder="email@example.com or https://..." class="settings-input" style="flex:1;" />
          <button id="addNotifBtn" class="btn btn-primary btn-sm">Add</button>
        </div>
        <div class="notif-events mono" style="font-size: 11px; color: var(--text-muted); margin-top: 6px;">
          Events: incident_created, diagnosis_complete, severity_critical, backup_complete
        </div>
        <div id="notifStatus" class="backup-status"></div>
      </section>

      <!-- Add-ons -->
      <section class="section">
        <h2>Add-ons</h2>
        <p class="section-desc">Control how add-on recommendations appear in your console.</p>
        <div class="toggle-row">
          <label class="toggle-label" for="addonsToggle">
            <span>Show add-on recommendations</span>
            <span class="toggle-hint">Suggests tools from the Seaynic Labs store based on what's running in your stack.</span>
          </label>
          <button id="addonsToggle" class="toggle-btn" role="switch" aria-checked="true">
            <span class="toggle-track"><span class="toggle-thumb"></span></span>
          </button>
        </div>
        <div class="toggle-row" style="margin-top:0.75rem;">
          <a href="/app/addons" class="btn btn-ghost btn-sm">View add-ons panel &rarr;</a>
        </div>
      </section>

      <!-- Public Status Page -->
      <section class="section">
        <h2>Public Status Page</h2>
        <p class="section-desc">Share a public URL showing your service health. No login required for visitors.</p>
        <div class="status-page-form">
          <div class="sp-row">
            <label style="flex:1;">
              <span>URL slug</span>
              <div class="slug-preview">
                <span class="slug-base mono">/status/</span>
                <input type="text" id="spSlug" placeholder="my-lab" class="settings-input mono" style="flex:1;" />
              </div>
            </label>
            <label>
              <span>Page title</span>
              <input type="text" id="spTitle" placeholder="Service Status" class="settings-input" />
            </label>
          </div>
          <label>
            <span>Description <span style="font-weight:400;color:var(--text-muted)">(optional)</span></span>
            <input type="text" id="spDesc" placeholder="Current status of my homelab services" class="settings-input" />
          </label>
          <div class="sp-monitors">
            <span class="module-label">Monitors to display</span>
            <div id="spMonitorList" class="sp-monitor-checks">
              <div class="loading mono">Loading monitors...</div>
            </div>
          </div>
          <div class="sp-options">
            <label class="module-check"><input type="checkbox" id="spShowResp" checked /> Show response times</label>
            <label class="module-check"><input type="checkbox" id="spShowUptime" checked /> Show uptime percentage</label>
            <label class="scanner-toggle"><input type="checkbox" id="spEnabled" checked /> <span>Page enabled</span></label>
          </div>
          <div class="scanner-actions">
            <button id="saveStatusPageBtn" class="btn btn-primary btn-sm">Save status page</button>
            <a id="statusPageLink" href="#" target="_blank" class="btn btn-ghost btn-sm" style="display:none;">View page</a>
          </div>
          <div id="statusPageStatus" class="backup-status"></div>
        </div>
      </section>

      <!-- Feedback -->
      <section class="section">
        <h2>Feedback</h2>
        <p class="section-desc">Request features or report issues. We read every submission.</p>
        <div id="featureRequestList" class="backup-list">
          <div class="loading mono">Loading...</div>
        </div>
        <div id="featureRequestForm" style="display:none; margin-top: 0.75rem;">
          <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 8px; padding: 1rem;">
            <label style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Title</label>
            <input type="text" id="frTitle" class="settings-input" placeholder="Short description of what you need" />
            <label style="display: block; font-size: 12px; font-weight: 600; margin: 8px 0 4px;">Category</label>
            <select id="frCategory" class="settings-input">
              <option value="feature">New Feature</option>
              <option value="improvement">Improvement</option>
              <option value="integration">Integration</option>
              <option value="bug">Bug Report</option>
              <option value="other">Other</option>
            </select>
            <label style="display: block; font-size: 12px; font-weight: 600; margin: 8px 0 4px;">Description</label>
            <textarea id="frDescription" class="settings-input" rows="4" placeholder="What problem does this solve? How would you use it?"></textarea>
            <div style="display: flex; gap: 8px; margin-top: 8px;">
              <button id="frSubmitBtn" class="btn btn-primary btn-sm">Submit</button>
              <button id="frCancelBtn" class="btn btn-ghost btn-sm">Cancel</button>
            </div>
          </div>
        </div>
        <button id="frAddBtn" class="btn btn-ghost btn-sm" style="margin-top: 0.5rem;">Send feedback</button>
        <div id="frStatus" class="backup-status"></div>
      </section>

    </div><!-- /tab-account -->

    <!-- ── TAB 2: INTEGRATIONS ── -->
    <div id="tab-integrations" class="tab-panel" role="tabpanel">

      <!-- AI Providers (BYOK) -->
      <section class="section">
          <h2>AI Providers</h2>
          <p class="section-desc">Bring your own API key for AI diagnostics and auto-fix. Your key is used first; the platform key is a fallback.</p>
          <div id="aiProvidersList" class="backup-list">
            <div class="loading mono">Loading...</div>
          </div>
          <div id="aiProviderForm" class="ds-add-form" style="display:none;">
            <div class="ds-form-header">
              <h3 id="aiFormTitle">Add Provider Key</h3>
              <button id="aiFormCancel" class="btn btn-ghost btn-sm">Cancel</button>
            </div>
            <div class="ds-form-body">
              <label>Provider</label>
              <select id="aiProviderSelect" class="settings-input">
                <option value="">Select provider...</option>
              </select>
              <label>API Key</label>
              <input type="password" id="aiKeyInput" class="settings-input" placeholder="sk-..." autocomplete="off" />
              <label>Diagnostics Model</label>
              <select id="aiDiagModel" class="settings-input"></select>
              <div id="aiAutofixSection" style="display:none;">
                <label>Auto-Fix Model</label>
                <select id="aiAutofixModel" class="settings-input"></select>
              </div>
              <div class="ds-form-actions">
                <button id="aiSaveBtn" class="btn btn-primary btn-sm">Save Key</button>
              </div>
            </div>
          </div>
          <button id="aiAddBtn" class="btn btn-ghost btn-sm" style="margin-top: 0.5rem;">
            <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 2v10M2 7h10"/></svg>
            Add Provider
          </button>
          <div id="aiStatus" class="backup-status"></div>
        </section>

      <!-- Scanner Schedule -->
      <section class="section">
        <h2>Scanner Schedule</h2>
        <p class="section-desc">Control how often the scanner runs and what it discovers. The scanner polls this configuration automatically.</p>
        <div class="scanner-form">
          <div class="scanner-row">
            <label>
              <span>Frequency</span>
              <select id="scanInterval" class="settings-input">
                <option value="hourly">Hourly</option>
                <option value="daily" selected>Daily</option>
                <option value="weekly">Weekly</option>
              </select>
            </label>
            <label id="scanWeekdayLabel" style="display:none;">
              <span>Day</span>
              <select id="scanWeekday" class="settings-input">
                <option value="0">Sunday</option>
                <option value="1">Monday</option>
                <option value="2">Tuesday</option>
                <option value="3">Wednesday</option>
                <option value="4">Thursday</option>
                <option value="5">Friday</option>
                <option value="6">Saturday</option>
              </select>
            </label>
            <label id="scanTimeLabel">
              <span>Time</span>
              <div class="time-row">
                <input type="number" id="scanHour" min="0" max="23" value="3" class="settings-input time-input" />
                <span class="time-sep">:</span>
                <input type="number" id="scanMinute" min="0" max="59" value="0" class="settings-input time-input" />
              </div>
            </label>
          </div>
          <div class="scanner-modules">
            <span class="module-label">Modules</span>
            <label class="module-check"><input type="checkbox" id="modDocker" checked disabled /> Docker containers</label>
            <label class="module-check"><input type="checkbox" id="modMetrics" checked /> Resource metrics</label>
            <label class="module-check"><input type="checkbox" id="modNetwork" /> Network devices</label>
            <label class="module-check"><input type="checkbox" id="modDns" /> DNS &amp; services</label>
            <label class="module-check"><input type="checkbox" id="modAuth" /> Auth detection</label>
          </div>
          <label>
            <span>Subnets <span style="font-weight:400;color:var(--text-muted)">(leave empty for auto-detect)</span></span>
            <input type="text" id="scanSubnets" placeholder="e.g. 192.168.0.0/24, 10.0.0.0/24" class="settings-input" />
          </label>
          <div class="scanner-actions">
            <label class="scanner-toggle">
              <input type="checkbox" id="scanEnabled" checked />
              <span>Scanning enabled</span>
            </label>
            <button id="saveScannerBtn" class="btn btn-primary btn-sm">Save schedule</button>
          </div>
          <div id="scannerStatus" class="backup-status"></div>
        </div>
      </section>

      <!-- Windlass -->
      <section class="section">
        <h2>Windlass</h2>
        <p class="section-desc">Schedule-aware service management. StdOut syncs with your Windlass engine to keep the HUD and service registry current.</p>
        <div class="scanner-form">
          <label>
            <span>Endpoint URL</span>
            <input type="url" id="windlassEndpointUrl" placeholder="http://host.docker.internal:8116" class="settings-input mono" />
          </label>
          <label>
            <span>Sync interval</span>
            <select id="windlassSyncInterval" class="settings-input">
              <option value="30">Every 30 seconds</option>
              <option value="60" selected>Every minute</option>
              <option value="300">Every 5 minutes</option>
              <option value="600">Every 10 minutes</option>
              <option value="1800">Every 30 minutes</option>
            </select>
          </label>
          <div class="scanner-actions">
            <label class="scanner-toggle">
              <input type="checkbox" id="windlassEnabled" checked />
              <span>Enabled</span>
            </label>
            <button id="saveWindlassBtn" class="btn btn-primary btn-sm">Save</button>
          </div>
          <div id="windlassStatus" class="backup-status"></div>
        </div>
      </section>

      <!-- Data Sources -->
      <section class="section">
        <h2>Data Sources</h2>
        <p class="section-desc">Connect monitoring, security, and observability tools to enrich incidents and power the HUD.</p>
        <div id="dsList" class="backup-list">
          <div class="loading mono">Loading...</div>
        </div>
        <div id="dsRecommendations" class="backup-list"></div>
        <div class="ds-add-form" id="dsAddForm" style="display:none;">
          <div class="ds-form-header">
            <h3 id="dsFormTitle">Add Data Source</h3>
            <button id="dsFormCancel" class="btn btn-ghost btn-sm">Cancel</button>
          </div>
          <label>
            <span>Type</span>
            <select id="dsType" class="settings-input">
              <option value="influxdb">InfluxDB</option>
              <option value="prometheus">Prometheus</option>
              <option value="trivy">Trivy</option>
              <option value="uptime-kuma">Uptime Kuma</option>
              <option value="loki">Loki</option>
              <option value="graylog">Graylog</option>
              <option value="crowdsec">CrowdSec</option>
              <option value="pihole">Pi-hole</option>
            </select>
          </label>
          <label>
            <span>Name</span>
            <input type="text" id="dsName" placeholder="e.g. My InfluxDB" class="settings-input" />
          </label>
          <label>
            <span>URL</span>
            <input type="text" id="dsUrl" placeholder="http://localhost:8086" class="settings-input mono" />
          </label>
          <label id="dsTokenLabel">
            <span id="dsTokenLabelText">API Token</span>
            <input type="password" id="dsToken" placeholder="API token" class="settings-input mono" autocomplete="off" />
          </label>
          <div class="ds-row" id="dsGraylogFields" style="display:none;">
            <label style="flex:1;">
              <span>Username</span>
              <input type="text" id="dsUsername" placeholder="admin" class="settings-input mono" />
            </label>
            <label style="flex:1;">
              <span>Password</span>
              <input type="password" id="dsPassword" placeholder="Graylog password" class="settings-input mono" autocomplete="off" />
            </label>
          </div>
          <div class="ds-row" id="dsInfluxFields">
            <label style="flex:1;">
              <span>Organization</span>
              <input type="text" id="dsOrg" placeholder="e.g. seaynic-labs" class="settings-input mono" />
            </label>
            <label style="flex:1;">
              <span>Bucket</span>
              <input type="text" id="dsBucket" placeholder="e.g. telegraf" class="settings-input mono" />
            </label>
          </div>
          <div class="ds-actions">
            <button id="dsTestBtn" class="btn btn-ghost btn-sm">Test Connection</button>
            <button id="dsSaveBtn" class="btn btn-primary btn-sm">Save</button>
          </div>
          <div id="dsTestResult" class="backup-status"></div>
        </div>
        <div class="ds-bottom">
          <button id="dsAddBtn" class="btn btn-primary btn-sm">Add data source</button>
          <div id="dsStatus" class="backup-status"></div>
        </div>
      </section>

      <!-- API Tokens -->
      <section class="section">
        <h2>API Tokens</h2>
        <p class="section-desc">Tokens for the stack discovery scanner. The raw token is shown once at creation.</p>
        <div id="tokenList" class="backup-list">
          <div class="loading mono">Loading tokens...</div>
        </div>
        <div class="token-create">
          <input type="text" id="tokenNameInput" placeholder="Token name (e.g. Scanner)" class="token-input" />
          <button id="createTokenBtn" class="btn btn-primary btn-sm">Generate token</button>
        </div>
        <div id="tokenStatus" class="backup-status"></div>
        <div id="tokenReveal" class="token-reveal" style="display:none;">
          <p class="token-warning">Copy this token now — it won't be shown again.</p>
          <code id="tokenValue" class="token-value"></code>
          <div id="scannerCmd" class="scanner-cmd-block">
            <p class="scanner-cmd-label">Quick start — run this on your server:</p>
            <pre class="scanner-cmd-pre"><code id="scannerCmdValue"></code></pre>
          </div>
        </div>
      </section>

    </div><!-- /tab-integrations -->

    <!-- ── TAB 3: DATA ── -->
    <div id="tab-data" class="tab-panel" role="tabpanel">

      <!-- Backups -->
      <section class="section">
        <h2>Backups</h2>
        <p class="section-desc">Encrypted snapshots of your data. Up to 3 kept automatically.</p>
        <div id="backupList" class="backup-list">
          <div class="loading mono">Loading backups...</div>
        </div>
        <div class="backup-actions">
          <button id="createBackupBtn" class="btn btn-primary">Create backup now</button>
          <div id="backupStatus" class="backup-status"></div>
        </div>
      </section>

      <!-- Danger Zone -->
      <section class="section danger-zone">
        <h2>Danger Zone</h2>
        <p class="section-desc">These actions are irreversible.</p>
        <div class="danger-actions">
          <a href="/app/api/export" class="btn btn-ghost">Export all data (JSON)</a>
        </div>
        <div class="delete-zone">
          <p class="delete-warning">Deleting your account deactivates it immediately. Your data is kept for 14 days in case you need recovery (contact support). After 14 days, all data is permanently purged.</p>
          <label class="delete-confirm-label">
            <span>Type <strong>DELETE</strong> to confirm</span>
            <input type="text" id="deleteConfirmInput" placeholder="DELETE" class="settings-input" autocomplete="off" />
          </label>
          <button id="deleteAccountBtn" class="btn btn-danger" disabled>Delete account</button>
          <div id="deleteStatus" class="backup-status"></div>
        </div>
      </section>

    </div><!-- /tab-data -->

  </div>
</Layout>

<script>
  // ── Tab switching ──
  function initTabs() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.tab-panel');

    function showTab(tabId: string) {
      buttons.forEach(btn => {
        const active = btn.dataset.tab === tabId;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-selected', String(active));
      });
      panels.forEach(panel => {
        panel.classList.toggle('active', panel.id === `tab-${tabId}`);
      });
      history.replaceState(null, '', `${window.location.pathname}#${tabId}`);
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => showTab(btn.dataset.tab!));
    });

    const hash = window.location.hash.slice(1);
    const valid = ['account', 'integrations', 'data'];
    if (valid.includes(hash)) showTab(hash);
  }

  initTabs();

  // ── Team Management ──
  const teamList = document.getElementById('teamList');
  const inviteBtn = document.getElementById('inviteBtn');
  const teamStatus = document.getElementById('teamStatus');

  async function loadTeam() {
    if (!teamList) return;
    try {
      const res = await fetch('/app/api/team');
      const data = await res.json();
      if (!data.members || data.members.length === 0) {
        teamList.innerHTML = '<div class="team-empty">No team members yet. Invite someone below.</div>';
        return;
      }
      teamList.innerHTML = data.members
        .filter((m: any) => m.status !== 'revoked')
        .map((m: any) => `
          <div class="team-row">
            <div class="team-info">
              <span class="team-email">${m.email}</span>
              <span class="team-role-badge ${m.role}">${m.role}</span>
              ${m.status === 'pending' ? '<span class="team-role-badge pending">pending</span>' : ''}
            </div>
            <div class="team-actions">
              <select class="settings-input team-role-select" data-id="${m.id}" style="width:auto;padding:4px 8px;font-size:12px;">
                <option value="viewer" ${m.role === 'viewer' ? 'selected' : ''}>Viewer</option>
                <option value="editor" ${m.role === 'editor' ? 'selected' : ''}>Editor</option>
                <option value="admin" ${m.role === 'admin' ? 'selected' : ''}>Admin</option>
              </select>
              <button class="btn btn-sm team-remove-btn" data-id="${m.id}" style="color:var(--text-muted);font-size:11px;">Remove</button>
            </div>
          </div>
        `).join('');

