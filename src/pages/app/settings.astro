  // ── AI Providers (BYOK) ──
  let aiProvidersData: any[] = [];

  async function loadAIProviders() {
    const list = document.getElementById('aiProvidersList');
    if (!list) return;
    const res = await window.stdoutFetch('/app/api/settings/ai-providers');
    if (!res?.ok) { list.innerHTML = '<div class="empty-hint">Failed to load providers</div>'; return; }
    const { providers } = await res.json();
    aiProvidersData = providers;
    if (!providers || providers.length === 0) {
      list.innerHTML = '<div class="empty-hint">No AI providers available</div>';
      return;
    }
    list.innerHTML = providers.map((p: any) => {
      const stateLabel = p.state === 'certified' ? 'Certified' : p.state === 'beta' ? 'Beta' : p.state;
      const stateColor = p.state === 'certified' ? '#4ade80' : p.state === 'beta' ? '#F97316' : '#94a3b8';
      const saved = p.savedKey;
      if (!saved) {
        return `<div class="ai-provider-card">
          <div class="ai-provider-left">
            <span class="ai-provider-name">${p.name}</span>
            <span class="ai-provider-state" style="color:${stateColor};">${stateLabel}</span>
          </div>
          <span class="ai-provider-nokey">No key</span>
        </div>`;
      }
      const statusColor = saved.status === 'active' ? 'var(--low)' : 'var(--high)';
      const validatedText = saved.lastValidatedAt
        ? new Date(saved.lastValidatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
        : 'never';
      return `<div class="ai-provider-card has-key">
        <div class="ai-provider-header">
          <div class="ai-provider-title">
            <span class="ai-provider-name">${p.name}</span>
            <span class="ai-provider-state" style="color:${stateColor};">${stateLabel}</span>
          </div>
          <div class="ai-provider-actions">
            <button class="btn btn-ghost btn-sm ai-validate-btn" data-provider="${p.id}">Test</button>
            <button class="btn btn-ghost btn-sm ai-delete-btn" data-key-id="${saved.id}" data-provider="${p.name}">Delete</button>
          </div>
        </div>
        <div class="ai-provider-meta">
          <span class="ai-provider-status" style="color:${statusColor};">${saved.status}</span>
          <code class="ai-provider-fingerprint">${saved.keyFingerprint}</code>
          <span class="ai-provider-validated">Validated ${validatedText}</span>
        </div>
      </div>`;
    }).join('');

    document.querySelectorAll('.ai-validate-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const provider = (btn as HTMLElement).dataset.provider;
        (btn as HTMLElement).textContent = 'Testing...';
        const res = await window.stdoutFetch('/app/api/settings/ai-providers', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'validate', provider }),
        });
        const data = await res?.json();
        const statusEl = document.getElementById('aiStatus');
        if (data?.valid) {
          if (statusEl) { statusEl.textContent = `${provider} key validated successfully`; statusEl.style.color = 'var(--low)'; }
        } else {
          if (statusEl) { statusEl.textContent = `Validation failed: ${data?.error || 'unknown error'}`; statusEl.style.color = 'var(--high)'; }
        }
        loadAIProviders();
      });
    });

    document.querySelectorAll('.ai-delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const keyId = (btn as HTMLElement).dataset.keyId;
        const name = (btn as HTMLElement).dataset.provider;
        if (!confirm(`Delete ${name} API key? Diagnostics will fall back to platform key.`)) return;
        await window.stdoutFetch('/app/api/settings/ai-providers', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete', keyId }),
        });
        loadAIProviders();
      });
    });
  }

  const aiAddBtn = document.getElementById('aiAddBtn');
  const aiForm = document.getElementById('aiProviderForm');
  const aiFormCancel = document.getElementById('aiFormCancel');
  const aiProviderSelect = document.getElementById('aiProviderSelect') as HTMLSelectElement | null;
  const aiDiagModel = document.getElementById('aiDiagModel') as HTMLSelectElement | null;
  const aiAutofixModel = document.getElementById('aiAutofixModel') as HTMLSelectElement | null;
  const aiAutofixSection = document.getElementById('aiAutofixSection');
  const aiSaveBtn = document.getElementById('aiSaveBtn');

  aiAddBtn?.addEventListener('click', () => {
    if (aiForm) aiForm.style.display = 'block';
    if (aiAddBtn) aiAddBtn.style.display = 'none';
    if (aiProviderSelect) {
      aiProviderSelect.innerHTML = '<option value="">Select provider...</option>';
