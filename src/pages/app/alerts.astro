---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { requireLicense } from '../../lib/license';
import { getAlertRoutes, getRecentAlerts } from '../../lib/alerts/alert-router';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

// License check
const licenseCheck = requireLicense();
if (!licenseCheck.valid) {
  return Astro.redirect('/app/settings?error=' + encodeURIComponent(licenseCheck.message));
}

// Get alert routes and recent alerts
const routes = getAlertRoutes(user.id);
const recentAlerts = getRecentAlerts(user.id, 20);
---
<Layout title="Alerts — StdOut">
  <div class="alerts-page">
    <div class="page-header">
      <div>
        <h1>Alert Routing</h1>
        <p class="subtitle">Configure how StdOut sends alerts to your team</p>
      </div>
      <div class="header-actions">
        <button id="addRouteBtn" class="btn-glass btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          Add Route
        </button>
      </div>
    </div>

    <div class="alerts-grid">
      <!-- Alert Routes -->
      <div class="routes-section">
        <h2>Alert Routes</h2>

        {routes.length === 0 ? (
          <div class="empty-card">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
            </svg>
            <h3>No Alert Routes</h3>
            <p>Add your first alert route to start receiving notifications from StdOut.</p>
            <button class="btn-glass btn-primary" onclick="document.getElementById('addRouteBtn').click()">
              Add Route
            </button>
          </div>
        ) : (
          <div class="routes-list">
            {routes.map(route => (
              <div class="route-card" data-route-id={route.id}>
                <div class="route-header">
                  <div class="route-icon" data-type={route.type}>
                    {route.type === 'slack' && (
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M6 15a2 2 0 01-2 2 2 2 0 01-2-2 2 2 0 012-2h2v2zm1 0a2 2 0 012-2 2 2 0 012 2v5a2 2 0 01-2 2 2 2 0 01-2-2v-5zM9 6a2 2 0 01-2-2 2 2 0 012-2 2 2 0 012 2v2H9zm0 1a2 2 0 012 2 2 2 0 01-2 2H4a2 2 0 01-2-2 2 2 0 012-2h5zm9 2a2 2 0 012 2 2 2 0 01-2 2 2 2 0 01-2-2V9h2zm-1 0V4a2 2 0 012-2 2 2 0 012 2 2 2 0 01-2 2h-2zm-2 9a2 2 0 01-2 2 2 2 0 01-2-2 2 2 0 012-2h2v2zm1 0a2 2 0 012-2 2 2 0 012 2v5a2 2 0 01-2 2 2 2 0 01-2-2v-5z"/>
                      </svg>
                    )}
                    {route.type === 'webhook' && (
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/>
                        <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/>
                      </svg>
                    )}
                    {route.type === 'discord' && (
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03z"/>
                      </svg>
                    )}
                  </div>
                  <div class="route-info">
                    <div class="route-name">{route.name}</div>
                    <div class="route-meta">
                      {route.type === 'slack' && `Slack: ${(route.config as any).channel || 'Default channel'}`}
                      {route.type === 'webhook' && `Webhook: ${(route.config as any).url?.slice(0, 40)}...`}
                      {route.type === 'discord' && `Discord: ${(route.config as any).username || 'StdOut'}`}
                    </div>
                  </div>
                  <div class="route-status">
                    <label class="toggle">
                      <input type="checkbox" class="route-toggle" data-route-id={route.id} checked={route.enabled} />
                      <span class="toggle-slider"></span>
                    </label>
                  </div>
                </div>
                <div class="route-config">
                  <div class="config-row">
                    <span class="config-label">Min Severity:</span>
                    <span class="config-value severity-{route.min_severity}">{route.min_severity}</span>
                  </div>
                  <div class="config-row">
                    <span class="config-label">Type:</span>
                    <span class="config-value">{route.type}</span>
                  </div>
                  <div class="config-row">
                    <span class="config-label">Status:</span>
                    <span class="config-value">{route.enabled ? 'Enabled' : 'Disabled'}</span>
                  </div>
                </div>
                <div class="route-actions">
                  <button class="btn-sm btn-glass edit-route-btn" data-route-id={route.id}>Edit</button>
                  <button class="btn-sm btn-glass btn-danger delete-route-btn" data-route-id={route.id}>Delete</button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Recent Alerts -->
      <div class="history-section">
        <h2>Recent Alerts</h2>

        {recentAlerts.length === 0 ? (
          <div class="empty-card small">
            <p>No alerts sent yet. Riggins will send alerts here when issues are detected.</p>
          </div>
        ) : (
          <div class="alerts-list">
            {recentAlerts.map(alert => (
              <div class="alert-item severity-{alert.severity}">
                <div class="alert-indicator"></div>
                <div class="alert-content">
                  <div class="alert-title">{alert.title}</div>
                  <div class="alert-message">{alert.message}</div>
                  <div class="alert-meta">
                    <span>{alert.source}</span>
                    <span>{new Date(alert.created_at).toLocaleString()}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>

  <style>
    .alerts-page {
      padding: 2rem;
      max-width: 1400px;
      margin: 0 auto;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 2rem;
    }

    .page-header h1 {
      margin: 0 0 0.5rem 0;
      font-size: 2rem;
      font-weight: 700;
    }

    .subtitle {
      margin: 0;
      color: rgba(255,255,255,0.6);
    }

    .alerts-grid {
      display: grid;
      grid-template-columns: 1fr 400px;
      gap: 2rem;
    }

    @media (max-width: 1024px) {
      .alerts-grid {
        grid-template-columns: 1fr;
      }
    }

    .routes-section h2,
    .history-section h2 {
      margin: 0 0 1rem 0;
      font-size: 1.25rem;
      font-weight: 600;
    }

    .routes-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .route-card {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      padding: 1.5rem;
    }

    .route-header {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
      margin-bottom: 1rem;
    }

    .route-icon {
      width: 40px;
      height: 40px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .route-icon[data-type="slack"] {
      background: rgba(74, 21, 75, 0.3);
      color: #E01E5A;
    }

    .route-icon[data-type="webhook"] {
      background: rgba(33, 150, 243, 0.2);
      color: #2196F3;
    }

    .route-icon[data-type="discord"] {
      background: rgba(88, 101, 242, 0.2);
      color: #5865F2;
    }

    .route-info {
      flex: 1;
      min-width: 0;
    }

    .route-name {
      font-weight: 600;
      font-size: 1.125rem;
      margin-bottom: 0.25rem;
    }

    .route-meta {
      font-size: 0.875rem;
      color: rgba(255,255,255,0.6);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .route-config {
      margin: 1rem 0;
      padding: 1rem;
      background: rgba(0,0,0,0.2);
      border-radius: 8px;
    }

    .config-row {
      display: flex;
      justify-content: space-between;
      padding: 0.5rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .config-row:last-child {
      border-bottom: none;
    }

    .config-label {
      color: rgba(255,255,255,0.6);
      font-size: 0.875rem;
    }

    .config-value {
      font-size: 0.875rem;
    }

    .config-value.severity-critical { color: #F44336; font-weight: 600; }
    .config-value.severity-high { color: #FF9800; font-weight: 600; }
    .config-value.severity-medium { color: #FFEB3B; font-weight: 600; }
    .config-value.severity-low { color: #4CAF50; font-weight: 600; }

    .route-actions {
      display: flex;
      gap: 0.5rem;
    }

    .btn-sm {
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
    }

    .btn-danger {
      color: #F44336;
    }

    .btn-danger:hover {
      background: rgba(244, 67, 54, 0.1);
    }

    .toggle {
      position: relative;
      display: inline-block;
      width: 48px;
      height: 24px;
    }

    .toggle input {
      opacity: 0;
      width: 0;
      height: 0;
    }

    .toggle-slider {
      position: absolute;
      cursor: pointer;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(255,255,255,0.2);
      transition: 0.3s;
      border-radius: 24px;
    }

    .toggle-slider:before {
      position: absolute;
      content: "";
      height: 18px;
      width: 18px;
      left: 3px;
      bottom: 3px;
      background-color: white;
      transition: 0.3s;
      border-radius: 50%;
    }

    .toggle input:checked + .toggle-slider {
      background-color: #4CAF50;
    }

    .toggle input:checked + .toggle-slider:before {
      transform: translateX(24px);
    }

    .alerts-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .alert-item {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      padding: 1rem;
      display: flex;
      gap: 1rem;
      position: relative;
    }

    .alert-indicator {
      width: 4px;
      border-radius: 2px;
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
    }

    .alert-item.severity-critical .alert-indicator {
      background: #F44336;
    }

    .alert-item.severity-high .alert-indicator {
      background: #FF9800;
    }

    .alert-item.severity-medium .alert-indicator {
      background: #FFEB3B;
    }

    .alert-item.severity-low .alert-indicator {
      background: #4CAF50;
    }

    .alert-content {
      flex: 1;
      padding-left: 1rem;
    }

    .alert-title {
      font-weight: 600;
      margin-bottom: 0.25rem;
    }

    .alert-message {
      font-size: 0.875rem;
      color: rgba(255,255,255,0.8);
      margin-bottom: 0.5rem;
    }

    .alert-meta {
      font-size: 0.75rem;
      color: rgba(255,255,255,0.5);
      display: flex;
      gap: 1rem;
    }

    .empty-card {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      padding: 3rem 2rem;
      text-align: center;
      color: rgba(255,255,255,0.6);
    }

    .empty-card.small {
      padding: 2rem;
    }

    .empty-card svg {
      opacity: 0.3;
      margin-bottom: 1rem;
    }

    .empty-card h3 {
      margin: 1rem 0 0.5rem 0;
      color: rgba(255,255,255,0.8);
    }

    .empty-card p {
      margin: 0 0 2rem 0;
    }
  </style>

  <script>
    // Add route button
    document.getElementById('addRouteBtn')?.addEventListener('click', () => {
      const type = prompt('Route type (slack/webhook/discord):');
      if (!type || !['slack', 'webhook', 'discord'].includes(type)) {
        alert('Invalid route type. Must be: slack, webhook, or discord');
        return;
      }

      const name = prompt('Route name (e.g., "Critical Alerts → Slack"):');
      if (!name) return;

      const severity = prompt('Min severity (critical/high/medium/low):', 'medium');
      if (!severity || !['critical', 'high', 'medium', 'low'].includes(severity)) {
        alert('Invalid severity. Must be: critical, high, medium, or low');
        return;
      }

      let config: any = {};

      if (type === 'slack') {
        const webhookUrl = prompt('Slack webhook URL:');
        if (!webhookUrl) return;
        config = { webhook_url: webhookUrl, channel: prompt('Channel (optional):') || undefined };
      } else if (type === 'webhook') {
        const url = prompt('Webhook URL:');
        if (!url) return;
        config = { url, method: 'POST' };
      } else if (type === 'discord') {
        const webhookUrl = prompt('Discord webhook URL:');
        if (!webhookUrl) return;
        config = { webhook_url: webhookUrl };
      }

      // Send to API (TODO: implement API endpoint)
      alert('Alert route creation API coming soon. Route config:\n\n' + JSON.stringify({ name, type, config, min_severity: severity }, null, 2));
    });

    // Toggle route enabled/disabled
    document.querySelectorAll('.route-toggle').forEach(toggle => {
      toggle.addEventListener('change', async (e) => {
        const routeId = (e.target as HTMLElement).getAttribute('data-route-id');
        const enabled = (e.target as HTMLInputElement).checked;

        // TODO: Call API to update route
        console.log(`Route ${routeId} ${enabled ? 'enabled' : 'disabled'}`);
      });
    });

    // Edit route
    document.querySelectorAll('.edit-route-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const routeId = (e.target as HTMLElement).getAttribute('data-route-id');
        alert(`Edit route UI coming soon for route: ${routeId}`);
      });
    });

    // Delete route
    document.querySelectorAll('.delete-route-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const routeId = (e.target as HTMLElement).getAttribute('data-route-id');
        if (!confirm('Delete this alert route?')) return;

        // TODO: Call API to delete route
        alert(`Delete route API coming soon for route: ${routeId}`);
      });
    });
  </script>
</Layout>
