    width: 16px;
    text-align: center;
    flex-shrink: 0;
  }
  .sidebar-doc-title {
    font-size: 12px;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sidebar-doc:hover .sidebar-doc-title {
    color: var(--text);
  }
  .sidebar-empty {
    font-size: 12px;
    color: var(--text-muted);
    padding: 4px 8px;
  }
  .sidebar-viewall {
    display: block;
    padding: 12px 16px;
    font-size: 12px;
    font-weight: 600;
    color: var(--accent-light);
    text-decoration: none;
    text-align: center;
    border-top: 1px solid var(--border);
    transition: all 0.15s ease;
  }
  .sidebar-viewall:hover {
