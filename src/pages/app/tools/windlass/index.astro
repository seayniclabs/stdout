---
export const prerender = false;
import Layout from '../../../../layouts/Layout.astro';
import { getAllServices, getConfig, getRecentEvents, getServiceSummary } from '../../../../lib/windlass';
import { requireLicense } from '../../../../lib/license';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

// License check
const licenseCheck = requireLicense();
if (!licenseCheck.valid) {
  return Astro.redirect('/app/settings?error=' + encodeURIComponent(licenseCheck.message));
}

const userId = Astro.locals.workspace?.ownerId || user.id;
const config = getConfig(userId);
const services = getAllServices(userId);
const summary = getServiceSummary(userId);
const events = getRecentEvents(userId, 20);
const suggestionServices = services.filter(s => s.schedulingSuggestion);
const estimatedRecoveredGbHours = services.reduce((sum, s) => {
  if (!s.memoryMb || !s.usageAnalytics) return sum;
  try {
    const analytics = JSON.parse(s.usageAnalytics);
    const idleMinutes = analytics?.idle_minutes_total || 0;
    return sum + ((s.memoryMb / 1024) * (idleMinutes / 60));
  } catch {
    return sum;
  }
}, 0);

// Group services by classification
const groups = {
  always_on: services.filter(s => s.classification === 'always_on'),
  scheduled: services.filter(s => s.classification === 'scheduled'),
  on_demand: services.filter(s => s.classification === 'on_demand'),
  manual: services.filter(s => s.classification === 'manual'),
};

function timeAgo(date: Date | null) {
  if (!date) return 'never';
  const ms = Date.now() - new Date(date).getTime();
  const mins = Math.floor(ms / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  const days = Math.floor(hrs / 24);
  return `${days}d ago`;
}

const classLabels: Record<string, string> = {
  always_on: 'Always On',
  scheduled: 'Scheduled',
  on_demand: 'On-Demand',
  manual: 'Manual',
};

const serviceTypeLabels: Record<string, string> = {
  always: 'Always',
  schedule: 'Schedule',
  'on-demand': 'On-demand',
  manual: 'Manual',
};

const stateColors: Record<string, string> = {
  running: 'var(--low)',
  stopped: 'var(--muted)',
  partial: '#F97316',
  error: 'var(--high)',
  unknown: 'var(--muted)',
  starting: '#60A5FA',
  stopping: '#F97316',
};
---
<Layout title="Windlass — StdOut">
  <div class="windlass-page">
    <div class="windlass-header">
      <div class="windlass-header-left">
        <h1>Windlass</h1>
        <p class="page-subtitle">Schedule-aware service management. See what's running, what should be, and control it all from here.</p>
      </div>
      <div class="windlass-actions">
        <a href="/app/tools/windlass/alerts" class="btn btn-ghost btn-sm">Alerts</a>
        <a href="/app/tools/windlass/timeline" class="btn btn-ghost btn-sm">Timeline</a>
        <button id="syncBtn" class="btn btn-primary btn-sm">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
          Sync
        </button>
      </div>
    </div>

    {!config ? (
      <div class="empty-state">
        <div class="empty-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h3>Connect Windlass</h3>
        <p>Windlass is StdOut's schedule-aware container manager. Define when services should run, and Windlass handles the rest — starting, stopping, and only alerting you during runtime windows.</p>

        <div class="setup-steps">
          <div class="setup-step">
            <span class="step-num">1</span>
            <div class="step-content">
              <strong>Install the engine</strong>
              <p>Download the Windlass engine and configure your services in <code>schedule.yaml</code>.</p>
            </div>
          </div>
          <div class="setup-step">
            <span class="step-num">2</span>
            <div class="step-content">
              <strong>Start the status server</strong>
              <p>Run <code>windlass --serve --port 8116</code> on your Docker host.</p>
            </div>
          </div>
          <div class="setup-step">
            <span class="step-num">3</span>
            <div class="step-content">
              <strong>Connect below</strong>
              <p>Enter the endpoint URL and StdOut will sync your service registry.</p>
            </div>
          </div>
        </div>

        <div class="setup-form" id="setupForm">
          <label class="form-label">Windlass Endpoint URL</label>
          <div class="form-row">
            <input type="url" id="endpointUrl" placeholder="http://localhost:8116" class="form-input" />
            <button id="connectBtn" class="btn btn-primary">Connect</button>
          </div>
          <p class="form-hint">The URL where your Windlass status server is running. Default: <code>http://localhost:8116</code></p>
        </div>

        <div class="docs-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          <a href="/app/docs">Read the full Windlass setup guide</a> in the Knowledge Base for installation details, schedule.yaml format, and troubleshooting.
        </div>
      </div>
    ) : services.length === 0 ? (
      <div class="empty-state">
        <div class="empty-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h3>No services synced yet</h3>
        <p>Connected to <code>{config.endpointUrl}</code>. Click Sync to pull in your service registry.</p>
        <button id="firstSyncBtn" class="btn btn-primary">Sync now</button>
        {config.lastSyncStatus && config.lastSyncStatus !== 'ok' && (
          <p class="sync-error">Last sync failed: {config.lastSyncStatus}</p>
        )}
      </div>
    ) : (
      <Fragment>
        {/* Summary gauges */}
        <div class="windlass-gauges">
          <div class="wl-gauge">
            <span class="wl-gauge-value" style="color: var(--low)">{summary.running}</span>
            <span class="wl-gauge-label">Running</span>
          </div>
          <div class="wl-gauge">
            <span class="wl-gauge-value" style="color: var(--muted)">{summary.stopped}</span>
            <span class="wl-gauge-label">Stopped</span>
          </div>
          <div class="wl-gauge">
            <span class="wl-gauge-value" style="color: #60A5FA">{summary.scheduled}</span>
            <span class="wl-gauge-label">Scheduled</span>
          </div>
          <div class="wl-gauge">
            <span class="wl-gauge-value" style="color: #F97316">{summary.totalMemory.toLocaleString()}</span>
            <span class="wl-gauge-label">MB Used</span>
          </div>
          <div class="wl-gauge">
            <span class="wl-gauge-value">{summary.total}</span>
            <span class="wl-gauge-label">Total</span>
          </div>
        </div>

        {config.lastSyncAt && (
          <div class="sync-status">
            Last synced: <span class="mono">{timeAgo(config.lastSyncAt)}</span>
            {config.lastSyncStatus && config.lastSyncStatus !== 'ok' && (
              <span class="sync-error"> — {config.lastSyncStatus}</span>
            )}
          </div>
        )}

        <div class="sync-status">
          Weekly savings estimate: <span class="mono">{estimatedRecoveredGbHours.toFixed(2)} GB-hours recovered</span>
          {suggestionServices.length > 0 && (
            <span class="sync-error"> — {suggestionServices.length} services idle 18h+/day (suggest scheduling)</span>
          )}
        </div>

        {/* Service groups */}
        {Object.entries(groups).map(([classification, svcList]) => svcList.length > 0 && (
          <div class="service-group">
            <h2 class="group-title">{classLabels[classification]} <span class="group-count">{svcList.length}</span></h2>
            <div class="service-grid">
              {svcList.map(svc => (
                <a href={`/app/tools/windlass/services/${svc.id}`} class="service-card">
                  <div class="service-card-header">
                    <span class="service-state-dot" style={`background: ${stateColors[svc.currentState] || 'var(--muted)'}`}></span>
                    <span class="service-name">{svc.name}</span>
                    <span class="service-type-badge">{serviceTypeLabels[svc.serviceType || 'manual'] || (svc.serviceType || 'manual')}</span>
                    {svc.currentState !== svc.expectedState && svc.classification !== 'manual' && (
                      <span class="state-mismatch" title={`Expected: ${svc.expectedState}, Actual: ${svc.currentState}`}>!</span>
                    )}
                  </div>
                  <div class="service-card-body">
                    <div class="service-meta">
                      <span class="meta-item">
                        <span class="meta-label">State</span>
                        <span class={`meta-value state-${svc.currentState}`}>{svc.currentState}</span>
                      </span>
                      {svc.memoryMb && svc.currentState === 'running' && (
                        <span class="meta-item">
                          <span class="meta-label">Memory</span>
                          <span class="meta-value mono">{svc.memoryMb} MB</span>
                        </span>
                      )}
                      {svc.containerCount && (
                        <span class="meta-item">
                          <span class="meta-label">Containers</span>
                          <span class="meta-value mono">{svc.containerCount}</span>
                        </span>
                      )}
                    </div>
                    {svc.runtimeWindowStart && svc.runtimeWindowEnd && (
                      <div class="service-schedule">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        {svc.runtimeWindowStart} — {svc.runtimeWindowEnd}
                      </div>
                    )}
                    {svc.description && (
                      <p class="service-desc">{svc.description}</p>
                    )}
                    {svc.schedulingSuggestion && (
                      <div class="schedule-suggestion-banner">
                        <span>{svc.schedulingSuggestion}</span>
                        <button
                          type="button"
                          class="btn btn-sm btn-ghost suggest-schedule-btn"
                          data-service-id={svc.id}
                          data-service-name={svc.name}
                          data-current-start={svc.runtimeWindowStart || ''}
                          data-current-end={svc.runtimeWindowEnd || ''}
                        >
                          Suggest schedule
                        </button>
                      </div>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}

        {/* Recent events */}
        {events.length > 0 && (
          <div class="events-section">
            <h2>Recent Events</h2>
            <div class="events-table">
              <table>
                <thead>
                  <tr>
                    <th>Time</th>
                    <th>Service</th>
                    <th>Event</th>
                    <th>Detail</th>
                  </tr>
                </thead>
                <tbody>
                  {events.map(evt => (
                    <tr>
                      <td class="mono">{timeAgo(evt.createdAt)}</td>
                      <td>{evt.serviceId || '—'}</td>
                      <td><span class={`event-badge event-${evt.eventType}`}>{evt.eventType.replace(/_/g, ' ')}</span></td>
                      <td class="event-detail">{evt.detail || ''}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </Fragment>
    )}
  </div>

  <div id="scheduleEditorDialog" class="schedule-editor-dialog" style="display:none;">
    <div class="schedule-editor-body">
      <h3>Suggest Schedule</h3>
      <p id="scheduleEditorServiceName">Set runtime window</p>
      <div class="schedule-editor-grid">
        <label class="form-label" for="scheduleStart">Start</label>
        <input type="time" id="scheduleStart" class="form-input" value="08:00" />
        <label class="form-label" for="scheduleEnd">End</label>
        <input type="time" id="scheduleEnd" class="form-input" value="20:00" />
      </div>
      <div class="schedule-editor-actions">
        <button type="button" id="scheduleCancelBtn" class="btn btn-ghost btn-sm">Cancel</button>
        <button type="button" id="scheduleSaveBtn" class="btn btn-primary btn-sm">Apply</button>
      </div>
    </div>
  </div>

  <style>
    .windlass-page { max-width: 1200px; margin: 0 auto; padding: 1.5rem; }
    .windlass-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; }
    .windlass-header h1 { font-size: 2rem; margin: 0; font-weight: 700; background: linear-gradient(135deg, var(--text) 0%, var(--accent) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .page-subtitle { color: var(--text-secondary); margin: 0.5rem 0 0; font-size: 0.95rem; line-height: 1.5; max-width: 600px; }
    .windlass-actions { display: flex; gap: 0.5rem; align-items: center; }

    /* Gauges */
    .windlass-gauges { display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; }
    .wl-gauge {
      background: rgba(26, 26, 36, 0.6);
      backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid rgba(249, 115, 22, 0.15);
      border-radius: 12px;
      padding: 1.25rem 1.75rem;
      text-align: center;
      flex: 1;
      min-width: 120px;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    .wl-gauge::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--accent), transparent);
      opacity: 0;
      transition: opacity 0.2s;
    }
    .wl-gauge:hover {
      transform: translateY(-2px) scale(1.02);
      border-color: rgba(249, 115, 22, 0.4);
      box-shadow: 0 8px 24px rgba(249, 115, 22, 0.15);
    }
    .wl-gauge:hover::before {
      opacity: 1;
    }
    .wl-gauge-value { display: block; font-size: 2.2rem; font-weight: 700; font-family: var(--font-mono); line-height: 1.2; letter-spacing: -0.02em; }
    .wl-gauge-label { display: block; font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 0.5rem; font-weight: 600; }

    /* Sync status */
    .sync-status { font-size: 0.8rem; color: var(--muted); margin-bottom: 1.5rem; }
    .sync-error { color: var(--high); }

    /* Service groups */
    .service-group { margin-bottom: 2rem; }
    .group-title { font-size: 1rem; color: var(--text); margin: 0 0 0.75rem; display: flex; align-items: center; gap: 0.5rem; }
    .group-count { background: var(--border); color: var(--muted); font-size: 0.7rem; padding: 0.1rem 0.5rem; border-radius: 10px; font-weight: 600; }

    .service-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0.75rem; }

    .service-card {
      display: block;
      background: rgba(26, 26, 36, 0.4);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 10px;
      padding: 1rem 1.25rem;
      text-decoration: none;
      color: var(--text);
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
    }
    .service-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 10px;
      padding: 1px;
      background: linear-gradient(135deg, transparent, rgba(249, 115, 22, 0.2));
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0;
      transition: opacity 0.2s;
    }
    .service-card:hover {
      transform: translateY(-2px) scale(1.01);
      border-color: rgba(249, 115, 22, 0.3);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3), 0 0 40px rgba(249, 115, 22, 0.1);
    }
    .service-card:hover::before {
      opacity: 1;
    }

    .service-card-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; }
    .service-state-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .service-name { font-weight: 600; font-size: 0.9rem; }
    .service-type-badge {
      margin-left: auto;
      font-size: 0.65rem;
      padding: 0.1rem 0.4rem;
      border-radius: 999px;
      border: 1px solid var(--border);
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .state-mismatch { background: var(--high); color: white; font-size: 0.65rem; font-weight: 700; width: 16px; height: 16px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-left: auto; }

    .service-meta { display: flex; gap: 1rem; flex-wrap: wrap; }
    .meta-item { display: flex; flex-direction: column; }
    .meta-label { font-size: 0.65rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.03em; }
    .meta-value { font-size: 0.8rem; font-weight: 500; }
    .state-running { color: var(--low); }
    .state-stopped { color: var(--muted); }
    .state-partial { color: #F97316; }
    .state-error { color: var(--high); }

    .service-schedule { display: flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; color: var(--muted); margin-top: 0.5rem; font-family: var(--font-mono); }
    .service-desc { font-size: 0.75rem; color: var(--muted); margin: 0.35rem 0 0; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .schedule-suggestion-banner {
      margin-top: 0.6rem;
      padding: 0.5rem 0.6rem;
      border-radius: 6px;
      border: 1px solid rgba(250, 204, 21, 0.35);
      background: rgba(250, 204, 21, 0.13);
      color: #facc15;
      font-size: 0.75rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
    }
    .suggest-schedule-btn { color: #facc15; border-color: rgba(250, 204, 21, 0.3); font-size: 0.7rem; }

    .schedule-editor-dialog {
      position: fixed;
      inset: 0;
      z-index: 1000;
      background: rgba(0, 0, 0, 0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }
    .schedule-editor-body {
      width: min(420px, 100%);
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1rem;
    }
    .schedule-editor-body h3 { margin: 0 0 0.25rem; font-size: 0.95rem; }
    .schedule-editor-body p { margin: 0 0 0.75rem; font-size: 0.8rem; color: var(--muted); }
    .schedule-editor-grid {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.5rem;
      align-items: center;
    }
    .schedule-editor-actions {
      margin-top: 0.9rem;
      display: flex;
      justify-content: flex-end;
      gap: 0.5rem;
    }

    /* Events */
    .events-section { margin-top: 2rem; }
    .events-section h2 { font-size: 1rem; margin: 0 0 0.75rem; }
    .events-table { overflow-x: auto; }
    .events-table table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
    .events-table th { text-align: left; padding: 0.4rem 0.75rem; border-bottom: 1px solid var(--border); color: var(--muted); font-weight: 600; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.03em; }
    .events-table td { padding: 0.4rem 0.75rem; border-bottom: 1px solid var(--border); }
    .event-badge { font-size: 0.7rem; padding: 0.15rem 0.4rem; border-radius: 4px; background: var(--border); white-space: nowrap; }
    .event-badge.event-service_started, .event-badge.event-manual_start { background: rgba(74, 222, 128, 0.15); color: var(--low); }
    .event-badge.event-service_stopped, .event-badge.event-manual_stop, .event-badge.event-schedule_stop { background: rgba(148, 163, 184, 0.15); color: var(--muted); }
    .event-badge.event-service_crashed { background: rgba(239, 68, 68, 0.15); color: var(--high); }
    .event-badge.event-sync_completed { background: rgba(96, 165, 250, 0.15); color: #60A5FA; }
    .event-detail { color: var(--muted); max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* Empty / setup state */
    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      background: rgba(26, 26, 36, 0.4);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 16px;
      max-width: 700px;
      margin: 2rem auto;
    }
    .empty-icon {
      margin-bottom: 1.5rem;
      opacity: 0.6;
    }
    .empty-state h3 {
      margin: 0 0 0.75rem;
      font-size: 1.5rem;
      font-weight: 600;
    }
    .empty-state p {
      color: var(--text-secondary);
      max-width: 550px;
      margin: 0 auto 2rem;
      font-size: 0.95rem;
      line-height: 1.6;
    }

    /* Setup steps */
    .setup-steps { display: flex; flex-direction: column; gap: 1rem; max-width: 520px; margin: 2rem auto; text-align: left; }
    .setup-step {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
      padding: 1rem;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.04);
      border-radius: 8px;
      transition: all 0.2s;
    }
    .setup-step:hover {
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(249, 115, 22, 0.2);
    }
    .step-num {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 100%);
      color: white;
      font-size: 0.9rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(249, 115, 22, 0.3);
    }
    .step-content strong { display: block; font-size: 0.95rem; margin-bottom: 0.35rem; font-weight: 600; }
    .step-content p { font-size: 0.85rem; color: var(--text-secondary); margin: 0; line-height: 1.5; }
    .step-content code {
      background: rgba(255, 255, 255, 0.06);
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 0.8rem;
      font-family: var(--font-mono);
      color: var(--accent);
      border: 1px solid rgba(255, 255, 255, 0.04);
    }

    .docs-link { display: flex; align-items: center; gap: 0.5rem; justify-content: center; margin-top: 1.5rem; font-size: 0.8rem; color: var(--muted); }
    .docs-link a { color: var(--accent, #F97316); }

    .setup-form { max-width: 450px; margin: 1.5rem auto 0; text-align: left; }
    .form-label { display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.35rem; }
    .form-row { display: flex; gap: 0.5rem; }
    .form-input { flex: 1; padding: 0.5rem 0.75rem; border: 1px solid var(--border); border-radius: 6px; background: var(--bg); color: var(--text); font-size: 0.85rem; font-family: var(--font-mono); }
    .form-hint { font-size: 0.75rem; color: var(--muted); margin-top: 0.5rem; }

    .mono { font-family: var(--font-mono); }

    @media (max-width: 640px) {
      .windlass-header { flex-direction: column; }
      .windlass-gauges { flex-wrap: wrap; }
      .wl-gauge { min-width: 80px; padding: 0.75rem; }
      .service-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    let selectedServiceId = '';
    const scheduleDialog = document.getElementById('scheduleEditorDialog');
    const scheduleStart = document.getElementById('scheduleStart') as HTMLInputElement | null;
    const scheduleEnd = document.getElementById('scheduleEnd') as HTMLInputElement | null;
    const scheduleServiceName = document.getElementById('scheduleEditorServiceName');

    document.querySelectorAll('.suggest-schedule-btn').forEach(btn => {
      btn.addEventListener('click', (evt) => {
        evt.preventDefault();
        evt.stopPropagation();
        const el = btn as HTMLElement;
        selectedServiceId = el.dataset.serviceId || '';
        const name = el.dataset.serviceName || 'Service';
        if (scheduleServiceName) scheduleServiceName.textContent = `${name}: set runtime window`;
        if (scheduleStart) scheduleStart.value = el.dataset.currentStart || '08:00';
        if (scheduleEnd) scheduleEnd.value = el.dataset.currentEnd || '20:00';
        if (scheduleDialog) scheduleDialog.style.display = 'flex';
      });
    });

    document.getElementById('scheduleCancelBtn')?.addEventListener('click', () => {
      if (scheduleDialog) scheduleDialog.style.display = 'none';
      selectedServiceId = '';
    });

    document.getElementById('scheduleSaveBtn')?.addEventListener('click', async () => {
      if (!selectedServiceId || !scheduleStart?.value || !scheduleEnd?.value) return;
      const res = await window.stdoutFetch('/app/api/windlass/services', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'suggest_schedule',
          serviceId: selectedServiceId,
          runtimeWindowStart: scheduleStart.value,
          runtimeWindowEnd: scheduleEnd.value,
        }),
      });
      if (res?.ok) {
        window.showToast?.('Schedule applied', 'success');
        location.reload();
      } else {
        const data = await res?.json().catch(() => ({}));
        window.showToast?.(data?.error || 'Unable to apply schedule', 'error');
      }
    });

    // Connect / Setup
    document.getElementById('connectBtn')?.addEventListener('click', async () => {
      const input = document.getElementById('endpointUrl') as HTMLInputElement;
      const url = input?.value?.trim();
      if (!url) return;
      const res = await window.stdoutFetch('/app/api/windlass/config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ endpointUrl: url }),
      });
      if (res?.ok) location.reload();
    });

    // Sync
    async function triggerSync() {
      const btn = document.getElementById('syncBtn') || document.getElementById('firstSyncBtn');
      if (btn) btn.textContent = 'Syncing...';
      const res = await window.stdoutFetch('/app/api/windlass/services', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'sync' }),
      });
      if (res?.ok) {
        location.reload();
      } else {
        const data = await res?.json().catch(() => ({}));
        window.showToast?.(data?.error || 'Sync failed', 'error');
        if (btn) btn.textContent = 'Sync';
      }
    }

    document.getElementById('syncBtn')?.addEventListener('click', triggerSync);
    document.getElementById('firstSyncBtn')?.addEventListener('click', triggerSync);
  </script>
</Layout>
