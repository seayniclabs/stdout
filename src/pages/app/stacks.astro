  .status-dot.running { background: #22C55E; box-shadow: 0 0 6px rgba(34,197,94,0.4); }
  .status-dot.stopped { background: #EF4444; box-shadow: 0 0 6px rgba(239,68,68,0.3); }
  .status-dot.unhealthy { background: #EAB308; box-shadow: 0 0 6px rgba(234,179,8,0.3); }

  /* Container tiles */
  .container-tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .container-tile {
    display: flex;
    align-items: center;
    gap: 5px;
