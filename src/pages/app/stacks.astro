  .ct-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
  .ct-dot.running { background: #22C55E; }
  .ct-dot.stopped, .ct-dot.exited { background: #EF4444; }
  .ct-dot.unknown { background: var(--text-muted); }
  .ct-dot.unhealthy { background: #EAB308; }

  .ct-name {
    font-weight: 500;
    color: var(--text);
    max-width: 140px;
    white-space: nowrap;
