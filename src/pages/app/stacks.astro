  .merge-label select:focus { border-color: var(--accent); outline: none; }
  .merge-actions { display: flex; gap: 8px; }
</style>

<script define:vars={{ templates: stackTemplates }}>
  document.querySelectorAll('.template-card').forEach(btn => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.getAttribute('data-idx') || '0');
      const t = templates[idx];
      if (t) {
        const nameInput = document.getElementById('stackNameInput');
        const descInput = document.getElementById('stackDescInput');
        if (nameInput) nameInput.value = t.name;
        if (descInput) descInput.value = t.description;
        nameInput?.focus();
      }
    });
  });
</script>

<script>
  // Stack edit: confirm + validate before saving
  const editForm = document.querySelector('.stack-edit-form');
  if (editForm) {
    editForm.addEventListener('submit', (e) => {
      const desc = (editForm.querySelector('textarea[name="description"]') as HTMLTextAreaElement)?.value || '';
      const hasContainers = /^### .+ \(.+\)/m.test(desc);

      if (!hasContainers && desc.trim().length > 0) {
        if (!confirm('Warning: This description doesn\'t contain any container definitions (### ContainerName (image) format). The container grid will show "No structured container data."\n\nSave anyway?')) {
          e.preventDefault();
          return;
        }
      }

      if (!confirm('Save changes? You can undo this from the stack card afterwards.')) {
        e.preventDefault();
      }
    });
  }

  // Stack card delete only — avoid catching .btn-danger on other pages (e.g. settings integrations)
  document.querySelectorAll('.stack-delete-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      if (!confirm('Delete this stack and all its data? This cannot be undone.')) {
        e.preventDefault();
      }
    });
  });

  // Re-import button
  const reimportBtn = document.getElementById('reimportBtn');
  if (reimportBtn) {
    reimportBtn.addEventListener('click', () => {
      if (confirm('Re-import from the last scan? You\'ll be taken to the review page to select which containers to include.')) {
        const form = document.getElementById('reimportForm') as HTMLFormElement;
        if (form) form.submit();
      }
    });
  }

  // Undo buttons: confirm
  document.querySelectorAll('.undo-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      if (!confirm('Restore the previous version of this stack description?')) {
        e.preventDefault();
      }
    });
  });
</script>

<script define:vars={{ stackCardsJson: stackCards.map(s => ({ id: s.id, name: s.name, containers: s.containers.length })) }}>
  const modal = document.getElementById('mergeModal');
  const sourceIdInput = document.getElementById('mergeSourceId');
  const sourceNameEl = document.getElementById('mergeSourceName');
  const targetSelect = document.getElementById('mergeTargetSelect');
  const confirmBtn = document.getElementById('mergeConfirmBtn');
  const cancelBtn = document.getElementById('mergeCancelBtn');
  const errorEl = document.getElementById('mergeError');

  function openMergeModal(stackId, stackName) {
    sourceIdInput.value = stackId;
    sourceNameEl.textContent = stackName;
    errorEl.style.display = 'none';
    confirmBtn.disabled = true;

    // Populate target dropdown with all stacks except the source
    targetSelect.innerHTML = '<option value="">Select a stack...</option>';
    for (const s of stackCardsJson) {
      if (s.id === stackId) continue;
      const opt = document.createElement('option');
      opt.value = s.id;
      opt.textContent = `${s.name} (${s.containers} containers)`;
      targetSelect.appendChild(opt);
    }

    modal.style.display = 'flex';
  }

  targetSelect.addEventListener('change', () => {
    confirmBtn.disabled = !targetSelect.value;
  });

  cancelBtn.addEventListener('click', () => {
    modal.style.display = 'none';
  });

  modal.addEventListener('click', (e) => {
    if (e.target === modal) modal.style.display = 'none';
  });

  confirmBtn.addEventListener('click', async () => {
    const sourceId = sourceIdInput.value;
    const targetId = targetSelect.value;
    if (!sourceId || !targetId) return;

    const targetName = targetSelect.options[targetSelect.selectedIndex].textContent;
    if (!confirm(`Merge "${sourceNameEl.textContent}" into "${targetName}"? The source stack will be deleted. This cannot be undone.`)) {
      return;
    }

    confirmBtn.disabled = true;
    confirmBtn.textContent = 'Merging...';
    errorEl.style.display = 'none';

    try {
      const res = await fetch('/app/api/stacks/merge', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sourceId, targetId }),
      });
      const data = await res.json();
      if (res.ok && data.ok) {
        window.location.href = '/app/stacks';
      } else {
        errorEl.textContent = data.error || 'Merge failed';
        errorEl.style.display = 'block';
        confirmBtn.disabled = false;
        confirmBtn.textContent = 'Merge';
      }
    } catch (err) {
      errorEl.textContent = 'Network error';
      errorEl.style.display = 'block';
      confirmBtn.disabled = false;
      confirmBtn.textContent = 'Merge';
    }
  });

  document.querySelectorAll('.merge-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      openMergeModal(btn.dataset.stackId, btn.dataset.stackName);
    });
  });
</script>
