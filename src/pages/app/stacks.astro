---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getDb, schema } from '../../lib/db';
import { nanoid } from 'nanoid';
import { eq, and, or, desc } from 'drizzle-orm';
import { validateCsrf } from '../../middleware';
import { stackTemplates } from '../../lib/stack-templates';
import { canPerform, getWorkspaceOwnerId } from '../../lib/rbac';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

const db = getDb();
const ws = Astro.locals.workspace;
const workspaceOwnerId = getWorkspaceOwnerId(Astro.locals);
const allowedStackUserIds = new Set([user.id, workspaceOwnerId]);

function stackAccessible(row: { userId: string } | null | undefined): boolean {
  return !!row && allowedStackUserIds.has(row.userId);
}

let error = '';
let editingStack: any = null;
let showCreateForm = Astro.url.searchParams.has('new');

// Handle POST: create or update
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (validateCsrf(form.get('_csrf') as string, Astro.cookies)) {
    const action = form.get('action') as string;

    const name = (form.get('name') as string || '').trim();
    const description = (form.get('description') as string || '').trim();

    // RBAC check for write actions
    if (ws && !ws.isOwnWorkspace) {
      const neededAction = action === 'delete' ? 'delete' : (action === 'create' ? 'create' : 'edit');
      if (!canPerform(ws.role, neededAction)) {
        error = `${ws.role} role cannot ${neededAction} stacks.`;
      }
    }

    if (!error && action === 'create' && name) {
      const id = nanoid();
      const now = new Date();
      db.insert(schema.stacks).values({ id, userId: user.id, name, description, createdAt: now, updatedAt: now }).run();
    } else if (!error && action === 'update') {
      const stackId = form.get('stackId') as string;
      if (stackId && name) {
        // Save previous description for undo
        const existing = db.select().from(schema.stacks).where(eq(schema.stacks.id, stackId)).get();
        if (!stackAccessible(existing)) {
          error = 'Stack not found.';
        } else if (existing) {
          // Validate: warn if new description doesn't parse to containers
          const testContainers = description.match(/^### .+ \(.+\)$/m);
          if (existing.description && !testContainers && description.length > 0) {
            // Description has content but no valid container headers — save anyway but flag
            console.warn(`Stack ${stackId} edited with non-parseable description`);
          }
          db.update(schema.stacks).set({
            name,
            description,
            previousDescription: existing.description,
            updatedAt: new Date(),
          }).where(and(
            eq(schema.stacks.id, stackId),
            eq(schema.stacks.userId, existing.userId),
          )).run();
        }
      }
    } else if (!error && action === 'restore') {
      // Undo: restore previous description
      const stackId = form.get('stackId') as string;
      if (stackId) {
        const existing = db.select().from(schema.stacks).where(eq(schema.stacks.id, stackId)).get();
        if (!stackAccessible(existing)) {
          error = 'Stack not found.';
        } else if (existing?.previousDescription) {
          db.update(schema.stacks).set({
            description: existing.previousDescription,
            previousDescription: null,
            updatedAt: new Date(),
          }).where(and(
            eq(schema.stacks.id, stackId),
            eq(schema.stacks.userId, existing.userId),
          )).run();
        }
      }
    } else if (!error && action === 'delete') {
      const stackId = form.get('stackId') as string;
      if (stackId) {
        const existing = db.select().from(schema.stacks).where(eq(schema.stacks.id, stackId)).get();
        if (!stackAccessible(existing)) {
          error = 'Stack not found.';
        } else if (existing) {
          db.delete(schema.stacks).where(and(
            eq(schema.stacks.id, stackId),
            eq(schema.stacks.userId, existing.userId),
          )).run();
        }
      }
    } else if (!error && action === 'reimport') {
      // Re-import from the last confirmed scan — reset it to pending so user can review
      const importId = form.get('importId') as string;
      if (importId) {
        const existing = db.select().from(schema.stackImports)
          .where(eq(schema.stackImports.id, importId)).get();
        if (existing) {
          // Create a new pending import from the same raw data
          const newId = nanoid();
          db.insert(schema.stackImports).values({
            id: newId,
            rawJson: existing.rawJson,
            renderedMarkdown: existing.renderedMarkdown,
            status: 'pending',
            createdAt: new Date(),
          }).run();
          return Astro.redirect(`/app/stacks/import/${newId}`);
        }
      }
    }
    if (!error) return Astro.redirect('/app/stacks');
  } else {
    error = 'Invalid form submission.';
  }
}

const editId = Astro.url.searchParams.get('edit');
const userStacks = db.select().from(schema.stacks)
  .where(
    workspaceOwnerId !== user.id
      ? or(
          eq(schema.stacks.userId, user.id),
          eq(schema.stacks.userId, workspaceOwnerId),
        )
      : eq(schema.stacks.userId, user.id),
  )
  .all();
if (editId) {
  editingStack = userStacks.find(s => s.id === editId);
  showCreateForm = false;
}

// Get monitor count (to detect stacks-deleted-but-monitors-exist state)
const monitorCount = db.select().from(schema.monitors)
  .where(eq(schema.monitors.userId, user.id)).all().length;

// Get pending imports
const pendingImports = db.select().from(schema.stackImports)
  .where(eq(schema.stackImports.status, 'pending')).all();

// Get last confirmed import (for re-import option)
const lastConfirmedImport = db.select().from(schema.stackImports)
  .where(eq(schema.stackImports.status, 'confirmed'))
  .orderBy(desc(schema.stackImports.createdAt))
  .limit(1).all()[0] || null;

// Get the most recent import (confirmed or pending) for "Last scan" timestamp
const recentImports = db.select().from(schema.stackImports)
  .orderBy(desc(schema.stackImports.createdAt))
  .limit(1).all();
const lastScanTime = recentImports.length > 0 ? recentImports[0].createdAt : null;

// Get incidents per stack
const allIncidents = db.select().from(schema.incidents)
  .where(eq(schema.incidents.userId, user.id)).all();
const incidentsByStack = new Map<string, number>();
const activeIncidentsByStack = new Map<string, number>();
for (const inc of allIncidents) {
  if (inc.stackId) {
    incidentsByStack.set(inc.stackId, (incidentsByStack.get(inc.stackId) || 0) + 1);
    if (inc.status !== 'resolved') {
      activeIncidentsByStack.set(inc.stackId, (activeIncidentsByStack.get(inc.stackId) || 0) + 1);
    }
  }
}

// Parse containers from stack descriptions (scanner-imported format)
interface ContainerInfo {
  name: string;
  image: string;
  status: string;
  ports: string;
  health: string;
}

function parseContainers(markdown: string): ContainerInfo[] {
  const containers: ContainerInfo[] = [];
  const lines = markdown.split('\n');
  let current: { name: string; image: string; details: string[] } | null = null;

  for (const line of lines) {
    const match = line.match(/^### (.+?) \((.+?)\)$/);
    if (match) {
      if (current) {
        containers.push(extractContainer(current));
      }
      current = { name: match[1], image: match[2], details: [] };
      continue;
    }
    if (current && line.startsWith('- ')) {
      current.details.push(line.slice(2));
    }
  }
  if (current) containers.push(extractContainer(current));
  return containers;
}

function extractContainer(c: { name: string; image: string; details: string[] }): ContainerInfo {
  const statusDetail = c.details.find(d => d.startsWith('Status:'));
  const portsDetail = c.details.find(d => d.startsWith('Ports:'));
  const healthDetail = c.details.find(d => d.startsWith('Health:'));
  return {
    name: c.name,
    image: c.image,
    status: statusDetail?.split(':')[1]?.trim() || 'unknown',
    ports: portsDetail?.replace('Ports: ', '') || '',
    health: healthDetail?.replace('Health: ', '') || '',
  };
}

// Build stack card data
interface StackCard {
  id: string;
  name: string;
  description: string;
  previousDescription: string | null;
  containers: ContainerInfo[];
  running: number;
  stopped: number;
  unhealthy: number;
  deviceCount: number;
  serviceCount: number;
  healthPercentage: number;
  lastScanTime: Date | null;
  updatedAt: Date;
  incidentCount: number;
  activeIncidents: number;
}

const stackCards: StackCard[] = userStacks.map(stack => {
  const containers = parseContainers(stack.description);
  const running = containers.filter(c => c.status === 'running').length;
  const stopped = containers.filter(c => c.status === 'stopped' || c.status === 'exited').length;
  const unhealthy = containers.filter(c => c.health === 'unhealthy').length;

  // Count discovered devices and services for this stack
  const deviceCount = db.select().from(schema.discoveredHosts)
    .where(and(
      eq(schema.discoveredHosts.userId, user.id),
      or(eq(schema.discoveredHosts.stackId, stack.id), eq(schema.discoveredHosts.stackId, null))
    ))
    .all().length;

  const serviceCount = db.select().from(schema.monitors)
    .where(and(
      eq(schema.monitors.userId, user.id),
      or(eq(schema.monitors.stackId, stack.id), eq(schema.monitors.stackId, null))
    ))
    .all().length;

  // Calculate health percentage
  const totalMonitors = serviceCount;
  const healthyMonitors = totalMonitors > 0
    ? db.select().from(schema.monitors)
        .where(and(
          eq(schema.monitors.userId, user.id),
          eq(schema.monitors.currentStatus, 'healthy'),
          or(eq(schema.monitors.stackId, stack.id), eq(schema.monitors.stackId, null))
        ))
        .all().length
    : 0;

  const healthPercentage = totalMonitors > 0 ? Math.round((healthyMonitors / totalMonitors) * 100) : 100;

  // Get last scan time from most recent stack import
  const lastImport = db.select().from(schema.stackImports)
    .where(eq(schema.stackImports.userId, user.id))
    .orderBy(desc(schema.stackImports.createdAt))
    .limit(1).get();

  return {
    id: stack.id,
    name: stack.name,
    description: stack.description,
    previousDescription: stack.previousDescription || null,
    containers,
    running,
    stopped,
    unhealthy,
    deviceCount,
    serviceCount,
    healthPercentage,
    lastScanTime: lastImport?.createdAt || null,
    updatedAt: stack.updatedAt,
    incidentCount: incidentsByStack.get(stack.id) || 0,
    activeIncidents: activeIncidentsByStack.get(stack.id) || 0,
  };
});

function timeAgo(date: Date) {
  const ms = Date.now() - date.getTime();
  const mins = Math.floor(ms / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  const days = Math.floor(hrs / 24);
  return `${days}d ago`;
}
---
<Layout title="Infrastructure — StdOut">
  <div class="infra-page">
    {/* Pending import banner */}
    {pendingImports.length > 0 && (
      <a href={`/app/stacks/import/${pendingImports[0].id}`} class="import-banner">
        <span class="import-banner-icon mono">&gt;_</span>
        <span>New scan results available — <strong>{pendingImports.length} pending import{pendingImports.length > 1 ? 's' : ''}</strong></span>
        <span class="import-banner-arrow">&rarr;</span>
      </a>
    )}

    {/* Page Header */}
    <div class="page-header">
      <div class="header-left">
        <h1>Infrastructure <a href="/app/docs/guide/stacks" class="help-link" title="Stacks documentation"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></a></h1>
        <p class="page-subtitle">Stacks represent your infrastructure groups -- Docker Compose projects, service clusters, or logical groupings of related services. Imported automatically by the scanner, or added manually.</p>
      </div>
      <div class="header-right">
        <div class="scanner-status mono">
          {lastScanTime ? (
            <span class="scan-time">
              <span class="scan-dot"></span>
              Last scan: {timeAgo(lastScanTime)}
            </span>
          ) : (
            <span class="scan-time no-scan">No scans yet</span>
          )}
        </div>
        {!showCreateForm && !editingStack && (
          <a href="/app/stacks?new" class="btn btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add Stack
          </a>
        )}
      </div>
    </div>

    {error && <div class="auth-error">{error}</div>}

    {/* Edit form (shown when editing) */}
    {editingStack && (
      <div class="form-panel">
        <div class="form-panel-header">
          <h2>Edit Stack</h2>
          <span style="font-size:0.8em; color:var(--text-muted); font-family:var(--font-mono);">Markdown format — imported by scanner</span>
          <a href="/app/stacks" class="btn btn-ghost btn-sm">Cancel</a>
        </div>
        <form method="POST" class="stack-form stack-edit-form">
          <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
          <input type="hidden" name="action" value="update" />
          <input type="hidden" name="stackId" value={editingStack.id} />
          <label>
            <span>Name</span>
            <input type="text" name="name" value={editingStack.name} required />
          </label>
          <label>
            <span>Description <span style="font-weight:400; color:var(--text-muted); font-size:0.8em;">(Markdown — imported by scanner)</span></span>
            <textarea name="description" rows={10} style="font-family:var(--font-mono); font-size:13px;">{editingStack.description}</textarea>
            <span style="font-size:0.75em; color:var(--text-muted); margin-top:4px; display:block;">
              Format: <code>### ContainerName (image)</code> headers with <code>- Key: Value</code> details. Editing manually may break the container grid display.
            </span>
          </label>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
          </div>
        </form>
      </div>
    )}

    {/* Create form (shown when ?new) */}
    {showCreateForm && (
      <div class="form-panel">
        <div class="form-panel-header">
          <h2>Add a Stack</h2>
          <a href="/app/stacks" class="btn btn-ghost btn-sm">Cancel</a>
        </div>

        <div class="template-section">
          <p class="template-hint">Start from a template or describe your stack from scratch.</p>
          <div class="template-grid">
            {stackTemplates.map((t, i) => (
              <button class="template-card" data-idx={i} type="button">
                <span class="template-name">{t.name}</span>
                <span class="template-tags mono">{t.tags}</span>
              </button>
            ))}
          </div>
        </div>

        <form method="POST" class="stack-form">
          <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
          <input type="hidden" name="action" value="create" />
          <label>
            <span>Name</span>
            <input type="text" name="name" id="stackNameInput" required placeholder="e.g. Mac Mini Lab" />
          </label>
          <label>
            <span>Description</span>
            <textarea name="description" id="stackDescInput" rows={8} placeholder="Docker containers, ports, services, dependencies...&#10;&#10;Example:&#10;- nginx proxy on :8101&#10;- Node.js app on :3000 (Astro SSR)&#10;- SQLite at /app/data/app.db&#10;- Cloudflare Tunnel for public access"></textarea>
          </label>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Stack</button>
          </div>
        </form>
      </div>
    )}

    {/* Stack Cards Grid */}
    {!showCreateForm && !editingStack && stackCards.length > 0 && (
      <div class="stack-grid">
        {stackCards.map(stack => (
          <div class="stack-card">
            <div class="stack-card-header">
              <a href={`/app/stacks/${stack.id}`} class="stack-name-link">
                <h3>{stack.name}</h3>
              </a>
              <div class="stack-badges">
                {stack.deviceCount > 0 && (
                  <span class="badge badge-count mono" title="Discovered network devices">{stack.deviceCount} devices</span>
                )}
                {stack.serviceCount > 0 && (
                  <span class="badge badge-count mono" title="Monitored services">{stack.serviceCount} services</span>
                )}
                {stack.healthPercentage < 100 && (
                  <span class="badge badge-health mono" title="Service health percentage" style={`color: ${stack.healthPercentage >= 90 ? 'var(--success)' : stack.healthPercentage >= 70 ? 'var(--warning)' : 'var(--danger)'}`}>
                    {stack.healthPercentage}% health
                  </span>
                )}
                {stack.containers.length > 0 && (
                  <span class="badge badge-count mono">{stack.containers.length} containers</span>
                )}
                {stack.activeIncidents > 0 && (
                  <span class="badge badge-incident mono">{stack.activeIncidents} active</span>
                )}
              </div>
            </div>

            {/* Summary stats row */}
            {(stack.deviceCount > 0 || stack.serviceCount > 0 || stack.lastScanTime) && (
              <div class="stack-summary">
                {stack.deviceCount > 0 && (
                  <div class="summary-item">
                    <span class="summary-label">Devices</span>
                    <span class="summary-value mono">{stack.deviceCount}</span>
                  </div>
                )}
                {stack.serviceCount > 0 && (
                  <div class="summary-item">
                    <span class="summary-label">Services</span>
                    <span class="summary-value mono">{stack.serviceCount}</span>
                  </div>
                )}
                {stack.healthPercentage >= 0 && stack.serviceCount > 0 && (
                  <div class="summary-item">
                    <span class="summary-label">Health</span>
                    <span class="summary-value mono" style={`color: ${stack.healthPercentage >= 90 ? 'var(--success)' : stack.healthPercentage >= 70 ? 'var(--warning)' : 'var(--danger)'}`}>
                      {stack.healthPercentage}%
                    </span>
                  </div>
                )}
                {stack.lastScanTime && (
                  <div class="summary-item">
                    <span class="summary-label">Last scan</span>
                    <span class="summary-value mono">{timeAgo(stack.lastScanTime)}</span>
                  </div>
                )}
              </div>
            )}

            {/* Health summary */}
            {stack.containers.length > 0 && (
              <div class="health-summary">
                {stack.running > 0 && (
                  <span class="health-item">
                    <span class="status-dot running"></span>
                    <span class="mono">{stack.running} up</span>
                  </span>
                )}
                {stack.stopped > 0 && (
                  <span class="health-item">
                    <span class="status-dot stopped"></span>
                    <span class="mono">{stack.stopped} down</span>
                  </span>
                )}
                {stack.unhealthy > 0 && (
                  <span class="health-item">
                    <span class="status-dot unhealthy"></span>
                    <span class="mono">{stack.unhealthy} unhealthy</span>
                  </span>
                )}
              </div>
            )}

            {/* Container tiles */}
            {stack.containers.length > 0 ? (
              <div class="container-tiles">
                {stack.containers.map(c => (
                  <div class={`container-tile ${c.status}`}>
                    <span class={`ct-dot ${c.status} ${c.health === 'unhealthy' ? 'unhealthy' : ''}`}></span>
                    <span class="ct-name" title={c.name}>{c.name}</span>
                    {c.ports && <span class="ct-port mono">{c.ports.split(',')[0]?.trim()}</span>}
                  </div>
                ))}
              </div>
            ) : (
              <div class="no-containers">
                <span class="mono">No structured container data</span>
              </div>
            )}

            {/* Card footer */}
            <div class="stack-card-footer">
              <span class="updated-at mono">Updated {timeAgo(stack.updatedAt)}</span>
              <div class="stack-actions">
                <a href={`/app/stacks/${stack.id}`} class="btn btn-ghost btn-xs">Details</a>
                {stack.incidentCount > 0 && (
                  <a href={`/app/incidents?stack=${stack.id}`} class="btn btn-ghost btn-xs">
                    {stack.incidentCount} incident{stack.incidentCount !== 1 ? 's' : ''}
                  </a>
                )}
                <button type="button" class="btn btn-ghost btn-xs merge-btn" data-stack-id={stack.id} data-stack-name={stack.name}>Merge</button>
                <a href={`/app/stacks?edit=${stack.id}`} class="btn btn-ghost btn-xs">Edit</a>
                {stack.previousDescription && (
                  <form method="POST" style="display:inline;">
                    <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
                    <input type="hidden" name="action" value="restore" />
                    <input type="hidden" name="stackId" value={stack.id} />
                    <button type="submit" class="btn btn-ghost btn-xs undo-btn" style="color:var(--accent-light);">Undo</button>
                  </form>
                )}
                <form method="POST" style="display:inline;">
                  <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="stackId" value={stack.id} />
                  <button type="submit" class="btn btn-danger btn-xs stack-delete-btn">Delete</button>
                </form>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}

    {/* Empty State */}
    {!showCreateForm && !editingStack && stackCards.length === 0 && (
      <div class="empty-state">
        <div class="empty-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
            <line x1="8" y1="21" x2="16" y2="21"/>
            <line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
        </div>

        {/* If monitors exist but stacks are gone, show contextual message */}
        {monitorCount > 0 ? (
          <>
            <h3>Stacks removed, monitors still running</h3>
            <p>Your {monitorCount} monitor{monitorCount !== 1 ? 's are' : ' is'} still active on the <a href="/app/hud">HUD</a>. Re-scan to rebuild your infrastructure view{lastConfirmedImport ? ', or re-import from your last scan' : ''}.</p>
          </>
        ) : (
          <>
            <h3>No stacks imported yet</h3>
            <p>Stacks map your infrastructure -- each one represents a Docker Compose project, a service cluster, or a logical group of services. The scanner discovers them automatically, or you can describe them by hand.</p>
          </>
        )}

        {/* Re-import from last confirmed scan if available */}
        {lastConfirmedImport ? (
          <div class="reimport-section">
            <p class="reimport-hint">A previous scan from {timeAgo(lastConfirmedImport.createdAt)} is available.</p>
            <form method="POST" id="reimportForm">
              <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
              <input type="hidden" name="action" value="reimport" />
              <input type="hidden" name="importId" value={lastConfirmedImport.id} />
            </form>
          </div>
        ) : null}

        <div class="setup-steps">
          <h4>Scanner setup</h4>
          <ol>
            <li><a href="/app/settings">Create an API token</a> in Settings</li>
            <li>Run the scanner on your Docker host:
              <pre class="scanner-cmd"><code>{`docker run --rm \\
  -v /var/run/docker.sock:/var/run/docker.sock:ro \\
  charlieseay/stdout-scanner scan \\
  --url YOUR_STDOUT_URL \\
  --token YOUR_API_TOKEN`}</code></pre>
            </li>
            <li>Come back here to review and confirm the import</li>
          </ol>
        </div>

        <div class="empty-actions">
          {lastConfirmedImport && (
            <button type="button" class="btn btn-primary" id="reimportBtn">Re-import Last Scan</button>
          )}
          {!lastConfirmedImport && (
            <a href="/app/settings" class="btn btn-primary">Create API Token</a>
          )}
          <a href="/app/stacks?new" class="btn btn-ghost">Add Stack Manually</a>
        </div>
      </div>
    )}

    {/* Merge modal */}
    <div id="mergeModal" class="merge-overlay" style="display:none;">
      <div class="merge-dialog">
        <h3>Merge Stack</h3>
        <p class="merge-hint">Merge <strong id="mergeSourceName"></strong> into another stack. Its containers, incidents, and docs will be moved to the target. The source stack will be deleted.</p>
        <input type="hidden" id="mergeSourceId" />
        <input type="hidden" name="_csrf" id="mergeCsrf" value={Astro.locals.csrfToken} />
        <label class="merge-label">
          <span>Merge into:</span>
          <select id="mergeTargetSelect">
            <option value="">Select a stack...</option>
          </select>
        </label>
        <div class="merge-actions">
          <button type="button" class="btn btn-primary btn-sm" id="mergeConfirmBtn" disabled>Merge</button>
          <button type="button" class="btn btn-ghost btn-sm" id="mergeCancelBtn">Cancel</button>
        </div>
        <div id="mergeError" class="auth-error" style="display:none; margin-top:10px;"></div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .infra-page { max-width: 1100px; margin: 0 auto; }

  /* Import banner */
  .import-banner { display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: var(--accent-dim); border: 1px solid var(--accent); border-radius: var(--radius); margin-bottom: 16px; text-decoration: none; color: var(--accent-light); font-size: 13px; transition: background 150ms; }
  .import-banner:hover { background: var(--accent-glow); }
  .import-banner-icon { font-size: 14px; }
  .import-banner-arrow { margin-left: auto; }

  /* Page header */
  .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; gap: 16px; }
  .header-left h1 { font-size: 22px; font-weight: 700; margin-bottom: 4px; }
  .page-subtitle { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }
  .header-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
  .scanner-status { font-size: 11px; color: var(--text-muted); }
  .scan-time { display: flex; align-items: center; gap: 6px; }
  .scan-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--low); box-shadow: 0 0 6px rgba(34,197,94,0.4); }
  .no-scan { color: var(--text-muted); }

  /* Stack cards grid */
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(480px, 1fr));
    gap: 16px;
  }

  .stack-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: var(--shadow-sm);
    transition: all 0.15s ease;
  }
  .stack-card:hover {
    border-color: var(--border-hover);
    box-shadow: var(--shadow-md);
  }

  .stack-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
  }
  .stack-name-link { text-decoration: none; color: inherit; }
  .stack-name-link:hover h3 { color: var(--accent-light); }
  .stack-name-link h3 { font-size: 16px; font-weight: 700; transition: color 0.15s; }

  .stack-badges { display: flex; gap: 6px; flex-shrink: 0; }
  .badge {
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
  }
  .badge-count { color: var(--text-secondary); background: rgba(160,160,184,0.1); border: 1px solid var(--border); }
  .badge-incident { color: var(--critical); background: var(--critical-dim); }
