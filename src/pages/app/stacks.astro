    color: var(--text-muted);
    border: 1px dashed var(--border);
    border-radius: var(--radius-sm);
  }

  /* Card footer */
  .stack-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 10px;
    border-top: 1px solid var(--border);
  }
  .updated-at { font-size: 10px; color: var(--text-muted); }
  .stack-actions { display: flex; gap: 6px; align-items: center; }

  /* Form panel */
  .form-panel {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-sm);
  }
  .form-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }
  .form-panel-header h2 { font-size: 16px; font-weight: 600; }

  /* Stack form */
  .stack-form { display: flex; flex-direction: column; gap: 12px; }
  .stack-form label { display: flex; flex-direction: column; gap: 4px; }
  .stack-form label span { font-size: 12px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.04em; }
  .stack-form input, .stack-form textarea { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text); font-family: var(--font-mono); font-size: 13px; padding: 10px 12px; }
  .stack-form textarea { resize: vertical; }
  .stack-form input:focus, .stack-form textarea:focus { border-color: var(--accent); outline: none; }
  .form-actions { display: flex; gap: 8px; padding-top: 4px; }

  /* Templates */
  .template-section { margin-bottom: 16px; }
  .template-hint { font-size: 13px; color: var(--text-muted); margin-bottom: 10px; }
  .template-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px; margin-bottom: 16px; }
  .template-card { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 10px 12px; cursor: pointer; text-align: left; transition: all 0.15s ease; display: flex; flex-direction: column; gap: 2px; }
  .template-card:hover { border-color: var(--accent); transform: translateY(-1px); box-shadow: var(--shadow-sm); }
  .template-name { font-size: 13px; font-weight: 600; color: var(--text); }
  .template-tags { font-size: 10px; color: var(--text-muted); }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: 60px 24px;
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    max-width: 600px;
    margin: 40px auto;
  }
  .empty-icon {
    color: var(--text-muted);
    margin-bottom: 16px;
    opacity: 0.5;
  }
  .empty-state h3 { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
  .empty-state p { font-size: 13px; color: var(--text-secondary); margin-bottom: 20px; line-height: 1.5; }
  .scanner-cmd {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px;
    overflow-x: auto;
    margin-bottom: 20px;
    text-align: left;
  }
  .scanner-cmd code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text);
    line-height: 1.6;
    white-space: pre;
  }
  .empty-actions { display: flex; gap: 10px; justify-content: center; }

  /* Setup steps */
  .setup-steps { text-align: left; margin-bottom: 20px; }
  .setup-steps h4 { font-size: 13px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 10px; }
  .setup-steps ol { font-size: 13px; color: var(--text-secondary); line-height: 1.8; padding-left: 20px; margin: 0; }
  .setup-steps ol li { margin-bottom: 8px; }
  .setup-steps a { color: var(--accent-light); text-decoration: underline; }

  /* Re-import section */
  .reimport-section { margin-bottom: 16px; }
  .reimport-hint { font-size: 12px; color: var(--text-muted); font-family: var(--font-mono); }

  /* Buttons */
  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border: none; border-radius: var(--radius-sm); font-weight: 600; font-size: 12px; cursor: pointer; text-decoration: none; transition: var(--transition); }
  .btn-sm { padding: 5px 10px; font-size: 11px; }
  .btn-xs { padding: 3px 8px; font-size: 10px; }
  .btn-primary { background: var(--accent-btn); color: #fff; }
  .btn-primary:hover { background: var(--accent-light); }
  .btn-ghost { background: transparent; color: var(--text-secondary); border: 1px solid var(--border); }
  .btn-ghost:hover { border-color: var(--accent); color: var(--text); }
  .btn-danger { background: transparent; color: var(--critical); border: 1px solid rgba(239,68,68,0.2); }
  .btn-danger:hover { background: var(--critical-dim); }

  .mono { font-family: var(--font-mono); }
  .auth-error { background: var(--critical-dim); border: 1px solid var(--critical); color: var(--critical); padding: 10px 14px; border-radius: var(--radius-sm); font-size: 13px; margin-bottom: 16px; }

  /* Responsive */
  @media (max-width: 900px) {
    .stack-grid { grid-template-columns: 1fr; }
    .page-header { flex-direction: column; gap: 12px; }
    .header-right { align-self: stretch; justify-content: space-between; }
  }
  @media (max-width: 500px) {
    .stack-card-footer { flex-direction: column; gap: 8px; align-items: flex-start; }
    .health-summary { flex-wrap: wrap; gap: 10px; }
    .template-grid { grid-template-columns: 1fr; }
  }

  /* Merge modal */
  .merge-overlay {
    position: fixed; inset: 0; z-index: 1000;
    background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
  }
  .merge-dialog {
    background: var(--bg-surface); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 24px; width: 420px; max-width: 90vw;
    box-shadow: var(--shadow-lg);
  }
  .merge-dialog h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; }
  .merge-hint { font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 16px; }
  .merge-label { display: flex; flex-direction: column; gap: 4px; margin-bottom: 16px; }
  .merge-label span { font-size: 12px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.04em; }
  .merge-label select {
    background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm);
    color: var(--text); font-family: var(--font-mono); font-size: 13px; padding: 8px 10px;
