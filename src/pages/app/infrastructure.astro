---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import DiscoverySummary from '../../components/DiscoverySummary.astro';
import MermaidTopologyDiagram from '../../components/MermaidTopologyDiagram.astro';
import { getDb, schema } from '../../lib/db';
import { discoveredHosts, discoveredServices } from '../../lib/db/schema';
import { eq, desc } from 'drizzle-orm';

const session = Astro.locals.user;
if (!session) return Astro.redirect('/app/login');

const db = getDb();

// Discovery data
const hosts = db.select().from(discoveredHosts)
  .orderBy(discoveredHosts.ipAddress).all();

const allServices = db.select().from(discoveredServices).all();

const hostsWithServices = hosts.map(host => ({
  ...host,
  services: allServices.filter(s => s.hostId === host.id),
}));

// Stacks data
const stacks = db.select().from(schema.stacks)
  .orderBy(desc(schema.stacks.updatedAt)).all();

// Satellites data (table doesn't exist yet)
const satellites = [];

// Discovery stats
const totalEntities = hosts.length + allServices.length;
const lastDiscoveryRun = hosts.length > 0
  ? Math.max(...hosts.map(h => h.lastSeen.getTime()))
  : null;

function timeAgo(timestamp: number) {
  const mins = Math.floor((Date.now() - timestamp) / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  return `${Math.floor(hrs / 24)}d ago`;
}
---

<Layout title="Infrastructure — StdOut">
  <div class="page-container">
    <!-- Autonomous Status Banner -->
    <div class="auto-banner">
      <div class="auto-icon">🤖</div>
      <div class="auto-content">
        <h2>Riggins is continuously monitoring your infrastructure</h2>
        <div class="auto-meta">
          <span class="highlight">{totalEntities} entities discovered</span> •
          <span class="highlight">{stacks.length} stacks auto-created</span> •
          Last scan: {lastDiscoveryRun ? timeAgo(lastDiscoveryRun) : 'Never'}
        </div>
      </div>
    </div>

    <!-- Tabs -->
    <div class="tabs">
      <button class="tab active" data-tab="discovery">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        Discovery
      </button>
      <button class="tab" data-tab="stacks">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>
        </svg>
        Stacks ({stacks.length})
      </button>
      <button class="tab" data-tab="satellites">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6M1 12h6m6 0h6"/>
        </svg>
        Satellites ({satellites.length})
      </button>
      <button class="tab" data-tab="topology">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"/><path d="M12 2v4m0 12v4M2 12h4m12 0h4"/><circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
        </svg>
        Topology Map
      </button>
    </div>

    <!-- Discovery Tab -->
    <div class="tab-content active" data-content="discovery">
      {hosts.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">🔍</div>
          <h3>Riggins is scanning your infrastructure...</h3>
          <p>Auto-discovery runs continuously. Check back in a few minutes.</p>
          <div class="auto-label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            Autonomous scanning enabled
          </div>
        </div>
      ) : (
        <div class="hosts-grid">
          {hostsWithServices.map(host => (
            <a href={`/app/devices/${host.id}`} class="host-card">
              <div class="host-header">
                <div class="host-info">
                  {host.hostname ? (
                    <>
                      <span class="host-hostname">{host.hostname}</span>
                      <span class="host-ip-secondary">{host.ipAddress}</span>
                    </>
                  ) : (
                    <span class="host-ip">{host.ipAddress}</span>
                  )}
                </div>
                <span class="auto-badge">Auto-found</span>
              </div>
              {host.services.length > 0 && (
                <div class="services-list">
                  <h4>Services ({host.services.length})</h4>
                  <div class="services-grid">
                    {host.services.map(service => (
                      <div class="service-item">
                        <span class="service-port">{service.port}/{service.protocol}</span>
                        <span class="service-name">{service.serviceName || 'Unknown'}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Stacks Tab -->
    <div class="tab-content" data-content="stacks">
      {stacks.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">📦</div>
          <h3>Stacks auto-create from discovered entities</h3>
          <p>Once Riggins discovers services, it automatically creates stack manifests (JSON definitions).</p>
        </div>
      ) : (
        <div class="stacks-grid">
          {stacks.map(stack => (
            <div class="stack-card">
              <div class="stack-header">
                <h3>{stack.name}</h3>
                <span class="auto-badge">Auto-created</span>
              </div>
              <p class="stack-description">{stack.description || 'No description'}</p>
              <div class="stack-footer">
                <span class="stack-count">{stack.serviceCount || 0} services</span>
                <a href={`/app/stacks/${stack.id}`} class="btn-text">View →</a>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Satellites Tab -->
    <div class="tab-content" data-content="satellites">
      {satellites.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">🛰️</div>
          <h3>No remote Riggins agents yet</h3>
          <p>Satellites are remote Riggins instances that monitor infrastructure outside your main network.</p>
          <button class="btn-primary">Deploy Satellite Agent</button>
        </div>
      ) : (
        <div class="satellites-grid">
          {satellites.map(sat => (
            <div class="satellite-card">
              <div class="satellite-header">
                <h3>{sat.name}</h3>
                <span class={`status-badge ${sat.status}`}>{sat.status}</span>
              </div>
              <div class="satellite-meta">
                <span>Location: {sat.location || 'Unknown'}</span>
                <span>Last seen: {timeAgo(sat.lastSeen?.getTime() || Date.now())}</span>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Topology Map Tab -->
    <div class="tab-content" data-content="topology">
      <MermaidTopologyDiagram />
    </div>
  </div>
</Layout>

<style>
  .page-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 24px;
  }

  /* Autonomous Banner */
  .auto-banner {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(16, 185, 129, 0.05));
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .auto-icon {
    font-size: 32px;
    flex-shrink: 0;
  }

  .auto-content h2 {
    font-size: 18px;
    margin: 0 0 4px 0;
  }

  .auto-meta {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .auto-meta .highlight {
    color: var(--success);
    font-weight: 600;
  }

  /* Tabs */
  .tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0;
  }

  .tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-secondary);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .tab.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
  }

  /* Tab Content */
  .tab-content {
    display: none;
  }

  .tab-content.active {
    display: block;
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 64px 32px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .empty-icon {
    font-size: 64px;
    margin-bottom: 16px;
  }

  .empty-state h3 {
    font-size: 20px;
    margin-bottom: 8px;
  }

  .empty-state p {
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .auto-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 107, 53, 0.15);
    color: var(--primary);
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
  }

  .auto-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(16, 185, 129, 0.15);
    color: var(--success);
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Host Cards */
  .hosts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 16px;
  }

  .host-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    transition: all 0.2s ease;
    text-decoration: none;
    color: inherit;
    display: block;
    cursor: pointer;
  }

  .host-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    border-color: var(--primary);
  }

  .host-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
  }

  .host-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .host-ip {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 600;
  }

  .host-hostname {
    font-size: 15px;
    font-weight: 600;
  }

  .host-ip-secondary {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
  }

  .services-list h4 {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-tertiary);
    margin-bottom: 12px;
  }

  .services-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .service-item {
    display: flex;
    gap: 12px;
    padding: 8px 12px;
    background: var(--bg-tertiary);
    border-radius: 6px;
    font-size: 13px;
  }

  .service-port {
    font-family: var(--font-mono);
    color: var(--primary);
    font-weight: 600;
  }

  /* Stacks Grid */
  .stacks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }

  .stack-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    transition: all 0.2s ease;
  }

  .stack-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .stack-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .stack-header h3 {
    font-size: 16px;
    margin: 0;
  }

  .stack-description {
    color: var(--text-secondary);
    font-size: 14px;
    margin-bottom: 16px;
  }

  .stack-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }

  .stack-count {
    font-size: 13px;
    color: var(--text-tertiary);
  }

  /* Satellites Grid */
  .satellites-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .satellite-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
  }

  .satellite-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .satellite-header h3 {
    font-size: 16px;
    margin: 0;
  }

  .status-badge {
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .status-badge.online {
    background: rgba(16, 185, 129, 0.15);
    color: var(--success);
  }

  .status-badge.offline {
    background: rgba(239, 68, 68, 0.15);
    color: var(--error);
  }

  .satellite-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    color: var(--text-secondary);
  }

  /* Buttons */
  .btn-primary {
    background: var(--primary);
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
  }

  .btn-text:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .tabs {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .tab {
      white-space: nowrap;
    }

    .hosts-grid,
    .stacks-grid,
    .satellites-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Tab switching
  const tabs = document.querySelectorAll('.tab');
  const tabContents = document.querySelectorAll('.tab-content');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const targetTab = (tab as HTMLElement).dataset.tab;

      tabs.forEach(t => t.classList.remove('active'));
      tabContents.forEach(c => c.classList.remove('active'));

      tab.classList.add('active');
      document.querySelector(`[data-content="${targetTab}"]`)?.classList.add('active');
    });
  });
</script>
</Layout>
