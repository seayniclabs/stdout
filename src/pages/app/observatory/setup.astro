---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');
---
<Layout title="Observatory Setup — StdOut">
  <div class="setup-page">
    <div class="setup-header">
      <h1>Observatory Setup</h1>
      <p class="subtitle">Automated installation and configuration</p>
    </div>

    <div class="setup-container">
      <!-- Overall Progress -->
      <div class="progress-card">
        <div class="progress-header">
          <h2>Overall Progress</h2>
          <span class="progress-percent" id="overallPercent">0%</span>
        </div>
        <div class="progress-bar">
          <div class="progress-fill" id="overallProgress" style="width: 0%"></div>
        </div>
        <div class="progress-meta">
          <span class="status" id="setupStatus">Initializing...</span>
          <span class="eta" id="setupEta">Calculating ETA...</span>
        </div>
      </div>

      <!-- Setup Steps -->
      <div class="steps-container" id="stepsContainer">
        <!-- Steps will be populated by JavaScript -->
      </div>

      <!-- Console Output -->
      <div class="console-card">
        <div class="console-header">
          <h3>Live Output</h3>
          <button id="clearConsoleBtn" class="btn-icon">Clear</button>
        </div>
        <div class="console-output mono" id="consoleOutput">
          <div class="console-line">
            <span class="timestamp">[00:00:00]</span>
            <span class="message">Waiting for setup to start...</span>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="setup-actions">
        <button id="startSetupBtn" class="btn-primary">Start Setup</button>
        <button id="skipSetupBtn" class="btn-secondary">Skip (Use Rule-Based Fallback)</button>
        <a href="/app/observatory" class="btn-secondary">Return to Observatory</a>
      </div>
    </div>
  </div>

  <style>
    .setup-page {
      padding: 2rem;
      max-width: 1200px;
      margin: 0 auto;
      min-height: 100vh;
    }

    .setup-header {
      margin-bottom: 2rem;
    }

    .setup-header h1 {
      font-size: 2rem;
      font-weight: 700;
      margin: 0 0 0.5rem 0;
      color: #F8FAFC;
    }

    .subtitle {
      font-size: 1rem;
      color: #94A3B8;
      margin: 0;
    }

    .setup-container {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .progress-card {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      padding: 1.5rem;
    }

    .progress-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .progress-header h2 {
      font-size: 1.25rem;
      font-weight: 600;
      color: #F8FAFC;
      margin: 0;
    }

    .progress-percent {
      font-size: 1.5rem;
      font-weight: 700;
      color: #22C55E;
      font-family: 'Fira Code', monospace;
    }

    .progress-bar {
      height: 12px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 6px;
      overflow: hidden;
      margin-bottom: 1rem;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #22C55E 0%, #16A34A 100%);
      transition: width 0.3s ease;
      border-radius: 6px;
    }

    .progress-meta {
      display: flex;
      justify-content: space-between;
      font-size: 0.875rem;
    }

    .status {
      color: #94A3B8;
    }

    .eta {
      color: #64748B;
      font-family: 'Fira Code', monospace;
    }

    .steps-container {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .step-card {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      padding: 1rem;
      transition: all 0.2s ease;
    }

    .step-card.running {
      border-color: #22C55E;
      box-shadow: 0 0 12px rgba(34, 197, 94, 0.2);
    }

    .step-card.complete {
      opacity: 0.7;
    }

    .step-card.error {
      border-color: #EF4444;
      box-shadow: 0 0 12px rgba(239, 68, 68, 0.2);
    }

    .step-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }

    .step-title {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-weight: 600;
      color: #F8FAFC;
    }

    .step-icon {
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      font-size: 0.75rem;
    }

    .step-icon.pending {
      background: rgba(100, 116, 139, 0.2);
      color: #64748B;
    }

    .step-icon.running {
      background: rgba(34, 197, 94, 0.2);
      color: #22C55E;
      animation: pulse 2s ease-in-out infinite;
    }

    .step-icon.complete {
      background: rgba(34, 197, 94, 0.2);
      color: #22C55E;
    }

    .step-icon.error {
      background: rgba(239, 68, 68, 0.2);
      color: #EF4444;
    }

    .step-icon.skipped {
      background: rgba(245, 158, 11, 0.2);
      color: #F59E0B;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    .step-status {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      padding: 0.25rem 0.75rem;
      border-radius: 12px;
    }

    .step-status.pending {
      background: rgba(100, 116, 139, 0.2);
      color: #94A3B8;
    }

    .step-status.running {
      background: rgba(34, 197, 94, 0.2);
      color: #22C55E;
    }

    .step-status.complete {
      background: rgba(34, 197, 94, 0.2);
      color: #22C55E;
    }

    .step-status.error {
      background: rgba(239, 68, 68, 0.2);
      color: #EF4444;
    }

    .step-status.skipped {
      background: rgba(245, 158, 11, 0.2);
      color: #F59E0B;
    }

    .step-progress {
      height: 4px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 2px;
      overflow: hidden;
      margin-bottom: 0.5rem;
    }

    .step-progress-fill {
      height: 100%;
      background: #22C55E;
      transition: width 0.3s ease;
    }

    .step-output {
      font-size: 0.75rem;
      color: #64748B;
      font-family: 'Fira Code', monospace;
    }

    .console-card {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      padding: 1.5rem;
      height: 400px;
      display: flex;
      flex-direction: column;
    }

    .console-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .console-header h3 {
      font-size: 1rem;
      font-weight: 600;
      color: #F8FAFC;
      margin: 0;
    }

    .btn-icon {
      padding: 0.25rem 0.75rem;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #94A3B8;
      border-radius: 6px;
      font-size: 0.75rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-icon:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #22C55E;
    }

    .console-output {
      flex: 1;
      overflow-y: auto;
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 8px;
      padding: 1rem;
      font-size: 0.75rem;
      font-family: 'Fira Code', monospace;
    }

    .console-line {
      margin-bottom: 0.25rem;
      display: flex;
      gap: 0.75rem;
    }

    .timestamp {
      color: #64748B;
      flex-shrink: 0;
    }

    .message {
      color: #94A3B8;
      flex: 1;
    }

    .message.error {
      color: #EF4444;
    }

    .message.warning {
      color: #F59E0B;
    }

    .message.success {
      color: #22C55E;
    }

    .setup-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      padding-top: 1rem;
    }

    .btn-primary, .btn-secondary {
      padding: 0.75rem 1.5rem;
      border-radius: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      border: none;
      text-decoration: none;
      display: inline-block;
    }

    .btn-primary {
      background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
      color: #020617;
    }

    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);
    }

    .btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.1);
      color: #F8FAFC;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.15);
    }
  </style>

  <script>
    // Will implement SSE connection and UI updates
    console.log('[Setup] Page loaded');
  </script>
</Layout>
