---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
const session = Astro.locals.user;
if (!session) return Astro.redirect('/app/login');
---

<Layout title="Observatory Network Test">
  <div class="page-header">
    <h1>🔍 Network Discovery Testing</h1>
    <p class="page-subtitle">Validate network scanning and service detection for Observatory monitoring</p>
  </div>

  <div class="test-container">
    <!-- Quick Scan Section -->
    <div class="test-card">
      <div class="card-header">
        <h2>Quick Network Scan</h2>
        <span class="badge badge-info">Step 1</span>
      </div>
      <p class="card-description">Scan local network to discover active hosts</p>

      <div class="scan-config">
        <label for="subnet">Network Subnet</label>
        <input
          type="text"
          id="subnet"
          value="192.168.0.0/24"
          placeholder="192.168.0.0/24"
        />
        <button id="startScan" class="btn-primary">
          <span class="btn-icon">🌐</span>
          Start Scan
        </button>
      </div>

      <div id="scanProgress" class="progress-section" style="display: none;">
        <div class="progress-bar">
          <div id="progressFill" class="progress-fill"></div>
        </div>
        <div id="progressText" class="progress-text">0%</div>
      </div>

      <div id="scanLogs" class="log-output"></div>
    </div>

    <!-- Discovered Hosts Section -->
    <div id="hostsCard" class="test-card" style="display: none;">
      <div class="card-header">
        <h2>Discovered Hosts</h2>
        <span id="hostCount" class="badge badge-success">0 hosts</span>
      </div>
      <div id="hostsList" class="hosts-grid"></div>
    </div>

    <!-- Service Detection Section -->
    <div id="servicesCard" class="test-card" style="display: none;">
      <div class="card-header">
        <h2>Service Detection</h2>
        <span class="badge badge-info">Step 2</span>
      </div>
      <p class="card-description">Scan discovered hosts for common services</p>

      <button id="scanServices" class="btn-primary">
        <span class="btn-icon">🔌</span>
        Scan for Services
      </button>

      <div id="serviceProgress" class="progress-section" style="display: none;">
        <div class="progress-bar">
          <div id="serviceProgressFill" class="progress-fill"></div>
        </div>
        <div id="serviceProgressText" class="progress-text">0%</div>
      </div>

      <div id="serviceLogs" class="log-output"></div>
      <div id="servicesGrid" class="services-grid"></div>
    </div>

    <!-- Observatory Integration Section -->
    <div id="integrationCard" class="test-card" style="display: none;">
      <div class="card-header">
        <h2>Observatory Integration</h2>
        <span class="badge badge-success">Step 3</span>
      </div>
      <p class="card-description">Add discovered services to Observatory monitoring</p>

      <div class="integration-summary">
        <div class="summary-stat">
          <span class="stat-value" id="totalHosts">0</span>
          <span class="stat-label">Hosts</span>
        </div>
        <div class="summary-stat">
          <span class="stat-value" id="totalServices">0</span>
          <span class="stat-label">Services</span>
        </div>
        <div class="summary-stat">
          <span class="stat-value" id="monitorableServices">0</span>
          <span class="stat-label">Monitorable</span>
        </div>
      </div>

      <button id="addToObservatory" class="btn-success btn-large">
        <span class="btn-icon">✅</span>
        Add to Observatory Monitoring
      </button>

      <div id="integrationResult" class="result-message"></div>
    </div>

    <!-- Test Results Section -->
    <div id="resultsCard" class="test-card" style="display: none;">
      <div class="card-header">
        <h2>Test Results</h2>
        <span class="badge badge-success">Complete</span>
      </div>

      <div class="test-results">
        <div class="result-item">
          <span class="result-check">✅</span>
          <span class="result-text">Network scan completed</span>
        </div>
        <div class="result-item">
          <span class="result-check">✅</span>
          <span class="result-text">Service detection completed</span>
        </div>
        <div class="result-item">
          <span class="result-check">✅</span>
          <span class="result-text">Services added to Observatory</span>
        </div>
      </div>

      <div class="test-actions">
        <a href="/app/observatory" class="btn-primary">
          <span class="btn-icon">📊</span>
          View in Observatory
        </a>
        <button id="runAgain" class="btn-secondary">
          <span class="btn-icon">🔄</span>
          Run Test Again
        </button>
      </div>
    </div>
  </div>
</Layout>

<style>
  .test-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .test-card {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .card-header h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .card-description {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .badge {
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .badge-info {
    background: rgba(59, 130, 246, 0.1);
    color: #3B82F6;
  }

  .badge-success {
    background: rgba(34, 197, 94, 0.1);
    color: #22C55E;
  }

  .scan-config {
    display: flex;
    gap: 1rem;
    align-items: flex-end;
    margin-bottom: 1.5rem;
  }

  .scan-config label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .scan-config input {
    flex: 1;
    max-width: 300px;
    padding: 0.75rem 1rem;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .scan-config input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
  }

  .btn-primary,
  .btn-secondary,
  .btn-success {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-primary {
    background: var(--color-primary);
    color: white;
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
  }

  .btn-success {
    background: #22C55E;
    color: white;
  }

  .btn-success:hover {
    background: #16A34A;
  }

  .btn-secondary {
    background: var(--color-bg-subtle);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-border);
  }

  .btn-large {
    padding: 1rem 2rem;
    font-size: 1.05rem;
  }

  .btn-icon {
    font-size: 1.2em;
  }

  .progress-section {
    margin: 1.5rem 0;
  }

  .progress-bar {
    width: 100%;
    height: 8px;
    background: var(--color-bg-subtle);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }

  .progress-fill {
    height: 100%;
    background: var(--color-primary);
    transition: width 0.3s ease;
    width: 0%;
  }

  .progress-text {
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .log-output {
    background: #0F172A;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    max-height: 200px;
    overflow-y: auto;
    margin-top: 1rem;
  }

  .log-output:empty {
    display: none;
  }

  .log-entry {
    padding: 0.25rem 0;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .log-level {
    font-weight: 600;
    flex-shrink: 0;
    width: 60px;
  }

  .log-level-info { color: #3B82F6; }
  .log-level-success { color: #22C55E; }
  .log-level-error { color: #EF4444; }

  .hosts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .host-card {
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1rem;
    transition: all 0.2s;
  }

  .host-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .host-ip {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.95rem;
  }

  .host-hostname {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .services-grid {
    margin-top: 1.5rem;
  }

  .service-group {
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1rem;
  }

  .service-group-header {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .service-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .service-tag {
    padding: 0.375rem 0.75rem;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #6366F1;
    font-family: var(--font-mono);
  }

  .integration-summary {
    display: flex;
    gap: 2rem;
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--color-bg-subtle);
    border-radius: 8px;
  }

  .summary-stat {
    flex: 1;
    text-align: center;
  }

  .stat-value {
    display: block;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .result-message {
    margin-top: 1rem;
    padding: 1rem;
    border-radius: 8px;
  }

  .result-message:empty {
    display: none;
  }

  .result-message.success {
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #22C55E;
  }

  .test-results {
    background: var(--color-bg-subtle);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .result-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
  }

  .result-item:not(:last-child) {
    border-bottom: 1px solid var(--color-border);
  }

  .result-check {
    font-size: 1.5rem;
  }

  .result-text {
    font-size: 1rem;
    color: var(--color-text);
  }

  .test-actions {
    display: flex;
    gap: 1rem;
  }
</style>

<script>
  let discoveredHosts: Array<{ ip: string; hostname?: string; services?: any[] }> = [];

  const startScanBtn = document.getElementById('startScan') as HTMLButtonElement;
  const subnetInput = document.getElementById('subnet') as HTMLInputElement;
  const scanProgress = document.getElementById('scanProgress');
  const progressFill = document.getElementById('progressFill');
  const progressText = document.getElementById('progressText');
  const scanLogs = document.getElementById('scanLogs');
  const hostsCard = document.getElementById('hostsCard');
  const hostsList = document.getElementById('hostsList');
  const hostCount = document.getElementById('hostCount');

  const servicesCard = document.getElementById('servicesCard');
  const scanServicesBtn = document.getElementById('scanServices') as HTMLButtonElement;
  const serviceProgress = document.getElementById('serviceProgress');
  const serviceProgressFill = document.getElementById('serviceProgressFill');
  const serviceProgressText = document.getElementById('serviceProgressText');
  const serviceLogs = document.getElementById('serviceLogs');
  const servicesGrid = document.getElementById('servicesGrid');

  const integrationCard = document.getElementById('integrationCard');
  const totalHosts = document.getElementById('totalHosts');
  const totalServices = document.getElementById('totalServices');
  const monitorableServices = document.getElementById('monitorableServices');
  const addToObservatoryBtn = document.getElementById('addToObservatory') as HTMLButtonElement;
  const integrationResult = document.getElementById('integrationResult');

  const resultsCard = document.getElementById('resultsCard');
  const runAgainBtn = document.getElementById('runAgain') as HTMLButtonElement;

  function addLog(level: string, message: string, container: HTMLElement) {
    const entry = document.createElement('div');
    entry.className = 'log-entry';
    entry.innerHTML = `
      <span class="log-level log-level-${level}">[${level.toUpperCase()}]</span>
      <span>${message}</span>
    `;
    container.appendChild(entry);
    container.scrollTop = container.scrollHeight;
  }

  startScanBtn?.addEventListener('click', async () => {
    const subnet = subnetInput.value.trim();
    if (!subnet) return;

    // Reset UI
    startScanBtn.disabled = true;
    startScanBtn.textContent = 'Scanning...';
    scanProgress!.style.display = 'block';
    scanLogs!.innerHTML = '';
    hostsCard!.style.display = 'none';
    servicesCard!.style.display = 'none';
    integrationCard!.style.display = 'none';
    resultsCard!.style.display = 'none';

    try {
      const response = await fetch('/app/api/network/scan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ subnet })
      });

      const reader = response.body!.getReader();
      const decoder = new TextDecoder();

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        const chunk = decoder.decode(value);
        const lines = chunk.split('\n').filter(l => l.trim());

        for (const line of lines) {
          try {
            const data = JSON.parse(line);

            if (data.type === 'progress') {
              progressFill!.style.width = `${data.percent}%`;
              progressText!.textContent = `${data.percent}%`;
            }

            if (data.type === 'log') {
              addLog(data.level, data.message, scanLogs!);
            }

            if (data.type === 'complete') {
              discoveredHosts = data.hosts;
              displayHosts(discoveredHosts);
              hostsCard!.style.display = 'block';
              servicesCard!.style.display = 'block';
            }
          } catch (e) {
            console.error('Failed to parse line:', line, e);
          }
        }
      }
    } catch (error: any) {
      addLog('error', error.message, scanLogs!);
    } finally {
      startScanBtn.disabled = false;
      startScanBtn.innerHTML = '<span class="btn-icon">🌐</span> Start Scan';
    }
  });

  function displayHosts(hosts: any[]) {
    hostsList!.innerHTML = hosts.map(host => `
      <div class="host-card">
        <div class="host-ip">${host.ip}</div>
        ${host.hostname ? `<div class="host-hostname">${host.hostname}</div>` : ''}
      </div>
    `).join('');
    hostCount!.textContent = `${hosts.length} hosts`;
  }

  scanServicesBtn?.addEventListener('click', async () => {
    if (discoveredHosts.length === 0) return;

    scanServicesBtn.disabled = true;
    scanServicesBtn.textContent = 'Scanning...';
    serviceProgress!.style.display = 'block';
    serviceLogs!.innerHTML = '';
    servicesGrid!.innerHTML = '';

    try {
      const response = await fetch('/app/api/network/scan-services', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hosts: discoveredHosts })
      });

      const reader = response.body!.getReader();
      const decoder = new TextDecoder();

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        const chunk = decoder.decode(value);
        const lines = chunk.split('\n').filter(l => l.trim());

        for (const line of lines) {
          try {
            const data = JSON.parse(line);

            if (data.type === 'progress') {
              serviceProgressFill!.style.width = `${data.percent}%`;
              serviceProgressText!.textContent = `${data.percent}%`;
            }

            if (data.type === 'log') {
              addLog(data.level, data.message, serviceLogs!);
            }

            if (data.type === 'complete') {
              discoveredHosts = data.hosts;
              displayServices(discoveredHosts);
              integrationCard!.style.display = 'block';
              updateIntegrationSummary();
            }
          } catch (e) {
            console.error('Failed to parse line:', line, e);
          }
        }
      }
    } catch (error: any) {
      addLog('error', error.message, serviceLogs!);
    } finally {
      scanServicesBtn.disabled = false;
      scanServicesBtn.innerHTML = '<span class="btn-icon">🔌</span> Scan for Services';
    }
  });

  function displayServices(hosts: any[]) {
    const hostsWithServices = hosts.filter(h => h.services && h.services.length > 0);

    servicesGrid!.innerHTML = hostsWithServices.map(host => `
      <div class="service-group">
        <div class="service-group-header">
          <span>💻</span>
          <span>${host.ip}${host.hostname ? ` (${host.hostname})` : ''}</span>
        </div>
        <div class="service-list">
          ${host.services.map((s: any) => `
            <span class="service-tag">${s.port} - ${s.service}</span>
          `).join('')}
        </div>
      </div>
    `).join('');
  }

  function updateIntegrationSummary() {
    const servicesCount = discoveredHosts.reduce((sum, h) => sum + (h.services?.length || 0), 0);
    const monitorable = discoveredHosts.filter(h => h.services && h.services.length > 0).length;

    totalHosts!.textContent = discoveredHosts.length.toString();
    totalServices!.textContent = servicesCount.toString();
    monitorableServices!.textContent = monitorable.toString();
  }

  addToObservatoryBtn?.addEventListener('click', async () => {
    addToObservatoryBtn.disabled = true;
    addToObservatoryBtn.textContent = 'Adding...';

    try {
      // Get all discovered service IDs (would need to be stored during scan)
      // For now, send the discovered hosts data
      const response = await fetch('/app/api/observatory/add-targets', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          serviceIds: [], // TODO: Track service IDs during scan
          hosts: discoveredHosts // Send host data as fallback
        })
      });

      if (!response.ok) {
        throw new Error('Failed to add services to Observatory');
      }

      const result = await response.json();

      integrationResult!.className = 'result-message success';
      integrationResult!.textContent = `✅ Successfully added ${result.added || 0} services to Observatory monitoring!`;

      setTimeout(() => {
        resultsCard!.style.display = 'block';
      }, 1000);

    } catch (error: any) {
      integrationResult!.className = 'result-message error';
      integrationResult!.textContent = `❌ Error: ${error.message}`;
    } finally {
      addToObservatoryBtn.disabled = false;
      addToObservatoryBtn.innerHTML = '<span class="btn-icon">✅</span> Add to Observatory Monitoring';
    }
  });

  runAgainBtn?.addEventListener('click', () => {
    window.location.reload();
  });
</script>
</Layout>
