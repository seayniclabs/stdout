---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { getTenantDb, tenantSchema } from '../../../lib/db';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

const db = getTenantDb(Astro.locals.workspace?.ownerId || user.id);
const monitors = db.select().from(tenantSchema.monitors)
  .where(eq(tenantSchema.monitors.userId, user.id)).all();

// Try to get stack data for grouping
const stacks = db.select().from(tenantSchema.stacks)
  .where(eq(tenantSchema.stacks.userId, user.id)).all();

// Group monitors by stack
const stackMap = new Map<string, typeof monitors>();
const ungrouped: typeof monitors = [];

for (const m of monitors) {
  if (m.stackId) {
    const group = stackMap.get(m.stackId) || [];
    group.push(m);
    stackMap.set(m.stackId, group);
  } else {
    ungrouped.push(m);
  }
}

// Build nodes for the map
interface MapNode {
  id: string;
  name: string;
  status: string;
  group: string;
  responseMs: number;
}

const nodes: MapNode[] = monitors.map(m => ({
  id: m.id,
  name: m.name,
  status: m.maintenance ? 'maintenance' : m.currentStatus,
  group: m.stackId || 'ungrouped',
  responseMs: m.lastResponseMs || 0,
}));

const groups: Array<{ id: string; name: string; count: number }> = [];
for (const [stackId, mons] of stackMap) {
  const stack = stacks.find(s => s.id === stackId);
  groups.push({ id: stackId, name: stack?.name || 'Unknown Stack', count: mons.length });
}
if (ungrouped.length > 0) {
  groups.push({ id: 'ungrouped', name: 'Unlinked', count: ungrouped.length });
}
---
<Layout title="Service Map — HUD — StdOut">
  <div class="map-page">
    <div class="map-header">
      <div>
        <h1>Service Map</h1>
        <span class="mono" style="font-size:12px;color:var(--text-muted);">{monitors.length} services across {groups.length} group{groups.length !== 1 ? 's' : ''}</span>
      </div>
      <a href="/app/hud" class="btn btn-ghost btn-sm">&larr; HUD Table</a>
    </div>

    <div class="map-canvas" id="mapCanvas">
      {groups.map((group, gi) => {
        const groupMonitors = nodes.filter(n => n.group === group.id);
        return (
          <div class="map-group" style={`--group-idx:${gi};`}>
            <div class="group-label mono">{group.name}</div>
            <div class="group-nodes">
              {groupMonitors.map(node => (
                <a href={`/app/hud/${node.id}`} class={`map-node ${node.status}`} title={`${node.name} — ${node.status} (${node.responseMs}ms)`}>
                  <div class={`node-dot ${node.status}`}></div>
                  <div class="node-name">{node.name}</div>
                  {node.responseMs > 0 && <div class="node-ms mono">{node.responseMs}ms</div>}
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    <div class="map-legend">
      <span class="legend-item"><span class="legend-dot healthy"></span> Healthy</span>
      <span class="legend-item"><span class="legend-dot degraded"></span> Degraded</span>
      <span class="legend-item"><span class="legend-dot down"></span> Down</span>
      <span class="legend-item"><span class="legend-dot maintenance"></span> Maintenance</span>
      <span class="legend-item"><span class="legend-dot unknown"></span> Unknown</span>
    </div>
  </div>
</Layout>

<style>
  .map-page { max-width: 1000px; margin: 0 auto; }
  .map-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
  .map-header h1 { font-size: 20px; font-weight: 700; font-family: var(--font-mono); letter-spacing: 0.06em; }

  .map-canvas { display: flex; flex-direction: column; gap: 20px; margin-bottom: 24px; }

  .map-group { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg, 12px); padding: 20px; box-shadow: var(--shadow-sm); }
  .group-label { font-size: 12px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 14px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
  .group-nodes { display: flex; flex-wrap: wrap; gap: 10px; }

  .map-node { display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none; color: inherit; transition: all 0.15s ease; min-width: 140px; }
  .map-node:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .map-node.down { border-color: rgba(239,68,68,0.3); }
  .map-node.degraded { border-color: rgba(234,179,8,0.3); }

  .node-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .node-dot.healthy { background: var(--low); box-shadow: 0 0 6px rgba(34,197,94,0.4); }
  .node-dot.degraded { background: var(--high); box-shadow: 0 0 6px rgba(234,179,8,0.4); }
  .node-dot.down { background: var(--critical); box-shadow: 0 0 6px rgba(239,68,68,0.4); animation: pulse 2s infinite; }
  .node-dot.maintenance { background: #3b82f6; }
  .node-dot.unknown { background: var(--text-muted); }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 6px rgba(239,68,68,0.4); }
    50% { box-shadow: 0 0 14px rgba(239,68,68,0.7); }
  }

  .node-name { font-size: 13px; font-weight: 600; }
  .node-ms { font-size: 11px; color: var(--text-muted); margin-left: auto; }

  .map-legend { display: flex; gap: 16px; flex-wrap: wrap; font-size: 12px; color: var(--text-muted); }
  .legend-item { display: flex; align-items: center; gap: 4px; }
  .legend-dot { width: 8px; height: 8px; border-radius: 50%; }
  .legend-dot.healthy { background: var(--low); }
  .legend-dot.degraded { background: var(--high); }
  .legend-dot.down { background: var(--critical); }
  .legend-dot.maintenance { background: #3b82f6; }
  .legend-dot.unknown { background: var(--text-muted); }

  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border: none; border-radius: var(--radius-sm); font-weight: 600; font-size: 12px; cursor: pointer; text-decoration: none; transition: var(--transition); }
  .btn-sm { padding: 5px 10px; font-size: 11px; }
  .btn-ghost { background: transparent; color: var(--text-secondary); border: 1px solid var(--border); }
  .btn-ghost:hover { border-color: var(--accent); color: var(--text); }
  .mono { font-family: var(--font-mono); }
</style>
