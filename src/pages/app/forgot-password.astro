---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getCentralDb, centralSchema } from '../../lib/db';
import { sendPasswordResetEmail } from '../../lib/email';
import { logAudit, getClientIp } from '../../lib/audit';
import { validateCsrf } from '../../middleware';
import { nanoid } from 'nanoid';
import crypto from 'node:crypto';
import { eq } from 'drizzle-orm';

let submitted = false;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (!validateCsrf(form.get('_csrf') as string, Astro.cookies)) {
    error = 'Invalid form submission.';
  } else {
    const email = (form.get('email') as string || '').trim().toLowerCase();

    if (!email) {
      error = 'Email is required.';
    } else {
      // Always show success to prevent email enumeration
      submitted = true;

      const user = getCentralDb().select().from(centralSchema.users)
        .where(eq(centralSchema.users.email, email)).get();

      if (user) {
        const token = crypto.randomBytes(32).toString('hex');
        const expiresAt = new Date(Date.now() + 60 * 60 * 1000); // 1 hour

        getCentralDb().insert(centralSchema.passwordResets).values({
          id: nanoid(),
          userId: user.id,
          token,
          expiresAt,
          createdAt: new Date(),
        }).run();

        logAudit('password_reset_request', { userId: user.id, ip: getClientIp(Astro.request) });
        await sendPasswordResetEmail(email, token);
      }
    }
  }
}

if (Astro.locals.user) return Astro.redirect('/app');
---
<Layout title="Forgot Password — StdOut">
  <div class="auth-page">
    <h1>Reset your password</h1>

    {submitted ? (
      <div class="success-msg">
        <p>If an account exists with that email, we've sent a reset link. Check your inbox.</p>
        <a href="/app/login" class="back-link">Back to login</a>
      </div>
    ) : (
      <>
        <p class="auth-subtitle">Enter your email and we'll send you a reset link.</p>
        {error && <div class="auth-error">{error}</div>}
        <form method="POST" class="auth-form">
          <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
          <label>
            <span>Email</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <button type="submit">Send reset link</button>
        </form>
        <p class="auth-switch"><a href="/app/login">Back to login</a></p>
      </>
    )}
  </div>
</Layout>

<style>
  .success-msg { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; text-align: left; }
  .success-msg p { font-size: 14px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 16px; }
  .back-link { color: var(--accent-light); font-size: 13px; }
</style>
