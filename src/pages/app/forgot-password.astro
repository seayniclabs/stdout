---
export const prerender = false;
// Password reset is handled by the store (seayniclabs.com) — it owns the user directory.
// After reset, the store redirects back to StdOut login.
const storeUrl = process.env.STORE_API_URL || 'https://store.seayniclabs.com';
const returnTo = encodeURIComponent('https://stdout.seayniclabs.com/app/login');
return Astro.redirect(`${storeUrl}/auth/forgot-password?return_to=${returnTo}`, 302);
---
