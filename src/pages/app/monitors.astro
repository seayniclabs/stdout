---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getDb } from '../../lib/db';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

const db = getDb();
const rawDb = (db as any).$client;

// Get all monitors with stats
const monitors = rawDb.prepare(`
  SELECT
    id, name, type, target, current_status,
    interval_seconds, paused, consecutive_failures,
    last_check_at, next_check_at
  FROM monitors
  WHERE user_id = ?
  ORDER BY
    CASE current_status
      WHEN 'down' THEN 1
      WHEN 'degraded' THEN 2
      WHEN 'unknown' THEN 3
      WHEN 'healthy' THEN 4
    END,
    name
`).all(user.id);

const statusCounts = {
  healthy: monitors.filter(m => m.current_status === 'healthy').length,
  degraded: monitors.filter(m => m.current_status === 'degraded').length,
  down: monitors.filter(m => m.current_status === 'down').length,
  unknown: monitors.filter(m => m.current_status === 'unknown').length,
  paused: monitors.filter(m => m.paused === 1).length,
};
---

<Layout title="All Monitors — StdOut">
  <div class="monitors-page">
    <div class="page-header">
      <h1>All Monitors ({monitors.length})</h1>
      <div class="status-summary">
        <span class="stat healthy">{statusCounts.healthy} healthy</span>
        <span class="stat unknown">{statusCounts.unknown} pending</span>
        {statusCounts.degraded > 0 && <span class="stat degraded">{statusCounts.degraded} degraded</span>}
        {statusCounts.down > 0 && <span class="stat down">{statusCounts.down} down</span>}
        {statusCounts.paused > 0 && <span class="stat paused">{statusCounts.paused} paused</span>}
      </div>
    </div>

    <div class="monitors-grid">
      {monitors.map(monitor => {
        const statusClass = monitor.paused ? 'paused' : monitor.current_status;
        const statusText = monitor.paused ? 'Paused' :
                          monitor.current_status === 'unknown' ? 'Pending first check' :
                          monitor.current_status;

        return (
          <div class={`monitor-card ${statusClass}`}>
            <div class="monitor-header">
              <div class={`status-dot ${statusClass}`}></div>
              <h3 class="monitor-name">{monitor.name}</h3>
              <span class="monitor-type mono">{monitor.type}</span>
            </div>
            <div class="monitor-target mono">{monitor.target}</div>
            <div class="monitor-meta">
              <span class="status-text">{statusText}</span>
              {monitor.consecutive_failures > 0 && (
                <span class="failures">{monitor.consecutive_failures} failures</span>
              )}
            </div>
            <div class="monitor-schedule">
              Checks every {monitor.interval_seconds}s
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Layout>

<style>
  .monitors-page { max-width: 1400px; margin: 0 auto; padding: 20px; }
  .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .page-header h1 { font-size: 24px; }
  .status-summary { display: flex; gap: 16px; }
  .stat { font-size: 13px; padding: 4px 12px; border-radius: 12px; font-family: var(--font-mono); }
  .stat.healthy { background: rgba(34,197,94,0.15); color: var(--low); }
  .stat.unknown { background: rgba(100,116,139,0.15); color: var(--text-muted); }
  .stat.degraded { background: rgba(251,191,36,0.15); color: var(--high); }
  .stat.down { background: rgba(239,68,68,0.15); color: var(--critical); }
  .stat.paused { background: rgba(100,116,139,0.15); color: var(--text-muted); }

  .monitors-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 12px; }
  .monitor-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; transition: all 150ms; }
  .monitor-card:hover { border-color: var(--accent); }
  .monitor-card.down { border-left: 3px solid var(--critical); }
  .monitor-card.degraded { border-left: 3px solid var(--high); }
  .monitor-card.healthy { border-left: 3px solid var(--low); }
  .monitor-card.paused { opacity: 0.6; }

  .monitor-header { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .status-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .status-dot.healthy { background: var(--low); }
  .status-dot.degraded { background: var(--high); }
  .status-dot.down { background: var(--critical); }
  .status-dot.unknown { background: var(--text-muted); animation: pulse 2s infinite; }
  .status-dot.paused { background: var(--text-muted); opacity: 0.5; }

  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  .monitor-name { font-size: 15px; font-weight: 600; flex: 1; }
  .monitor-type { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; padding: 2px 6px; background: rgba(100,116,139,0.1); border-radius: 4px; }
  .monitor-target { font-size: 13px; color: var(--text-secondary); margin-bottom: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .monitor-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .status-text { font-size: 12px; color: var(--text-muted); }
  .failures { font-size: 11px; color: var(--critical); font-family: var(--font-mono); }
  .monitor-schedule { font-size: 11px; color: var(--text-muted); }
  .mono { font-family: var(--font-mono); }
</style>
