---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { getDb, schema } from '../../../lib/db';
import { eq, desc, or } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

const db = getDb();

// Fetch user's own docs
const userDocs = db.select().from(schema.docs)
  .where(eq(schema.docs.userId, user.id))
  .orderBy(desc(schema.docs.updatedAt))
  .all();

// Community docs feature not yet implemented
const communityDocs: typeof userDocs = [];

const typeLabels: Record<string, string> = {
  runbook: 'Runbook',
  postmortem: 'Post-Mortem',
  guide: 'Guide',
  note: 'Note',
};

const typeColors: Record<string, string> = {
  runbook: '#3B82F6',
  postmortem: '#EF4444',
  guide: '#22C55E',
  note: '#5A5A72',
};

const typeDimColors: Record<string, string> = {
  runbook: 'rgba(59, 130, 246, 0.12)',
  postmortem: 'rgba(239, 68, 68, 0.12)',
  guide: 'rgba(34, 197, 94, 0.12)',
  note: 'rgba(90, 90, 114, 0.12)',
};

// Community gets purple
const communityColor = '#A855F7';
const communityDimColor = 'rgba(168, 85, 247, 0.12)';

// Count docs by type (user docs only)
const typeCounts: Record<string, number> = { runbook: 0, postmortem: 0, guide: 0, note: 0 };
for (const doc of userDocs) {
  if (typeCounts[doc.docType] !== undefined) typeCounts[doc.docType]++;
}

// StdOut docs: community guides tagged as getting-started, or with "StdOut" in title
const stdoutDocs = communityDocs.filter(d =>
  d.title?.toLowerCase().includes('stdout') ||
  d.title?.toLowerCase().includes('getting started') ||
  d.title?.toLowerCase().includes('scanner') ||
  d.title?.toLowerCase().includes('setup') ||
  d.tags?.toLowerCase().includes('stdout') ||
  d.tags?.toLowerCase().includes('getting-started')
);
// If no tagged docs found, fall back to all community guides
const stdoutDocsDisplay = stdoutDocs.length > 0 ? stdoutDocs : communityDocs.filter(d => d.docType === 'guide');

// Recently updated (last 5 from user docs only, since community docs are empty)
const recentlyUpdated = [...userDocs].sort((a, b) => b.updatedAt.getTime() - a.updatedAt.getTime()).slice(0, 5);

// Featured: community docs + most recently updated user docs (up to 4 total)
const featured = [
  ...communityDocs.slice(0, 2),
  ...userDocs.slice(0, 2),
].slice(0, 4);

function truncate(str: string, max: number) {
  if (!str) return '';
  const clean = str.replace(/[#*_`\[\]]/g, '').replace(/\n/g, ' ').trim();
  return clean.length > max ? clean.slice(0, max) + '...' : clean;
}

function timeAgo(date: Date) {
  const ms = Date.now() - date.getTime();
  const mins = Math.floor(ms / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  const days = Math.floor(hrs / 24);
  return `${days}d ago`;
}

function formatDate(date: Date) {
  return date.toISOString().split('T')[0];
}
---
<Layout title="Knowledge Base — StdOut">
  <div class="kb-layout">
    <!-- Sidebar -->
    <aside class="kb-sidebar">
      <div class="sidebar-section">
        <div class="sidebar-label">Guides</div>
        <a href="/app/docs/guide/getting-started" class="sidebar-item" style="color: var(--accent-light);">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <span>Documentation &rarr;</span>
        </a>
      </div>
      <div class="sidebar-section">
        <div class="sidebar-label">Categories</div>
        <button class="sidebar-item active" data-filter="all">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          <span>All Docs</span>
          <span class="sidebar-count mono">{userDocs.length}</span>
        </button>
        <button class="sidebar-item sidebar-item--featured" data-filter="stdout">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FB923C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <span>StdOut</span>
          <span class="sidebar-count mono">{stdoutDocsDisplay.length}</span>
        </button>
        <button class="sidebar-item" data-filter="runbook">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M9 14l2 2 4-4"/></svg>
          <span>Runbooks</span>
          <span class="sidebar-count mono">{typeCounts.runbook}</span>
        </button>
        <button class="sidebar-item" data-filter="postmortem">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          <span>Post-Mortems</span>
          <span class="sidebar-count mono">{typeCounts.postmortem}</span>
        </button>
        <button class="sidebar-item" data-filter="guide">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <span>Guides</span>
          <span class="sidebar-count mono">{typeCounts.guide}</span>
        </button>
        <button class="sidebar-item" data-filter="note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          <span>Notes</span>
          <span class="sidebar-count mono">{typeCounts.note}</span>
        </button>
        <button class="sidebar-item" data-filter="community">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span>Community</span>
          <span class="sidebar-count mono">{communityDocs.length}</span>
        </button>
      </div>

      {recentlyUpdated.length > 0 && (
        <div class="sidebar-section">
          <div class="sidebar-label">Recently Updated</div>
          {recentlyUpdated.map(doc => (
            <a href={`/app/docs/${doc.id}`} class="sidebar-recent">
              <span class="recent-title">{doc.title}</span>
              <span class="recent-time mono">{timeAgo(doc.updatedAt)}</span>
            </a>
          ))}
        </div>
      )}
    </aside>

    <!-- Main content -->
    <main class="kb-main">
      <!-- Page Header -->
      <div class="page-header">
        <div class="page-header-left">
          <div class="page-title-row">
            <h1>Knowledge Base <a href="/app/docs/guide/knowledge-base" class="help-link" title="Knowledge Base documentation"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></a></h1>
            <span class="count-badge mono">{userDocs.length}</span>
          </div>
          <p class="page-subtitle">Your operational knowledge library. Runbooks, post-mortems, guides, and notes -- all searchable alongside your incidents.</p>
        </div>
        <div class="page-header-actions">
          <div class="search-box">
            <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="doc-search" class="search-input" placeholder="Search docs..." />
          </div>
          <a href="/app/docs/new" class="btn btn-primary">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 2v10M2 7h10"/></svg>
            New Doc
          </a>
        </div>
      </div>

      <!-- Mobile category tabs -->
      <div class="mobile-tabs">
        <button class="mobile-tab active" data-filter="all">All</button>
        <button class="mobile-tab" data-filter="stdout">StdOut</button>
        <button class="mobile-tab" data-filter="runbook">Runbooks</button>
        <button class="mobile-tab" data-filter="postmortem">Post-Mortems</button>
        <button class="mobile-tab" data-filter="guide">Guides</button>
        <button class="mobile-tab" data-filter="note">Notes</button>
        <button class="mobile-tab" data-filter="community">Community</button>
      </div>

      {userDocs.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">&gt;_</div>
          <h3>Your knowledge base is empty</h3>
          <p>This is where your operational knowledge lives -- runbooks for recurring issues, post-mortems from resolved incidents, guides for your setup, and notes for everything else. Start by documenting your most common fix, or browse community docs for ideas.</p>
          <div class="empty-actions">
            <a href="/app/docs/new" class="btn btn-primary">Create your first doc</a>
            <a href="/app/search" class="btn btn-ghost">Search community docs</a>
          </div>
          <p class="empty-hint">Docs are searchable alongside incidents and resolutions. The more you document, the better your AI diagnoses become.</p>
        </div>
      ) : (
        <div id="docs-container">
          {/* Featured section */}
          {featured.length > 0 && (
            <div class="featured-section" data-section="featured">
              <div class="section-header">
                <h2>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  Featured
                </h2>
              </div>
              <div class="featured-cards">
                {featured.map(doc => (
                  <a href={`/app/docs/${doc.id}`} class="featured-card" data-type={doc.docType} data-source={doc.source}>
                    <div class="featured-card-top">
                      <span class="type-badge" style={`color: ${doc.source === 'community' ? communityColor : typeColors[doc.docType] || '#5A5A72'}; background: ${doc.source === 'community' ? communityDimColor : typeDimColors[doc.docType] || 'rgba(90,90,114,0.12)'}`}>
                        {doc.source === 'community' ? 'Community' : typeLabels[doc.docType] || doc.docType}
                      </span>
                    </div>
                    <div class="featured-card-title">{doc.title}</div>
                    <div class="featured-card-snippet">{truncate(doc.content, 80)}</div>
                    <div class="featured-card-meta">
                      <span class="mono">{formatDate(doc.updatedAt)}</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

          {/* All docs grid */}
          <div class="docs-section">
            <div class="section-header">
              <h2 id="section-title">All Documents</h2>
              <span class="section-count mono" id="section-count">{userDocs.length}</span>
            </div>
            <div class="doc-grid" id="doc-grid">
              {userDocs.map(doc => (
                <a href={`/app/docs/${doc.id}`}
                   class="doc-card"
                   data-type={doc.docType}
                   data-source={doc.source}
                   data-stdout={stdoutDocsDisplay.some(s => s.id === doc.id) ? 'true' : 'false'}
                   data-title={doc.title.toLowerCase()}
                   data-tags={doc.tags?.toLowerCase() || ''}
                   data-content={truncate(doc.content, 200).toLowerCase()}>
                  <div class="doc-card-header">
                    <div class="doc-card-icon" style={`color: ${doc.source === 'community' ? communityColor : typeColors[doc.docType] || '#5A5A72'}`}>
                      {doc.docType === 'runbook' && (
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M9 14l2 2 4-4"/></svg>
                      )}
                      {doc.docType === 'postmortem' && (
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                      )}
                      {doc.docType === 'guide' && (
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                      )}
                      {doc.docType === 'note' && (
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                      )}
                    </div>
                    <div class="doc-card-badges">
                      <span class="type-badge" style={`color: ${typeColors[doc.docType] || '#5A5A72'}; background: ${typeDimColors[doc.docType] || 'rgba(90,90,114,0.12)'}`}>
                        {typeLabels[doc.docType] || doc.docType}
                      </span>
                      {doc.source === 'community' && (
                        <span class="type-badge" style={`color: ${communityColor}; background: ${communityDimColor}`}>Community</span>
                      )}
                      {doc.source === 'fork' && (
                        <span class="type-badge" style="color: var(--accent-light); background: var(--accent-dim);">Fork</span>
                      )}
                    </div>
                  </div>
                  <div class="doc-card-title">{doc.title}</div>
                  <div class="doc-card-snippet">{truncate(doc.content, 100)}</div>
                  {doc.tags && (
                    <div class="doc-card-tags">
                      {doc.tags.split(',').slice(0, 4).map(tag => (
                        <span class="tag">{tag.trim()}</span>
                      ))}
                    </div>
                  )}
                  <div class="doc-card-footer">
                    <span class="doc-card-date mono">{formatDate(doc.updatedAt)}</span>
                  </div>
                </a>
              ))}
            </div>
            <div class="no-results" id="no-results" style="display:none;">
              <p>No docs match your search or filter.</p>
            </div>
          </div>
        </div>
      )}
    </main>
  </div>
</Layout>

<script>
  // Sidebar + mobile tab filtering
  const sidebarItems = document.querySelectorAll<HTMLButtonElement>('.sidebar-item');
  const mobileTabs = document.querySelectorAll<HTMLButtonElement>('.mobile-tab');
  const docCards = document.querySelectorAll<HTMLAnchorElement>('.doc-card');
  const searchInput = document.getElementById('doc-search') as HTMLInputElement | null;
  const sectionTitle = document.getElementById('section-title');
  const sectionCount = document.getElementById('section-count');
  const noResults = document.getElementById('no-results');
  const featuredSection = document.querySelector('.featured-section') as HTMLElement | null;
  const docGrid = document.getElementById('doc-grid');

  let currentFilter = 'all';
  let currentSearch = '';

  const filterLabels: Record<string, string> = {
    all: 'All Documents',
    stdout: 'StdOut Guides',
    runbook: 'Runbooks',
    postmortem: 'Post-Mortems',
    guide: 'Guides',
    note: 'Notes',
    community: 'Community Library',
  };

  function applyFilters() {
    let visible = 0;
    docCards.forEach(card => {
      const type = card.dataset.type || '';
      const source = card.dataset.source || '';
      const title = card.dataset.title || '';
      const tags = card.dataset.tags || '';
      const content = card.dataset.content || '';

      const isStdout = card.dataset.stdout === 'true';
      let matchFilter = currentFilter === 'all'
        || (currentFilter === 'community' && source === 'community')
        || (currentFilter === 'stdout' && isStdout)
        || type === currentFilter;

      let matchSearch = !currentSearch
        || title.includes(currentSearch)
        || tags.includes(currentSearch)
        || content.includes(currentSearch);

      if (matchFilter && matchSearch) {
        card.style.display = '';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    if (sectionTitle) sectionTitle.textContent = filterLabels[currentFilter] || 'All Documents';
    if (sectionCount) sectionCount.textContent = String(visible);
    if (noResults) noResults.style.display = visible === 0 && docCards.length > 0 ? '' : 'none';
    if (featuredSection) featuredSection.style.display = currentFilter === 'all' && !currentSearch ? '' : 'none';
  }

  function setFilter(filter: string) {
    currentFilter = filter;
    sidebarItems.forEach(btn => btn.classList.toggle('active', btn.dataset.filter === filter));
    mobileTabs.forEach(btn => btn.classList.toggle('active', btn.dataset.filter === filter));
    applyFilters();
  }

  sidebarItems.forEach(btn => {
    btn.addEventListener('click', () => setFilter(btn.dataset.filter || 'all'));
  });

  mobileTabs.forEach(btn => {
    btn.addEventListener('click', () => setFilter(btn.dataset.filter || 'all'));
  });

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      currentSearch = searchInput.value.toLowerCase().trim();
      applyFilters();
    });
  }

  // Auto-select filter from URL param (e.g., /app/docs?filter=stdout)
  const urlFilter = new URLSearchParams(window.location.search).get('filter');
  if (urlFilter && filterLabels[urlFilter]) {
    setFilter(urlFilter);
  }
</script>

<style>
  /* Two-column layout */
  .kb-layout {
    display: flex;
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
    min-height: calc(100vh - 120px);
  }

  /* Sidebar */
  .kb-sidebar {
    width: 250px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .sidebar-section {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px;
    box-shadow: var(--shadow-sm);
  }
  .sidebar-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    padding: 4px 8px 8px;
  }
  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 8px 10px;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 500;
    font-family: var(--font-ui);
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: left;
  }
  .sidebar-item:hover {
    background: var(--bg-hover);
    color: var(--text);
  }
  .sidebar-item.active {
    background: var(--accent-dim);
    color: var(--accent-light);
  }
  .sidebar-item svg {
    flex-shrink: 0;
    opacity: 0.7;
  }
  .sidebar-item.active svg {
    opacity: 1;
  }
  .sidebar-item span:first-of-type {
    flex: 1;
  }
  .sidebar-count {
    font-size: 10px;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 8px;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
  .sidebar-item.active .sidebar-count {
    background: var(--accent-dim);
    border-color: transparent;
    color: var(--accent-light);
  }
  .sidebar-item--featured {
    border-left: 2px solid #FB923C;
    padding-left: 10px;
  }
  .sidebar-item--featured span:first-of-type {
    color: #FB923C;
    font-weight: 600;
  }

  /* Recently updated sidebar links */
  .sidebar-recent {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }
  .sidebar-recent:hover {
    background: var(--bg-hover);
  }
  .recent-title {
    font-size: 12px;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .recent-time {
    font-size: 10px;
    color: var(--text-muted);
  }

  /* Main area */
  .kb-main {
    flex: 1;
    min-width: 0;
  }

  /* Page header */
  .page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 20px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .page-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .page-title-row h1 {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .count-badge {
    font-size: 12px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 10px;
    background: var(--accent-dim);
    color: var(--accent-light);
  }
  .page-subtitle {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 4px;
  }
  .page-header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Search box */
  .search-box {
    position: relative;
  }
  .search-icon {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }
  .search-input {
