---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { getTenantDb, tenantSchema } from '../../../lib/db';
import { eq, desc, or } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

const db = getTenantDb(Astro.locals.workspace?.ownerId || user.id);

// Fetch user's own docs + community docs
const allDocs = db.select().from(tenantSchema.docs)
  .where(or(
    eq(tenantSchema.docs.userId, user.id),
    eq(tenantSchema.docs.source, 'community')
  ))
  .orderBy(desc(tenantSchema.docs.updatedAt))
  .all();

// Split into user docs and community docs for display
const userDocs = allDocs.filter(d => d.source !== 'community');
const communityDocs = allDocs.filter(d => d.source === 'community');

const typeLabels: Record<string, string> = {
  runbook: 'Runbook',
  postmortem: 'Post-Mortem',
  guide: 'Guide',
  note: 'Note',
};
function formatSize(bytes: number): string {
  if (!bytes) return '0 B';
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / 1048576).toFixed(1) + ' MB';
}

const typeColors: Record<string, string> = {
  runbook: 'var(--accent-light)',
  postmortem: 'var(--critical)',
  guide: 'var(--low)',
  note: 'var(--text-muted)',
};
---
<Layout title="Knowledge Base — StdOut">
  <div class="docs-page">
    <div class="page-header">
      <h1>Knowledge Base</h1>
      <a href="/app/docs/new" class="btn btn-primary">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 2v10M2 7h10"/></svg>
        New doc
      </a>
    </div>

    {userDocs.length === 0 && communityDocs.length === 0 ? (
      <div class="empty-state">
        <div class="empty-icon mono">{ }</div>
        <h3>No docs yet</h3>
        <p>Create runbooks, post-mortems, guides, and operational notes. The AI references these in future diagnoses.</p>
        <a href="/app/docs/new" class="btn btn-primary">Create your first doc</a>
      </div>
    ) : null}

    {userDocs.length > 0 && (
      <div class="doc-list">
        {userDocs.map(doc => (
          <a href={`/app/docs/${doc.id}`} class="doc-row">
            <div class="doc-info">
              <div class="doc-title">
                {doc.source === 'fork' && <span class="source-badge fork-badge">Fork</span>}
                {doc.title}
              </div>
              <div class="doc-meta">
                <span class="doc-type" style={`color: ${typeColors[doc.docType] || 'var(--text-muted)'}`}>{typeLabels[doc.docType] || doc.docType}</span>
                {doc.tags && doc.tags.split(',').map(tag => (
                  <span class="tag">{tag.trim()}</span>
                ))}
                <span class="mono" style="color: var(--text-muted);">{formatSize(doc.sizeBytes)}</span>
              </div>
            </div>
            <div class="doc-date mono">{doc.updatedAt.toISOString().split('T')[0]}</div>
          </a>
        ))}
      </div>
    )}

    {communityDocs.length > 0 && (
      <div class="community-section">
        <div class="section-header">
          <h2>Community Library</h2>
          <span class="community-count mono">{communityDocs.length} docs</span>
        </div>
        <div class="doc-list">
          {communityDocs.map(doc => (
            <a href={`/app/docs/${doc.id}`} class="doc-row">
              <div class="doc-info">
                <div class="doc-title">
                  <span class="source-badge community-badge">Community</span>
                  {doc.title}
                </div>
                <div class="doc-meta">
                  <span class="doc-type" style={`color: ${typeColors[doc.docType] || 'var(--text-muted)'}`}>{typeLabels[doc.docType] || doc.docType}</span>
                  {doc.tags && doc.tags.split(',').map(tag => (
                    <span class="tag">{tag.trim()}</span>
                  ))}
                </div>
              </div>
              <div class="doc-date mono">{doc.updatedAt.toISOString().split('T')[0]}</div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>

<style>
  .docs-page { max-width: 800px; margin: 0 auto; }
  .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .page-header h1 { font-size: 20px; }
  .doc-list { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .doc-row { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid var(--border); text-decoration: none; color: inherit; transition: background 150ms; }
  .doc-row:last-child { border-bottom: none; }
  .doc-row:hover { background: var(--bg-surface); }
  .doc-info { flex: 1; min-width: 0; }
  .doc-title { font-size: 13px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 2px; }
  .doc-meta { display: flex; gap: 8px; align-items: center; font-size: 11px; }
  .doc-type { font-weight: 600; font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.04em; }
  .doc-date { font-size: 11px; color: var(--text-muted); flex-shrink: 0; }
  .tag { padding: 1px 6px; border-radius: 3px; font-size: 10px; font-weight: 500; background: var(--accent-dim); color: var(--accent-light); }
  .empty-state { text-align: center; padding: 60px 20px; border: 1px dashed var(--border); border-radius: var(--radius); }
  .empty-icon { font-size: 28px; color: var(--accent); margin-bottom: 16px; }
  .empty-state h3 { font-size: 16px; margin-bottom: 8px; }
  .empty-state p { font-size: 13px; color: var(--text-secondary); margin-bottom: 20px; max-width: 400px; margin-left: auto; margin-right: auto; }
  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border: none; border-radius: var(--radius-sm); font-weight: 600; font-size: 12px; cursor: pointer; text-decoration: none; transition: var(--transition); }
  .btn-primary { background: var(--accent-btn); color: #fff; }
  .btn-primary:hover { background: var(--accent-light); }
  .mono { font-family: var(--font-mono); }
  .community-section { margin-top: 32px; }
  .section-header { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .section-header h2 { font-size: 15px; font-weight: 600; color: var(--text-secondary); }
  .community-count { font-size: 11px; color: var(--text-muted); }
  .source-badge { display: inline-block; padding: 1px 6px; border-radius: 3px; font-size: 9px; font-weight: 700; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.04em; margin-right: 6px; vertical-align: middle; }
  .community-badge { background: rgba(0, 212, 170, 0.12); color: var(--low); }
  .fork-badge { background: var(--accent-dim); color: var(--accent-light); }
</style>

