---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getUserLimits } from '../../lib/tiers';
import { getTeamMembers, getWorkspaceOwnerId } from '../../lib/rbac';
import { getCentralDb, centralSchema } from '../../lib/db';
import { eq, and, desc } from 'drizzle-orm';
import { inArray } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

const { limits } = getUserLimits(user);
const isOwnWorkspace = !Astro.locals.workspace || Astro.locals.workspace.isOwnWorkspace;

let members: any[] = [];
let activityLog: any[] = [];

if (isOwnWorkspace) {
  members = getTeamMembers(getWorkspaceOwnerId(Astro.locals));
  try {
    const db = getCentralDb();
    activityLog = db.select({
      action: centralSchema.auditLog.action,
      details: centralSchema.auditLog.details,
      createdAt: centralSchema.auditLog.createdAt,
    }).from(centralSchema.auditLog)
      .where(and(
        eq(centralSchema.auditLog.userId, user.id),
        inArray(centralSchema.auditLog.action, ['team_invite', 'team_role_update', 'team_remove']),
      ))
      .orderBy(desc(centralSchema.auditLog.createdAt))
      .limit(25)
      .all();
  } catch {}
}

const activeMembers = members.filter(m => m.status === 'accepted');
const pendingMembers = members.filter(m => m.status === 'pending');
const seatCount = activeMembers.length + 1; // +1 for owner

function timeAgo(date: Date | null): string {
  if (!date) return '—';
  const diff = Math.floor((Date.now() - date.getTime()) / 1000);
  if (diff < 60) return 'just now';
  if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
  if (diff < 604800) return `${Math.floor(diff / 86400)}d ago`;
  return date.toLocaleDateString();
}

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function activityLabel(action: string, details: string | null): string {
  let d: any = {};
  try { d = JSON.parse(details || '{}'); } catch {}
  switch (action) {
    case 'team_invite':
      return `Invited <strong>${escapeHtml(String(d.email || 'member'))}</strong> as ${escapeHtml(String(d.role || 'viewer'))}${d.autoAccepted ? ' · auto-accepted' : ' · invite pending'}`;
    case 'team_role_update':
      return `Changed <strong>${escapeHtml(String(d.email || 'member'))}</strong>: ${escapeHtml(String(d.oldRole ?? ''))} → ${escapeHtml(String(d.newRole ?? ''))}`;
    case 'team_remove':
      return `Removed <strong>${escapeHtml(String(d.email || 'member'))}</strong> from team`;
    default:
      return escapeHtml(action);
  }
}
---
<Layout title="Team — StdOut">
  <div class="team-page">

    {!isOwnWorkspace ? (
      <div class="upgrade-gate">
        <div class="upgrade-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="40" height="40">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <h2>Team management is only available in your workspace</h2>
        <p>You're currently viewing a team workspace. Switch back to your own workspace to manage your team.</p>
        <a href="/app" class="btn btn-primary">Go to my workspace</a>
      </div>
    ) : (
      <>
        <div class="team-header">
          <div class="team-header-left">
            <h1>Team</h1>
            <div class="team-meta">
              <span class="seat-badge">{seatCount} / {limits.maxSeats} seats</span>
              <span class="plan-badge">Self-Hosted</span>
            </div>
          </div>
          <button class="btn btn-primary" id="showInviteBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Invite member
          </button>
        </div>

        <!-- Invite form (hidden by default) -->
        <div class="invite-panel" id="invitePanel" style="display:none;">
          <h3>Invite a team member</h3>
          <div class="invite-row">
            <input type="email" id="inviteEmail" class="settings-input" placeholder="Email address" autocomplete="email" />
            <select id="inviteRole" class="settings-input role-select">
              <option value="viewer">Viewer — read only</option>
              <option value="editor">Editor — create & edit</option>
              <option value="admin">Admin — full access</option>
            </select>
            <button class="btn btn-primary" id="inviteBtn">Send invite</button>
            <button class="btn btn-ghost" id="cancelInviteBtn">Cancel</button>
          </div>
          <div id="inviteStatus" class="status-msg"></div>
        </div>

        <!-- Active members -->
        <section class="team-section">
          <div class="section-label">
            <span>Members</span>
            <span class="section-count">{activeMembers.length + 1}</span>
          </div>

          <div class="members-table">
            <!-- Owner row (always first) -->
            <div class="member-row owner-row">
              <div class="member-avatar">{(user.displayName || user.email).charAt(0).toUpperCase()}</div>
              <div class="member-info">
                <div class="member-name">{user.displayName || user.email} <span class="you-tag">you</span></div>
                <div class="member-email mono">{user.email}</div>
              </div>
              <div class="member-role-cell">
                <span class="role-badge role-owner">Owner</span>
              </div>
              <div class="member-joined">—</div>
              <div class="member-actions"></div>
            </div>

            {activeMembers.map(m => (
              <div class="member-row" data-id={m.id}>
                <div class="member-avatar">{m.email.charAt(0).toUpperCase()}</div>
                <div class="member-info">
                  <div class="member-name">{m.email}</div>
                  <div class="member-email mono">Joined {timeAgo(m.acceptedAt)}</div>
                </div>
                <div class="member-role-cell">
                  <select class="role-inline-select" data-member-id={m.id} data-current-role={m.role}>
                    <option value="admin" selected={m.role === 'admin'}>Admin</option>
                    <option value="editor" selected={m.role === 'editor'}>Editor</option>
                    <option value="viewer" selected={m.role === 'viewer'}>Viewer</option>
                  </select>
                </div>
                <div class="member-joined">{timeAgo(m.acceptedAt)}</div>
                <div class="member-actions">
                  <button class="btn-remove" data-member-id={m.id} data-email={m.email} title="Remove member">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                      <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                    </svg>
                  </button>
                </div>
              </div>
            ))}

            {activeMembers.length === 0 && (
              <div class="empty-members">
                No team members yet. Invite someone to collaborate.
              </div>
            )}
          </div>
        </section>

        <!-- Pending invites -->
        {pendingMembers.length > 0 && (
          <section class="team-section">
            <div class="section-label">
              <span>Pending invites</span>
              <span class="section-count pending">{pendingMembers.length}</span>
            </div>

            <div class="members-table">
              {pendingMembers.map(m => (
                <div class="member-row pending-row" data-id={m.id}>
                  <div class="member-avatar pending-avatar">?</div>
                  <div class="member-info">
                    <div class="member-name">{m.email}</div>
                    <div class="member-email mono">Invited {timeAgo(m.invitedAt)}</div>
                  </div>
                  <div class="member-role-cell">
                    <span class={`role-badge role-${m.role}`}>{m.role}</span>
                  </div>
                  <div class="member-joined">
                    <span class="pending-chip">Pending</span>
                  </div>
                  <div class="member-actions">
                    <button class="btn-remove" data-member-id={m.id} data-email={m.email} title="Revoke invite">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                      </svg>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Bottom grid: permissions + activity -->
        <div class="team-grid">

          <!-- Role permissions reference -->
          <section class="team-section">
            <div class="section-label"><span>Role permissions</span></div>
            <table class="perm-table">
              <thead>
                <tr>
                  <th></th>
                  <th>Owner</th>
                  <th>Admin</th>
                  <th>Editor</th>
                  <th>Viewer</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>View incidents, stacks, docs</td>
                  <td class="check">✓</td><td class="check">✓</td><td class="check">✓</td><td class="check">✓</td>
                </tr>
                <tr>
                  <td>Create incidents &amp; docs</td>
                  <td class="check">✓</td><td class="check">✓</td><td class="check">✓</td><td class="dash">—</td>
                </tr>
                <tr>
                  <td>Edit incidents &amp; docs</td>
                  <td class="check">✓</td><td class="check">✓</td><td class="check">✓</td><td class="dash">—</td>
                </tr>
                <tr>
                  <td>Delete incidents &amp; docs</td>
                  <td class="check">✓</td><td class="check">✓</td><td class="dash">—</td><td class="dash">—</td>
                </tr>
                <tr>
                  <td>Manage monitors</td>
                  <td class="check">✓</td><td class="check">✓</td><td class="check">✓</td><td class="dash">—</td>
                </tr>
                <tr>
                  <td>Manage team &amp; settings</td>
                  <td class="check">✓</td><td class="check">✓</td><td class="dash">—</td><td class="dash">—</td>
                </tr>
                <tr>
                  <td>Backup &amp; export</td>
                  <td class="check">✓</td><td class="check">✓</td><td class="dash">—</td><td class="dash">—</td>
                </tr>
              </tbody>
            </table>
          </section>

          <!-- Activity feed -->
          <section class="team-section">
            <div class="section-label"><span>Activity</span></div>
            {activityLog.length > 0 ? (
              <ul class="activity-list">
                {activityLog.map(item => (
                  <li class="activity-item">
                    <span class="activity-dot"></span>
                    <span class="activity-text" set:html={activityLabel(item.action, item.details)}></span>
                    <span class="activity-time mono">{timeAgo(item.createdAt)}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <div class="empty-activity">No team activity yet.</div>
            )}
          </section>

        </div>

        <div id="globalStatus" class="status-msg global-status"></div>
      </>
    )}

  </div>
</Layout>

<script>
  const csrfToken = (document.querySelector('meta[name="csrf-token"]') as HTMLMetaElement)?.content || '';

  async function apiPost(body: object) {
    const res = await fetch('/app/api/team', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
      body: JSON.stringify(body),
    });
    return { ok: res.ok, data: await res.json() };
  }

  function showStatus(el: HTMLElement | null, msg: string, ok: boolean) {
    if (!el) return;
    el.textContent = msg;
    el.className = 'status-msg ' + (ok ? 'status-ok' : 'status-err');
    if (ok) setTimeout(() => { if (el) el.textContent = ''; }, 3500);
  }

  // Show/hide invite panel
  const showBtn = document.getElementById('showInviteBtn');
  const panel = document.getElementById('invitePanel');
  const cancelBtn = document.getElementById('cancelInviteBtn');

  showBtn?.addEventListener('click', () => {
    if (panel) panel.style.display = 'block';
    (document.getElementById('inviteEmail') as HTMLInputElement)?.focus();
    showBtn.style.display = 'none';
  });
  cancelBtn?.addEventListener('click', () => {
    if (panel) panel.style.display = 'none';
    if (showBtn) showBtn.style.display = '';
    (document.getElementById('inviteStatus') as HTMLElement).textContent = '';
  });

  // Invite
  document.getElementById('inviteBtn')?.addEventListener('click', async () => {
    const email = (document.getElementById('inviteEmail') as HTMLInputElement).value.trim();
    const role = (document.getElementById('inviteRole') as HTMLSelectElement).value;
    const status = document.getElementById('inviteStatus') as HTMLElement;

    if (!email) { showStatus(status, 'Enter an email address.', false); return; }

    const btn = document.getElementById('inviteBtn') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Sending…';

    const { ok, data } = await apiPost({ action: 'invite', email, role });
    btn.disabled = false;
    btn.textContent = 'Send invite';

    if (ok) {
      showStatus(status, `Invite sent to ${email}.`, true);
      (document.getElementById('inviteEmail') as HTMLInputElement).value = '';
      setTimeout(() => window.location.reload(), 1200);
    } else {
      showStatus(status, data.error || 'Invite failed.', false);
    }
  });

  // Role change
  document.querySelectorAll<HTMLSelectElement>('.role-inline-select').forEach(sel => {
    sel.addEventListener('change', async () => {
      const memberId = sel.dataset.memberId!;
      const role = sel.value;
      const prev = sel.dataset.currentRole!;
      const status = document.getElementById('globalStatus') as HTMLElement;

      const { ok, data } = await apiPost({ action: 'update_role', memberId, role });
      if (ok) {
        sel.dataset.currentRole = role;
        showStatus(status, `Role updated to ${role}.`, true);
      } else {
        sel.value = prev; // revert
        showStatus(status, data.error || 'Failed to update role.', false);
      }
    });
  });

  // Remove / revoke
  document.querySelectorAll<HTMLButtonElement>('.btn-remove').forEach(btn => {
    btn.addEventListener('click', async () => {
      const memberId = btn.dataset.memberId!;
      const email = btn.dataset.email || 'this member';
      const status = document.getElementById('globalStatus') as HTMLElement;

      if (!confirm(`Remove ${email} from your team?`)) return;

      const { ok, data } = await apiPost({ action: 'remove', memberId });
      if (ok) {
        btn.closest('.member-row')?.remove();
        showStatus(status, `${email} removed.`, true);
      } else {
        showStatus(status, data.error || 'Failed to remove member.', false);
      }
    });
  });
</script>

<style>
.team-page {
  max-width: 900px;
  margin: 0 auto;
  padding: 2rem 1.5rem 4rem;
}

/* ── Upgrade gate ── */
.upgrade-gate {
  text-align: center;
  padding: 4rem 2rem;
  max-width: 480px;
  margin: 0 auto;
}
.upgrade-icon {
  width: 72px;
  height: 72px;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1.5rem;
  color: var(--accent);
}
.upgrade-gate h2 { font-size: 1.4rem; margin-bottom: 0.75rem; }
.upgrade-gate p { color: var(--muted); margin-bottom: 1.5rem; line-height: 1.6; }
.upgrade-gate .btn { margin-bottom: 1rem; }
.upgrade-note { font-size: 13px; color: var(--muted); }
.upgrade-note a { color: var(--accent); }

/* ── Header ── */
.team-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.75rem;
}
.team-header-left { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
.team-header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; }
.team-meta { display: flex; align-items: center; gap: 0.5rem; }
.seat-badge {
  font-size: 12px;
  font-weight: 600;
  padding: 2px 8px;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: 20px;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}
.plan-badge {
  font-size: 11px;
  font-weight: 700;
  padding: 2px 7px;
  background: var(--accent-dim, rgba(249,115,22,0.12));
  border: 1px solid var(--accent-glow, rgba(249,115,22,0.25));
  border-radius: 20px;
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* ── Invite panel ── */
.invite-panel {
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 1.25rem 1.5rem;
  margin-bottom: 1.5rem;
}
.invite-panel h3 { font-size: 14px; font-weight: 600; margin: 0 0 0.75rem; }
.invite-row {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  align-items: center;
}
.invite-row .settings-input { flex: 1; min-width: 160px; }
.role-select { max-width: 200px; }

/* ── Section ── */
.team-section {
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  margin-bottom: 1.25rem;
  overflow: hidden;
}
.section-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1.25rem;
  border-bottom: 1px solid var(--border);
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--muted);
}
.section-count {
  font-size: 11px;
  padding: 1px 6px;
  background: rgba(255,255,255,0.06);
  border-radius: 10px;
  color: var(--muted);
}
.section-count.pending { color: #f59e0b; background: rgba(245,158,11,0.12); }

/* ── Members table ── */
.members-table { padding: 0.25rem 0; }
.member-row {
  display: grid;
  grid-template-columns: 36px 1fr 140px 90px 40px;
  align-items: center;
  gap: 0.75rem;
  padding: 0.6rem 1.25rem;
  border-bottom: 1px solid var(--border);
  transition: background 0.12s;
}
.member-row:last-child { border-bottom: none; }
.member-row:hover { background: rgba(255,255,255,0.025); }

.member-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light, var(--accent)) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}
.pending-avatar {
  background: rgba(255,255,255,0.08);
  color: var(--muted);
  border: 1px dashed var(--border);
}

.member-info { min-width: 0; }
.member-name {
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}
.member-email {
  font-size: 11px;
  color: var(--muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.you-tag {
  font-size: 10px;
  padding: 1px 5px;
  background: var(--accent-dim, rgba(249,115,22,0.12));
  color: var(--accent);
  border-radius: 3px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.member-role-cell { display: flex; align-items: center; }
.role-badge {
  font-size: 11px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 4px;
  text-transform: capitalize;
}
.role-owner { background: rgba(249,115,22,0.14); color: var(--accent); }
.role-admin { background: rgba(139,92,246,0.14); color: #a78bfa; }
.role-editor { background: rgba(16,185,129,0.14); color: #34d399; }
.role-viewer { background: rgba(148,163,184,0.1); color: var(--muted); }

.role-inline-select {
  font-size: 12px;
  font-weight: 600;
  padding: 3px 24px 3px 8px;
  border: 1px solid var(--border);
  border-radius: 5px;
  background: var(--bg-base, #0d1117);
  color: var(--text, #e2e8f0);
  cursor: pointer;
  appearance: auto;
}
.role-inline-select:hover { border-color: var(--accent); }

.member-joined { font-size: 11px; color: var(--muted); }
.member-actions { display: flex; align-items: center; justify-content: flex-end; }

.pending-chip {
  font-size: 11px;
  font-weight: 600;
  padding: 2px 6px;
  background: rgba(245,158,11,0.12);
  color: #f59e0b;
  border-radius: 4px;
}

.btn-remove {
  background: none;
  border: none;
  padding: 4px 6px;
  cursor: pointer;
  color: var(--muted);
  border-radius: 4px;
  display: flex;
  align-items: center;
  transition: color 0.15s, background 0.15s;
}
.btn-remove:hover { color: #ef4444; background: rgba(239,68,68,0.08); }

.owner-row { cursor: default; }
.pending-row { opacity: 0.75; }

.empty-members {
  padding: 2rem;
  text-align: center;
  font-size: 13px;
  color: var(--muted);
}

/* ── Bottom grid ── */
.team-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
}
@media (max-width: 680px) {
  .team-grid { grid-template-columns: 1fr; }
  .member-row { grid-template-columns: 36px 1fr 110px 0 32px; }
  .member-joined { display: none; }
}

/* ── Permissions table ── */
.perm-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}
.perm-table th {
  padding: 0.5rem 0.75rem;
  text-align: center;
  font-size: 11px;
  font-weight: 700;
  color: var(--muted);
  border-bottom: 1px solid var(--border);
}
.perm-table th:first-child { text-align: left; }
.perm-table td {
  padding: 0.45rem 0.75rem;
  border-bottom: 1px solid rgba(255,255,255,0.04);
  color: var(--muted);
  text-align: center;
}
.perm-table td:first-child { text-align: left; font-size: 12px; }
.perm-table tr:last-child td { border-bottom: none; }
.perm-table .check { color: #34d399; font-weight: 700; }
.perm-table .dash { color: rgba(255,255,255,0.15); }

/* ── Activity feed ── */
.activity-list {
  list-style: none;
  margin: 0;
  padding: 0.5rem 0;
}
.activity-item {
  display: grid;
  grid-template-columns: 8px 1fr auto;
  align-items: start;
