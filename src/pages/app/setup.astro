---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');
---
<Layout title="StdOut Setup — Complete Installation">
  <div class="setup-page">
    <div class="setup-header">
      <h1>Welcome to StdOut</h1>
      <p class="subtitle">Automated installation and configuration</p>
    </div>

    <div class="setup-container">
      <!-- Animated Splash Screen -->
      <div class="splash-screen" id="splashScreen">
        <div class="splash-icon">📡</div>
        <div class="splash-status" id="splashStatus">Initializing StdOut...</div>
        <div class="splash-progress">
          <div class="splash-progress-bar">
            <div class="splash-progress-fill" id="splashProgressFill"></div>
          </div>
          <div class="splash-percent" id="splashPercent">0%</div>
        </div>
        <div class="splash-substatus" id="splashSubstatus">Preparing installation environment</div>
      </div>
    </div>
  </div>

  <style>
    .setup-page {
      padding: 0;
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
    }

    .setup-header {
      text-align: center;
      margin-bottom: 3rem;
    }

    .setup-header h1 {
      font-size: 2.5rem;
      font-weight: 700;
      margin: 0 0 0.5rem 0;
      color: #F8FAFC;
    }

    .subtitle {
      font-size: 1.125rem;
      color: #94A3B8;
      margin: 0;
    }

    .setup-container {
      width: 100%;
      max-width: 600px;
      padding: 0 2rem;
    }

    /* Animated Splash Screen */
    .splash-screen {
      text-align: center;
      padding: 3rem 2rem;
      background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(30, 41, 59, 0.6) 100%);
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }

    .splash-icon {
      font-size: 6rem;
      margin-bottom: 2rem;
      display: inline-block;
      animation: radar-pulse 2s ease-in-out infinite;
    }

    @keyframes radar-pulse {
      0%, 100% {
        transform: scale(1) rotate(0deg);
        opacity: 1;
      }
      50% {
        transform: scale(1.1) rotate(180deg);
        opacity: 0.8;
      }
    }

    .splash-status {
      font-size: 1.5rem;
      font-weight: 600;
      color: #F8FAFC;
      margin-bottom: 2rem;
    }

    .splash-progress {
      margin: 2rem 0;
    }

    .splash-progress-bar {
      width: 100%;
      height: 8px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 1rem;
    }

    .splash-progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #F97316 0%, #FB923C 100%);
      border-radius: 4px;
      transition: width 0.5s ease;
      width: 0%;
      box-shadow: 0 0 20px rgba(249, 115, 22, 0.6);
    }

    .splash-percent {
      font-size: 2.5rem;
      font-weight: 700;
      color: #F97316;
      font-family: 'Fira Code', monospace;
    }

    .splash-substatus {
      font-size: 0.875rem;
      color: #94A3B8;
      margin-top: 1.5rem;
      font-family: 'Fira Code', monospace;
    }
  </style>

  <script>
    function updateSplashProgress(progress: number, status: string, substatus: string) {
      const progressFill = document.getElementById('splashProgressFill');
      const percent = document.getElementById('splashPercent');
      const statusEl = document.getElementById('splashStatus');
      const substatusEl = document.getElementById('splashSubstatus');

      if (progressFill) progressFill.style.width = `${progress}%`;
      if (percent) percent.textContent = `${Math.round(progress)}%`;
      if (statusEl) statusEl.textContent = status;
      if (substatusEl) substatusEl.textContent = substatus;
    }

    async function startInstallation() {
      updateSplashProgress(5, 'Starting installation...', 'Connecting to installation service');

      const eventSource = new EventSource('/app/api/setup/install-stream');

      eventSource.addEventListener('state', (e) => {
        const state = JSON.parse(e.data);
        const progress = state.overallProgress || 0;
        const status = state.status || 'Installing...';

        // Get the most recent step for substatus
        const runningStep = state.steps?.find((s: any) => s.status === 'running');
        const substatus = runningStep ? runningStep.description : 'Processing...';

        updateSplashProgress(progress, status, substatus);
      });

      eventSource.addEventListener('event', (e) => {
        const event = JSON.parse(e.data);

        if (event.type === 'step_start' || event.type === 'output') {
          const substatus = event.message || 'Processing...';
          const statusEl = document.getElementById('splashStatus');
          updateSplashProgress(
            parseFloat(document.getElementById('splashProgressFill')?.style.width || '0'),
            statusEl?.textContent || 'Installing...',
            substatus
          );
        }
      });

      eventSource.addEventListener('complete', (e) => {
        updateSplashProgress(100, 'Installation complete!', 'Redirecting to dashboard...');
        eventSource.close();

        // Redirect to dashboard after brief delay
        setTimeout(() => {
          window.location.href = '/app';
        }, 1500);
      });

      eventSource.addEventListener('error', (e: any) => {
        updateSplashProgress(0, 'Installation error', 'Please refresh and try again');
        eventSource.close();
      });
    }

    // Auto-start installation
    setTimeout(() => {
      startInstallation();
    }, 500);
  </script>
</Layout>
