---
import Layout from '../../../layouts/Layout.astro';
const meta = { title: 'CrowdSec Integration - StdOut', description: 'Connect StdOut to CrowdSec for collaborative IPS and malicious IP blocking.', canonical: 'https://stdout.app/app/integrations/crowdsec' };
---
<Layout {meta}>
  <main class="integration-page">
    <header class="integration-header">
      <h1>CrowdSec Integration</h1>
      <p>Collaborative IPS with community threat intelligence.</p>
      <span class="status-badge">Not Configured</span>
    </header>
    <section class="integration-config">
      <h2>Configuration</h2>
      <form>
        <div class="form-group">
          <label for="crowdsec-api">CrowdSec Local API URL</label>
          <input type="text" id="crowdsec-api" value="http://localhost:8080" />
        </div>
        <div class="form-group">
          <label>
            <input type="checkbox" name="autoBlock" checked />
            Auto-block IPs flagged by CrowdSec
          </label>
        </div>
        <button type="submit" class="btn-primary">Save Configuration</button>
      </form>
    </section>
    <section class="integration-docs">
      <h2>Setup Guide</h2>
      <ol>
        <li><strong>Install CrowdSec</strong><pre><code>curl -s https://packagecloud.io/install/repositories/crowdsec/crowdsec/script.deb.sh | sudo bash
sudo apt install crowdsec</code></pre></li>
        <li><strong>Start CrowdSec</strong><pre><code>sudo systemctl start crowdsec</code></pre></li>
        <li><strong>Configure bouncer</strong><p>StdOut acts as a CrowdSec bouncer - blocks IPs flagged by community intelligence.</p></li>
      </ol>
      <h3>What Gets Monitored</h3>
      <ul>
        <li><strong>Attack signatures</strong> - SSH brute force, web scans, DDoS</li>
        <li><strong>Community threat intel</strong> - IPs flagged by other CrowdSec users</li>
        <li><strong>Auto-remediation</strong> - Firewall rules applied automatically</li>
      </ul>
    </section>
  </main>
</Layout>
