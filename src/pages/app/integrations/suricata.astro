---
import Layout from '../../../layouts/Layout.astro';

const meta = {
  title: 'Suricata Integration - StdOut',
  description: 'Connect StdOut to Suricata IDS/IPS for real-time threat detection and security event monitoring.',
  canonical: 'https://stdout.app/app/integrations/suricata'
};
---

<Layout {meta}>
  <main class="integration-page">
    <header class="integration-header">
      <h1>Suricata Integration</h1>
      <p>Real-time threat detection from Suricata IDS/IPS logs.</p>
      <span class="status-badge" id="suricata-status">Not Configured</span>
    </header>

    <section class="integration-config">
      <h2>Configuration</h2>
      <form id="suricata-config-form">
        <div class="form-group">
          <label for="eve-json-path">EVE JSON Log Path</label>
          <input type="text" id="eve-json-path" name="eveJsonPath" value="/var/log/suricata/eve.json" placeholder="/var/log/suricata/eve.json" />
          <p class="help-text">Path to Suricata's EVE JSON output file</p>
        </div>

        <div class="form-group">
          <label for="alert-severity">Alert Severity Threshold</label>
          <select id="alert-severity" name="alertSeverity">
            <option value="1">Critical (Severity 1)</option>
            <option value="2" selected>High (Severity 1-2)</option>
            <option value="3">Medium (Severity 1-3)</option>
          </select>
        </div>

        <div class="form-group">
          <label>
            <input type="checkbox" name="autoCreateIncidents" checked />
            Auto-create incidents for critical alerts
          </label>
        </div>

        <div class="form-group">
          <label>
            <input type="checkbox" name="enableAI" checked />
            Use AI to analyze attack patterns
          </label>
        </div>

        <button type="submit" class="btn-primary">Save Configuration</button>
      </form>
    </section>

    <section class="integration-test">
      <h2>Test Connection</h2>
      <button id="test-btn" class="btn-secondary">Test Suricata Integration</button>
      <div id="test-results" style="display: none;"></div>
    </section>

    <section class="integration-docs">
      <h2>Setup Guide</h2>
      <ol>
        <li>
          <strong>Enable EVE JSON logging in Suricata</strong>
          <pre><code># suricata.yaml
outputs:
  - eve-log:
      enabled: yes
      filetype: regular
      filename: /var/log/suricata/eve.json</code></pre>
        </li>
        <li>
          <strong>Grant StdOut read access to EVE logs</strong>
          <pre><code>sudo usermod -a -G suricata stdout
sudo chmod g+r /var/log/suricata/eve.json</code></pre>
        </li>
        <li>
          <strong>Configure alert thresholds</strong>
          <p>Set which severity levels trigger StdOut incidents (1 = critical, 3 = informational).</p>
        </li>
        <li>
          <strong>Test the integration</strong>
          <p>Click "Test Suricata Integration" above to verify StdOut can parse EVE logs.</p>
        </li>
      </ol>

      <h3>What Gets Monitored</h3>
      <ul>
        <li><strong>Alert events:</strong> IDS signature matches (malware, exploits, policy violations)</li>
        <li><strong>Anomaly events:</strong> Unusual traffic patterns detected by Suricata</li>
        <li><strong>Flow metadata:</strong> Connection summaries (src/dst IP, ports, bytes transferred)</li>
        <li><strong>TLS/DNS events:</strong> Certificate validation failures, suspicious DNS queries</li>
      </ul>

      <h3>AI-Powered Analysis</h3>
      <p>When enabled, Observatory Analyst processes Suricata alerts to:</p>
      <ul>
        <li>Correlate alerts across time to detect multi-stage attacks</li>
        <li>Identify false positives (e.g., known internal tools triggering signatures)</li>
        <li>Generate incident runbooks with specific remediation steps</li>
        <li>Track attacker IPs and suggest firewall rules</li>
      </ul>
    </section>
  </main>

  <style>
    .integration-page {
      max-width: 900px;
      margin: 0 auto;
      padding: 40px 20px;
    }

    .integration-header {
      text-align: center;
      margin-bottom: 60px;
    }

    .integration-header h1 {
      font-size: 32px;
      font-weight: 700;
      margin: 0 0 12px;
    }

    .integration-header p {
      font-size: 16px;
      color: var(--text-secondary);
      margin: 0 0 16px;
    }

    .status-badge {
      display: inline-block;
      padding: 6px 16px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      background: var(--surface);
      color: var(--text-secondary);
    }

    .status-badge.connected {
      background: #22C55E20;
      color: #22C55E;
    }

    .integration-config,
    .integration-test,
    .integration-docs {
      margin-bottom: 60px;
    }

    .integration-config h2,
    .integration-test h2,
    .integration-docs h2 {
      font-size: 24px;
      font-weight: 700;
      margin: 0 0 24px;
      padding-bottom: 12px;
      border-bottom: 2px solid var(--border);
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .form-group input[type="text"],
    .form-group select {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--surface);
      color: var(--text);
      font-size: 14px;
    }

    .help-text {
      font-size: 12px;
      color: var(--text-secondary);
      margin: 4px 0 0;
    }

    .btn-primary,
    .btn-secondary {
      padding: 10px 24px;
      border-radius: 6px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-primary {
      background: var(--accent);
      color: #fff;
    }

    .btn-primary:hover {
      background: var(--accent-hover);
    }

    .btn-secondary {
      background: transparent;
      border: 2px solid var(--accent);
      color: var(--accent);
    }

    .btn-secondary:hover {
      background: var(--accent);
      color: #fff;
    }

    #test-results {
      margin-top: 20px;
      padding: 16px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
    }

    .integration-docs h3 {
      font-size: 18px;
      font-weight: 600;
      margin: 32px 0 16px;
    }

    .integration-docs ol,
    .integration-docs ul {
      padding-left: 24px;
      margin: 16px 0;
    }

    .integration-docs li {
      margin-bottom: 12px;
      line-height: 1.6;
    }

    pre {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 12px;
      overflow-x: auto;
      margin: 12px 0;
    }

    code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      color: #22C55E;
    }
  </style>

  <script>
    const form = document.getElementById('suricata-config-form');
    const testBtn = document.getElementById('test-btn');
    const testResults = document.getElementById('test-results');
    const statusBadge = document.getElementById('suricata-status');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);

      try {
        const response = await fetch('/app/api/integrations/suricata/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(formData))
        });

        if (!response.ok) throw new Error('Configuration failed');

        if (statusBadge) {
          statusBadge.textContent = 'Configured';
          statusBadge.classList.add('connected');
        }

        alert('Suricata integration configured successfully!');
      } catch (error) {
        alert('Configuration failed: ' + (error instanceof Error ? error.message : String(error)));
      }
    });

    testBtn?.addEventListener('click', async () => {
      testBtn.textContent = 'Testing...';
      testBtn.disabled = true;

      try {
        const response = await fetch('/app/api/integrations/suricata/test', {
          method: 'POST'
        });

        if (!response.ok) throw new Error('Test failed');

        const data = await response.json();

        if (testResults) {
          testResults.innerHTML = `
            <h4 style="color: var(--success); margin-bottom: 12px;">✓ Connection Successful</h4>
            <p><strong>EVE log accessible:</strong> ${data.accessible ? 'Yes' : 'No'}</p>
            <p><strong>Recent alerts:</strong> ${data.alertCount || 0}</p>
            <p><strong>Last event timestamp:</strong> ${data.lastEvent || 'N/A'}</p>
          `;
          testResults.style.display = 'block';
        }
      } catch (error) {
        if (testResults) {
          testResults.innerHTML = `
            <h4 style="color: var(--error); margin-bottom: 12px;">✗ Connection Failed</h4>
            <p>${error instanceof Error ? error.message : String(error)}</p>
          `;
          testResults.style.display = 'block';
        }
      } finally {
        testBtn.textContent = 'Test Suricata Integration';
        testBtn.disabled = false;
      }
    });
  </script>
</Layout>
