---
export const prerender = false;
import { deleteSession, getSessionFromCookies, SESSION_COOKIE } from '../../lib/auth';
import { validateCsrf } from '../../middleware';
import { isOIDCEnabled, getLogoutURL } from '../../lib/oidc';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const csrfToken = form.get('_csrf') as string || '';

  // Read session BEFORE deleting cookie, then invalidate both
  const sessionId = getSessionFromCookies(Astro.cookies);

  if (validateCsrf(csrfToken, Astro.cookies)) {
    if (sessionId) deleteSession(sessionId);
  }

  Astro.cookies.delete(SESSION_COOKIE, { path: '/' });

  // End Authentik session too (single logout)
  if (isOIDCEnabled()) {
    return Astro.redirect(getLogoutURL());
  }
  return Astro.redirect('/');
}
---
<html lang="en"><head><meta charset="UTF-8"/><title>Log out — StdOut</title></head>
<body style="display:flex;align-items:center;justify-content:center;min-height:100vh;font-family:system-ui;background:#07070C;color:#EEEEF5;">
  <form method="POST" style="text-align:center;">
    <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
    <p style="margin-bottom:1rem;">Are you sure you want to log out?</p>
    <button type="submit" style="padding:0.5rem 1.5rem;background:#C2410C;color:#fff;border:none;border-radius:6px;font-weight:600;cursor:pointer;">Log out</button>
    <a href="/app" style="display:block;margin-top:0.75rem;color:#9090A8;font-size:0.85rem;">Cancel</a>
  </form>
</body></html>
