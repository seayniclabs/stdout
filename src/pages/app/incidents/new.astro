---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { getTenantDb, tenantSchema } from '../../../lib/db';
import { nanoid } from 'nanoid';
import { eq } from 'drizzle-orm';
import { validateCsrf } from '../../../middleware';
import { notify } from '../../../lib/notify';
import { getUserLimits } from '../../../lib/tiers';
import { canPerform } from '../../../lib/rbac';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');
const ws = Astro.locals.workspace;
if (ws && !ws.isOwnWorkspace && !canPerform(ws.role, 'create')) return Astro.redirect('/app');

const db = getTenantDb(Astro.locals.workspace?.ownerId || user.id);
const userStacks = db.select().from(tenantSchema.stacks).where(eq(tenantSchema.stacks.userId, user.id)).all();
const { tier, limits } = getUserLimits(user);

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (!validateCsrf(form.get('_csrf') as string, Astro.cookies)) {
    error = 'Invalid form submission.';
  } else {
    const title = (form.get('title') as string || '').trim();
    const description = (form.get('description') as string || '').trim();
    const severity = form.get('severity') as string || 'medium';
    const stackId = (form.get('stackId') as string || '') || null;
    const tags = (form.get('tags') as string || '').trim() || null;

    const rawDb = (db as any).$client;

    if (!title || !description) {
      error = 'Title and description are required.';
    } else if (limits.maxIncidentsPerMonth !== Infinity) {
      // Check monthly incident limit
      const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000);
      let monthCount = 0;
      if (rawDb?.prepare) {
        const row = rawDb.prepare('SELECT COUNT(*) as cnt FROM incidents WHERE user_id = ? AND created_at > ?').get(user.id, thirtyDaysAgo.getTime());
        monthCount = row?.cnt || 0;
      }
      if (monthCount >= limits.maxIncidentsPerMonth) {
        error = `Incident limit reached (${limits.maxIncidentsPerMonth}/month on ${tier} plan). Upgrade to continue.`;
      }
    }
    if (!error && title && description) {
      const id = nanoid();
      const now = new Date();
      db.insert(tenantSchema.incidents).values({
        id, userId: user.id, stackId, title, description, severity, tags,
        status: 'active', createdAt: now, updatedAt: now,
      }).run();

      // Sync to FTS
      if (rawDb?.prepare) {
        rawDb.prepare('INSERT INTO incidents_fts(rowid, title, description, tags) SELECT rowid, title, description, tags FROM incidents WHERE id = ?').run(id);
      }

      // Notify
      notify(user.id, {
        event: severity === 'critical' ? 'severity_critical' : 'incident_created',
        title: `Incident: ${title}`,
        body: description.substring(0, 200),
        url: `/app/incidents/${id}`,
        metadata: { severity, incidentId: id },
      });

      return Astro.redirect(`/app/incidents/${id}`);
    }
  }
}
---
<Layout title="New Incident — StdOut">
  <div class="form-page">
    <h1>Log an incident</h1>

    {error && <div class="auth-error">{error}</div>}

    <form method="POST" class="incident-form">
      <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />

      <label>
        <span>Title</span>
        <input type="text" name="title" id="incidentTitle" required placeholder="e.g. nginx 502 Bad Gateway after deploy" autocomplete="off" />
      </label>

      <div id="liveSimilar" class="live-similar" style="display:none;"></div>

      <label>
        <span>Description</span>
        <textarea name="description" required rows={6} placeholder="What happened? Paste error output, describe symptoms, include any context."></textarea>
      </label>

      <div class="form-row">
        <label class="form-half">
          <span>Severity</span>
          <select name="severity">
            <option value="critical">Critical</option>
            <option value="high">High</option>
            <option value="medium" selected>Medium</option>
            <option value="low">Low</option>
          </select>
        </label>

        <label class="form-half">
          <span>Stack</span>
          <select name="stackId">
            {userStacks.length !== 1 && <option value="">None</option>}
            {userStacks.map(s => (
              <option value={s.id} selected={userStacks.length === 1}>{s.name}</option>
            ))}
          </select>
        </label>
      </div>

      <label>
        <span>Tags <span style="color:var(--text-muted); font-weight:400;">(comma-separated)</span></span>
        <input type="text" name="tags" placeholder="docker, nginx, n8n" autocomplete="off" />
      </label>

      <button type="submit" class="btn btn-primary">Log incident</button>
    </form>
  </div>
</Layout>

<style>
  .form-page { max-width: 640px; margin: 0 auto; }
  .form-page h1 { font-size: 20px; margin-bottom: 20px; }
  .incident-form { display: flex; flex-direction: column; gap: 16px; }
  .incident-form label { display: flex; flex-direction: column; gap: 4px; }
  .incident-form label span { font-size: 12px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.04em; }
  .incident-form input, .incident-form select, .incident-form textarea {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: var(--font-ui);
    font-size: 14px;
    padding: 10px 12px;
    transition: border-color 150ms;
  }
  .incident-form textarea { font-family: var(--font-mono); font-size: 13px; resize: vertical; }
  .incident-form input:focus, .incident-form select:focus, .incident-form textarea:focus {
    border-color: var(--accent);
    outline: none;
  }
  .form-row { display: flex; gap: 12px; }
  .form-half { flex: 1; }
  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; border: none; border-radius: var(--radius-sm); font-weight: 600; font-size: 13px; cursor: pointer; text-decoration: none; transition: var(--transition); }
  .btn-primary { background: var(--accent-btn); color: #fff; }
  .btn-primary:hover { background: var(--accent-light); }
  .live-similar { margin: -8px 0 4px; }
  .live-similar-card { display: block; padding: 10px 12px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); margin-bottom: 4px; text-decoration: none; color: inherit; transition: border-color 150ms; }
  .live-similar-card:hover { border-color: var(--accent); }
  .live-similar-title { font-size: 12px; font-weight: 500; }
  .live-similar-fix { font-size: 11px; font-family: var(--font-mono); color: var(--accent-light); margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .live-similar-header { font-size: 11px; font-family: var(--font-mono); color: var(--text-muted); margin-bottom: 6px; }
</style>

<script>
  let debounce: any;
  const titleInput = document.getElementById('incidentTitle') as HTMLInputElement;
  const similarDiv = document.getElementById('liveSimilar')!;

  titleInput?.addEventListener('input', () => {
    clearTimeout(debounce);
    const q = titleInput.value.trim();
    if (q.length < 4) { similarDiv.style.display = 'none'; return; }
    debounce = setTimeout(async () => {
      try {
        const res = await fetch(`/app/api/similar?q=${encodeURIComponent(q)}`);
        const data = await res.json();
        if (data.matches && data.matches.length > 0) {
          similarDiv.style.display = 'block';
          similarDiv.innerHTML = `<div class="live-similar-header">You may have solved this before:</div>` +
            data.matches.slice(0, 3).map((m: any) => `
              <a href="/app/incidents/${m.incidentId}" class="live-similar-card" target="_blank">
                <div class="live-similar-title">${esc(m.title)}</div>
                <div class="live-similar-fix">${esc(m.resolution)}</div>
              </a>
            `).join('');
        } else {
          similarDiv.style.display = 'none';
        }
      } catch { similarDiv.style.display = 'none'; }
    }, 400);
  });

  function esc(s: string) {
    return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }
</script>
