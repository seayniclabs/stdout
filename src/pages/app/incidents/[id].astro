---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { getDb, schema } from '../../../lib/db';
import { nanoid } from 'nanoid';
import { eq, desc } from 'drizzle-orm';
import { validateCsrf } from '../../../middleware';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

const { id } = Astro.params;
const db = getDb();

const incident = db.select().from(schema.incidents).where(eq(schema.incidents.id, id!)).get();
if (!incident) return Astro.redirect('/app');

// Handle resolution POST
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (validateCsrf(form.get('_csrf') as string, Astro.cookies)) {
    const action = form.get('action') as string;

    if (action === 'resolve') {
      const content = (form.get('content') as string || '').trim();
      if (content) {
        const resId = nanoid();
        const now = new Date();
        db.insert(schema.resolutions).values({
          id: resId, incidentId: id!, content, createdAt: now,
        }).run();

        // Sync to FTS - get rowid AFTER insert
        const rawDb = (db as any).$client;
        if (rawDb?.prepare) {
          const row = rawDb.prepare('SELECT rowid, content FROM resolutions WHERE id = ?').get(resId);
          if (row) {
            rawDb.prepare('INSERT INTO resolutions_fts(rowid, content) VALUES (?, ?)').run(row.rowid, row.content);
          }
        }

        db.update(schema.incidents).set({ status: 'resolved', resolvedAt: now, updatedAt: now }).where(eq(schema.incidents.id, id!)).run();
      }
    } else if (action === 'status') {
      const status = form.get('status') as string;
      if (['active', 'investigating', 'monitoring', 'resolved'].includes(status)) {
        const updates: any = { status, updatedAt: new Date() };
        if (status === 'resolved') updates.resolvedAt = new Date();
        db.update(schema.incidents).set(updates).where(eq(schema.incidents.id, id!)).run();
      }
    }

    return Astro.redirect(`/app/incidents/${id}`);
  }
}

// Re-fetch after potential POST
const current = db.select().from(schema.incidents).where(eq(schema.incidents.id, id!)).get()!;
const resolutions = db.select().from(schema.resolutions).where(eq(schema.resolutions.incidentId, id!)).orderBy(desc(schema.resolutions.createdAt)).all();
const diagnosis = db.select().from(schema.diagnoses).where(eq(schema.diagnoses.incidentId, id!)).orderBy(desc(schema.diagnoses.createdAt)).limit(1).all();
const latestDiagnosis = diagnosis[0] || null;

// Get stack context if linked
let stackName = '';
if (current.stackId) {
  const stack = db.select().from(schema.stacks).where(eq(schema.stacks.id, current.stackId)).get();
  if (stack) stackName = stack.name;
}

const severityColors: Record<string, string> = { critical: 'var(--critical)', high: 'var(--high)', medium: 'var(--medium)', low: 'var(--low)' };
const statusLabels: Record<string, string> = { active: 'Active', investigating: 'Investigating', monitoring: 'Monitoring', resolved: 'Resolved' };
---
<Layout title={`${current.title} — StdOut`}>
  <div class="detail-page">
    <!-- Header -->
    <div class="incident-header">
      <div class="header-top">
        <a href="/app" class="back-link">&larr; Incidents</a>
        <span class="mono" style="color:var(--text-muted);">#{current.id.slice(0, 8)}</span>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:flex-start;">
        <h1>{current.title}</h1>
        <div class="export-btns">
          <a href={`/app/api/incidents/export?id=${current.id}&format=markdown`} class="btn btn-ghost btn-sm" title="Export as Markdown">Export .md</a>
          <a href={`/app/api/incidents/export?id=${current.id}&format=json`} class="btn btn-ghost btn-sm" title="Export as JSON">Export .json</a>
        </div>
      </div>
      <div class="header-meta">
        <span class={`severity-pill ${current.severity}`}>{current.severity}</span>
        <span class={`status-pill ${current.status}`}>{statusLabels[current.status] || current.status}</span>
        {stackName && <span class="stack-label">{stackName}</span>}
        {current.tags && current.tags.split(',').map(t => <span class="tag">{t.trim()}</span>)}
      </div>
    </div>

    <!-- Description -->
    <section class="section">
      <h2>Description</h2>
      <pre class="description-block">{current.description}</pre>
    </section>

    <!-- Status controls -->
    {current.status !== 'resolved' && (
      <section class="section">
        <h2>Update Status</h2>
        <form method="POST" class="status-form">
          <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
          <input type="hidden" name="action" value="status" />
          {['investigating', 'monitoring', 'resolved'].filter(s => s !== current.status).map(s => (
            <button type="submit" name="status" value={s} class={`status-btn ${s}`}>{statusLabels[s]}</button>
          ))}
        </form>
      </section>
    )}

    <!-- Metrics Context (InfluxDB enrichment) -->
    <section class="section" id="metricsSection" style="display:none;">
      <h2>Resource Metrics</h2>
      <p class="metrics-hint mono" id="metricsHint">Loading metrics around incident time...</p>
      <div class="metrics-grid" id="metricsGrid"></div>
    </section>

    <!-- Similar Past Fixes -->
    {current.status !== 'resolved' && (
      <section class="section">
        <h2>Past Fixes</h2>
        <div id="similarMatches" class="similar-loading mono">Searching your history...</div>
      </section>
    )}

    <!-- AI Diagnosis -->
    <section class="section">
      <h2>AI Diagnosis</h2>
      <div id="diagnosisContainer">
        {latestDiagnosis ? (
          <div class="diagnosis-result">
            {/* Tool execution proof (transactional evidence) */}
            {latestDiagnosis.toolUsed ? (
              <div class="tool-proof" style="background:var(--card-bg);border-left:3px solid var(--accent);padding:12px;margin-bottom:16px;border-radius:4px;">
                <div style="font-weight:600;margin-bottom:4px;">✓ Diagnostic Tool Executed</div>
                <div class="mono" style="font-size:12px;color:var(--text-muted);">
                  Ran: <code>{JSON.parse(latestDiagnosis.toolUsed).tool}</code> {JSON.stringify(JSON.parse(latestDiagnosis.toolUsed).args || {})}
                </div>
                {JSON.parse(latestDiagnosis.toolUsed).output && (
                  <details style="margin-top:8px;">
                    <summary style="cursor:pointer;font-size:12px;color:var(--text-muted);">Show output</summary>
                    <pre style="margin-top:8px;font-size:11px;background:var(--bg);padding:8px;border-radius:4px;overflow-x:auto;">{JSON.parse(latestDiagnosis.toolUsed).output}</pre>
                  </details>
                )}
              </div>
            ) : (
              <div class="tool-proof" style="background:var(--card-bg);border-left:3px solid var(--text-muted);padding:12px;margin-bottom:16px;border-radius:4px;">
                <div style="font-size:13px;color:var(--text-muted);">No diagnostic tools executed (diagnosis from description only)</div>
              </div>
            )}
            <h3>Root Causes</h3>
            <ol class="root-causes">
              {JSON.parse(latestDiagnosis.rootCauses).map((cause: string) => <li>{cause}</li>)}
            </ol>
            {latestDiagnosis.suggestedCommands && (
              <>
                <h3>Suggested Commands</h3>
                <div class="commands">
                  {JSON.parse(latestDiagnosis.suggestedCommands).map((cmd: string) => (
                    <code class="command-line">{cmd}</code>
                  ))}
                </div>
              </>
            )}
            <div class="diagnosis-meta">
              <span class="mono">{latestDiagnosis.model}</span>
              <span>{latestDiagnosis.promptTokens} in / {latestDiagnosis.completionTokens} out</span>
            </div>
          </div>
        ) : (
          <div class="diagnosis-empty">
            <button id="diagnoseBtn" class="btn btn-primary" data-incident-id={current.id}>
              Get AI Diagnosis
            </button>
            <div id="diagnoseLoading" style="display:none;">
              <span class="mono" style="color:var(--accent);">Analyzing...</span>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- Auto-Fix (BYOK user key required) -->
    {current.status !== 'resolved' && (
      <section class="section">
        <h2>Auto-Fix</h2>
        <p class="section-hint">Generate a step-by-step remediation plan using your AI provider key. Plans use ~4K tokens from your key. <a href="/app/settings#integrations" style="color: var(--accent);">Manage keys</a></p>

        <div id="autofixContainer">
          <button id="autofixPlanBtn" class="btn btn-primary" data-incident-id={current.id}>
            Generate Fix Plan
          </button>
          <div id="autofixLoading" style="display:none;">
            <span class="mono" style="color:var(--accent);">Generating remediation plan...</span>
          </div>
        </div>

        <div id="autofixPlan" style="display:none;">
          <div class="autofix-summary" id="autofixSummary"></div>
          <div class="autofix-meta" id="autofixMeta"></div>
          <div class="autofix-steps" id="autofixSteps"></div>
        </div>
      </section>
    )}

    <!-- Resolutions -->
    <section class="section">
      <h2>Resolutions ({resolutions.length})</h2>
      {resolutions.map(r => (
        <div class="resolution-card">
          <pre class="resolution-content">{r.content}</pre>
          <div class="resolution-meta mono">{r.createdAt.toISOString().split('T')[0]}</div>
        </div>
      ))}

      {current.status !== 'resolved' && (
        <form method="POST" class="resolution-form">
          <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
          <input type="hidden" name="action" value="resolve" />
          <label>
            <span>What fixed it?</span>
            <textarea name="content" rows={4} required placeholder="Describe the resolution..."></textarea>
          </label>
          <button type="submit" class="btn btn-primary">Record Resolution</button>
        </form>
      )}
    </section>
  </div>
</Layout>

<script>
  // Load similar past fixes
  const similarEl = document.getElementById('similarMatches');
  if (similarEl) {
    const incidentTitle = document.querySelector('.incident-header h1')?.textContent || '';
    if (incidentTitle) {
      fetch(`/app/api/similar?q=${encodeURIComponent(incidentTitle)}&exclude=${window.location.pathname.split('/').pop()}`)
        .then(r => r.json())
        .then(data => {
          const { matches, docs } = data;
          if ((!matches || matches.length === 0) && (!docs || docs.length === 0)) {
            similarEl.innerHTML = `
              <div class="empty-past-fixes">
                <div class="empty-icon">📚</div>
                <p class="empty-title">No matching past fixes yet</p>
                <p class="empty-hint">This incident doesn't match any resolved incidents in your history. As you resolve more incidents, StdOut will suggest similar fixes automatically.</p>
                <div class="empty-actions">
                  <a href="/app/docs" class="btn-secondary btn-sm">Browse Runbooks</a>
                  <a href="/app/incidents?status=resolved" class="btn-secondary btn-sm">View Resolved Incidents</a>
                </div>
              </div>
            `;
            return;
          }
          let html = '';
          if (matches && matches.length > 0) {
            html += matches.map((m: any) => `
              <a href="/app/incidents/${encodeURIComponent(String(m.incidentId || ''))}" class="similar-card">
                <div class="similar-title">${esc(m.title)}</div>
                <div class="similar-resolution">${esc(m.resolution)}</div>
                <div class="similar-meta mono">${esc(String(m.severity ?? ''))} &middot; ${esc(String(m.tags || ''))}</div>
              </a>
            `).join('');
          }
          if (docs && docs.length > 0) {
            html += '<div class="similar-divider mono">Related docs</div>';
            html += docs.map((d: any) => `
              <a href="/app/docs/${encodeURIComponent(String(d.docId || ''))}" class="similar-card">
                <div class="similar-title">${esc(d.title)} <span class="similar-type">${esc(String(d.docType ?? ''))}</span></div>
                <div class="similar-resolution">${esc(d.snippet)}</div>
              </a>
            `).join('');
          }
          similarEl.innerHTML = html;
        })
        .catch(() => { similarEl.innerHTML = '<div style="color:var(--text-muted);font-size:13px;">Search unavailable.</div>'; });
    } else {
      similarEl.innerHTML = '';
    }
  }

  function esc(s: string) {
    return (s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function autofixRiskClass(risk: string) {
    const r = (risk || '').toLowerCase();
    if (r === 'high') return 'risk-high';
    if (r === 'medium') return 'risk-medium';
    return 'risk-low';
  }

  const btn = document.getElementById('diagnoseBtn');
  const loading = document.getElementById('diagnoseLoading');
  const diagnosisContainer = document.getElementById('diagnosisContainer');
  if (btn) {
    btn.addEventListener('click', async () => {
      const incidentId = btn.getAttribute('data-incident-id');
      btn.style.display = 'none';
      if (loading) loading.style.display = 'block';
      try {
        const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
        const res = await fetch('/app/api/diagnose', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ incidentId, _csrf: csrf }),
        });
        if (res.ok) {
          const result = await res.json();
          // Render diagnosis inline instead of page reload (preserves tool execution proof)
          let html = '<div class="diagnosis-result">';

          // Tool execution proof (transactional evidence)
          if (result.toolUsed) {
            const toolName = esc(result.toolUsed.tool || '');
            const toolArgs = result.toolUsed.args ? JSON.stringify(result.toolUsed.args) : '';
            html += '<div class="tool-proof" style="background:var(--card-bg);border-left:3px solid var(--accent);padding:12px;margin-bottom:16px;border-radius:4px;">';
            html += '<div style="font-weight:600;margin-bottom:4px;">✓ Diagnostic Tool Executed</div>';
            html += `<div class="mono" style="font-size:12px;color:var(--text-muted);">Ran: <code>${toolName}</code> ${toolArgs}</div>`;
            html += '</div>';
          } else {
            html += '<div class="tool-proof" style="background:var(--card-bg);border-left:3px solid var(--text-muted);padding:12px;margin-bottom:16px;border-radius:4px;">';
            html += '<div style="font-size:13px;color:var(--text-muted);">No diagnostic tools executed (diagnosis from description only)</div>';
            html += '</div>';
          }

          html += '<h3>Root Causes</h3><ol class="root-causes">';
          (result.rootCauses || []).forEach((cause: string) => {
            html += `<li>${esc(cause)}</li>`;
          });
          html += '</ol>';

          if (result.suggestedCommands && result.suggestedCommands.length > 0) {
            html += '<h3>Suggested Commands</h3><div class="commands">';
            result.suggestedCommands.forEach((cmd: string) => {
              html += `<code class="command-line">${esc(cmd)}</code>`;
            });
            html += '</div>';
          }

          html += '<div class="diagnosis-meta">';
          html += `<span class="mono">${esc(result.model || '')}</span>`;
          html += `<span>${result.promptTokens || 0} in / ${result.completionTokens || 0} out</span>`;
          html += '</div></div>';

          if (diagnosisContainer) {
            diagnosisContainer.innerHTML = html;
          }
        } else {
          const err = await res.text();
          window.showToast?.('Diagnosis failed: ' + err, 'error');
          btn.style.display = 'inline-flex';
          if (loading) loading.style.display = 'none';
        }
      } catch (e) {
        window.showToast?.('Network error', 'error');
        btn.style.display = 'inline-flex';
        if (loading) loading.style.display = 'none';
      }
    });
  }

  // --- Metrics enrichment (InfluxDB) ---
  const metricsSection = document.getElementById('metricsSection');
  const metricsGrid = document.getElementById('metricsGrid');
  const metricsHint = document.getElementById('metricsHint');

  // Try to guess a container name from the incident title/tags
  const incTitle = document.querySelector('.incident-header h1')?.textContent || '';
  const incTags = Array.from(document.querySelectorAll('.tag')).map(t => t.textContent?.trim() || '');

  function guessContainer(): string | null {
    // Check tags first
    const skip = new Set(['hud', 'auto', 'http', 'tcp', 'docker', 'ping', 'dns', 'critical', 'high', 'medium', 'low']);
    for (const tag of incTags) {
      if (tag && !skip.has(tag)) return tag;
    }
    // Try title pattern "X is down"
    const m = incTitle.match(/^(.+?)\s+is\s+(down|degraded)/i);
    if (m) return m[1].toLowerCase().replace(/\s+/g, '-');
    return null;
  }

  const containerName = guessContainer();
  if (containerName) {
    fetch(`/app/api/metrics?type=container&name=${encodeURIComponent(containerName)}&range=60`)
      .then(r => r.json())
      .then(data => {
        if (!data.configured || !data.data) return;
        const { cpu, memory, network } = data.data;
        if ((!cpu || cpu.length === 0) && (!memory || memory.length === 0) && (!network || network.length === 0)) return;

        if (metricsSection) metricsSection.style.display = '';
        if (metricsHint) {
          const src = data.source === 'prometheus' ? 'Prometheus' : 'InfluxDB';
          metricsHint.textContent = `Metrics for "${containerName}" — last 60 minutes via ${src}`;
        }

        let html = '';
        if (cpu && cpu.length > 1) {
          html += renderMetricCard('CPU %', cpu, 'var(--accent-light)', '%');
        }
        if (memory && memory.length > 1) {
          html += renderMetricCard('Memory', memory, 'var(--teal)', ' MB');
        }
        if (network && network.length > 1) {
          html += renderMetricCard('Network', network, '#60A5FA', ' B/s');
        }
        if (metricsGrid) metricsGrid.innerHTML = html;
      })
      .catch(() => {});
  }

  function renderMetricCard(label: string, points: {time: string; value: number}[], color: string, unit: string): string {
    const values = points.map(p => p.value);
    const max = Math.max(...values, 0.001);
    const min = Math.min(...values);
    const latest = values[values.length - 1];
    const latestStr = latest < 10 ? latest.toFixed(1) : Math.round(latest).toString();

    // Build SVG sparkline
    const w = 240, h = 40;
    const pts = values.map((v, i) => {
      const x = (i / Math.max(values.length - 1, 1)) * w;
      const y = h - 2 - ((v - min) / (max - min + 0.001)) * (h - 4);
      return `${x},${y}`;
    });
    const linePath = pts.length > 1 ? `M${pts.join(' L')}` : '';
    const areaPath = pts.length > 1 ? `M${pts.join(' L')} L${w},${h} L0,${h} Z` : '';

    return `
      <div class="metric-card">
        <div class="metric-header">
          <span class="metric-label">${label}</span>
          <span class="metric-value mono" style="color:${color};">${latestStr}${unit}</span>
        </div>
        <svg class="metric-spark" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none">
          <path d="${areaPath}" fill="${color}" opacity="0.1" />
          <path d="${linePath}" fill="none" stroke="${color}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>`;
  }

  // --- Auto-Fix ---
  const autofixPlanBtn = document.getElementById('autofixPlanBtn');
  const autofixLoading = document.getElementById('autofixLoading');
  const autofixContainer = document.getElementById('autofixContainer');
  const autofixPlanDiv = document.getElementById('autofixPlan');

  if (autofixPlanBtn) {
    autofixPlanBtn.addEventListener('click', async () => {
      const incidentId = (autofixPlanBtn as HTMLElement).dataset.incidentId;
      autofixPlanBtn.style.display = 'none';
      if (autofixLoading) autofixLoading.style.display = 'block';

      try {
        const res = await window.stdoutFetch('/app/api/incidents/autofix', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ incidentId, action: 'plan' }),
        });

        const data = await res?.json();

        if (!res?.ok) {
          window.showToast?.(data?.error || 'Auto-fix failed', 'error');
          autofixPlanBtn.style.display = 'inline-flex';
          if (autofixLoading) autofixLoading.style.display = 'none';
          return;
        }

        // Render the plan (DOM APIs — model output is never parsed as HTML)
        if (autofixPlanDiv) autofixPlanDiv.style.display = 'block';
        if (autofixLoading) autofixLoading.style.display = 'none';

        const plan = data.plan;
        const summaryEl = document.getElementById('autofixSummary');
        const metaEl = document.getElementById('autofixMeta');
        const stepsEl = document.getElementById('autofixSteps');

        autofixPlanDiv?.querySelector('.autofix-progress')?.remove();
        summaryEl?.replaceChildren();
        metaEl?.replaceChildren();
        stepsEl?.replaceChildren();

        if (summaryEl) {
          const strong = document.createElement('strong');
          strong.textContent = (plan.summary != null && String(plan.summary).trim() !== '')
            ? String(plan.summary)
            : 'Remediation plan generated';
          summaryEl.appendChild(strong);
          if (plan.totalRisk) {
            summaryEl.appendChild(document.createTextNode(' '));
            const badge = document.createElement('span');
            badge.className = `risk-badge ${autofixRiskClass(String(plan.totalRisk))}`;
            badge.textContent = `${String(plan.totalRisk)} risk`;
            summaryEl.appendChild(badge);
          }
          if (plan.estimatedTime) {
            summaryEl.appendChild(document.createTextNode(' '));
            const timeB = document.createElement('span');
            timeB.className = 'time-badge';
            timeB.textContent = String(plan.estimatedTime);
            summaryEl.appendChild(timeB);
          }
        }

        if (metaEl) {
          const mono = document.createElement('span');
          mono.className = 'mono';
          mono.textContent = `${data.provider}/${data.model}`;
          metaEl.appendChild(mono);
          metaEl.appendChild(document.createTextNode(' '));
          const tok = document.createElement('span');
          tok.textContent = `${data.tokens.prompt} in / ${data.tokens.completion} out`;
          metaEl.appendChild(tok);
        }

        if (stepsEl && plan.steps && plan.steps.length > 0) {
          stepsEl.replaceChildren();
          const total = plan.steps.length;

          plan.steps.forEach((step: any, i: number) => {
            const stepId = `step-${i}`;
            const hasDetails = (step.commands?.length > 0) || (step.files?.length > 0) || step.verification || step.rollback;

            const stepWrap = document.createElement('div');
            stepWrap.className = 'autofix-step';
            stepWrap.id = stepId;

            const header = document.createElement('div');
            header.className = 'step-header';

            const cb = document.createElement('input');
            cb.type = 'checkbox';
            cb.className = 'step-checkbox';
            cb.dataset.step = String(i);
            header.appendChild(cb);

            const num = document.createElement('span');
            num.className = 'step-number';
            num.textContent = String(step.order ?? i + 1);
            header.appendChild(num);

            const desc = document.createElement('span');
            desc.className = 'step-desc';
            desc.textContent = step.description != null ? String(step.description) : '';
            header.appendChild(desc);

            const riskB = document.createElement('span');
            riskB.className = `risk-badge ${autofixRiskClass(String(step.risk || ''))}`;
            riskB.textContent = step.risk != null ? String(step.risk) : '?';
            header.appendChild(riskB);

            if (hasDetails) {
              const toggle = document.createElement('button');
              toggle.type = 'button';
              toggle.className = 'step-toggle';
              toggle.dataset.target = `${stepId}-details`;
              toggle.title = 'Show details';
              toggle.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>';
              header.appendChild(toggle);
            }

            stepWrap.appendChild(header);

            if (hasDetails) {
              const details = document.createElement('div');
              details.className = 'step-details';
              details.id = `${stepId}-details`;
              details.style.display = 'none';

              if (step.commands && step.commands.length > 0) {
                const sec = document.createElement('div');
                sec.className = 'step-section';
                const lab = document.createElement('span');
                lab.className = 'step-section-label';
                lab.textContent = 'Commands';
                sec.appendChild(lab);
                const cmdWrap = document.createElement('div');
                cmdWrap.className = 'step-commands';
                for (const c of step.commands as string[]) {
                  const row = document.createElement('div');
                  row.className = 'command-row';
                  const code = document.createElement('code');
                  code.className = 'command-line';
                  code.textContent = c;
                  const copyBtn = document.createElement('button');
                  copyBtn.type = 'button';
                  copyBtn.className = 'copy-btn';
                  copyBtn.title = 'Copy';
                  copyBtn.dataset.copy = c;
                  copyBtn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
                  const runBtn = document.createElement('button');
                  runBtn.type = 'button';
                  runBtn.className = 'run-btn';
                  runBtn.title = 'Execute';
                  runBtn.dataset.cmd = c;
                  runBtn.dataset.step = String(i);
                  runBtn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>';
                  row.appendChild(code);
                  row.appendChild(copyBtn);
                  row.appendChild(runBtn);
                  cmdWrap.appendChild(row);
                }
                sec.appendChild(cmdWrap);
                details.appendChild(sec);
              }

              if (step.files && step.files.length > 0) {
                const sec = document.createElement('div');
                sec.className = 'step-section';
                const lab = document.createElement('span');
                lab.className = 'step-section-label';
                lab.textContent = 'Files';
                sec.appendChild(lab);
                for (const f of step.files as any[]) {
                  const row = document.createElement('div');
                  row.className = 'file-change';
                  const pathEl = document.createElement('code');
                  pathEl.className = 'mono';
                  pathEl.textContent = f.path != null ? String(f.path) : '';
                  const ch = document.createElement('span');
                  ch.className = 'file-change-desc';
                  ch.textContent = f.change != null ? String(f.change) : '';
                  row.appendChild(pathEl);
                  row.appendChild(ch);
                  sec.appendChild(row);
                }
                details.appendChild(sec);
              }

              if (step.verification) {
                const sec = document.createElement('div');
                sec.className = 'step-section step-section-muted';
                const lab = document.createElement('span');
                lab.className = 'step-section-label';
                lab.textContent = 'Verification';
                sec.appendChild(lab);
                const p = document.createElement('p');
                p.textContent = String(step.verification);
                sec.appendChild(p);
                details.appendChild(sec);
              }

              if (step.rollback) {
                const sec = document.createElement('div');
                sec.className = 'step-section step-section-muted';
                const lab = document.createElement('span');
                lab.className = 'step-section-label';
                lab.textContent = 'Rollback';
                sec.appendChild(lab);
                const p = document.createElement('p');
                p.textContent = String(step.rollback);
                sec.appendChild(p);
                details.appendChild(sec);
              }

              stepWrap.appendChild(details);
            }

            stepsEl.appendChild(stepWrap);
          });

          const prog = document.createElement('div');
          prog.className = 'autofix-progress';
          prog.innerHTML = '<div class="progress-bar"><div class="progress-fill" id="autofixProgressFill" style="width: 0%"></div></div><span class="progress-text" id="autofixProgressText">0 / ' + total + ' steps</span>';
          stepsEl.before(prog);

          stepsEl.querySelectorAll('.step-toggle').forEach((btn: Element) => {
            btn.addEventListener('click', () => {
              const targetId = (btn as HTMLElement).dataset.target;
              const target = document.getElementById(targetId!);
              if (target) {
                const isOpen = target.style.display !== 'none';
                target.style.display = isOpen ? 'none' : 'block';
                (btn as HTMLElement).classList.toggle('open', !isOpen);
              }
            });
          });

          stepsEl.querySelectorAll('.copy-btn').forEach((btn: Element) => {
            btn.addEventListener('click', () => {
              const text = (btn as HTMLElement).dataset.copy || '';
              navigator.clipboard.writeText(text).then(() => {
                (btn as HTMLElement).innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--low)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>';
                setTimeout(() => {
                  (btn as HTMLElement).innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
                }, 1500);
              });
            });
          });

          stepsEl.querySelectorAll('.step-checkbox').forEach((cb: Element) => {
            cb.addEventListener('change', () => {
              const checked = stepsEl!.querySelectorAll('.step-checkbox:checked').length;
              const fill = document.getElementById('autofixProgressFill');
              const text = document.getElementById('autofixProgressText');
              if (fill) fill.style.width = `${(checked / total) * 100}%`;
              if (text) text.textContent = `${checked} / ${total} steps`;
              const stepEl = (cb as HTMLElement).closest('.autofix-step');
              if (stepEl) stepEl.classList.toggle('step-done', (cb as HTMLInputElement).checked);
            });
          });

          stepsEl.querySelectorAll('.run-btn').forEach((btn: Element) => {
            btn.addEventListener('click', async () => {
              const cmd = (btn as HTMLElement).dataset.cmd || '';
              const stepIdx = (btn as HTMLElement).dataset.step;
              if (!confirm(`Execute this command?\n\n${cmd}`)) return;

              (btn as HTMLElement).innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';

              const incidentId = (autofixPlanBtn as HTMLElement).dataset.incidentId;
              const res = await window.stdoutFetch('/app/api/incidents/autofix-exec', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ command: cmd, incidentId, stepIndex: stepIdx, approved: true }),
              });

              const execData = await res?.json().catch(() => ({ ok: false, error: 'Parse error' }));

              const row = (btn as HTMLElement).closest('.command-row');
              let outputEl = row?.nextElementSibling;
              if (outputEl?.classList.contains('cmd-output')) outputEl.remove();

              const output = document.createElement('div');
              output.className = 'cmd-output';
              const preOut = document.createElement('pre');
              preOut.className = execData?.ok ? 'cmd-stdout' : 'cmd-stderr';
              preOut.textContent = execData?.ok
                ? (execData.stdout || '(no output)')
                : (execData?.stderr || execData?.error || 'Command failed');
              output.appendChild(preOut);
              if (execData?.ok) {
                (btn as HTMLElement).innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--low)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>';
              } else {
                (btn as HTMLElement).innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--high)" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';
              }
              row?.after(output);
            });
          });

          const firstDetails = document.getElementById('step-0-details');
          const firstToggle = stepsEl.querySelector('.step-toggle');
          if (firstDetails) firstDetails.style.display = 'block';
          if (firstToggle) firstToggle.classList.add('open');

        } else if (stepsEl && plan.raw) {
          stepsEl.replaceChildren();
          const rawPre = document.createElement('pre');
          rawPre.className = 'autofix-raw';
          rawPre.textContent = typeof plan.raw === 'string' ? plan.raw : String(plan.raw);
          stepsEl.appendChild(rawPre);
        }

        if (autofixContainer) {
          autofixContainer.replaceChildren();
          const retry = document.createElement('button');
          retry.id = 'autofixRetryBtn';
          retry.type = 'button';
          retry.className = 'btn btn-ghost btn-sm';
          retry.textContent = 'Generate new plan';
          retry.addEventListener('click', () => {
            if (autofixPlanDiv) autofixPlanDiv.style.display = 'none';
            autofixContainer.replaceChildren();
            autofixContainer.appendChild(autofixPlanBtn);
            autofixPlanBtn.style.display = 'inline-flex';
          });
          autofixContainer.appendChild(retry);
        }
      } catch (err) {
        window.showToast?.('Network error', 'error');
        autofixPlanBtn.style.display = 'inline-flex';
        if (autofixLoading) autofixLoading.style.display = 'none';
      }
    });
  }
</script>

<style>
  .detail-page { max-width: 760px; margin: 0 auto; }
