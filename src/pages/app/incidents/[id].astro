---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { getTenantDb, tenantSchema } from '../../../lib/db';
import { nanoid } from 'nanoid';
import { eq, desc } from 'drizzle-orm';
import { validateCsrf } from '../../../middleware';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

const { id } = Astro.params;
const db = getTenantDb(Astro.locals.workspace?.ownerId || user.id);

const incident = db.select().from(tenantSchema.incidents).where(eq(tenantSchema.incidents.id, id!)).get();
if (!incident || incident.userId !== user.id) return Astro.redirect('/app');

// Handle resolution POST
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (validateCsrf(form.get('_csrf') as string, Astro.cookies)) {
    const action = form.get('action') as string;

    if (action === 'resolve') {
      const content = (form.get('content') as string || '').trim();
      if (content) {
        const resId = nanoid();
        const now = new Date();
        db.insert(tenantSchema.resolutions).values({
          id: resId, incidentId: id!, userId: user.id, content, createdAt: now,
        }).run();

        // Sync to FTS
        const rawDb = (db as any)._.session?.client;
        if (rawDb?.prepare) {
          rawDb.prepare('INSERT INTO resolutions_fts(rowid, content) SELECT rowid, content FROM resolutions WHERE id = ?').run(resId);
        }

        db.update(tenantSchema.incidents).set({ status: 'resolved', resolvedAt: now, updatedAt: now }).where(eq(tenantSchema.incidents.id, id!)).run();
      }
    } else if (action === 'status') {
      const status = form.get('status') as string;
      if (['active', 'investigating', 'monitoring', 'resolved'].includes(status)) {
        const updates: any = { status, updatedAt: new Date() };
        if (status === 'resolved') updates.resolvedAt = new Date();
        db.update(tenantSchema.incidents).set(updates).where(eq(tenantSchema.incidents.id, id!)).run();
      }
    }

    return Astro.redirect(`/app/incidents/${id}`);
  }
}

// Re-fetch after potential POST
const current = db.select().from(tenantSchema.incidents).where(eq(tenantSchema.incidents.id, id!)).get()!;
const resolutions = db.select().from(tenantSchema.resolutions).where(eq(tenantSchema.resolutions.incidentId, id!)).orderBy(desc(tenantSchema.resolutions.createdAt)).all();
const diagnosis = db.select().from(tenantSchema.diagnoses).where(eq(tenantSchema.diagnoses.incidentId, id!)).orderBy(desc(tenantSchema.diagnoses.createdAt)).limit(1).all();
const latestDiagnosis = diagnosis[0] || null;

// Get stack context if linked
let stackName = '';
if (current.stackId) {
  const stack = db.select().from(tenantSchema.stacks).where(eq(tenantSchema.stacks.id, current.stackId)).get();
  if (stack) stackName = stack.name;
}

const severityColors: Record<string, string> = { critical: 'var(--critical)', high: 'var(--high)', medium: 'var(--medium)', low: 'var(--low)' };
const statusLabels: Record<string, string> = { active: 'Active', investigating: 'Investigating', monitoring: 'Monitoring', resolved: 'Resolved' };
---
<Layout title={`${current.title} — StdOut`}>
  <div class="detail-page">
    <!-- Header -->
    <div class="incident-header">
      <div class="header-top">
        <a href="/app" class="back-link">&larr; Incidents</a>
        <span class="mono" style="color:var(--text-muted);">#{current.id.slice(0, 8)}</span>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:flex-start;">
        <h1>{current.title}</h1>
        <div class="export-btns">
          <a href={`/app/api/incidents/export?id=${current.id}&format=markdown`} class="btn btn-ghost btn-sm" title="Export as Markdown">Export .md</a>
          <a href={`/app/api/incidents/export?id=${current.id}&format=json`} class="btn btn-ghost btn-sm" title="Export as JSON">Export .json</a>
        </div>
      </div>
      <div class="header-meta">
        <span class={`severity-pill ${current.severity}`}>{current.severity}</span>
        <span class={`status-pill ${current.status}`}>{statusLabels[current.status] || current.status}</span>
        {stackName && <span class="stack-label">{stackName}</span>}
        {current.tags && current.tags.split(',').map(t => <span class="tag">{t.trim()}</span>)}
      </div>
    </div>

    <!-- Description -->
    <section class="section">
      <h2>Description</h2>
      <pre class="description-block">{current.description}</pre>
    </section>

    <!-- Status controls -->
    {current.status !== 'resolved' && (
      <section class="section">
        <h2>Update Status</h2>
        <form method="POST" class="status-form">
          <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
          <input type="hidden" name="action" value="status" />
          {['investigating', 'monitoring', 'resolved'].filter(s => s !== current.status).map(s => (
            <button type="submit" name="status" value={s} class={`status-btn ${s}`}>{statusLabels[s]}</button>
          ))}
        </form>
      </section>
    )}

    <!-- Similar Past Fixes -->
    {current.status !== 'resolved' && (
      <section class="section">
        <h2>Past Fixes</h2>
        <div id="similarMatches" class="similar-loading mono">Searching your history...</div>
      </section>
    )}

    <!-- AI Diagnosis -->
    <section class="section">
      <h2>AI Diagnosis</h2>
      {latestDiagnosis ? (
        <div class="diagnosis-result">
          <h3>Root Causes</h3>
          <ol class="root-causes">
            {JSON.parse(latestDiagnosis.rootCauses).map((cause: string) => <li>{cause}</li>)}
          </ol>
          {latestDiagnosis.suggestedCommands && (
            <>
              <h3>Suggested Commands</h3>
              <div class="commands">
                {JSON.parse(latestDiagnosis.suggestedCommands).map((cmd: string) => (
                  <code class="command-line">{cmd}</code>
                ))}
              </div>
            </>
          )}
          <div class="diagnosis-meta">
            <span class="mono">{latestDiagnosis.model}</span>
            <span>{latestDiagnosis.promptTokens} in / {latestDiagnosis.completionTokens} out</span>
          </div>
        </div>
      ) : (
        <div class="diagnosis-empty">
          <button id="diagnoseBtn" class="btn btn-primary" data-incident-id={current.id}>
            Get AI Diagnosis
          </button>
          <div id="diagnoseLoading" style="display:none;">
            <span class="mono" style="color:var(--accent);">Analyzing...</span>
          </div>
        </div>
      )}
    </section>

    <!-- Resolutions -->
    <section class="section">
      <h2>Resolutions ({resolutions.length})</h2>
      {resolutions.map(r => (
        <div class="resolution-card">
          <pre class="resolution-content">{r.content}</pre>
          <div class="resolution-meta mono">{r.createdAt.toISOString().split('T')[0]}</div>
        </div>
      ))}

      {current.status !== 'resolved' && (
        <form method="POST" class="resolution-form">
          <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
          <input type="hidden" name="action" value="resolve" />
          <label>
            <span>What fixed it?</span>
            <textarea name="content" rows={4} required placeholder="Describe the resolution..."></textarea>
          </label>
          <button type="submit" class="btn btn-primary">Record Resolution</button>
        </form>
      )}
    </section>
  </div>
</Layout>

<script>
  // Load similar past fixes
  const similarEl = document.getElementById('similarMatches');
  if (similarEl) {
    const incidentTitle = document.querySelector('.incident-header h1')?.textContent || '';
    if (incidentTitle) {
      fetch(`/app/api/similar?q=${encodeURIComponent(incidentTitle)}&exclude=${window.location.pathname.split('/').pop()}`)
        .then(r => r.json())
        .then(data => {
          const { matches, docs } = data;
          if ((!matches || matches.length === 0) && (!docs || docs.length === 0)) {
            similarEl.innerHTML = '<div style="color:var(--text-muted);font-size:13px;">No matching past fixes found. Try AI Diagnosis below.</div>';
            return;
          }
          let html = '';
          if (matches && matches.length > 0) {
            html += matches.map((m: any) => `
              <a href="/app/incidents/${m.incidentId}" class="similar-card">
                <div class="similar-title">${esc(m.title)}</div>
                <div class="similar-resolution">${esc(m.resolution)}</div>
                <div class="similar-meta mono">${m.severity} &middot; ${m.tags || ''}</div>
              </a>
            `).join('');
          }
          if (docs && docs.length > 0) {
            html += '<div class="similar-divider mono">Related docs</div>';
            html += docs.map((d: any) => `
              <a href="/app/docs/${d.docId}" class="similar-card">
                <div class="similar-title">${esc(d.title)} <span class="similar-type">${d.docType}</span></div>
                <div class="similar-resolution">${esc(d.snippet)}</div>
              </a>
            `).join('');
          }
          similarEl.innerHTML = html;
        })
        .catch(() => { similarEl.innerHTML = '<div style="color:var(--text-muted);font-size:13px;">Search unavailable.</div>'; });
    } else {
      similarEl.innerHTML = '';
    }
  }

  function esc(s: string) {
    return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  const btn = document.getElementById('diagnoseBtn');
  const loading = document.getElementById('diagnoseLoading');
  if (btn) {
    btn.addEventListener('click', async () => {
      const incidentId = btn.getAttribute('data-incident-id');
      btn.style.display = 'none';
      if (loading) loading.style.display = 'block';
      try {
        const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
        const res = await fetch('/app/api/diagnose', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ incidentId, _csrf: csrf }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.text();
          window.showToast?.('Diagnosis failed: ' + err, 'error');
          btn.style.display = 'inline-flex';
          if (loading) loading.style.display = 'none';
        }
      } catch (e) {
        window.showToast?.('Network error', 'error');
        btn.style.display = 'inline-flex';
        if (loading) loading.style.display = 'none';
      }
    });
  }
</script>

<style>
  .detail-page { max-width: 760px; margin: 0 auto; }
  .back-link { color: var(--text-muted); text-decoration: none; font-size: 13px; }
  .back-link:hover { color: var(--text); }
  .header-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .incident-header h1 { font-size: 20px; margin-bottom: 10px; }
  .header-meta { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .severity-pill, .status-pill { font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 4px; font-family: var(--font-mono); }
  .severity-pill.critical { color: var(--critical); background: var(--critical-dim); }
  .severity-pill.high { color: var(--high); background: var(--high-dim); }
  .severity-pill.medium { color: var(--medium); background: var(--medium-dim); }
  .severity-pill.low { color: var(--low); background: var(--low-dim); }
  .status-pill.active { color: var(--critical); background: var(--critical-dim); }
  .status-pill.investigating { color: var(--high); background: var(--high-dim); }
  .status-pill.monitoring { color: var(--medium); background: var(--medium-dim); }
  .status-pill.resolved { color: var(--resolved); background: rgba(85,85,106,0.12); }
  .stack-label { font-size: 11px; color: var(--accent-light); background: var(--accent-dim); padding: 2px 8px; border-radius: 4px; }
  .tag { padding: 1px 6px; border-radius: 3px; font-size: 10px; font-weight: 500; background: rgba(144,144,168,0.1); color: var(--text-secondary); }
  .section { margin-top: 28px; }
  .section h2 { font-size: 14px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 12px; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
  .description-block { font-family: var(--font-mono); font-size: 13px; line-height: 1.6; white-space: pre-wrap; word-wrap: break-word; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px; color: var(--text); }
  .status-form { display: flex; gap: 8px; }
  .status-btn { padding: 6px 14px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-surface); color: var(--text-secondary); font-size: 12px; font-weight: 500; cursor: pointer; transition: var(--transition); }
  .status-btn:hover { border-color: var(--accent); color: var(--text); }
  .diagnosis-result { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; }
  .diagnosis-result h3 { font-size: 13px; font-weight: 600; margin: 12px 0 8px; color: var(--accent-light); }
  .diagnosis-result h3:first-child { margin-top: 0; }
  .root-causes { padding-left: 20px; font-size: 13px; line-height: 1.6; }
  .root-causes li { margin-bottom: 6px; }
  .commands { display: flex; flex-direction: column; gap: 4px; }
  .command-line { display: block; font-family: var(--font-mono); font-size: 12px; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 4px; padding: 8px 12px; color: var(--accent-light); }
  .diagnosis-meta { margin-top: 12px; font-size: 11px; color: var(--text-muted); display: flex; gap: 16px; }
  .resolution-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px; margin-bottom: 8px; }
  .resolution-content { font-family: var(--font-mono); font-size: 13px; white-space: pre-wrap; word-wrap: break-word; color: var(--text); }
  .resolution-meta { margin-top: 8px; font-size: 11px; color: var(--text-muted); }
  .resolution-form { margin-top: 16px; display: flex; flex-direction: column; gap: 12px; }
  .resolution-form label { display: flex; flex-direction: column; gap: 4px; }
  .resolution-form label span { font-size: 12px; font-weight: 600; color: var(--text-secondary); }
  .resolution-form textarea { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text); font-family: var(--font-mono); font-size: 13px; padding: 10px 12px; resize: vertical; }
  .resolution-form textarea:focus { border-color: var(--accent); outline: none; }
  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; border: none; border-radius: var(--radius-sm); font-weight: 600; font-size: 13px; cursor: pointer; text-decoration: none; }
  .btn-primary { background: var(--accent-btn); color: #fff; }
  .btn-primary:hover { background: var(--accent-light); }
  .mono { font-family: var(--font-mono); }
  .similar-loading { font-size: 12px; color: var(--text-muted); }
  .similar-card { display: block; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px; margin-bottom: 8px; text-decoration: none; color: inherit; transition: border-color 150ms; }
  .similar-card:hover { border-color: var(--accent); }
  .similar-title { font-size: 13px; font-weight: 500; margin-bottom: 6px; }
  .similar-type { font-size: 10px; font-family: var(--font-mono); color: var(--accent-light); background: var(--accent-dim); padding: 1px 6px; border-radius: 3px; margin-left: 6px; }
  .similar-resolution { font-size: 12px; font-family: var(--font-mono); color: var(--text-secondary); line-height: 1.5; white-space: pre-wrap; word-wrap: break-word; }
  .similar-meta { font-size: 11px; color: var(--text-muted); margin-top: 6px; }
  .similar-divider { font-size: 11px; color: var(--text-muted); margin: 12px 0 8px; padding-top: 8px; border-top: 1px solid var(--border); }
</style>
