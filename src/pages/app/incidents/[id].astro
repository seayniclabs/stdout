  .commands { display: flex; flex-direction: column; gap: 4px; }
  .command-line { display: block; font-family: var(--font-mono); font-size: 12px; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 4px; padding: 8px 12px; color: var(--accent-light); }
  .diagnosis-meta { margin-top: 12px; font-size: 11px; color: var(--text-muted); display: flex; gap: 16px; }

</style>
<style is:global>
  /* Auto-Fix (global — rendered via innerHTML) */
  .section-hint { font-size: 0.8rem; color: var(--muted); margin: 0 0 1rem; }
  .autofix-summary { margin-bottom: 0.5rem; font-size: 0.95rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .risk-badge { font-size: 0.65rem; padding: 0.15rem 0.5rem; border: 1px solid; border-radius: 4px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; }
  .risk-badge.risk-high { color: var(--high); border-color: var(--high); }
  .risk-badge.risk-medium { color: #F97316; border-color: #F97316; }
  .risk-badge.risk-low { color: var(--low); border-color: var(--low); }
  .time-badge { font-size: 0.7rem; color: var(--muted); font-family: var(--font-mono); }
  .autofix-meta { font-size: 0.75rem; color: var(--muted); margin-bottom: 1rem; display: flex; gap: 1rem; }

  /* Progress bar */
  .autofix-progress { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
  .progress-bar { flex: 1; height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; }
  .progress-fill { height: 100%; background: var(--low, #4ade80); border-radius: 3px; transition: width 0.3s ease; }
  .progress-text { font-size: 0.75rem; font-family: var(--font-mono); color: var(--muted); white-space: nowrap; }

  /* Steps */
  .autofix-steps { display: flex; flex-direction: column; gap: 0.5rem; }
  .autofix-step { background: var(--card-bg, rgba(255,255,255,0.03)); border: 1px solid var(--border); border-radius: 8px; padding: 0; transition: opacity 0.2s, border-color 0.15s; }
  .autofix-step:hover { border-color: var(--border-hover, rgba(255,255,255,0.14)); }
  .autofix-step.step-done { opacity: 0.45; }
  .autofix-step.step-done .step-desc { text-decoration: line-through; color: var(--muted); }

  .step-header { display: flex; align-items: center; gap: 0.5rem; padding: 0.65rem 0.75rem; }
  .step-checkbox { width: 16px; height: 16px; accent-color: var(--low, #4ade80); cursor: pointer; flex-shrink: 0; }
  .step-number { width: 24px; height: 24px; border-radius: 50%; background: #F97316; color: #fff; font-size: 0.7rem; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; line-height: 1; }
  .step-desc { font-size: 0.85rem; font-weight: 500; flex: 1; }
  .step-toggle { background: none; border: none; color: var(--muted); cursor: pointer; padding: 4px; border-radius: 4px; flex-shrink: 0; transition: transform 0.2s; }
  .step-toggle:hover { color: var(--text); }
  .step-toggle.open { transform: rotate(180deg); }

  /* Step details (collapsible) */
  .step-details { padding: 0.6rem 0.75rem 0.75rem; border-top: 1px solid var(--border); }
  .step-section { margin-top: 0.6rem; }
  .step-section-label { display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); font-weight: 600; margin-bottom: 0.3rem; }
  .step-section-muted { opacity: 0.7; }
  .step-section-muted p { font-size: 0.8rem; margin: 0; color: var(--muted); line-height: 1.5; }

  /* Commands with copy buttons */
  .command-row { display: flex; align-items: center; gap: 0.35rem; margin-bottom: 0.25rem; }
  .command-row .command-line { flex: 1; font-size: 0.8rem; overflow-x: auto; }
  .copy-btn { background: none; border: 1px solid var(--border); border-radius: 4px; color: var(--muted); cursor: pointer; padding: 3px 5px; flex-shrink: 0; transition: color 0.15s, border-color 0.15s; }
  .copy-btn:hover { color: var(--text); border-color: var(--text); }
  .run-btn { background: none; border: 1px solid rgba(249, 115, 22, 0.3); border-radius: 4px; color: #F97316; cursor: pointer; padding: 3px 5px; flex-shrink: 0; transition: color 0.15s, border-color 0.15s, background 0.15s; }
  .run-btn:hover { background: rgba(249, 115, 22, 0.1); border-color: #F97316; }
  .cmd-output { margin: 0.25rem 0 0.5rem 0; }
  .cmd-stdout { font-size: 0.75rem; background: rgba(74, 222, 128, 0.05); border: 1px solid rgba(74, 222, 128, 0.15); border-radius: 4px; padding: 0.5rem; color: var(--low); white-space: pre-wrap; max-height: 200px; overflow-y: auto; }
  .cmd-stderr { font-size: 0.75rem; background: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.15); border-radius: 4px; padding: 0.5rem; color: var(--high); white-space: pre-wrap; max-height: 200px; overflow-y: auto; }

  /* Files */
  .file-change { font-size: 0.8rem; padding: 0.3rem 0; display: flex; flex-direction: column; gap: 0.1rem; }
  .file-change code { font-size: 0.75rem; color: var(--accent, #F97316); }
  .file-change-desc { font-size: 0.78rem; color: var(--muted); }

  .autofix-raw { font-size: 0.8rem; white-space: pre-wrap; background: var(--card-bg); padding: 1rem; border-radius: 6px; border: 1px solid var(--border); }
  .resolution-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px; margin-bottom: 8px; }
  .resolution-content { font-family: var(--font-mono); font-size: 13px; white-space: pre-wrap; word-wrap: break-word; color: var(--text); }
  .resolution-meta { margin-top: 8px; font-size: 11px; color: var(--text-muted); }
  .resolution-form { margin-top: 16px; display: flex; flex-direction: column; gap: 12px; }
  .resolution-form label { display: flex; flex-direction: column; gap: 4px; }
  .resolution-form label span { font-size: 12px; font-weight: 600; color: var(--text-secondary); }
  .resolution-form textarea { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text); font-family: var(--font-mono); font-size: 13px; padding: 10px 12px; resize: vertical; }
  .resolution-form textarea:focus { border-color: var(--accent); outline: none; }
  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; border: none; border-radius: var(--radius-sm); font-weight: 600; font-size: 13px; cursor: pointer; text-decoration: none; }
  .btn-primary { background: var(--accent-btn); color: #fff; }
  .btn-primary:hover { background: var(--accent-light); }
  .mono { font-family: var(--font-mono); }
  .similar-loading { font-size: 12px; color: var(--text-muted); }
  .similar-card { display: block; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px; margin-bottom: 8px; text-decoration: none; color: inherit; transition: border-color 150ms; }
  .similar-card:hover { border-color: var(--accent); }
  .similar-title { font-size: 13px; font-weight: 500; margin-bottom: 6px; }
  .similar-type { font-size: 10px; font-family: var(--font-mono); color: var(--accent-light); background: var(--accent-dim); padding: 1px 6px; border-radius: 3px; margin-left: 6px; }
  .similar-resolution { font-size: 12px; font-family: var(--font-mono); color: var(--text-secondary); line-height: 1.5; white-space: pre-wrap; word-wrap: break-word; }
  .similar-meta { font-size: 11px; color: var(--text-muted); margin-top: 6px; }
  .similar-divider { font-size: 11px; color: var(--text-muted); margin: 12px 0 8px; padding-top: 8px; border-top: 1px solid var(--border); }

  /* Metrics enrichment */
  .metrics-hint { font-size: 11px; color: var(--text-muted); margin-bottom: 12px; }
  .metrics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; }
  .metric-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 12px;
    transition: border-color 150ms;
  }
  .metric-card:hover { border-color: var(--border-hover); }
  .metric-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .metric-label { font-size: 10px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; }
  .metric-value { font-size: 14px; font-weight: 700; }
  .metric-spark { width: 100%; height: 40px; overflow: visible; }

  /* Empty past fixes state */
  .empty-past-fixes {
    text-align: center;
    padding: 2rem;
    background: var(--bg-surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
  .empty-past-fixes .empty-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .empty-past-fixes .empty-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 0.5rem 0;
  }
  .empty-past-fixes .empty-hint {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0 0 1.5rem 0;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }
  .empty-past-fixes .empty-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
