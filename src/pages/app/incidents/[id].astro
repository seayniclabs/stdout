---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { getTenantDb, tenantSchema } from '../../../lib/db';
import { nanoid } from 'nanoid';
import { eq, desc } from 'drizzle-orm';
import { validateCsrf } from '../../../middleware';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

const { id } = Astro.params;
const db = getTenantDb(Astro.locals.workspace?.ownerId || user.id);

const incident = db.select().from(tenantSchema.incidents).where(eq(tenantSchema.incidents.id, id!)).get();
if (!incident || incident.userId !== user.id) return Astro.redirect('/app');

// Handle resolution POST
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (validateCsrf(form.get('_csrf') as string, Astro.cookies)) {
    const action = form.get('action') as string;

    if (action === 'resolve') {
      const content = (form.get('content') as string || '').trim();
      if (content) {
        const resId = nanoid();
        const now = new Date();
        db.insert(tenantSchema.resolutions).values({
          id: resId, incidentId: id!, userId: user.id, content, createdAt: now,
        }).run();

        // Sync to FTS
        const rawDb = (db as any).$client;
        if (rawDb?.prepare) {
          rawDb.prepare('INSERT INTO resolutions_fts(rowid, content) SELECT rowid, content FROM resolutions WHERE id = ?').run(resId);
        }

        db.update(tenantSchema.incidents).set({ status: 'resolved', resolvedAt: now, updatedAt: now }).where(eq(tenantSchema.incidents.id, id!)).run();
      }
    } else if (action === 'status') {
      const status = form.get('status') as string;
      if (['active', 'investigating', 'monitoring', 'resolved'].includes(status)) {
        const updates: any = { status, updatedAt: new Date() };
        if (status === 'resolved') updates.resolvedAt = new Date();
        db.update(tenantSchema.incidents).set(updates).where(eq(tenantSchema.incidents.id, id!)).run();
      }
    }

    return Astro.redirect(`/app/incidents/${id}`);
  }
}

// Re-fetch after potential POST
const current = db.select().from(tenantSchema.incidents).where(eq(tenantSchema.incidents.id, id!)).get()!;
const resolutions = db.select().from(tenantSchema.resolutions).where(eq(tenantSchema.resolutions.incidentId, id!)).orderBy(desc(tenantSchema.resolutions.createdAt)).all();
const diagnosis = db.select().from(tenantSchema.diagnoses).where(eq(tenantSchema.diagnoses.incidentId, id!)).orderBy(desc(tenantSchema.diagnoses.createdAt)).limit(1).all();
const latestDiagnosis = diagnosis[0] || null;

// Get stack context if linked
let stackName = '';
if (current.stackId) {
  const stack = db.select().from(tenantSchema.stacks).where(eq(tenantSchema.stacks.id, current.stackId)).get();
  if (stack) stackName = stack.name;
}

const severityColors: Record<string, string> = { critical: 'var(--critical)', high: 'var(--high)', medium: 'var(--medium)', low: 'var(--low)' };
const statusLabels: Record<string, string> = { active: 'Active', investigating: 'Investigating', monitoring: 'Monitoring', resolved: 'Resolved' };
---
<Layout title={`${current.title} — StdOut`}>
  <div class="detail-page">
    <!-- Header -->
    <div class="incident-header">
      <div class="header-top">
        <a href="/app" class="back-link">&larr; Incidents</a>
        <span class="mono" style="color:var(--text-muted);">#{current.id.slice(0, 8)}</span>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:flex-start;">
        <h1>{current.title}</h1>
        <div class="export-btns">
          <a href={`/app/api/incidents/export?id=${current.id}&format=markdown`} class="btn btn-ghost btn-sm" title="Export as Markdown">Export .md</a>
          <a href={`/app/api/incidents/export?id=${current.id}&format=json`} class="btn btn-ghost btn-sm" title="Export as JSON">Export .json</a>
        </div>
      </div>
      <div class="header-meta">
        <span class={`severity-pill ${current.severity}`}>{current.severity}</span>
        <span class={`status-pill ${current.status}`}>{statusLabels[current.status] || current.status}</span>
        {stackName && <span class="stack-label">{stackName}</span>}
        {current.tags && current.tags.split(',').map(t => <span class="tag">{t.trim()}</span>)}
      </div>
    </div>

    <!-- Description -->
    <section class="section">
      <h2>Description</h2>
      <pre class="description-block">{current.description}</pre>
    </section>

    <!-- Status controls -->
    {current.status !== 'resolved' && (
      <section class="section">
        <h2>Update Status</h2>
        <form method="POST" class="status-form">
          <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
          <input type="hidden" name="action" value="status" />
          {['investigating', 'monitoring', 'resolved'].filter(s => s !== current.status).map(s => (
            <button type="submit" name="status" value={s} class={`status-btn ${s}`}>{statusLabels[s]}</button>
          ))}
        </form>
      </section>
    )}

    <!-- Metrics Context (InfluxDB enrichment) -->
    <section class="section" id="metricsSection" style="display:none;">
      <h2>Resource Metrics</h2>
      <p class="metrics-hint mono" id="metricsHint">Loading metrics around incident time...</p>
      <div class="metrics-grid" id="metricsGrid"></div>
    </section>

    <!-- Similar Past Fixes -->
    {current.status !== 'resolved' && (
      <section class="section">
        <h2>Past Fixes</h2>
        <div id="similarMatches" class="similar-loading mono">Searching your history...</div>
      </section>
    )}

    <!-- AI Diagnosis -->
    <section class="section">
      <h2>AI Diagnosis</h2>
      {latestDiagnosis ? (
        <div class="diagnosis-result">
          <h3>Root Causes</h3>
          <ol class="root-causes">
            {JSON.parse(latestDiagnosis.rootCauses).map((cause: string) => <li>{cause}</li>)}
          </ol>
          {latestDiagnosis.suggestedCommands && (
            <>
              <h3>Suggested Commands</h3>
              <div class="commands">
                {JSON.parse(latestDiagnosis.suggestedCommands).map((cmd: string) => (
                  <code class="command-line">{cmd}</code>
                ))}
              </div>
            </>
          )}
          <div class="diagnosis-meta">
            <span class="mono">{latestDiagnosis.model}</span>
            <span>{latestDiagnosis.promptTokens} in / {latestDiagnosis.completionTokens} out</span>
          </div>
        </div>
      ) : (
        <div class="diagnosis-empty">
          <button id="diagnoseBtn" class="btn btn-primary" data-incident-id={current.id}>
            Get AI Diagnosis
          </button>
          <div id="diagnoseLoading" style="display:none;">
            <span class="mono" style="color:var(--accent);">Analyzing...</span>
          </div>
        </div>
      )}
    </section>

    <!-- Auto-Fix (BYOK user key required) -->
    {current.status !== 'resolved' && (
      <section class="section">
        <h2>Auto-Fix</h2>
        <p class="section-hint">Generate a step-by-step remediation plan using your AI provider key. Requires a BYOK key in Settings.</p>

        <div id="autofixContainer">
          <button id="autofixPlanBtn" class="btn btn-primary" data-incident-id={current.id}>
            Generate Fix Plan
          </button>
          <div id="autofixLoading" style="display:none;">
            <span class="mono" style="color:var(--accent);">Generating remediation plan...</span>
          </div>
        </div>

        <div id="autofixPlan" style="display:none;">
          <div class="autofix-summary" id="autofixSummary"></div>
          <div class="autofix-meta" id="autofixMeta"></div>
          <div class="autofix-steps" id="autofixSteps"></div>
        </div>
      </section>
    )}

    <!-- Resolutions -->
    <section class="section">
      <h2>Resolutions ({resolutions.length})</h2>
      {resolutions.map(r => (
        <div class="resolution-card">
          <pre class="resolution-content">{r.content}</pre>
          <div class="resolution-meta mono">{r.createdAt.toISOString().split('T')[0]}</div>
        </div>
      ))}

      {current.status !== 'resolved' && (
        <form method="POST" class="resolution-form">
          <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
          <input type="hidden" name="action" value="resolve" />
          <label>
            <span>What fixed it?</span>
            <textarea name="content" rows={4} required placeholder="Describe the resolution..."></textarea>
          </label>
          <button type="submit" class="btn btn-primary">Record Resolution</button>
        </form>
      )}
    </section>
  </div>
</Layout>

<script>
  // Load similar past fixes
  const similarEl = document.getElementById('similarMatches');
  if (similarEl) {
    const incidentTitle = document.querySelector('.incident-header h1')?.textContent || '';
    if (incidentTitle) {
      fetch(`/app/api/similar?q=${encodeURIComponent(incidentTitle)}&exclude=${window.location.pathname.split('/').pop()}`)
        .then(r => r.json())
        .then(data => {
          const { matches, docs } = data;
          if ((!matches || matches.length === 0) && (!docs || docs.length === 0)) {
            similarEl.innerHTML = '<div style="color:var(--text-muted);font-size:13px;">No matching past fixes found. Try AI Diagnosis below.</div>';
            return;
          }
          let html = '';
          if (matches && matches.length > 0) {
            html += matches.map((m: any) => `
              <a href="/app/incidents/${m.incidentId}" class="similar-card">
                <div class="similar-title">${esc(m.title)}</div>
                <div class="similar-resolution">${esc(m.resolution)}</div>
                <div class="similar-meta mono">${m.severity} &middot; ${m.tags || ''}</div>
              </a>
            `).join('');
          }
          if (docs && docs.length > 0) {
            html += '<div class="similar-divider mono">Related docs</div>';
            html += docs.map((d: any) => `
              <a href="/app/docs/${d.docId}" class="similar-card">
                <div class="similar-title">${esc(d.title)} <span class="similar-type">${d.docType}</span></div>
                <div class="similar-resolution">${esc(d.snippet)}</div>
              </a>
            `).join('');
          }
          similarEl.innerHTML = html;
        })
        .catch(() => { similarEl.innerHTML = '<div style="color:var(--text-muted);font-size:13px;">Search unavailable.</div>'; });
    } else {
      similarEl.innerHTML = '';
    }
  }

  function esc(s: string) {
    return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  const btn = document.getElementById('diagnoseBtn');
  const loading = document.getElementById('diagnoseLoading');
  if (btn) {
    btn.addEventListener('click', async () => {
      const incidentId = btn.getAttribute('data-incident-id');
      btn.style.display = 'none';
      if (loading) loading.style.display = 'block';
      try {
        const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
        const res = await fetch('/app/api/diagnose', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ incidentId, _csrf: csrf }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.text();
          window.showToast?.('Diagnosis failed: ' + err, 'error');
          btn.style.display = 'inline-flex';
          if (loading) loading.style.display = 'none';
        }
      } catch (e) {
        window.showToast?.('Network error', 'error');
        btn.style.display = 'inline-flex';
        if (loading) loading.style.display = 'none';
      }
    });
  }

  // --- Metrics enrichment (InfluxDB) ---
  const metricsSection = document.getElementById('metricsSection');
  const metricsGrid = document.getElementById('metricsGrid');
  const metricsHint = document.getElementById('metricsHint');

  // Try to guess a container name from the incident title/tags
  const incTitle = document.querySelector('.incident-header h1')?.textContent || '';
  const incTags = Array.from(document.querySelectorAll('.tag')).map(t => t.textContent?.trim() || '');

  function guessContainer(): string | null {
    // Check tags first
    const skip = new Set(['hud', 'auto', 'http', 'tcp', 'docker', 'ping', 'dns', 'critical', 'high', 'medium', 'low']);
    for (const tag of incTags) {
      if (tag && !skip.has(tag)) return tag;
    }
    // Try title pattern "X is down"
    const m = incTitle.match(/^(.+?)\s+is\s+(down|degraded)/i);
    if (m) return m[1].toLowerCase().replace(/\s+/g, '-');
    return null;
  }

  const containerName = guessContainer();
  if (containerName) {
    fetch(`/app/api/metrics?type=container&name=${encodeURIComponent(containerName)}&range=60`)
      .then(r => r.json())
      .then(data => {
        if (!data.configured || !data.data) return;
        const { cpu, memory, network } = data.data;
        if ((!cpu || cpu.length === 0) && (!memory || memory.length === 0) && (!network || network.length === 0)) return;

        if (metricsSection) metricsSection.style.display = '';
        if (metricsHint) {
          const src = data.source === 'prometheus' ? 'Prometheus' : 'InfluxDB';
          metricsHint.textContent = `Metrics for "${containerName}" — last 60 minutes via ${src}`;
        }

        let html = '';
        if (cpu && cpu.length > 1) {
          html += renderMetricCard('CPU %', cpu, 'var(--accent-light)', '%');
        }
        if (memory && memory.length > 1) {
          html += renderMetricCard('Memory', memory, 'var(--teal)', ' MB');
        }
        if (network && network.length > 1) {
          html += renderMetricCard('Network', network, '#60A5FA', ' B/s');
        }
        if (metricsGrid) metricsGrid.innerHTML = html;
      })
      .catch(() => {});
  }

  function renderMetricCard(label: string, points: {time: string; value: number}[], color: string, unit: string): string {
    const values = points.map(p => p.value);
    const max = Math.max(...values, 0.001);
    const min = Math.min(...values);
    const latest = values[values.length - 1];
    const latestStr = latest < 10 ? latest.toFixed(1) : Math.round(latest).toString();

    // Build SVG sparkline
    const w = 240, h = 40;
    const pts = values.map((v, i) => {
      const x = (i / Math.max(values.length - 1, 1)) * w;
      const y = h - 2 - ((v - min) / (max - min + 0.001)) * (h - 4);
      return `${x},${y}`;
    });
    const linePath = pts.length > 1 ? `M${pts.join(' L')}` : '';
    const areaPath = pts.length > 1 ? `M${pts.join(' L')} L${w},${h} L0,${h} Z` : '';

    return `
      <div class="metric-card">
        <div class="metric-header">
          <span class="metric-label">${label}</span>
          <span class="metric-value mono" style="color:${color};">${latestStr}${unit}</span>
        </div>
        <svg class="metric-spark" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none">
          <path d="${areaPath}" fill="${color}" opacity="0.1" />
          <path d="${linePath}" fill="none" stroke="${color}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>`;
  }

  // --- Auto-Fix ---
  const autofixPlanBtn = document.getElementById('autofixPlanBtn');
  const autofixLoading = document.getElementById('autofixLoading');
  const autofixContainer = document.getElementById('autofixContainer');
  const autofixPlanDiv = document.getElementById('autofixPlan');

  if (autofixPlanBtn) {
    autofixPlanBtn.addEventListener('click', async () => {
      const incidentId = (autofixPlanBtn as HTMLElement).dataset.incidentId;
      autofixPlanBtn.style.display = 'none';
      if (autofixLoading) autofixLoading.style.display = 'block';

      try {
        const res = await window.stdoutFetch('/app/api/incidents/autofix', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ incidentId, action: 'plan' }),
        });

        const data = await res?.json();

        if (!res?.ok) {
          window.showToast?.(data?.error || 'Auto-fix failed', 'error');
          autofixPlanBtn.style.display = 'inline-flex';
          if (autofixLoading) autofixLoading.style.display = 'none';
          return;
        }

        // Render the plan
        if (autofixPlanDiv) autofixPlanDiv.style.display = 'block';
        if (autofixLoading) autofixLoading.style.display = 'none';

        const plan = data.plan;
        const summaryEl = document.getElementById('autofixSummary');
        const metaEl = document.getElementById('autofixMeta');
        const stepsEl = document.getElementById('autofixSteps');

        if (summaryEl) {
          summaryEl.innerHTML = `<strong>${plan.summary || 'Remediation plan generated'}</strong>`;
          if (plan.totalRisk) {
            const riskColor = plan.totalRisk === 'high' ? 'var(--high)' : plan.totalRisk === 'medium' ? '#F97316' : 'var(--low)';
            summaryEl.innerHTML += ` <span class="risk-badge" style="color: ${riskColor}; border-color: ${riskColor};">${plan.totalRisk} risk</span>`;
          }
          if (plan.estimatedTime) {
            summaryEl.innerHTML += ` <span class="time-badge">${plan.estimatedTime}</span>`;
          }
        }

        if (metaEl) {
          metaEl.innerHTML = `<span class="mono">${data.provider}/${data.model}</span> <span>${data.tokens.prompt} in / ${data.tokens.completion} out</span>`;
        }

        if (stepsEl && plan.steps && plan.steps.length > 0) {
          stepsEl.innerHTML = plan.steps.map((step: any, i: number) => {
            const riskColor = step.risk === 'high' ? 'var(--high)' : step.risk === 'medium' ? '#F97316' : 'var(--low)';
            const stepId = `step-${i}`;
            const hasDetails = (step.commands?.length > 0) || (step.files?.length > 0) || step.verification || step.rollback;

            let html = `<div class="autofix-step" id="${stepId}">
              <div class="step-header">
                <label class="step-check">
                  <input type="checkbox" class="step-checkbox" data-step="${i}" />
                  <span class="step-number">${step.order || i + 1}</span>
                </label>
                <div class="step-header-text">
                  <span class="step-desc">${step.description}</span>
                  <span class="risk-badge" style="color: ${riskColor}; border-color: ${riskColor};">${step.risk || '?'}</span>
                </div>
                ${hasDetails ? `<button class="step-toggle" data-target="${stepId}-details" title="Show details">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                </button>` : ''}
              </div>`;

            if (hasDetails) {
              html += `<div class="step-details" id="${stepId}-details" style="display:none;">`;

              if (step.commands && step.commands.length > 0) {
                html += `<div class="step-section">
                  <span class="step-section-label">Commands</span>
                  <div class="step-commands">${step.commands.map((c: string) =>
                    `<div class="command-row">
                      <code class="command-line">${c}</code>
                      <button class="copy-btn" data-copy="${c.replace(/"/g, '&quot;')}" title="Copy">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                      </button>
                    </div>`
                  ).join('')}</div>
                </div>`;
              }

              if (step.files && step.files.length > 0) {
                html += `<div class="step-section">
                  <span class="step-section-label">Files</span>
                  ${step.files.map((f: any) => `<div class="file-change"><code class="mono">${f.path}</code><span class="file-change-desc">${f.change}</span></div>`).join('')}
                </div>`;
              }

              if (step.verification) {
                html += `<div class="step-section step-section-muted">
                  <span class="step-section-label">Verification</span>
                  <p>${step.verification}</p>
                </div>`;
              }

              if (step.rollback) {
                html += `<div class="step-section step-section-muted">
                  <span class="step-section-label">Rollback</span>
                  <p>${step.rollback}</p>
                </div>`;
              }

              html += '</div>'; // close step-details
            }

            html += '</div>'; // close autofix-step
            return html;
          }).join('');

          // Progress bar
          const total = plan.steps.length;
          stepsEl.insertAdjacentHTML('beforebegin',
            `<div class="autofix-progress">
              <div class="progress-bar"><div class="progress-fill" id="autofixProgressFill" style="width: 0%"></div></div>
              <span class="progress-text" id="autofixProgressText">0 / ${total} steps</span>
            </div>`
          );

          // Bind toggles
          stepsEl.querySelectorAll('.step-toggle').forEach((btn: Element) => {
            btn.addEventListener('click', () => {
              const targetId = (btn as HTMLElement).dataset.target;
              const target = document.getElementById(targetId!);
              if (target) {
                const isOpen = target.style.display !== 'none';
                target.style.display = isOpen ? 'none' : 'block';
                (btn as HTMLElement).classList.toggle('open', !isOpen);
              }
            });
          });

          // Bind copy buttons
          stepsEl.querySelectorAll('.copy-btn').forEach((btn: Element) => {
            btn.addEventListener('click', () => {
              const text = (btn as HTMLElement).dataset.copy || '';
              navigator.clipboard.writeText(text).then(() => {
                (btn as HTMLElement).innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--low)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>';
                setTimeout(() => {
                  (btn as HTMLElement).innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
                }, 1500);
              });
            });
          });

          // Bind checkboxes for progress tracking
          stepsEl.querySelectorAll('.step-checkbox').forEach((cb: Element) => {
            cb.addEventListener('change', () => {
              const checked = stepsEl!.querySelectorAll('.step-checkbox:checked').length;
              const fill = document.getElementById('autofixProgressFill');
              const text = document.getElementById('autofixProgressText');
              if (fill) fill.style.width = `${(checked / total) * 100}%`;
              if (text) text.textContent = `${checked} / ${total} steps`;

              // Dim completed steps
              const stepEl = (cb as HTMLElement).closest('.autofix-step');
              if (stepEl) stepEl.classList.toggle('step-done', (cb as HTMLInputElement).checked);
            });
          });

          // Auto-expand the first step
          const firstDetails = document.getElementById('step-0-details');
          const firstToggle = stepsEl.querySelector('.step-toggle');
          if (firstDetails) firstDetails.style.display = 'block';
          if (firstToggle) firstToggle.classList.add('open');

        } else if (stepsEl && plan.raw) {
          stepsEl.innerHTML = `<pre class="autofix-raw">${plan.raw}</pre>`;
        }

        // Show "Generate again" button
        if (autofixContainer) {
          autofixContainer.innerHTML = `<button id="autofixRetryBtn" class="btn btn-ghost btn-sm">Generate new plan</button>`;
          document.getElementById('autofixRetryBtn')?.addEventListener('click', () => {
            if (autofixPlanDiv) autofixPlanDiv.style.display = 'none';
            autofixContainer.innerHTML = '';
            autofixContainer.appendChild(autofixPlanBtn);
            autofixPlanBtn.style.display = 'inline-flex';
          });
        }
      } catch (err) {
        window.showToast?.('Network error', 'error');
        autofixPlanBtn.style.display = 'inline-flex';
        if (autofixLoading) autofixLoading.style.display = 'none';
      }
    });
  }
</script>

<style>
  .detail-page { max-width: 760px; margin: 0 auto; }
  .back-link { color: var(--text-muted); text-decoration: none; font-size: 13px; }
  .back-link:hover { color: var(--text); }
  .header-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .incident-header h1 { font-size: 20px; margin-bottom: 10px; }
  .header-meta { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
