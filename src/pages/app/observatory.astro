  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js" integrity="sha384-e6nUZLBkQ86NJ6TVVKAeSaK8jWa3NhkYWZFomE39AvDbQWeie9PlQqM3pmYW5d1g" crossorigin="anonymous"></script>
  <script>
    // WebSocket connection to Sentinel
    let ws: WebSocket | null = null;
    let chart: any = null;
    let metricsData = {
      cpu: { labels: [], data: [] },
      memory: { labels: [], data: [] },
      network: { labels: [], data: [] },
      requests: { labels: [], data: [] }
    };
    let currentMetric = 'cpu';
    let logsPaused = false;

    // ── Autonomic Control: operating mode, auto-pilot, god mode, killswitch, RAG, approvals ──
    async function loadModeState() {
      try {
        const res = await fetch('/app/api/observatory/mode');
        if (!res.ok) return;
        const { state } = await res.json();
        renderModeState(state);
      } catch (e) { console.error('mode load failed', e); }
    }

    function renderModeState(s: any) {
      // Mode ladder — highlight the manual mode; show effective if higher (auto-pilot).
      document.querySelectorAll('.mode-btn').forEach((b) => {
        const m = (b as HTMLElement).dataset.mode;
        b.classList.toggle('active', m === s.manualMode);
      });
      const ap = document.getElementById('autopilotToggle') as HTMLInputElement | null;
      if (ap) ap.checked = !!s.autopilotEnabled;
      const apState = document.getElementById('autopilotState');
      if (apState) {
        if (s.autopilotEnabled) {
          apState.innerHTML = `<span style="color: var(--success); font-weight: 600;">● Enabled</span> — currently at "${s.autopilotLevel}" (effective: ${s.effectiveMode}). Ceiling: non-destructive.`;
        } else {
          apState.innerHTML = `<span style="color: var(--text-muted); font-weight: 600;">○ Disabled</span> — Self-escalates discover → diagnose → auto-fix as it earns trust. Ceiling: non-destructive.`;
        }
      }
      const gm = document.getElementById('godModeToggle') as HTMLInputElement | null;
      if (gm) gm.checked = !!s.godModeGranted;
      const rag = document.getElementById('ragPublicToggle') as HTMLInputElement | null;
      if (rag) rag.checked = !!s.ragIncludePublic;

      // Killswitch banner + badge.
      const banner = document.getElementById('killswitchBanner');
      const badge = document.getElementById('modeKillswitchBadge');
      if (banner) banner.style.display = s.killswitchTripped ? 'flex' : 'none';
      if (badge) badge.style.display = s.killswitchTripped ? 'inline-block' : 'none';
      const reason = document.getElementById('killswitchReason');
      if (reason && s.killswitchReason) reason.textContent = s.killswitchReason;
    }

    async function postMode(body: any) {
      const res = await fetch('/app/api/observatory/mode', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
      });
      if (!res.ok) {
        const e = await res.json().catch(() => ({}));
        alert(e.error || 'Action failed (need manage_settings permission?)');
        await loadModeState();
        return null;
      }
      const data = await res.json();
      if (data.state) renderModeState(data.state);
      return data;
    }

    async function loadPendingFixes() {
      const list = document.getElementById('pendingFixes');
      if (!list) return;
      try {
        const res = await fetch('/app/api/observatory/pending-fix');
        if (!res.ok) return;
        const { fixes } = await res.json();
        if (!fixes || fixes.length === 0) {
          list.innerHTML = '<div class="pending-empty">No fixes awaiting approval.</div>';
          return;
        }
        list.innerHTML = fixes.map((f: any) => `
          <div class="pending-item" data-id="${f.id}">
            <div class="pf-body">
              <div class="pf-cmd">${escapeHtml(f.command)}</div>
              <div class="pf-reason">${escapeHtml(f.reason || '')} · proposed by ${escapeHtml(f.proposedBy || 'autopilot')}</div>
            </div>
            <div class="pf-actions">
              <button class="btn-glass pf-approve" data-id="${f.id}">Approve</button>
              <button class="btn-glass pf-deny" data-id="${f.id}">Deny</button>
            </div>
          </div>`).join('');
        list.querySelectorAll('.pf-approve').forEach((b) =>
          b.addEventListener('click', () => decidePending((b as HTMLElement).dataset.id!, 'approve')));
        list.querySelectorAll('.pf-deny').forEach((b) =>
          b.addEventListener('click', () => decidePending((b as HTMLElement).dataset.id!, 'deny')));
      } catch (e) { console.error('pending load failed', e); }
    }

    async function decidePending(id: string, decision: 'approve' | 'deny') {
      if (decision === 'approve' && !confirm('Approve and run this command on the host?')) return;
      const res = await fetch('/app/api/observatory/pending-fix', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, decision }),
      });
      if (!res.ok) {
        const e = await res.json().catch(() => ({}));
        alert(e.error || 'Decision failed');
      }
      await loadPendingFixes();
    }

    function escapeHtml(s: string) {
      return String(s).replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
    }

    function wireAutonomicControls() {
      document.querySelectorAll('.mode-btn').forEach((b) =>
        b.addEventListener('click', () => postMode({ op: 'setMode', mode: (b as HTMLElement).dataset.mode })));
      document.getElementById('autopilotToggle')?.addEventListener('change', (e) =>
        postMode({ op: 'setAutopilot', enabled: (e.target as HTMLInputElement).checked }));
      document.getElementById('godModeToggle')?.addEventListener('change', (e) => {
        const on = (e.target as HTMLInputElement).checked;
        if (on && !confirm('Grant god mode? This lets the brain auto-apply DESTRUCTIVE fixes. Human-only.')) {
          (e.target as HTMLInputElement).checked = false; return;
        }
        postMode({ op: 'setGodMode', granted: on });
      });
      document.getElementById('ragPublicToggle')?.addEventListener('change', (e) =>
        postMode({ op: 'setRagIncludePublic', enabled: (e.target as HTMLInputElement).checked }));
      document.getElementById('resetKillswitchBtn')?.addEventListener('click', () =>
        postMode({ op: 'resetKillswitch' }));
      loadModeState();
      loadPendingFixes();
      // Refresh approvals periodically (the reflex may park new ones).
      setInterval(loadPendingFixes, 30000);
      setInterval(loadModeState, 30000);
    }

    let wsReconnectAttempts = 0;
    const MAX_WS_RECONNECT_ATTEMPTS = 3;

    function connectWebSocket() {
      const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      const host = window.location.hostname;
      const port = '5683'; // Sentinel port

      try {
        ws = new WebSocket(`${protocol}//${host}:${port}/ws`);

        ws.onopen = () => {
          console.log('[Observatory Agent] Initialized with auto-routing (Ollama → Claude CLI → Gemini CLI)');
          wsReconnectAttempts = 0; // Reset on successful connection
        };

        ws.onmessage = (event) => {
          const data = JSON.parse(event.data);
          handleSentinelMessage(data);
        };

        ws.onerror = () => {
          // Silently fail - Sentinel AI is optional
        };

        ws.onclose = () => {
          // Only retry a few times, then give up silently
          if (wsReconnectAttempts < MAX_WS_RECONNECT_ATTEMPTS) {
            wsReconnectAttempts++;
            setTimeout(connectWebSocket, 5000);
          }
        };
      } catch (error) {
        // Silently fail - Sentinel AI is optional
        if (wsReconnectAttempts < MAX_WS_RECONNECT_ATTEMPTS) {
          wsReconnectAttempts++;
          setTimeout(connectWebSocket, 5000);
        }
      }
    }

    function handleSentinelMessage(data: any) {
      if (data.type === 'watcher_alert') {
        addAlert(data);
      } else if (data.type === 'analyst_diagnosis') {
        addDiagnosis(data);
      } else if (data.type === 'log') {
        addLog(data);
      } else if (data.type === 'metrics') {
        updateMetrics(data);
      } else if (data.type === 'trace') {
        addTrace(data);
      }
    }

    function addAlert(alert: any) {
      const alertsList = document.getElementById('alertsList');
      const alertCount = document.getElementById('alertCount');

      if (alertsList && alertCount) {
        const empty = alertsList.querySelector('.empty-alerts');
        if (empty) empty.remove();

        const alertEl = document.createElement('div');
        alertEl.className = 'alert-item';
        alertEl.innerHTML = `
          <div class="alert-header">
            <span class="alert-severity">${alert.severity || 'MEDIUM'}</span>
            <span class="alert-time mono">just now</span>
          </div>
          <div class="alert-message">${alert.analysis || alert.message}</div>
        `;
        alertsList.prepend(alertEl);

        const currentCount = parseInt(alertCount.textContent || '0');
        alertCount.textContent = String(currentCount + 1);

        // Keep only last 50 alerts
        while (alertsList.children.length > 50) {
          alertsList.removeChild(alertsList.lastChild!);
        }
      }
    }

    function addDiagnosis(diagnosis: any) {
      addLog({ level: 'INFO', message: `Analyst diagnosis: ${diagnosis.summary || 'Analysis complete'}` });
    }

    function addLog(log: any) {
      if (logsPaused) return;

      const logsStream = document.getElementById('logsStream');
      if (logsStream) {
        const logEl = document.createElement('div');
        logEl.className = `log-entry log-${log.level.toLowerCase()}`;

        const time = new Date().toLocaleTimeString('en-US', { hour12: false });
        logEl.innerHTML = `
          <span class="log-time">${time}</span>
          <span class="log-level">${log.level}</span>
          <span class="log-msg">${log.message}</span>
        `;

        logsStream.prepend(logEl);

        // Keep only last 100 logs
        while (logsStream.children.length > 100) {
          logsStream.removeChild(logsStream.lastChild!);
        }
      }
    }

    function addTrace(trace: any) {
      const tracesList = document.getElementById('tracesList');
      if (!tracesList) return;

      const traceEl = document.createElement('div');
      traceEl.className = 'trace';

      const spans = trace.spans || [];
      const spansHtml = spans.map((span: any) => {
        const width = (span.duration / trace.totalDuration * 100).toFixed(1);
        const color = span.error ? '#EF4444' : '#22C55E';
        return `<div class="trace-span" style="width: ${width}%; background: ${color}80;"></div>`;
      }).join('');

      traceEl.innerHTML = `
        <div class="trace-header">
          <span class="trace-method">${trace.method || 'GET'}</span>
          <span class="trace-path">${trace.path || '/'}</span>
          <span class="trace-duration">${trace.totalDuration || 0}ms</span>
        </div>
        <div class="trace-spans">${spansHtml}</div>
      `;

      tracesList.prepend(traceEl);

      // Keep only last 20 traces
      while (tracesList.children.length > 20) {
        tracesList.removeChild(tracesList.lastChild!);
      }
    }

    function updateMetrics(data: any) {
      // Update metric values
      if (data.servicesUp !== undefined) {
        const el = document.getElementById('servicesUp');
        if (el) el.textContent = data.servicesUp;
      }
      if (data.avgResponse !== undefined) {
        const el = document.getElementById('avgResponse');
        if (el) el.textContent = `${data.avgResponse}ms`;
      }
      if (data.errorRate !== undefined) {
        const el = document.getElementById('errorRate');
        if (el) el.textContent = `${data.errorRate}%`;
      }
      if (data.activeTraces !== undefined) {
        const el = document.getElementById('activeTraces');
        if (el) el.textContent = data.activeTraces;
      }

      // Update chart data
      const timestamp = new Date().toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute: '2-digit' });

      if (data.cpu !== undefined) {
        metricsData.cpu.labels.push(timestamp);
        metricsData.cpu.data.push(data.cpu);
        if (metricsData.cpu.labels.length > 30) {
          metricsData.cpu.labels.shift();
          metricsData.cpu.data.shift();
        }
      }

      if (data.memory !== undefined) {
        metricsData.memory.labels.push(timestamp);
        metricsData.memory.data.push(data.memory);
        if (metricsData.memory.labels.length > 30) {
          metricsData.memory.labels.shift();
          metricsData.memory.data.shift();
        }
      }

      if (data.network !== undefined) {
        metricsData.network.labels.push(timestamp);
        metricsData.network.data.push(data.network);
        if (metricsData.network.labels.length > 30) {
          metricsData.network.labels.shift();
          metricsData.network.data.shift();
        }
      }

      if (data.requests !== undefined) {
        metricsData.requests.labels.push(timestamp);
        metricsData.requests.data.push(data.requests);
        if (metricsData.requests.labels.length > 30) {
          metricsData.requests.labels.shift();
          metricsData.requests.data.shift();
        }
      }

      if (chart) {
        updateChart();
      }
    }

    function initChart() {
      const canvas = document.getElementById('metricsChart') as HTMLCanvasElement;
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      // @ts-ignore
      chart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: metricsData[currentMetric].labels,
          datasets: [{
            label: currentMetric.toUpperCase(),
            data: metricsData[currentMetric].data,
            borderColor: '#22C55E',
            backgroundColor: 'rgba(34, 197, 94, 0.1)',
            borderWidth: 2,
            tension: 0.4,
            fill: true,
            pointRadius: 0,
            pointHoverRadius: 4,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              mode: 'index',
              intersect: false,
              backgroundColor: 'rgba(15, 23, 42, 0.9)',
              borderColor: 'rgba(34, 197, 94, 0.5)',
              borderWidth: 1,
              titleColor: '#F8FAFC',
              bodyColor: '#94A3B8',
              padding: 12,
              displayColors: false
            }
          },
          scales: {
            x: {
              grid: { color: 'rgba(255, 255, 255, 0.05)' },
              ticks: { color: '#64748B', maxTicksLimit: 10 }
            },
            y: {
              grid: { color: 'rgba(255, 255, 255, 0.05)' },
              ticks: { color: '#64748B' },
              beginAtZero: true
            }
          },
          interaction: {
            mode: 'nearest',
            axis: 'x',
            intersect: false
          }
        }
      });
    }

    function updateChart() {
      if (!chart) return;

      chart.data.labels = metricsData[currentMetric].labels;
      chart.data.datasets[0].data = metricsData[currentMetric].data;
      chart.data.datasets[0].label = currentMetric.toUpperCase();
      chart.update('none');
    }

    function switchMetric(metric: string) {
      currentMetric = metric;
      document.querySelectorAll('.metric-tab').forEach(tab => {
        tab.classList.remove('active');
        if (tab.getAttribute('data-metric') === metric) {
          tab.classList.add('active');
        }
      });
      updateChart();
    }

    // Generate mock data for demonstration
    function generateMockData() {
      const timestamp = new Date().toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute: '2-digit' });

      updateMetrics({
        servicesUp: Math.floor(Math.random() * 2) + 11,
        avgResponse: Math.floor(Math.random() * 50) + 100,
        errorRate: (Math.random() * 2).toFixed(2),
        activeTraces: Math.floor(Math.random() * 10) + 5,
        cpu: Math.floor(Math.random() * 30) + 40,
        memory: Math.floor(Math.random() * 20) + 60,
        network: Math.floor(Math.random() * 100) + 500,
        requests: Math.floor(Math.random() * 200) + 800
      });

      // Random logs
      if (Math.random() > 0.7) {
        const levels = ['INFO', 'WARN', 'ERROR'];
        const messages = [
          'Health check completed successfully',
          'Cache miss ratio: 12%',
          'Database query took 234ms',
          'Rate limit exceeded for IP 192.168.1.100',
          'Failed to connect to external service'
        ];
        addLog({
          level: levels[Math.floor(Math.random() * levels.length)],
          message: messages[Math.floor(Math.random() * messages.length)]
        });
      }

      // Random trace
      if (Math.random() > 0.8) {
        const methods = ['GET', 'POST', 'PUT', 'DELETE'];
        const paths = ['/api/tasks', '/api/services', '/api/health', '/api/metrics'];
        const totalDuration = Math.floor(Math.random() * 300) + 50;

        addTrace({
          method: methods[Math.floor(Math.random() * methods.length)],
          path: paths[Math.floor(Math.random() * paths.length)],
          totalDuration,
          spans: [
            { duration: totalDuration * 0.3, error: false },
            { duration: totalDuration * 0.5, error: false },
            { duration: totalDuration * 0.2, error: Math.random() > 0.9 }
          ]
        });
      }
    }

    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
      initChart();
      connectWebSocket();
      wireAutonomicControls();

      // Add metric tab switching
      document.querySelectorAll('.metric-tab').forEach(tab => {
        tab.addEventListener('click', (e) => {
          const metric = (e.currentTarget as HTMLElement).getAttribute('data-metric');
          if (metric) switchMetric(metric);
        });
      });

      // Refresh button
      document.getElementById('refreshBtn')?.addEventListener('click', () => {
        location.reload();
      });

      // Run check button
      document.getElementById('runCheckBtn')?.addEventListener('click', async () => {
        const btn = document.getElementById('runCheckBtn') as HTMLButtonElement;
        if (!btn) return;

        btn.disabled = true;
        btn.textContent = 'Checking...';

        try {
          const response = await fetch('/app/api/observatory/check', { method: 'POST' });
          const result = await response.json();

          if (result.success) {
            addLog({
              level: 'INFO',
              message: `Check complete: ${result.stacksChecked} stacks checked, ${result.anomaliesDetected} anomalies detected, ${result.incidentsCreated} incidents created`
            });

            if (result.incidentsCreated > 0) {
              addAlert({
                severity: 'HIGH',
                analysis: `Observatory created ${result.incidentsCreated} incident(s) from detected anomalies`
              });
            }

            // Refresh agent runs
            await fetchAgentRuns();
          } else {
            addLog({ level: 'ERROR', message: `Check failed: ${result.error || 'Unknown error'}` });
          }
        } catch (error) {
          console.error('Check failed:', error);
          addLog({ level: 'ERROR', message: 'Failed to trigger Observatory check' });
        } finally {
          btn.disabled = false;
          btn.innerHTML = `
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
            Run Check Now
          `;
        }
      });

      // Pause watcher button
      document.getElementById('pauseWatcherBtn')?.addEventListener('click', async () => {
        alert('Pause/resume functionality coming soon');
      });

      // Pause logs button
      document.getElementById('pauseLogsBtn')?.addEventListener('click', (e) => {
        logsPaused = !logsPaused;
        const btn = e.currentTarget as HTMLElement;
        btn.innerHTML = logsPaused
          ? '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>'
          : '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>';
      });

      // Fetch agent runs
      async function fetchAgentRuns() {
        try {
          const response = await fetch('/app/api/observatory/runs?limit=10');
          const data = await response.json();

          const runsList = document.getElementById('runsList');
          const runCount = document.getElementById('runCount');

          if (!runsList || !runCount) return;

          runCount.textContent = data.count.toString();

          if (data.runs && data.runs.length > 0) {
            const empty = runsList.querySelector('.empty-runs');
            if (empty) empty.remove();

            runsList.innerHTML = '';

            data.runs.forEach((run: any) => {
              const runEl = document.createElement('div');
              runEl.className = 'run-item';

              const time = new Date(run.createdAt).toLocaleTimeString('en-US', { hour12: false });
              const confidence = (run.confidenceScore * 100).toFixed(0);

              runEl.innerHTML = `
                <div class="run-header">
                  <span class="run-agent mono">${run.agentName}</span>
                  <span class="run-time mono">${time}</span>
                </div>
                <div class="run-decision">
                  <span class="decision-badge decision-${run.decisionMade}">${run.decisionMade.replace('_', ' ')}</span>
                  <span class="run-confidence mono">${confidence}%</span>
                </div>
              `;

              runsList.appendChild(runEl);
            });
          }
        } catch (error) {
          console.error('Failed to fetch agent runs:', error);
        }
      }

      // Mock data generator DISABLED - using real Observatory data now
      // setInterval(generateMockData, 3000);

      // Initial mock data DISABLED
      // for (let i = 0; i < 10; i++) {
      //   generateMockData();
      // }

      // Fetch agent runs on load
      fetchAgentRuns();

      // Refresh agent runs every 30 seconds
      setInterval(fetchAgentRuns, 30000);
    });
  </script>
</Layout>
