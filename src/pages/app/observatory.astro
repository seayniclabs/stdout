---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { requireLicense } from '../../lib/license';
import NeuralBackground from '../../components/NeuralBackground.astro';
import { getDb, schema } from '../../lib/db';
import { desc, sql } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

// License check
const licenseCheck = requireLicense();
if (!licenseCheck.valid) {
  return Astro.redirect('/app/settings?error=' + encodeURIComponent(licenseCheck.message));
}

const db = getDb();

// Fetch recent Riggins activity from multiple sources
const recentDiscoveries = await db.select({
  id: schema.discoveredServices.id,
  serviceName: schema.discoveredServices.serviceName,
  port: schema.discoveredServices.port,
  createdAt: schema.discoveredServices.createdAt,
  hostId: schema.discoveredServices.hostId
}).from(schema.discoveredServices)
  .orderBy(desc(schema.discoveredServices.createdAt))
  .limit(10);

const recentMonitors = await db.select({
  id: schema.monitors.id,
  name: schema.monitors.name,
  type: schema.monitors.type,
  target: schema.monitors.target,
  createdAt: schema.monitors.createdAt,
  currentStatus: schema.monitors.currentStatus
}).from(schema.monitors)
  .orderBy(desc(schema.monitors.createdAt))
  .limit(10);

const recentIncidents = await db.select({
  id: schema.incidents.id,
  title: schema.incidents.title,
  severity: schema.incidents.severity,
  status: schema.incidents.status,
  createdAt: schema.incidents.createdAt,
  resolvedAt: schema.incidents.resolvedAt
}).from(schema.incidents)
  .orderBy(desc(schema.incidents.createdAt))
  .limit(10);

const recentDiagnoses = await db.select({
  id: schema.diagnoses.id,
  incidentId: schema.diagnoses.incidentId,
  rootCauses: schema.diagnoses.rootCauses,
  createdAt: schema.diagnoses.createdAt
}).from(schema.diagnoses)
  .orderBy(desc(schema.diagnoses.createdAt))
  .limit(10);

const recentRemediations = await db.select({
  id: schema.remediationExecutions.id,
  incidentId: schema.remediationExecutions.incidentId,
  status: schema.remediationExecutions.status,
  startedAt: schema.remediationExecutions.startedAt,
  completedAt: schema.remediationExecutions.completedAt
}).from(schema.remediationExecutions)
  .where(sql`${schema.remediationExecutions.status} IN ('success', 'failed', 'running')`)
  .orderBy(desc(schema.remediationExecutions.startedAt))
  .limit(10);

// Build unified activity feed
const activityFeed = [
  ...recentDiscoveries.map(d => ({
    type: 'discover',
    icon: '🔍',
    text: `Auto-discovered new service: ${d.serviceName || 'unknown'}${d.port ? `:${d.port}` : ''}`,
    timestamp: d.createdAt
  })),
  ...recentMonitors.map(m => ({
    type: 'monitor',
    icon: '✅',
    text: `Auto-created monitor for ${m.name} (${m.type}:${m.target})`,
    timestamp: m.createdAt
  })),
  ...recentDiagnoses.map(d => ({
    type: 'diagnose',
    icon: '🩺',
    text: `Diagnosed incident: ${d.rootCauses.substring(0, 80)}...`,
    timestamp: d.createdAt
  })),
  ...recentRemediations.filter(r => r.status === 'success').map(r => ({
    type: 'remediate',
    icon: '🔄',
    text: `Auto-remediated incident ${r.incidentId}`,
    timestamp: r.completedAt || r.startedAt
  })),
  ...recentIncidents.filter(i => i.resolvedAt).map(i => ({
    type: 'learn',
    icon: '📝',
    text: `Generated runbook from resolved incident: ${i.title}`,
    timestamp: i.resolvedAt!
  }))
].sort((a, b) => (b.timestamp?.getTime() || 0) - (a.timestamp?.getTime() || 0))
  .slice(0, 15);

function timeAgo(date: Date | null | undefined): string {
  if (!date) return 'Never';
  const seconds = Math.floor((Date.now() - date.getTime()) / 1000);
  if (seconds < 60) return `${seconds} seconds ago`;
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return `${minutes} minute${minutes === 1 ? '' : 's'} ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours} hour${hours === 1 ? '' : 's'} ago`;
  const days = Math.floor(hours / 24);
  return `${days} day${days === 1 ? '' : 's'} ago`;
}

// TODO: Fetch Observatory data from Sentinel API
const sentinelUrl = process.env.SENTINEL_API_URL || 'http://localhost:8081';
---
<Layout title="Observatory — StdOut">
  <NeuralBackground />
  <div class="observatory-page">
    <div class="observatory-header">
      <div class="header-left">
        <h1>Observatory</h1>
        <p class="subtitle">24/7 Infrastructure Monitoring & Observability</p>
      </div>
      <div class="header-actions">
        <a href="/app/observatory/status" class="btn-glass" style="text-decoration:none;display:inline-flex;align-items:center;gap:6px">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          Status
        </a>
        <button id="runCheckBtn" class="btn-glass btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
          Run Check Now
        </button>
        <button id="pauseWatcherBtn" class="btn-glass">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
          Pause Watcher
        </button>
        <button id="refreshBtn" class="btn-glass">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
          Refresh
        </button>
        <div class="status-indicator">
          <span class="pulse"></span>
          <span>Live</span>
        </div>
      </div>
    </div>

    <div class="observatory-grid">
      <!-- Autonomic Control — operating mode, auto-pilot, god mode, killswitch, RAG, approvals -->
      <div class="obs-card obs-autonomic" style="grid-column: 1 / -1;">
        <div class="obs-card-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 100 20 10 10 0 000-20z"/><path d="M12 6v6l4 2"/></svg>
          <h3>Autonomic Control</h3>
          <span id="modeKillswitchBadge" class="ks-badge" style="display:none">KILLSWITCH</span>
        </div>

        <div class="autonomic-body">
          <!-- Operating mode ladder -->
          <div class="auto-section">
            <div class="auto-label">Operating mode
              <span class="auto-hint">How much the brain is allowed to do</span>
            </div>
            <div class="mode-ladder" id="modeLadder">
              <button class="mode-btn" data-mode="discover">
                <span class="mode-name">Discover</span>
                <span class="mode-desc">Eyes only — scan &amp; log</span>
              </button>
              <button class="mode-btn" data-mode="diagnose">
                <span class="mode-name">Diagnose</span>
                <span class="mode-desc">Brain explains incidents</span>
              </button>
              <button class="mode-btn" data-mode="autofix">
                <span class="mode-name">Auto-fix</span>
                <span class="mode-desc">Apply non-destructive fixes</span>
              </button>
            </div>
          </div>

          <!-- Toggles -->
          <div class="auto-toggles">
            <label class="auto-toggle">
              <input type="checkbox" id="autopilotToggle" />
              <span class="toggle-track"><span class="toggle-thumb"></span></span>
              <span class="toggle-text">
                <strong>Auto-pilot</strong>
                <small id="autopilotState">Self-escalates discover → diagnose → auto-fix as it earns trust. Ceiling: non-destructive.</small>
              </span>
            </label>

            <label class="auto-toggle">
              <input type="checkbox" id="godModeToggle" />
              <span class="toggle-track toggle-danger"><span class="toggle-thumb"></span></span>
              <span class="toggle-text">
                <strong>God mode <span class="danger-tag">experimental</span></strong>
                <small>Experimental mode - May generate unexpected results. Monitor costs carefully. Human approval required.</small>
              </span>
            </label>

            <label class="auto-toggle">
              <input type="checkbox" id="ragPublicToggle" />
              <span class="toggle-track"><span class="toggle-thumb"></span></span>
              <span class="toggle-text">
                <strong>Include public resources in learning</strong>
                <small>Internal + community docs are always used. Public web sources are off by default.</small>
              </span>
            </label>
          </div>

          <!-- Killswitch banner (shown only when tripped) -->
          <div id="killswitchBanner" class="killswitch-banner" style="display:none">
            <div class="ks-text">
              <strong>Killswitch tripped — auto-pilot demoted to diagnose-only.</strong>
              <small id="killswitchReason">A loop or catastrophe was detected.</small>
            </div>
            <button id="resetKillswitchBtn" class="btn-glass">Reset killswitch</button>
          </div>

          <!-- Pending approvals queue -->
          <div class="auto-section pending-section">
            <div class="auto-label">Awaiting approval
              <span class="auto-hint">Above-ceiling fixes the brain wants to run</span>
            </div>
            <div id="pendingFixes" class="pending-list">
              <div class="pending-empty">No fixes awaiting approval.</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Riggins Activity Feed (Live) -->
      <div class="obs-card obs-activity">
        <div class="obs-card-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <h3>Riggins Activity (Live)</h3>
          <div class="activity-status">
            <span class="pulse-dot"></span>
            <span>Scanning infrastructure</span>
          </div>
        </div>
        <div class="activity-feed">
          {activityFeed.length === 0 ? (
            <div class="pending-empty">No activity yet. Riggins is starting up...</div>
          ) : (
            activityFeed.map(activity => (
              <div class={`activity-item ${activity.type}`}>
                <div class="activity-icon">{activity.icon}</div>
                <div class="activity-content">
                  <div class="activity-text">{activity.text}</div>
                  <div class="activity-time">{timeAgo(activity.timestamp)}</div>
                </div>
              </div>
            ))
          )}
        </div>
      </div>

      <!-- AI Agent Status -->
      <div class="obs-card obs-agents">
        <div class="obs-card-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
          <h3>AI Agents</h3>
        </div>
        <div class="agent-status">
          <div class="agent">
            <div class="agent-icon">🔍</div>
            <div class="agent-info">
              <div class="agent-name">Watcher</div>
              <div class="agent-model mono">Llama 3.2 3B</div>
            </div>
            <div class="agent-state">
              <span class="status-dot status-healthy"></span>
              <span class="agent-label">Active</span>
            </div>
          </div>
          <div class="agent-meta">
            <span class="mono">Last check: <span id="watcherLastCheck">2m ago</span></span>
            <span class="mono">Next: <span id="watcherNextCheck">3m</span></span>
          </div>
        </div>
        <div class="agent-status">
          <div class="agent">
            <div class="agent-icon">🧠</div>
            <div class="agent-info">
              <div class="agent-name">Analyst</div>
              <div class="agent-model mono">Qwen 2.5 14B</div>
            </div>
            <div class="agent-state">
              <span class="status-dot status-standby"></span>
              <span class="agent-label">Standby</span>
            </div>
          </div>
          <div class="agent-meta">
            <span class="mono">Triggers: HIGH | CRITICAL alerts</span>
          </div>
        </div>
      </div>

      <!-- System Metrics -->
      <div class="obs-card obs-metrics">
        <div class="obs-card-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          <h3>System Metrics</h3>
          <div class="metric-tabs" id="metricTabs">
            <button class="metric-tab active" data-metric="cpu">CPU</button>
            <button class="metric-tab" data-metric="memory">Memory</button>
            <button class="metric-tab" data-metric="network">Network</button>
            <button class="metric-tab" data-metric="requests">Requests</button>
          </div>
        </div>
        <div class="metrics-container">
          <canvas id="metricsChart"></canvas>
        </div>
      </div>

      <!-- Key Metrics Grid -->
      <div class="obs-card obs-key-metrics">
        <div class="obs-card-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
          <h3>Key Metrics</h3>
        </div>
        <div class="metrics-grid">
          <div class="metric">
            <div class="metric-value" id="servicesUp">--</div>
            <div class="metric-label">Services Up</div>
          </div>
          <div class="metric">
            <div class="metric-value" id="avgResponse">--</div>
            <div class="metric-label">Avg Response</div>
          </div>
          <div class="metric">
            <div class="metric-value" id="errorRate">--</div>
            <div class="metric-label">Error Rate</div>
          </div>
          <div class="metric">
            <div class="metric-value" id="activeTraces">--</div>
            <div class="metric-label">Active Traces</div>
          </div>
        </div>
      </div>

      <!-- Recent Alerts -->
      <div class="obs-card obs-alerts">
        <div class="obs-card-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <h3>Recent Alerts</h3>
          <span class="alert-count" id="alertCount">0</span>
        </div>
        <div class="alerts-list" id="alertsList">
          <div class="empty-alerts">
            <span>No alerts in the last 24 hours</span>
          </div>
        </div>
      </div>

      <!-- Live Logs -->
      <div class="obs-card obs-logs">
        <div class="obs-card-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          <h3>Live Logs</h3>
          <div class="log-controls">
            <button id="pauseLogsBtn" class="btn-icon" title="Pause">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
            </button>
            <a href="#" class="obs-link">Loki →</a>
          </div>
        </div>
        <div class="logs-stream mono" id="logsStream">
          <div class="log-entry log-info">
            <span class="log-time">12:34:56</span>
            <span class="log-level">INFO</span>
            <span class="log-msg">Observatory initialized</span>
          </div>
        </div>
      </div>

      <!-- Agent Runs -->
      <div class="obs-card obs-runs">
        <div class="obs-card-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
          <h3>Agent Runs</h3>
          <span class="run-count mono" id="runCount">0</span>
        </div>
        <div class="runs-list" id="runsList">
          <div class="empty-runs">
            <span>No agent runs yet</span>
          </div>
        </div>
      </div>

      <!-- Distributed Traces -->
      <div class="obs-card obs-traces">
        <div class="obs-card-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 2 12 12 16 14"/></svg>
          <h3>Recent Traces</h3>
          <a href="#" class="obs-link">Tempo →</a>
        </div>
        <div class="traces-list" id="tracesList">
          <div class="trace">
            <div class="trace-header">
              <span class="trace-method">POST</span>
              <span class="trace-path">/api/tasks</span>
              <span class="trace-duration">124ms</span>
            </div>
            <div class="trace-spans">
              <div class="trace-span" style="width: 40%; background: var(--low-dim);">
                <span>Database</span>
              </div>
              <div class="trace-span" style="width: 30%; background: var(--accent-dim);">
                <span>Process</span>
              </div>
              <div class="trace-span" style="width: 30%; background: var(--teal-dim);">
                <span>Response</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Fira+Sans:wght@300;400;500;600;700&display=swap');
    /* ── Autonomic Control card ───────────────────────────────────────────── */
    .obs-autonomic .autonomic-body { display: flex; flex-direction: column; gap: 20px; padding-top: 4px; }
    .ks-badge {
      margin-left: auto; font-size: 11px; font-weight: 700; letter-spacing: 0.5px;
      color: #fff; background: #ef4444; padding: 3px 8px; border-radius: 6px;
    }
    .auto-section { display: flex; flex-direction: column; gap: 10px; }
    .auto-label { font-size: 13px; font-weight: 600; color: #F8FAFC; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
    .auto-hint { font-size: 12px; font-weight: 400; color: #94A3B8; }
    .mode-ladder { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .mode-btn {
      display: flex; flex-direction: column; gap: 6px; align-items: flex-start;
      text-align: left; padding: 14px 16px; border-radius: 12px; cursor: pointer;
      background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);
      color: #CBD5E1; transition: all 0.15s ease;
      min-height: 72px;
    }
    .mode-btn:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.25); }
    .mode-btn .mode-name { font-size: 15px; font-weight: 700; color: #F8FAFC; line-height: 1.2; }
    .mode-btn .mode-desc { font-size: 13px; color: #94A3B8; line-height: 1.4; }
    .mode-btn.active { background: rgba(108,92,231,0.18); border-color: #6c5ce7; box-shadow: 0 0 0 1px #6c5ce7 inset; }
    .mode-btn.active .mode-desc { color: #c4b5fd; }
    .mode-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .auto-toggles { display: flex; flex-direction: column; gap: 16px; }
    .auto-toggle { display: flex; align-items: flex-start; gap: 14px; cursor: pointer; padding: 2px 0; }
    .auto-toggle input { position: absolute; opacity: 0; width: 0; height: 0; }
    .toggle-track {
      flex-shrink: 0; width: 42px; height: 24px; border-radius: 999px; margin-top: 2px;
      background: rgba(255,255,255,0.15); position: relative; transition: background 0.15s ease;
    }
    .toggle-thumb {
      position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; border-radius: 50%;
      background: #fff; transition: transform 0.15s ease;
    }
    .auto-toggle input:checked + .toggle-track { background: #6c5ce7; }
    .auto-toggle input:checked + .toggle-track.toggle-danger { background: #ef4444; }
    .auto-toggle input:checked + .toggle-track .toggle-thumb { transform: translateX(18px); }
    .toggle-text { display: flex; flex-direction: column; gap: 4px; flex: 1; }
    .toggle-text strong { font-size: 14px; color: #F8FAFC; font-weight: 600; line-height: 1.3; }
    .toggle-text small { font-size: 13px; color: #94A3B8; line-height: 1.5; }
    .danger-tag { font-size: 10px; font-weight: 700; color: #fca5a5; background: rgba(239,68,68,0.15); padding: 1px 6px; border-radius: 4px; margin-left: 4px; }

    .killswitch-banner {
      display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 12px;
      background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.35);
    }
    .killswitch-banner .ks-text { display: flex; flex-direction: column; gap: 2px; }
    .killswitch-banner strong { font-size: 13px; color: #fecaca; }
    .killswitch-banner small { font-size: 12px; color: #f87171; }
    .killswitch-banner button { margin-left: auto; flex-shrink: 0; }

    .pending-list { display: flex; flex-direction: column; gap: 10px; }
    .pending-empty { font-size: 13px; color: #94A3B8; padding: 8px 0; }
    .pending-item {
      display: flex; align-items: flex-start; gap: 12px; padding: 12px 14px; border-radius: 12px;
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1);
    }
    .pending-item .pf-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
    .pending-item .pf-cmd { font-family: ui-monospace, monospace; font-size: 12px; color: #F8FAFC; word-break: break-all; }
    .pending-item .pf-reason { font-size: 12px; color: #64748B; }
    .pending-item .pf-actions { display: flex; gap: 8px; flex-shrink: 0; }
    .pf-approve { background: rgba(34,197,94,0.18) !important; border-color: rgba(34,197,94,0.4) !important; color: #86efac !important; }
    .pf-deny { background: rgba(239,68,68,0.14) !important; border-color: rgba(239,68,68,0.35) !important; color: #fca5a5 !important; }

    .observatory-page {
      padding: 2rem;
      max-width: 1800px;
      margin: 0 auto;
      min-height: 100vh;
