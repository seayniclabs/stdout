---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { requireLicense } from '../../lib/license';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

// License check
const licenseCheck = requireLicense();
if (!licenseCheck.valid) {
  return Astro.redirect('/app/settings?error=' + encodeURIComponent(licenseCheck.message));
}

// TODO: Fetch Observatory data from Sentinel API
const sentinelUrl = process.env.SENTINEL_API_URL || 'http://localhost:8081';
---
<Layout title="Observatory — StdOut">
  <div class="observatory-page">
    <div class="observatory-header">
      <div class="header-left">
        <h1>Observatory</h1>
        <p class="subtitle">24/7 Infrastructure Monitoring & Observability</p>
      </div>
      <div class="header-actions">
        <button id="pauseWatcherBtn" class="btn-glass">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
          Pause Watcher
        </button>
        <button id="refreshBtn" class="btn-glass">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
          Refresh
        </button>
        <div class="status-indicator">
          <span class="pulse"></span>
          <span>Live</span>
        </div>
      </div>
    </div>

    <div class="observatory-grid">
      <!-- AI Agent Status -->
      <div class="obs-card obs-agents">
        <div class="obs-card-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
          <h3>AI Agents</h3>
        </div>
        <div class="agent-status">
          <div class="agent">
            <div class="agent-icon">🔍</div>
            <div class="agent-info">
              <div class="agent-name">Watcher</div>
              <div class="agent-model mono">Llama 3.2 3B</div>
            </div>
            <div class="agent-state">
              <span class="status-dot status-healthy"></span>
              <span class="agent-label">Active</span>
            </div>
          </div>
          <div class="agent-meta">
            <span class="mono">Last check: <span id="watcherLastCheck">2m ago</span></span>
            <span class="mono">Next: <span id="watcherNextCheck">3m</span></span>
          </div>
        </div>
        <div class="agent-status">
          <div class="agent">
            <div class="agent-icon">🧠</div>
            <div class="agent-info">
              <div class="agent-name">Analyst</div>
              <div class="agent-model mono">Qwen 2.5 14B</div>
            </div>
            <div class="agent-state">
              <span class="status-dot status-standby"></span>
              <span class="agent-label">Standby</span>
            </div>
          </div>
          <div class="agent-meta">
            <span class="mono">Triggers: HIGH | CRITICAL alerts</span>
          </div>
        </div>
      </div>

      <!-- System Metrics -->
      <div class="obs-card obs-metrics">
        <div class="obs-card-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          <h3>System Metrics</h3>
          <div class="metric-tabs" id="metricTabs">
            <button class="metric-tab active" data-metric="cpu">CPU</button>
            <button class="metric-tab" data-metric="memory">Memory</button>
            <button class="metric-tab" data-metric="network">Network</button>
            <button class="metric-tab" data-metric="requests">Requests</button>
          </div>
        </div>
        <div class="metrics-container">
          <canvas id="metricsChart"></canvas>
        </div>
      </div>

      <!-- Key Metrics Grid -->
      <div class="obs-card obs-key-metrics">
        <div class="obs-card-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
          <h3>Key Metrics</h3>
        </div>
        <div class="metrics-grid">
          <div class="metric">
            <div class="metric-value" id="servicesUp">--</div>
            <div class="metric-label">Services Up</div>
          </div>
          <div class="metric">
            <div class="metric-value" id="avgResponse">--</div>
            <div class="metric-label">Avg Response</div>
          </div>
          <div class="metric">
            <div class="metric-value" id="errorRate">--</div>
            <div class="metric-label">Error Rate</div>
          </div>
          <div class="metric">
            <div class="metric-value" id="activeTraces">--</div>
            <div class="metric-label">Active Traces</div>
          </div>
        </div>
      </div>

      <!-- Recent Alerts -->
      <div class="obs-card obs-alerts">
        <div class="obs-card-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <h3>Recent Alerts</h3>
          <span class="alert-count" id="alertCount">0</span>
        </div>
        <div class="alerts-list" id="alertsList">
          <div class="empty-alerts">
            <span>No alerts in the last 24 hours</span>
          </div>
        </div>
      </div>

      <!-- Live Logs -->
      <div class="obs-card obs-logs">
        <div class="obs-card-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          <h3>Live Logs</h3>
          <div class="log-controls">
            <button id="pauseLogsBtn" class="btn-icon" title="Pause">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
            </button>
            <a href="#" class="obs-link">Loki →</a>
          </div>
        </div>
        <div class="logs-stream mono" id="logsStream">
          <div class="log-entry log-info">
            <span class="log-time">12:34:56</span>
            <span class="log-level">INFO</span>
            <span class="log-msg">Observatory initialized</span>
          </div>
        </div>
      </div>

      <!-- Distributed Traces -->
      <div class="obs-card obs-traces">
        <div class="obs-card-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 2 12 12 16 14"/></svg>
          <h3>Recent Traces</h3>
          <a href="#" class="obs-link">Tempo →</a>
        </div>
        <div class="traces-list" id="tracesList">
          <div class="trace">
            <div class="trace-header">
              <span class="trace-method">POST</span>
              <span class="trace-path">/api/tasks</span>
              <span class="trace-duration">124ms</span>
            </div>
            <div class="trace-spans">
              <div class="trace-span" style="width: 40%; background: var(--low-dim);">
                <span>Database</span>
              </div>
              <div class="trace-span" style="width: 30%; background: var(--accent-dim);">
                <span>Process</span>
              </div>
              <div class="trace-span" style="width: 30%; background: var(--teal-dim);">
                <span>Response</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Fira+Sans:wght@300;400;500;600;700&display=swap');

    .observatory-page {
      padding: 2rem;
      max-width: 1800px;
      margin: 0 auto;
      min-height: 100vh;
      background: #020617;
      font-family: 'Fira Sans', sans-serif;
    }

    .observatory-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 2rem;
    }

    .observatory-header h1 {
      font-size: 2.5rem;
      font-weight: 700;
      margin: 0 0 0.5rem 0;
      background: linear-gradient(135deg, #F8FAFC 0%, #94A3B8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .subtitle {
      font-size: 1rem;
      color: #94A3B8;
      margin: 0;
    }

    .header-actions {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .btn-glass {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #F8FAFC;
      padding: 0.75rem 1.5rem;
      border-radius: 12px;
      font-family: 'Fira Sans', sans-serif;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 200ms ease;
    }

    .btn-glass:hover {
      background: rgba(255, 255, 255, 0.15);
      border-color: rgba(255, 255, 255, 0.3);
      transform: translateY(-1px);
    }

    .btn-glass:focus-visible {
      outline: 2px solid #22C55E;
      outline-offset: 2px;
    }

    .status-indicator {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.3);
      padding: 0.5rem 1rem;
      border-radius: 12px;
      font-size: 0.875rem;
      color: #22C55E;
    }

    .pulse {
      width: 8px;
      height: 8px;
      background: #22C55E;
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }

    @media (max-width: 768px) {
      .observatory-header {
        flex-direction: column;
        gap: 1rem;
      }

      .header-actions {
        width: 100%;
        justify-content: space-between;
      }
    }

    .observatory-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      grid-auto-rows: 280px;
      gap: 1.5rem;
      margin-top: 2rem;
    }

    .obs-agents { grid-column: span 4; grid-row: span 2; }
    .obs-metrics { grid-column: span 8; grid-row: span 2; }
    .obs-key-metrics { grid-column: span 4; grid-row: span 1; }
    .obs-alerts { grid-column: span 4; grid-row: span 2; }
    .obs-logs { grid-column: span 8; grid-row: span 2; }
    .obs-traces { grid-column: span 12; grid-row: span 1; }

    .metric-tabs {
      display: flex;
      gap: 0.5rem;
    }

    .metric-tab {
      padding: 0.375rem 0.75rem;
      background: rgba(255, 255, 255, 0.05);
      color: #94A3B8;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      font-size: 0.75rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 200ms ease;
    }

    .metric-tab:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #CBD5E1;
    }

    .metric-tab.active {
      background: #22C55E;
      color: #020617;
      border-color: #22C55E;
    }

    .metrics-container {
      flex: 1;
      position: relative;
      min-height: 200px;
    }

    #metricsChart {
      width: 100%;
      height: 100%;
    }

    @media (max-width: 1400px) {
      .obs-agents { grid-column: span 6; }
      .obs-metrics { grid-column: span 6; }
      .obs-key-metrics { grid-column: span 6; }
      .obs-alerts { grid-column: span 12; }
      .obs-logs { grid-column: span 12; }
    }

    @media (max-width: 768px) {
      .observatory-page { padding: 1rem; }
      .observatory-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
        grid-auto-rows: auto;
      }
      .obs-agents, .obs-metrics, .obs-key-metrics, .obs-alerts, .obs-logs, .obs-traces {
        grid-column: span 1;
        grid-row: span 1;
      }
      .metric-tabs {
        flex-wrap: wrap;
      }
    }

    .obs-card {
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 24px;
      padding: 1.5rem;
      transition: all 200ms ease;
      display: flex;
      flex-direction: column;
    }

    .obs-card:hover {
      border-color: rgba(255, 255, 255, 0.2);
      transform: translateY(-2px);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.4);
    }

    .obs-card-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .obs-card-header svg {
      color: #22C55E;
    }

    .obs-card-header h3 {
      font-size: 1.125rem;
      font-weight: 600;
      color: #F8FAFC;
      flex: 1;
    }

    .obs-link {
      font-size: 0.875rem;
      color: #94A3B8;
      text-decoration: none;
      transition: color 0.2s;
      cursor: pointer;
    }

    .obs-link:hover {
      color: #22C55E;
      text-decoration: underline;
    }

    /* AI Agents */
    .agent-status {
      margin-bottom: 1.5rem;
      padding: 1rem;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      transition: all 200ms ease;
    }

    .agent-status:hover {
      background: rgba(255, 255, 255, 0.05);
      border-color: rgba(255, 255, 255, 0.12);
    }

    .agent-status:last-child {
      margin-bottom: 0;
    }

    .agent {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 0.75rem;
    }

    .agent-icon {
      font-size: 24px;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(34, 197, 94, 0.1);
      border-radius: 12px;
    }

    .agent-info {
      flex: 1;
    }

    .agent-name {
      font-size: 0.875rem;
      font-weight: 600;
      color: #F8FAFC;
    }

    .agent-model {
      font-size: 0.75rem;
      color: #64748B;
      font-family: 'Fira Code', monospace;
    }

    .agent-state {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .agent-label {
      font-size: 0.75rem;
      color: #94A3B8;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }

    .status-healthy {
      background: #22C55E;
      box-shadow: 0 0 8px rgba(34, 197, 94, 0.7);
    }

    .status-standby {
      background: #64748B;
      box-shadow: 0 0 4px rgba(100, 116, 139, 0.5);
      animation: none;
    }

    @keyframes pulse {
      0%, 100% {
        opacity: 1;
        box-shadow: 0 0 8px rgba(34, 197, 94, 0.7);
      }
      50% {
        opacity: 0.5;
        box-shadow: 0 0 16px rgba(34, 197, 94, 0.3);
      }
    }

    .agent-meta {
      display: flex;
      gap: 1rem;
      font-size: 0.75rem;
      color: #64748B;
      padding-left: 56px;
      font-family: 'Fira Code', monospace;
    }

    /* Metrics */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
      flex: 1;
    }

    @media (max-width: 1024px) {
      .metrics-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .metric {
      text-align: center;
      padding: 1rem;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      transition: all 200ms ease;
    }

    .metric:hover {
      background: rgba(255, 255, 255, 0.05);
      border-color: rgba(255, 255, 255, 0.15);
      transform: scale(1.02);
    }

    .metric-value {
      font-size: 2rem;
      font-weight: 700;
      color: #22C55E;
      margin-bottom: 0.5rem;
      font-family: 'Fira Code', monospace;
    }

    .metric-label {
      font-size: 0.75rem;
      color: #64748B;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* Alerts */
    .alert-count {
      background: rgba(239, 68, 68, 0.2);
      color: #EF4444;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.25rem 0.75rem;
      border-radius: 12px;
      min-width: 20px;
      text-align: center;
    }

    .alerts-list {
      max-height: 400px;
      overflow-y: auto;
      flex: 1;
    }

    .empty-alerts {
      text-align: center;
      padding: 3rem 1rem;
      color: #64748B;
      font-size: 0.875rem;
    }

    .alert-item {
      padding: 1rem;
      border-left: 3px solid #F59E0B;
      background: rgba(255, 255, 255, 0.02);
      border-radius: 12px;
      margin-bottom: 0.75rem;
      cursor: pointer;
      transition: all 200ms ease;
    }

    .alert-item:hover {
      background: rgba(255, 255, 255, 0.05);
      transform: translateX(2px);
    }

    .alert-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.5rem;
    }

    .alert-severity {
      font-size: 0.625rem;
      font-weight: 700;
      text-transform: uppercase;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      background: rgba(245, 158, 11, 0.2);
      color: #F59E0B;
    }

    .alert-time {
      font-size: 0.75rem;
      color: #64748B;
      font-family: 'Fira Code', monospace;
    }

    .alert-message {
      font-size: 0.875rem;
      color: #94A3B8;
    }

    /* Logs */
    .log-controls {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-icon {
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #94A3B8;
      cursor: pointer;
      border-radius: 8px;
      transition: all 200ms ease;
    }

    .btn-icon:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #22C55E;
    }

    .logs-stream {
      max-height: 400px;
      overflow-y: auto;
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      padding: 1rem;
      font-size: 0.75rem;
      font-family: 'Fira Code', monospace;
      flex: 1;
    }

    .log-entry {
      display: flex;
      gap: 0.75rem;
      padding: 0.5rem;
      border-left: 2px solid transparent;
      padding-left: 0.75rem;
      border-radius: 8px;
      margin-bottom: 0.25rem;
      transition: all 150ms ease;
    }

    .log-entry:hover {
      background: rgba(255, 255, 255, 0.03);
      border-left-color: #22C55E;
    }

    .log-time {
      color: #64748B;
      min-width: 60px;
      flex-shrink: 0;
    }

    .log-level {
      min-width: 50px;
      font-weight: 600;
      flex-shrink: 0;
    }

    .log-info .log-level { color: #22C55E; }
    .log-warn .log-level { color: #F59E0B; }
    .log-error .log-level { color: #EF4444; }

    .log-msg {
      color: #94A3B8;
      flex: 1;
    }

    /* Traces */
    .traces-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      flex: 1;
    }

    .trace {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 1rem;
      transition: all 200ms ease;
    }

    .trace:hover {
      background: rgba(255, 255, 255, 0.05);
      border-color: rgba(255, 255, 255, 0.15);
      transform: translateY(-1px);
    }

    .trace-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }

    .trace-method {
      font-size: 0.75rem;
      font-weight: 700;
      color: #22C55E;
      font-family: 'Fira Code', monospace;
    }

    .trace-path {
      font-size: 0.875rem;
      color: #F8FAFC;
      flex: 1;
      font-family: 'Fira Code', monospace;
    }

    .trace-duration {
      font-size: 0.875rem;
      font-weight: 600;
      color: #64748B;
      font-family: 'Fira Code', monospace;
    }

    .trace-spans {
      display: flex;
      gap: 2px;
      height: 8px;
      border-radius: 4px;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.05);
    }

    .trace-span {
      height: 100%;
      transition: all 200ms ease;
    }

    /* Accessibility */
    @media (prefers-reduced-motion: reduce) {
      * {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Focus states */
    .btn-icon:focus-visible,
    .alert-item:focus-visible,
    .trace:focus-visible {
      outline: 2px solid #22C55E;
      outline-offset: 2px;
    }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js" integrity="sha384-D3aJLOerQJpYjJgfhPLGUZnz3PljzqG9D1R3tCF9x8cEMPvZGvSMPbDqXfR5D1zH" crossorigin="anonymous"></script>
  <script>
    // WebSocket connection to Sentinel
    let ws: WebSocket | null = null;
    let chart: any = null;
    let metricsData = {
      cpu: { labels: [], data: [] },
      memory: { labels: [], data: [] },
      network: { labels: [], data: [] },
      requests: { labels: [], data: [] }
    };
    let currentMetric = 'cpu';
    let logsPaused = false;

    function connectWebSocket() {
      const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      const host = window.location.hostname;
      const port = '8081'; // Sentinel port

      try {
        ws = new WebSocket(`${protocol}//${host}:${port}/ws`);

        ws.onopen = () => {
          console.log('Connected to Sentinel AI');
          addLog({ level: 'INFO', message: 'Connected to Sentinel AI WebSocket' });
        };

        ws.onmessage = (event) => {
          const data = JSON.parse(event.data);
          handleSentinelMessage(data);
        };

        ws.onerror = (error) => {
          console.error('WebSocket error:', error);
          addLog({ level: 'ERROR', message: 'WebSocket connection error' });
        };

        ws.onclose = () => {
          console.log('Disconnected from Sentinel AI');
          addLog({ level: 'WARN', message: 'Disconnected from Sentinel AI - reconnecting in 5s' });
          // Reconnect after 5 seconds
          setTimeout(connectWebSocket, 5000);
        };
      } catch (error) {
        console.error('Failed to connect to Sentinel:', error);
        addLog({ level: 'ERROR', message: 'Failed to connect to Sentinel AI' });
        setTimeout(connectWebSocket, 5000);
      }
    }

    function handleSentinelMessage(data: any) {
      if (data.type === 'watcher_alert') {
        addAlert(data);
      } else if (data.type === 'analyst_diagnosis') {
        addDiagnosis(data);
      } else if (data.type === 'log') {
        addLog(data);
      } else if (data.type === 'metrics') {
        updateMetrics(data);
      } else if (data.type === 'trace') {
        addTrace(data);
      }
    }

    function addAlert(alert: any) {
      const alertsList = document.getElementById('alertsList');
      const alertCount = document.getElementById('alertCount');

      if (alertsList && alertCount) {
        const empty = alertsList.querySelector('.empty-alerts');
        if (empty) empty.remove();

        const alertEl = document.createElement('div');
        alertEl.className = 'alert-item';
        alertEl.innerHTML = `
          <div class="alert-header">
            <span class="alert-severity">${alert.severity || 'MEDIUM'}</span>
            <span class="alert-time mono">just now</span>
          </div>
          <div class="alert-message">${alert.analysis || alert.message}</div>
        `;
        alertsList.prepend(alertEl);

        const currentCount = parseInt(alertCount.textContent || '0');
        alertCount.textContent = String(currentCount + 1);

        // Keep only last 50 alerts
        while (alertsList.children.length > 50) {
          alertsList.removeChild(alertsList.lastChild!);
        }
      }
    }

    function addDiagnosis(diagnosis: any) {
      addLog({ level: 'INFO', message: `Analyst diagnosis: ${diagnosis.summary || 'Analysis complete'}` });
    }

    function addLog(log: any) {
      if (logsPaused) return;

      const logsStream = document.getElementById('logsStream');
      if (logsStream) {
        const logEl = document.createElement('div');
        logEl.className = `log-entry log-${log.level.toLowerCase()}`;

        const time = new Date().toLocaleTimeString('en-US', { hour12: false });
        logEl.innerHTML = `
          <span class="log-time">${time}</span>
          <span class="log-level">${log.level}</span>
          <span class="log-msg">${log.message}</span>
        `;

        logsStream.prepend(logEl);

        // Keep only last 100 logs
        while (logsStream.children.length > 100) {
          logsStream.removeChild(logsStream.lastChild!);
        }
      }
    }

    function addTrace(trace: any) {
      const tracesList = document.getElementById('tracesList');
      if (!tracesList) return;

      const traceEl = document.createElement('div');
      traceEl.className = 'trace';

      const spans = trace.spans || [];
      const spansHtml = spans.map((span: any) => {
        const width = (span.duration / trace.totalDuration * 100).toFixed(1);
        const color = span.error ? '#EF4444' : '#22C55E';
        return `<div class="trace-span" style="width: ${width}%; background: ${color}80;"></div>`;
      }).join('');

      traceEl.innerHTML = `
        <div class="trace-header">
          <span class="trace-method">${trace.method || 'GET'}</span>
          <span class="trace-path">${trace.path || '/'}</span>
          <span class="trace-duration">${trace.totalDuration || 0}ms</span>
        </div>
        <div class="trace-spans">${spansHtml}</div>
      `;

      tracesList.prepend(traceEl);

      // Keep only last 20 traces
      while (tracesList.children.length > 20) {
        tracesList.removeChild(tracesList.lastChild!);
      }
    }

    function updateMetrics(data: any) {
      // Update metric values
      if (data.servicesUp !== undefined) {
        const el = document.getElementById('servicesUp');
        if (el) el.textContent = data.servicesUp;
      }
      if (data.avgResponse !== undefined) {
        const el = document.getElementById('avgResponse');
        if (el) el.textContent = `${data.avgResponse}ms`;
      }
      if (data.errorRate !== undefined) {
        const el = document.getElementById('errorRate');
        if (el) el.textContent = `${data.errorRate}%`;
      }
      if (data.activeTraces !== undefined) {
        const el = document.getElementById('activeTraces');
        if (el) el.textContent = data.activeTraces;
      }

      // Update chart data
      const timestamp = new Date().toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute: '2-digit' });

      if (data.cpu !== undefined) {
        metricsData.cpu.labels.push(timestamp);
        metricsData.cpu.data.push(data.cpu);
        if (metricsData.cpu.labels.length > 30) {
          metricsData.cpu.labels.shift();
          metricsData.cpu.data.shift();
        }
      }

      if (data.memory !== undefined) {
        metricsData.memory.labels.push(timestamp);
        metricsData.memory.data.push(data.memory);
        if (metricsData.memory.labels.length > 30) {
          metricsData.memory.labels.shift();
          metricsData.memory.data.shift();
        }
      }

      if (data.network !== undefined) {
        metricsData.network.labels.push(timestamp);
        metricsData.network.data.push(data.network);
        if (metricsData.network.labels.length > 30) {
          metricsData.network.labels.shift();
          metricsData.network.data.shift();
        }
      }

      if (data.requests !== undefined) {
        metricsData.requests.labels.push(timestamp);
        metricsData.requests.data.push(data.requests);
        if (metricsData.requests.labels.length > 30) {
          metricsData.requests.labels.shift();
          metricsData.requests.data.shift();
        }
      }

      if (chart) {
        updateChart();
      }
    }

    function initChart() {
      const canvas = document.getElementById('metricsChart') as HTMLCanvasElement;
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      // @ts-ignore
      chart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: metricsData[currentMetric].labels,
          datasets: [{
            label: currentMetric.toUpperCase(),
            data: metricsData[currentMetric].data,
            borderColor: '#22C55E',
            backgroundColor: 'rgba(34, 197, 94, 0.1)',
            borderWidth: 2,
            tension: 0.4,
            fill: true,
            pointRadius: 0,
            pointHoverRadius: 4,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              mode: 'index',
              intersect: false,
              backgroundColor: 'rgba(15, 23, 42, 0.9)',
              borderColor: 'rgba(34, 197, 94, 0.5)',
              borderWidth: 1,
              titleColor: '#F8FAFC',
              bodyColor: '#94A3B8',
              padding: 12,
              displayColors: false
            }
          },
          scales: {
            x: {
              grid: { color: 'rgba(255, 255, 255, 0.05)' },
              ticks: { color: '#64748B', maxTicksLimit: 10 }
            },
            y: {
              grid: { color: 'rgba(255, 255, 255, 0.05)' },
              ticks: { color: '#64748B' },
              beginAtZero: true
            }
          },
          interaction: {
            mode: 'nearest',
            axis: 'x',
            intersect: false
          }
        }
      });
    }

    function updateChart() {
      if (!chart) return;

      chart.data.labels = metricsData[currentMetric].labels;
      chart.data.datasets[0].data = metricsData[currentMetric].data;
      chart.data.datasets[0].label = currentMetric.toUpperCase();
      chart.update('none');
    }

    function switchMetric(metric: string) {
      currentMetric = metric;
      document.querySelectorAll('.metric-tab').forEach(tab => {
        tab.classList.remove('active');
        if (tab.getAttribute('data-metric') === metric) {
          tab.classList.add('active');
        }
      });
      updateChart();
    }

    // Generate mock data for demonstration
    function generateMockData() {
      const timestamp = new Date().toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute: '2-digit' });

      updateMetrics({
        servicesUp: Math.floor(Math.random() * 2) + 11,
        avgResponse: Math.floor(Math.random() * 50) + 100,
        errorRate: (Math.random() * 2).toFixed(2),
        activeTraces: Math.floor(Math.random() * 10) + 5,
        cpu: Math.floor(Math.random() * 30) + 40,
        memory: Math.floor(Math.random() * 20) + 60,
        network: Math.floor(Math.random() * 100) + 500,
        requests: Math.floor(Math.random() * 200) + 800
      });

      // Random logs
      if (Math.random() > 0.7) {
        const levels = ['INFO', 'WARN', 'ERROR'];
        const messages = [
          'Health check completed successfully',
          'Cache miss ratio: 12%',
          'Database query took 234ms',
          'Rate limit exceeded for IP 192.168.1.100',
          'Failed to connect to external service'
        ];
        addLog({
          level: levels[Math.floor(Math.random() * levels.length)],
          message: messages[Math.floor(Math.random() * messages.length)]
        });
      }

      // Random trace
      if (Math.random() > 0.8) {
        const methods = ['GET', 'POST', 'PUT', 'DELETE'];
        const paths = ['/api/tasks', '/api/services', '/api/health', '/api/metrics'];
        const totalDuration = Math.floor(Math.random() * 300) + 50;

        addTrace({
          method: methods[Math.floor(Math.random() * methods.length)],
          path: paths[Math.floor(Math.random() * paths.length)],
          totalDuration,
          spans: [
            { duration: totalDuration * 0.3, error: false },
            { duration: totalDuration * 0.5, error: false },
            { duration: totalDuration * 0.2, error: Math.random() > 0.9 }
          ]
        });
      }
    }

    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
      initChart();
      connectWebSocket();

      // Add metric tab switching
      document.querySelectorAll('.metric-tab').forEach(tab => {
        tab.addEventListener('click', (e) => {
          const metric = (e.currentTarget as HTMLElement).getAttribute('data-metric');
          if (metric) switchMetric(metric);
        });
      });

      // Refresh button
      document.getElementById('refreshBtn')?.addEventListener('click', () => {
        location.reload();
      });

      // Pause watcher button
      document.getElementById('pauseWatcherBtn')?.addEventListener('click', async () => {
        alert('Pause/resume functionality coming soon');
      });

      // Pause logs button
      document.getElementById('pauseLogsBtn')?.addEventListener('click', (e) => {
        logsPaused = !logsPaused;
        const btn = e.currentTarget as HTMLElement;
        btn.innerHTML = logsPaused
          ? '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>'
          : '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>';
      });

      // Generate mock data every 3 seconds for demonstration
      setInterval(generateMockData, 3000);

      // Initial data generation
      for (let i = 0; i < 10; i++) {
        generateMockData();
      }
    });
  </script>
</Layout>
