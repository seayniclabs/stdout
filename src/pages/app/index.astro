---
import Layout from '../../layouts/Layout.astro';
import { getDb, schema } from '../../lib/db';
import { eq, desc, sql } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

const db = getDb();

// Get user's incidents
const userIncidents = db
  .select()
  .from(schema.incidents)
  .where(eq(schema.incidents.userId, user.id))
  .orderBy(desc(schema.incidents.createdAt))
  .all();

const activeCount = userIncidents.filter(i => i.status !== 'resolved').length;
const resolvedCount = userIncidents.filter(i => i.status === 'resolved').length;
---
<Layout title="StdOut — Incidents">
  <div class="dashboard">
    <!-- Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-value" style={activeCount > 0 ? 'color: var(--critical)' : ''}>{activeCount}</div>
        <div class="stat-label">Active</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{userIncidents.length}</div>
        <div class="stat-label">This month</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" style="color: var(--accent-light);">{resolvedCount}</div>
        <div class="stat-label">Resolved</div>
      </div>
    </div>

    <!-- Actions -->
    <div class="actions-row">
      <h2>Incidents</h2>
      <a href="/app/incidents/new" class="btn btn-primary">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 2v10M2 7h10"/></svg>
        New incident
      </a>
    </div>

    <!-- Incident list -->
    {userIncidents.length === 0 ? (
      <div class="empty-state">
        <div class="empty-icon">&gt;_</div>
        <h3>No incidents yet</h3>
        <p>Log your first incident to start building your runbook.</p>
        <a href="/app/incidents/new" class="btn btn-primary">Log an incident</a>
      </div>
    ) : (
      <div class="incident-list">
        {userIncidents.map(incident => (
          <a href={`/app/incidents/${incident.id}`} class="incident-row">
            <div class={`severity-bar ${incident.severity}`} style="height: 36px;"></div>
            <div class="incident-info">
              <div class="incident-title">{incident.title}</div>
              <div class="incident-meta">
                <span class="mono">#{incident.id.slice(0, 8)}</span>
                {incident.tags && incident.tags.split(',').map(tag => (
                  <span class="tag">{tag.trim()}</span>
                ))}
              </div>
            </div>
            <div class="incident-status-col">
              <span class={`status-badge ${incident.status}`}>{incident.status}</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>

<style>
  .dashboard { max-width: 800px; }
  .stats-row {
    display: flex;
    gap: 1px;
    background: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 24px;
  }
  .stat-card {
    flex: 1;
    padding: 16px 20px;
    background: var(--bg-surface);
    text-align: center;
  }
  .stat-value {
    font-size: 24px;
    font-weight: 700;
    font-family: var(--font-mono);
    letter-spacing: -0.02em;
  }
  .stat-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 2px;
  }
  .actions-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .actions-row h2 {
    font-size: 16px;
    font-weight: 600;
  }
  .incident-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .incident-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: background 150ms;
    text-decoration: none;
    color: inherit;
  }
  .incident-row:last-child { border-bottom: none; }
  .incident-row:hover { background: var(--bg-surface); }
  .incident-info { flex: 1; min-width: 0; }
  .incident-title {
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 2px;
  }
  .incident-meta {
    font-size: 11px;
    color: var(--text-muted);
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .tag {
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 10px;
    font-weight: 500;
    background: var(--accent-dim);
    color: var(--accent-light);
  }
  .status-badge {
    font-size: 11px;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: 4px;
    font-family: var(--font-mono);
  }
  .status-badge.active { color: var(--critical); background: var(--critical-dim); }
  .status-badge.investigating { color: var(--high); background: var(--high-dim); }
  .status-badge.monitoring { color: var(--medium); background: var(--medium-dim); }
  .status-badge.resolved { color: var(--resolved); background: rgba(85,85,106,0.12); }
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
  .empty-icon {
    font-family: var(--font-mono);
    font-size: 28px;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .empty-state h3 {
    font-size: 16px;
    margin-bottom: 8px;
  }
  .empty-state p {
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }
</style>
