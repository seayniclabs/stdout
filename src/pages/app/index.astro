---
import Layout from '../../layouts/Layout.astro';
import { getDb, schema } from '../../lib/db';
import { eq, desc } from 'drizzle-orm';
import { getRecentChecks, getUptimeStats } from '../../lib/hud';
import { checkForUpdate, getLicenseNotice, type UpdateCheckResult } from '../../lib/update-check';
import { getStoredLicense } from '../../lib/license';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

// Version check (silent failure — never blocks the page)
let updateInfo: UpdateCheckResult | null = null;
try {
  updateInfo = await checkForUpdate();
} catch {}
const hasUpdate = updateInfo?.hasUpdate ?? false;
const licenseNotice = getLicenseNotice();

const db = getDb();

// --- Monitors data ---
const allMonitors = db.select().from(schema.monitors)
  .where(eq(schema.monitors.userId, user.id))
  .orderBy(desc(schema.monitors.createdAt))
  .all();

const monitorsData = allMonitors.map(m => {
  const uptime = getUptimeStats(user.id, m.id, 30);
  const sparkline = getRecentChecks(user.id, m.id, 20);
  return { ...m, uptimePercent: uptime.uptimePercent, sparkline };
});

const servicesUp = monitorsData.filter(m => m.currentStatus === 'healthy').length;
const servicesDown = monitorsData.filter(m => m.currentStatus === 'down').length;
const servicesDegraded = monitorsData.filter(m => m.currentStatus === 'degraded').length;
const totalMonitors = allMonitors.length;

// Calculate actual 30d uptime (only from active monitors with checks)
const activeMonitorsData = monitorsData.filter(m => m.currentStatus !== 'unknown');
const totalUptime = activeMonitorsData.length > 0
  ? activeMonitorsData.reduce((sum, m) => sum + m.uptimePercent, 0) / activeMonitorsData.length
  : null; // null if no active monitors yet

// Calculate average latency from recent checks
const allLatencies: number[] = [];
for (const m of monitorsData) {
  if (m.sparkline && m.sparkline.length > 0) {
    const latencies = m.sparkline
      .filter((check: any) => check.responseTimeMs !== null && check.responseTimeMs !== undefined)
      .map((check: any) => check.responseTimeMs);
    allLatencies.push(...latencies);
  }
}
const avgLatency = allLatencies.length > 0
  ? Math.round(allLatencies.reduce((sum, l) => sum + l, 0) / allLatencies.length)
  : null;

// --- Incidents data ---
const allIncidents = db.select().from(schema.incidents)
  .where(eq(schema.incidents.userId, user.id))
  .orderBy(desc(schema.incidents.createdAt))
  .all();

const activeIncidents = allIncidents.filter(i => i.status !== 'resolved');
const recentIncidents = allIncidents.slice(0, 5);

// --- Docs count ---
const docsCount = db.select().from(schema.docs)
  .where(eq(schema.docs.userId, user.id))
  .all().length;

// --- Stacks count ---
const stacksCount = db.select().from(schema.stacks)
  .where(eq(schema.stacks.userId, user.id))
  .all().length;

// --- Pending imports ---
const pendingImports = db.select().from(schema.stackImports)
  .where(eq(schema.stackImports.status, 'pending')).all();

// --- Onboarding state ---
const tokens = getDb().select().from(schema.apiTokens)
  .where(eq(schema.apiTokens.userId, user.id)).all();
const hasToken = tokens.length > 0;

// Load onboarding progress from tenant preferences
const prefs = db.select().from(schema.tenantPreferences)
  .where(eq(schema.tenantPreferences.userId, user.id)).get();
const onboardingDismissed = prefs?.onboardingDismissed ?? false;
const savedProgress: string[] = prefs?.onboardingProgress ? JSON.parse(prefs.onboardingProgress) : [];

const confirmedImport = db.select().from(schema.stackImports)
  .where(eq(schema.stackImports.status, 'confirmed'))
  .all()
  .sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime())[0];

const windlassCfg = db.select().from(schema.windlassConfig)
  .where(eq(schema.windlassConfig.userId, user.id))
  .get();

const autoCompleted = new Set(savedProgress);
const hasLicense = !!getStoredLicense();
if (hasLicense) autoCompleted.add('license');
if (prefs?.workspaceName) autoCompleted.add('environment');
if (hasToken) autoCompleted.add('token');
if (stacksCount > 0 || pendingImports.length > 0) autoCompleted.add('scanner');
if (confirmedImport) autoCompleted.add('review');
if (windlassCfg?.lastSyncedAt) autoCompleted.add('windlass');
if (totalMonitors > 0) autoCompleted.add('monitors');
const completedSteps = Array.from(autoCompleted);
const totalSteps = 8;
const allDone = completedSteps.length >= totalSteps || completedSteps.includes('done');

// --- Add-ons banner state ---
const addonsHidden = prefs?.addonsHidden ?? false;
const addonsDismissed = prefs?.addonsDismissed ?? false;
// Only show add-ons banner if user has services (makes it contextual, not promotional)
const showAddonsBanner = !addonsHidden && !addonsDismissed && (totalMonitors > 0 || stacksCount > 0);
const completedCount = completedSteps.length;
const progressPct = Math.round((completedCount / totalSteps) * 100);
const isNewUser = !onboardingDismissed && !allDone && (stacksCount === 0 && allIncidents.length === 0 && totalMonitors === 0);
// Hide onboarding if dismissed OR all steps complete OR has active infrastructure (monitors/stacks/incidents)
const hasActiveInfra = totalMonitors > 0 || stacksCount > 0 || allIncidents.length > 0;
const showOnboarding = !onboardingDismissed && !allDone && !hasActiveInfra;

// --- Recent activity (last 5 incidents created/resolved) ---
const activityItems: { text: string; time: Date; type: string }[] = [];
for (const inc of allIncidents.slice(0, 20)) {
  if (activityItems.length >= 5) break;
  if (inc.resolvedAt) {
    activityItems.push({ text: `Resolved: ${inc.title}`, time: inc.resolvedAt, type: 'resolved' });
  }
  activityItems.push({ text: `Created: ${inc.title}`, time: inc.createdAt, type: inc.severity });
}
activityItems.sort((a, b) => b.time.getTime() - a.time.getTime());
const activity = activityItems.slice(0, 5);

function timeAgo(date: Date) {
  const ms = Date.now() - date.getTime();
  const mins = Math.floor(ms / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return mins === 1 ? '1 minute ago' : `${mins} minutes ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return hrs === 1 ? '1 hour ago' : `${hrs} hours ago`;
  const days = Math.floor(hrs / 24);
  return days === 1 ? '1 day ago' : `${days} days ago`;
}
---
<Layout title="Dashboard — StdOut">
  <div class="dash">
    {/* Pending import banner */}
    {pendingImports.length > 0 && (
      <a href={`/app/stacks/import/${pendingImports[0].id}`} class="import-banner">
        <span class="import-banner-icon mono">&gt;_</span>
        <span>New scan results available — <strong>{pendingImports.length} pending import{pendingImports.length > 1 ? 's' : ''}</strong></span>
        <span class="import-banner-arrow">&rarr;</span>
      </a>
    )}

    {/* Update available banner */}
    {licenseNotice && !licenseNotice.valid && (
      <div class="update-banner" style="border-color: var(--warning);">
        <span>{licenseNotice.message}</span>
      </div>
    )}

    {hasUpdate && updateInfo && (
      <div class="update-banner" id="updateBanner">
        <a href={updateInfo.releaseUrl} class="update-banner-link" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>Update available: <strong>v{updateInfo.currentVersion}</strong> &rarr; <strong>v{updateInfo.latestVersion}</strong></span>
        </a>
        <button class="update-banner-dismiss" id="dismissUpdate" aria-label="Dismiss">&times;</button>
      </div>
    )}

    {/* Add-ons banner */}
    {showAddonsBanner && (
      <div class="addons-banner" id="addonsBanner">
        <a href="/app/addons" class="addons-banner-link">
          <span class="addons-banner-icon">+</span>
          <span>Tools that work with your stack — <strong>explore add-ons</strong></span>
        </a>
        <button class="addons-banner-dismiss" id="dismissAddons" aria-label="Dismiss">&times;</button>
      </div>
    )}

    {/* Onboarding checklist — shown as banner for returning users, full view for new users */}
    {showOnboarding && (
      <div class={`onboarding ${isNewUser ? 'onboarding--full' : 'onboarding--banner'}`} id="onboarding-widget">
        <div class="onboarding-top">
          <div class="onboarding-top-left">
            {isNewUser && <div class="empty-icon">&gt;_</div>}
            <div>
              <h3>{isNewUser ? 'Welcome to StdOut' : 'Getting Started'}</h3>
              {isNewUser && <p class="onboarding-subtitle">Let's get your infrastructure documented. Complete these steps to get the most out of StdOut.</p>}
            </div>
          </div>
          <button class="onboarding-dismiss" id="onboarding-dismiss" title="Dismiss checklist" aria-label="Dismiss onboarding">&times;</button>
        </div>

        <div class="onboarding-progress">
          <div class="progress-bar">
            <div class="progress-fill" style={`width: ${progressPct}%`}></div>
          </div>
          <span class="progress-label mono">{completedCount}/{totalSteps} complete</span>
        </div>

        <div class="onboarding-steps" id="onboarding-steps">
          <a href="/app/settings#license" class={`onboard-step ${completedSteps.includes('license') ? 'done' : 'active'}`} data-step="license">
            <div class="step-num">{completedSteps.includes('license') ? '\u2713' : '1'}</div>
            <div class="step-content">
              <h4>Activate your license</h4>
              <p>{hasLicense ? 'License activated successfully \u2014 Edition: Self-Hosted' : 'Enter the key from your purchase email, or skip to evaluate for 14 days.'}</p>
            </div>
            <span class="step-arrow">&rarr;</span>
          </a>
          <a href="/app/settings" class={`onboard-step ${completedSteps.includes('environment') ? 'done' : ''}`} data-step="environment">
            <div class="step-num">{completedSteps.includes('environment') ? '\u2713' : '2'}</div>
            <div class="step-content">
              <h4>Name your environment</h4>
              <p>Label this install (e.g. Home Lab, Office Server).</p>
            </div>
            <span class="step-arrow">&rarr;</span>
          </a>
          <a href="/app/settings" class={`onboard-step ${completedSteps.includes('token') ? 'done' : ''}`} data-step="token">
            <div class="step-num">{completedSteps.includes('token') ? '\u2713' : '3'}</div>
            <div class="step-content">
              <h4>Create a scanner token</h4>
              <p>Generate the API token the scanner uses to send data here.</p>
            </div>
            <span class="step-arrow">&rarr;</span>
          </a>
          <a href="/app/docs/guide/scanner-setup" class={`onboard-step ${completedSteps.includes('scanner') ? 'done' : ''}`} data-step="scanner">
            <div class="step-num">{completedSteps.includes('scanner') ? '\u2713' : '4'}</div>
            <div class="step-content">
              <h4>Run the scanner</h4>
              <p>Run the docker command on your host to discover stacks and containers.</p>
            </div>
            <span class="step-arrow">&rarr;</span>
          </a>
          <a href={pendingImports[0] ? `/app/stacks/import/${pendingImports[0].id}` : '/app/stacks'} class={`onboard-step ${completedSteps.includes('review') ? 'done' : ''}`} data-step="review">
            <div class="step-num">{completedSteps.includes('review') ? '\u2713' : '5'}</div>
            <div class="step-content">
              <h4>Review your environment</h4>
              <p>Confirm discovered stacks and containers from the scan.</p>
            </div>
            <span class="step-arrow">&rarr;</span>
          </a>
          <a href="/app/tools/windlass" class={`onboard-step ${completedSteps.includes('windlass') ? 'done' : ''}`} data-step="windlass">
            <div class="step-num">{completedSteps.includes('windlass') ? '\u2713' : '6'}</div>
            <div class="step-content">
              <h4>Configure Windlass</h4>
              <p>Apply a generated schedule so Windlass can watch your services.</p>
            </div>
            <span class="step-arrow">&rarr;</span>
          </a>
          <a href="/app/hud" class={`onboard-step ${completedSteps.includes('monitors') ? 'done' : ''}`} data-step="monitors">
            <div class="step-num">{completedSteps.includes('monitors') ? '\u2713' : '7'}</div>
            <div class="step-content">
              <h4>Set up health checks</h4>
              <p>Add monitors from your confirmed stacks (one-click suggestions on the HUD).</p>
            </div>
            <span class="step-arrow">&rarr;</span>
          </a>
          <div class={`onboard-step ${allDone ? 'done' : ''}`} data-step="done">
            <div class="step-num">{allDone ? '\u2713' : '8'}</div>
            <div class="step-content">
              <h4>You're set up</h4>
              <p>{stacksCount} stacks, {totalMonitors} monitors{windlassCfg?.lastSyncedAt ? ', Windlass connected' : ''}.</p>
            </div>
          </div>
        </div>
      </div>
    )}

    {/* Dashboard content — always shown for users with data, hidden for brand-new users */}
    {!isNewUser && (
      <Fragment>
        <!-- Status overview cards -->
        <div class="overview-cards">
          <div class="ov-card">
            <div class="ov-icon" style={servicesDown > 0 ? 'color: var(--critical);' : 'color: var(--low);'}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            </div>
            <div class="ov-data">
              <div class="ov-value mono">{servicesUp}<span class="ov-of">/{totalMonitors}</span></div>
              <div class="ov-label">Services Up</div>
            </div>
            {servicesDown > 0 && <div class="ov-alert">{servicesDown} down</div>}
            {servicesDegraded > 0 && servicesDown === 0 && <div class="ov-warn">{servicesDegraded} degraded</div>}
          </div>

          <div class="ov-card">
            <div class="ov-icon" style={activeIncidents.length > 0 ? 'color: var(--critical);' : 'color: var(--low);'}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <div class="ov-data">
              <div class="ov-value mono">{activeIncidents.length}</div>
              <div class="ov-label">Active Incidents</div>
            </div>
          </div>

          <div class="ov-card">
            <div class="ov-icon" style={`color: ${totalUptime === null ? 'var(--text-muted)' : totalUptime >= 99.9 ? 'var(--low)' : totalUptime >= 99 ? 'var(--high)' : 'var(--critical)'};`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div class="ov-data">
              <div class="ov-value mono">{totalUptime !== null ? `${totalUptime.toFixed(1)}%` : '\u2014'}</div>
              <div class="ov-label">30d Uptime</div>
            </div>
          </div>

          <div class="ov-card">
            <div class="ov-icon" style="color: var(--accent-light);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/></svg>
            </div>
            <div class="ov-data">
              <div class="ov-value mono">{avgLatency !== null ? `${avgLatency}ms` : '\u2014'}</div>
              <div class="ov-label">Avg Latency</div>
            </div>
          </div>
        </div>

        <!-- Two-column layout: left (services + incidents), right (actions + activity) -->
        <div class="dash-grid">
          <div class="dash-col">
            <!-- Service Health -->
            <div class="dash-section">
              <div class="dash-section-header">
                <h2>Service Health</h2>
                <a href="/app/hud" class="dash-link">View HUD &rarr;</a>
              </div>
              {totalMonitors === 0 ? (
                <div class="mini-empty">
                  <p>No monitors configured yet.</p>
                  <a href="/app/hud" class="btn btn-ghost btn-sm">Set up HUD</a>
                </div>
              ) : (
                <div class="svc-grid">
                  {monitorsData.slice(0, 12).map(m => {
                    const statusClass = m.maintenance ? 'maintenance' : m.currentStatus;
                    // Build mini sparkline
                    const pts = m.sparkline.map((c: any, i: number) => {
                      const x = (i / Math.max(m.sparkline.length - 1, 1)) * 100;
                      const ms = c.ms || 0;
                      const maxMs = Math.max(...m.sparkline.map((s: any) => s.ms || 0), 1);
                      const y = 16 - Math.min(14, (ms / maxMs) * 14);
                      return `${x},${y}`;
                    });
                    const linePath = pts.length > 1 ? `M${pts.join(' L')}` : '';
                    const sparkColor = m.currentStatus === 'degraded' ? 'yellow' : m.currentStatus === 'down' ? 'red' : 'green';
                    return (
                      <a href={`/app/hud/${m.id}`} class="svc-card">
                        <div class="svc-card-top">
                          <span class={`svc-dot ${statusClass}`}></span>
                          <span class="svc-card-name">{m.name}</span>
                        </div>
                        <div class="svc-card-spark">
                          {linePath && (
                            <svg viewBox="0 0 100 16" preserveAspectRatio="none">
                              <path class={`spark-line ${sparkColor}`} d={linePath} />
                            </svg>
                          )}
                        </div>
                        <div class="svc-card-meta mono">
                          {m.lastResponseMs ? `${m.lastResponseMs}ms` : '\u2014'}
                        </div>
                      </a>
                    );
                  })}
                </div>
              )}
            </div>

            <!-- Recent Incidents -->
            <div class="dash-section">
              <div class="dash-section-header">
                <h2>Recent Incidents</h2>
                <a href="/app/incidents" class="dash-link">View all &rarr;</a>
              </div>
              {recentIncidents.length === 0 ? (
                <div class="mini-empty mini-empty--success">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--low);"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                  <p style="color: var(--low); font-weight: 500;">All Systems Nominal</p>
                  <p style="font-size: 0.875rem; color: var(--text-muted);">All monitored services are responding normally. No active incidents.</p>
                </div>
              ) : (
                <div class="recent-list">
                  {recentIncidents.map(inc => (
                    <a href={`/app/incidents/${inc.id}`} class="recent-row">
                      <div class={`severity-bar ${inc.severity}`} style="height: 32px;"></div>
                      <div class="recent-info">
                        <div class="recent-title">{inc.title}</div>
                        <div class="recent-meta mono">{timeAgo(inc.createdAt)}</div>
                      </div>
                      <span class={`status-pip ${inc.status}`}>{inc.status}</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>

          <div class="dash-col dash-col-side">
            <!-- Quick Actions -->
            <div class="dash-section">
              <h2>Quick Actions</h2>
              <div class="actions-grid">
                <a href="/app/incidents/new" class="action-btn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                  <span>New Incident</span>
                </a>
                <a href="/app/hud" class="action-btn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                  <span>View HUD</span>
                </a>
                <a href="/app/docs" class="action-btn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                  <span>Search Docs</span>
                </a>
                <a href="/app/search" class="action-btn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                  <span>Search</span>
                </a>
              </div>
            </div>

            <!-- Activity Feed -->
            <div class="dash-section">
              <h2>Activity</h2>
              {activity.length === 0 ? (
                <div class="mini-empty">
                  <div style="padding: 0.75rem 0; border-left: 2px solid var(--border); padding-left: 0.75rem; opacity: 0.5;">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                      <span class="activity-dot low"></span>
                      <span style="font-size: 0.875rem; color: var(--text-muted);">Monitor check completed</span>
                      <span style="font-size: 0.75rem; color: var(--text-dim); margin-left: auto;">2m ago</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                      <span class="activity-dot high"></span>
                      <span style="font-size: 0.875rem; color: var(--text-muted);">Incident created</span>
                      <span style="font-size: 0.75rem; color: var(--text-dim); margin-left: auto;">5m ago</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                      <span class="activity-dot resolved"></span>
                      <span style="font-size: 0.875rem; color: var(--text-muted);">Incident resolved</span>
                      <span style="font-size: 0.75rem; color: var(--text-dim); margin-left: auto;">10m ago</span>
                    </div>
                  </div>
                  <p style="font-size: 0.875rem; color: var(--text-muted); margin-top: 0.75rem;">Events will appear here once activity starts.</p>
                </div>
              ) : (
                <div class="activity-feed">
                  {activity.map(item => (
                    <div class="activity-row">
                      <span class={`activity-dot ${item.type}`}></span>
                      <span class="activity-text">{item.text}</span>
                      <span class="activity-time mono">{timeAgo(item.time)}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>

            <!-- Infrastructure summary -->
            <div class="dash-section">
              <h2>Infrastructure</h2>
              <div class="infra-stats">
