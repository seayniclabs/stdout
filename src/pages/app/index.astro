---
import Layout from '../../layouts/Layout.astro';
import { getTenantDb, getCentralDb, tenantSchema, centralSchema } from '../../lib/db';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

const db = getTenantDb(Astro.locals.workspace?.ownerId || user.id);

// Get user's incidents
const userIncidents = db
  .select()
  .from(tenantSchema.incidents)
  .where(eq(tenantSchema.incidents.userId, user.id))
  .orderBy(desc(tenantSchema.incidents.createdAt))
  .all();

const activeCount = userIncidents.filter(i => i.status !== 'resolved').length;
const resolvedCount = userIncidents.filter(i => i.status === 'resolved').length;

// Check for pending imports
const pendingImports = db.select().from(tenantSchema.stackImports)
  .where(eq(tenantSchema.stackImports.status, 'pending')).all();

// Onboarding state
const stacks = db.select().from(tenantSchema.stacks)
  .where(eq(tenantSchema.stacks.userId, user.id)).all();
const tokens = getCentralDb().select().from(centralSchema.apiTokens)
  .where(eq(centralSchema.apiTokens.userId, user.id)).all();
const isNewUser = stacks.length === 0 && userIncidents.length === 0;
const hasToken = tokens.length > 0;
---
<Layout title="StdOut — Incidents">
  <div class="dashboard">
    {/* Pending import banner */}
    {pendingImports.length > 0 && (
      <a href={`/app/stacks/import/${pendingImports[0].id}`} class="import-banner">
        <span class="import-banner-icon mono">&gt;_</span>
        <span>New scan results available — <strong>{pendingImports.length} pending import{pendingImports.length > 1 ? 's' : ''}</strong></span>
        <span class="import-banner-arrow">&rarr;</span>
      </a>
    )}

    <!-- Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-value" style={activeCount > 0 ? 'color: var(--critical)' : ''}>{activeCount}</div>
        <div class="stat-label">Active</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{userIncidents.length}</div>
        <div class="stat-label">This month</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" style="color: var(--accent-light);">{resolvedCount}</div>
        <div class="stat-label">Resolved</div>
      </div>
    </div>

    <!-- Actions -->
    <div class="actions-row">
      <h2>Incidents</h2>
      <a href="/app/incidents/new" class="btn btn-primary">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 2v10M2 7h10"/></svg>
        New incident
      </a>
    </div>

    <!-- Onboarding or incident list -->
    {isNewUser ? (
      <div class="onboarding">
        <div class="onboarding-header">
          <div class="empty-icon">&gt;_</div>
          <h3>Welcome to StdOut</h3>
          <p>Let's get your infrastructure documented. Three steps and you're running.</p>
        </div>

        <div class="onboarding-steps">
          <div class={`onboard-step ${hasToken ? 'done' : 'active'}`}>
            <div class="step-num">{hasToken ? '✓' : '1'}</div>
            <div class="step-content">
              <h4>Create an API token</h4>
              {hasToken ? (
                <p class="step-done-text">Token created — ready to scan.</p>
              ) : (
                <Fragment>
                  <p>The scanner needs a token to push results to your account.</p>
                  <a href="/app/settings" class="btn btn-primary btn-sm">Go to Settings → API Tokens</a>
                </Fragment>
              )}
            </div>
          </div>

          <div class={`onboard-step ${hasToken && stacks.length === 0 ? 'active' : hasToken && stacks.length > 0 ? 'done' : ''}`}>
            <div class="step-num">{stacks.length > 0 ? '✓' : '2'}</div>
            <div class="step-content">
              <h4>Run the scanner</h4>
              {stacks.length > 0 ? (
                <p class="step-done-text">Stack imported — your infrastructure is documented.</p>
              ) : hasToken ? (
                <Fragment>
                  <p>Discover your infrastructure automatically. Run this on your server:</p>
                  <pre class="scanner-cmd"><code>docker run --rm \
  -v /var/run/docker.sock:/var/run/docker.sock:ro \
  ghcr.io/charlieseay/stdout-scanner scan \
  --output json --dry-run</code></pre>
                  <p class="step-hint">See the <a href="/docs/scanner">scanner docs</a> for full setup with push-to-StdOut, network scanning, and scheduling.</p>
                </Fragment>
              ) : (
                <p>Create a token first, then run the scanner.</p>
              )}
            </div>
          </div>

          <div class={`onboard-step ${stacks.length > 0 ? 'active' : ''}`}>
            <div class="step-num">3</div>
            <div class="step-content">
              <h4>Log your first incident</h4>
              {stacks.length > 0 ? (
                <Fragment>
                  <p>When something breaks, log it here. StdOut matches it against your past resolutions.</p>
                  <a href="/app/incidents/new" class="btn btn-primary btn-sm">Log an incident</a>
                </Fragment>
              ) : (
                <p>After scanning, you'll be ready to start logging incidents.</p>
              )}
            </div>
          </div>
        </div>

        <div class="onboarding-alt">
          <span class="alt-text">or skip setup and</span>
          <a href="/app/incidents/new" class="alt-link">log an incident directly</a>
          <span class="alt-text">·</span>
          <a href="/app/stacks" class="alt-link">describe a stack manually</a>
        </div>
      </div>
    ) : userIncidents.length === 0 ? (
      <div class="empty-state">
        <div class="empty-icon">&gt;_</div>
        <h3>No incidents yet</h3>
        <p>When something breaks, log it here. StdOut matches it against your past resolutions and knowledge base.</p>
        <a href="/app/incidents/new" class="btn btn-primary">Log an incident</a>
      </div>
    ) : (
      <div class="incident-list">
        {userIncidents.map(incident => (
          <a href={`/app/incidents/${incident.id}`} class="incident-row">
            <div class={`severity-bar ${incident.severity}`} style="height: 36px;"></div>
            <div class="incident-info">
              <div class="incident-title">{incident.title}</div>
              <div class="incident-meta">
                <span class="mono">#{incident.id.slice(0, 8)}</span>
                {incident.tags && incident.tags.split(',').map(tag => (
                  <span class="tag">{tag.trim()}</span>
                ))}
              </div>
            </div>
            <div class="incident-status-col">
              <span class={`status-badge ${incident.status}`}>{incident.status}</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>

<style>
  .dashboard { max-width: 800px; margin: 0 auto; }
  .import-banner { display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: var(--accent-dim); border: 1px solid var(--accent); border-radius: var(--radius); margin-bottom: 16px; text-decoration: none; color: var(--accent-light); font-size: 13px; transition: background 150ms; }
  .import-banner:hover { background: var(--accent-glow); }
  .import-banner-icon { font-size: 14px; }
  .import-banner-arrow { margin-left: auto; }
  .stats-row {
    display: flex;
    gap: 1px;
    background: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 24px;
    box-shadow: var(--shadow-sm);
  }
  .stat-card {
    flex: 1;
    padding: 20px 20px;
    background: var(--bg-surface);
    text-align: center;
  }
  .stat-value {
    font-size: 32px;
    font-weight: 700;
    font-family: var(--font-mono);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .stat-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 6px;
    font-weight: 500;
  }
  .actions-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .actions-row h2 {
    font-size: 16px;
    font-weight: 600;
  }
  .incident-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .incident-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    color: inherit;
  }
  .incident-row:last-child { border-bottom: none; }
  .incident-row:hover { background: var(--bg-hover); transform: translateX(2px); }
  .incident-info { flex: 1; min-width: 0; }
  .incident-title {
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 2px;
  }
  .incident-meta {
    font-size: 11px;
    color: var(--text-muted);
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .tag {
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 10px;
    font-weight: 500;
    background: var(--accent-dim);
    color: var(--accent-light);
  }
  .status-badge {
    font-size: 11px;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: 4px;
    font-family: var(--font-mono);
  }
  .status-badge.active { color: var(--critical); background: var(--critical-dim); }
  .status-badge.investigating { color: var(--high); background: var(--high-dim); }
  .status-badge.monitoring { color: var(--medium); background: var(--medium-dim); }
  .status-badge.resolved { color: var(--resolved); background: rgba(85,85,106,0.12); }
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
  .empty-icon {
    font-family: var(--font-mono);
    font-size: 28px;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .empty-state h3 {
    font-size: 16px;
    margin-bottom: 8px;
  }
  .empty-state p {
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }
  .onboarding { margin-top: 8px; }
  .onboarding-header { text-align: center; margin-bottom: 28px; }
  .onboarding-header h3 { font-size: 18px; margin-bottom: 6px; }
  .onboarding-header p { font-size: 13px; color: var(--text-secondary); }
  .onboarding-steps { display: flex; flex-direction: column; gap: 2px; margin-bottom: 24px; }
  .onboard-step { display: flex; gap: 14px; padding: 16px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); opacity: 0.4; }
  .onboard-step.active { opacity: 1; border-color: var(--accent); }
  .onboard-step.done { opacity: 0.7; }
  .step-num { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 13px; font-weight: 700; font-family: var(--font-mono); background: var(--bg); border: 1px solid var(--border); flex-shrink: 0; }
  .onboard-step.active .step-num { background: var(--accent); color: #fff; border-color: var(--accent); }
  .onboard-step.done .step-num { background: var(--low); color: #fff; border-color: var(--low); }
  .step-content { flex: 1; }
  .step-content h4 { font-size: 14px; font-weight: 600; margin-bottom: 4px; }
  .step-content p { font-size: 13px; color: var(--text-secondary); margin-bottom: 8px; line-height: 1.5; }
  .step-done-text { color: var(--low) !important; font-family: var(--font-mono); font-size: 12px !important; }
  .step-hint { font-size: 12px !important; color: var(--text-muted) !important; }
  .step-hint a { color: var(--accent-light); }
  .scanner-cmd { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px; overflow-x: auto; margin-bottom: 8px; }
  .scanner-cmd code { font-family: var(--font-mono); font-size: 12px; color: var(--text); line-height: 1.6; white-space: pre; }
  .onboarding-alt { text-align: center; font-size: 12px; color: var(--text-muted); }
  .alt-link { color: var(--accent-light); text-decoration: none; }
  .alt-link:hover { text-decoration: underline; }
  .alt-text { margin: 0 2px; }
</style>
