---
import Layout from '../../layouts/Layout.astro';
import { getTenantDb, getCentralDb, tenantSchema, centralSchema } from '../../lib/db';
import { eq, desc } from 'drizzle-orm';
import { getRecentChecks, getUptimeStats } from '../../lib/hud';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

const db = getTenantDb(Astro.locals.workspace?.ownerId || user.id);

// --- Monitors data ---
const allMonitors = db.select().from(tenantSchema.monitors)
  .where(eq(tenantSchema.monitors.userId, user.id))
  .orderBy(desc(tenantSchema.monitors.createdAt))
  .all();

const monitorsData = allMonitors.map(m => {
  const uptime = getUptimeStats(user.id, m.id, 30);
  const sparkline = getRecentChecks(user.id, m.id, 20);
  return { ...m, uptimePercent: uptime.uptimePercent, sparkline };
});

const servicesUp = monitorsData.filter(m => m.currentStatus === 'healthy').length;
const servicesDown = monitorsData.filter(m => m.currentStatus === 'down').length;
const servicesDegraded = monitorsData.filter(m => m.currentStatus === 'degraded').length;
const totalMonitors = allMonitors.length;

// Aggregate 30d uptime
const totalUptime = monitorsData.length > 0
  ? monitorsData.reduce((sum, m) => sum + m.uptimePercent, 0) / monitorsData.length
  : 0;

// --- Incidents data ---
const allIncidents = db.select().from(tenantSchema.incidents)
  .where(eq(tenantSchema.incidents.userId, user.id))
  .orderBy(desc(tenantSchema.incidents.createdAt))
  .all();

const activeIncidents = allIncidents.filter(i => i.status !== 'resolved');
const recentIncidents = allIncidents.slice(0, 5);

// --- Docs count ---
const docsCount = db.select().from(tenantSchema.docs)
  .where(eq(tenantSchema.docs.userId, user.id))
  .all().length;

// --- Stacks count ---
const stacksCount = db.select().from(tenantSchema.stacks)
  .where(eq(tenantSchema.stacks.userId, user.id))
  .all().length;

// --- Pending imports ---
const pendingImports = db.select().from(tenantSchema.stackImports)
  .where(eq(tenantSchema.stackImports.status, 'pending')).all();

// --- Onboarding state ---
const tokens = getCentralDb().select().from(centralSchema.apiTokens)
  .where(eq(centralSchema.apiTokens.userId, user.id)).all();
const isNewUser = stacksCount === 0 && allIncidents.length === 0 && totalMonitors === 0;
const hasToken = tokens.length > 0;

// --- Recent activity (last 5 incidents created/resolved) ---
const activityItems: { text: string; time: Date; type: string }[] = [];
for (const inc of allIncidents.slice(0, 20)) {
  if (activityItems.length >= 5) break;
  if (inc.resolvedAt) {
    activityItems.push({ text: `Resolved: ${inc.title}`, time: inc.resolvedAt, type: 'resolved' });
  }
  activityItems.push({ text: `Created: ${inc.title}`, time: inc.createdAt, type: inc.severity });
}
activityItems.sort((a, b) => b.time.getTime() - a.time.getTime());
const activity = activityItems.slice(0, 5);

function timeAgo(date: Date) {
  const ms = Date.now() - date.getTime();
  const mins = Math.floor(ms / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  const days = Math.floor(hrs / 24);
  return `${days}d ago`;
}
---
<Layout title="Dashboard — StdOut">
  <div class="dash">
    {/* Pending import banner */}
    {pendingImports.length > 0 && (
      <a href={`/app/stacks/import/${pendingImports[0].id}`} class="import-banner">
        <span class="import-banner-icon mono">&gt;_</span>
        <span>New scan results available — <strong>{pendingImports.length} pending import{pendingImports.length > 1 ? 's' : ''}</strong></span>
        <span class="import-banner-arrow">&rarr;</span>
      </a>
    )}

    {isNewUser ? (
      <!-- Onboarding for new users -->
      <div class="onboarding">
        <div class="onboarding-header">
          <div class="empty-icon">&gt;_</div>
          <h3>Welcome to StdOut</h3>
          <p>Let's get your infrastructure documented. Three steps and you're running.</p>
        </div>

        <div class="onboarding-steps">
          <div class={`onboard-step ${hasToken ? 'done' : 'active'}`}>
            <div class="step-num">{hasToken ? '\u2713' : '1'}</div>
            <div class="step-content">
              <h4>Create an API token</h4>
              {hasToken ? (
                <p class="step-done-text">Token created — ready to scan.</p>
              ) : (
                <Fragment>
                  <p>The scanner needs a token to push results to your account.</p>
                  <a href="/app/settings" class="btn btn-primary btn-sm">Go to Settings</a>
                </Fragment>
              )}
            </div>
          </div>

          <div class={`onboard-step ${hasToken && stacksCount === 0 ? 'active' : stacksCount > 0 ? 'done' : ''}`}>
            <div class="step-num">{stacksCount > 0 ? '\u2713' : '2'}</div>
            <div class="step-content">
              <h4>Run the scanner</h4>
              {stacksCount > 0 ? (
                <p class="step-done-text">Stack imported — your infrastructure is documented.</p>
              ) : hasToken ? (
                <Fragment>
                  <p>Discover your infrastructure automatically. Run this on your server:</p>
                  <pre class="scanner-cmd"><code>docker run --rm \
  -v /var/run/docker.sock:/var/run/docker.sock:ro \
  ghcr.io/charlieseay/stdout-scanner scan \
  --output json --dry-run</code></pre>
                  <p class="step-hint">See the <a href="/docs/scanner">scanner docs</a> for full setup.</p>
                </Fragment>
              ) : (
                <p>Create a token first, then run the scanner.</p>
              )}
            </div>
          </div>

          <div class={`onboard-step ${stacksCount > 0 ? 'active' : ''}`}>
            <div class="step-num">3</div>
            <div class="step-content">
              <h4>Log your first incident</h4>
              {stacksCount > 0 ? (
                <Fragment>
                  <p>When something breaks, log it here. StdOut matches it against your past resolutions.</p>
                  <a href="/app/incidents/new" class="btn btn-primary btn-sm">Log an incident</a>
                </Fragment>
              ) : (
                <p>After scanning, you'll be ready to start logging incidents.</p>
              )}
            </div>
          </div>
        </div>

        <div class="onboarding-alt">
          <span class="alt-text">or skip setup and</span>
          <a href="/app/incidents/new" class="alt-link">log an incident directly</a>
          <span class="alt-text">·</span>
          <a href="/app/stacks" class="alt-link">describe a stack manually</a>
        </div>
      </div>
    ) : (
      <!-- Dashboard for existing users -->
      <Fragment>
        <!-- Status overview cards -->
        <div class="overview-cards">
          <div class="ov-card">
            <div class="ov-icon" style={servicesDown > 0 ? 'color: var(--critical);' : 'color: var(--low);'}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            </div>
            <div class="ov-data">
              <div class="ov-value mono">{servicesUp}<span class="ov-of">/{totalMonitors}</span></div>
              <div class="ov-label">Services Up</div>
            </div>
            {servicesDown > 0 && <div class="ov-alert">{servicesDown} down</div>}
            {servicesDegraded > 0 && servicesDown === 0 && <div class="ov-warn">{servicesDegraded} degraded</div>}
          </div>

          <div class="ov-card">
            <div class="ov-icon" style={activeIncidents.length > 0 ? 'color: var(--critical);' : 'color: var(--low);'}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <div class="ov-data">
              <div class="ov-value mono">{activeIncidents.length}</div>
              <div class="ov-label">Active Incidents</div>
            </div>
          </div>

          <div class="ov-card">
            <div class="ov-icon" style={`color: ${totalUptime >= 99.9 ? 'var(--low)' : totalUptime >= 99 ? 'var(--high)' : 'var(--critical)'};`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div class="ov-data">
              <div class="ov-value mono">{totalMonitors > 0 ? `${totalUptime.toFixed(1)}%` : '\u2014'}</div>
              <div class="ov-label">30d Uptime</div>
            </div>
          </div>

          <div class="ov-card">
            <div class="ov-icon" style="color: var(--accent-light);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <div class="ov-data">
              <div class="ov-value mono">{docsCount}</div>
              <div class="ov-label">Docs</div>
            </div>
          </div>
        </div>

        <!-- Two-column layout: left (services + incidents), right (actions + activity) -->
        <div class="dash-grid">
          <div class="dash-col">
            <!-- Service Health -->
            <div class="dash-section">
              <div class="dash-section-header">
                <h2>Service Health</h2>
                <a href="/app/hud" class="dash-link">View HUD &rarr;</a>
              </div>
              {totalMonitors === 0 ? (
                <div class="mini-empty">
                  <p>No monitors configured yet.</p>
                  <a href="/app/hud" class="btn btn-ghost btn-sm">Set up HUD</a>
                </div>
              ) : (
                <div class="svc-grid">
                  {monitorsData.slice(0, 12).map(m => {
                    const statusClass = m.maintenance ? 'maintenance' : m.currentStatus;
                    // Build mini sparkline
                    const pts = m.sparkline.map((c: any, i: number) => {
                      const x = (i / Math.max(m.sparkline.length - 1, 1)) * 100;
                      const ms = c.ms || 0;
                      const maxMs = Math.max(...m.sparkline.map((s: any) => s.ms || 0), 1);
                      const y = 16 - Math.min(14, (ms / maxMs) * 14);
                      return `${x},${y}`;
                    });
                    const linePath = pts.length > 1 ? `M${pts.join(' L')}` : '';
                    const sparkColor = m.currentStatus === 'degraded' ? 'yellow' : m.currentStatus === 'down' ? 'red' : 'green';
                    return (
                      <a href={`/app/hud/${m.id}`} class="svc-card">
                        <div class="svc-card-top">
                          <span class={`svc-dot ${statusClass}`}></span>
                          <span class="svc-card-name">{m.name}</span>
                        </div>
                        <div class="svc-card-spark">
                          {linePath && (
                            <svg viewBox="0 0 100 16" preserveAspectRatio="none">
                              <path class={`spark-line ${sparkColor}`} d={linePath} />
                            </svg>
                          )}
                        </div>
                        <div class="svc-card-meta mono">
                          {m.lastResponseMs ? `${m.lastResponseMs}ms` : '\u2014'}
                        </div>
                      </a>
                    );
                  })}
                </div>
              )}
            </div>

            <!-- Recent Incidents -->
            <div class="dash-section">
              <div class="dash-section-header">
                <h2>Recent Incidents</h2>
                <a href="/app/incidents" class="dash-link">View all &rarr;</a>
              </div>
              {recentIncidents.length === 0 ? (
                <div class="mini-empty">
                  <p>No incidents logged yet.</p>
                </div>
              ) : (
                <div class="recent-list">
                  {recentIncidents.map(inc => (
                    <a href={`/app/incidents/${inc.id}`} class="recent-row">
                      <div class={`severity-bar ${inc.severity}`} style="height: 32px;"></div>
                      <div class="recent-info">
                        <div class="recent-title">{inc.title}</div>
                        <div class="recent-meta mono">{timeAgo(inc.createdAt)}</div>
                      </div>
                      <span class={`status-pip ${inc.status}`}>{inc.status}</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>

          <div class="dash-col dash-col-side">
            <!-- Quick Actions -->
            <div class="dash-section">
              <h2>Quick Actions</h2>
              <div class="actions-grid">
                <a href="/app/incidents/new" class="action-btn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                  <span>New Incident</span>
                </a>
                <a href="/app/hud" class="action-btn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                  <span>View HUD</span>
                </a>
                <a href="/app/docs" class="action-btn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                  <span>Search Docs</span>
                </a>
                <a href="/app/search" class="action-btn">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                  <span>Search</span>
                </a>
              </div>
            </div>

            <!-- Activity Feed -->
            <div class="dash-section">
              <h2>Activity</h2>
              {activity.length === 0 ? (
                <div class="mini-empty">
                  <p>No activity yet. Incidents and resolutions will appear here.</p>
                </div>
              ) : (
                <div class="activity-feed">
                  {activity.map(item => (
                    <div class="activity-row">
                      <span class={`activity-dot ${item.type}`}></span>
                      <span class="activity-text">{item.text}</span>
                      <span class="activity-time mono">{timeAgo(item.time)}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>

            <!-- Infrastructure summary -->
            <div class="dash-section">
              <h2>Infrastructure</h2>
              <div class="infra-stats">
                <div class="infra-row">
                  <span class="infra-label">Stacks</span>
                  <span class="infra-val mono">{stacksCount}</span>
                </div>
                <div class="infra-row">
                  <span class="infra-label">Monitors</span>
                  <span class="infra-val mono">{totalMonitors}</span>
                </div>
                <div class="infra-row">
                  <span class="infra-label">Incidents (total)</span>
                  <span class="infra-val mono">{allIncidents.length}</span>
                </div>
                <div class="infra-row">
                  <span class="infra-label">Knowledge base</span>
                  <span class="infra-val mono">{docsCount} docs</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </Fragment>
    )}
  </div>
</Layout>

<style>
  .dash { max-width: 1100px; margin: 0 auto; }

  /* Import banner */
  .import-banner { display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: var(--accent-dim); border: 1px solid var(--accent); border-radius: var(--radius); margin-bottom: 16px; text-decoration: none; color: var(--accent-light); font-size: 13px; transition: background 150ms; }
  .import-banner:hover { background: var(--accent-glow); }
  .import-banner-icon { font-size: 14px; }
  .import-banner-arrow { margin-left: auto; }

  /* Overview cards */
  .overview-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 24px;
  }
  .ov-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    box-shadow: var(--shadow-sm);
    position: relative;
    transition: all 0.15s ease;
  }
  .ov-card:hover {
    border-color: var(--border-hover);
    box-shadow: var(--shadow-md);
  }
  .ov-icon {
    flex-shrink: 0;
    opacity: 0.9;
    margin-top: 2px;
  }
  .ov-data { flex: 1; }
  .ov-value {
    font-size: 24px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .ov-of {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
  }
  .ov-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 4px;
    font-weight: 500;
  }
  .ov-alert {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 10px;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--critical);
    background: var(--critical-dim);
    padding: 2px 6px;
    border-radius: 3px;
  }
  .ov-warn {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 10px;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--high);
    background: var(--high-dim);
    padding: 2px 6px;
    border-radius: 3px;
  }

  /* Dashboard grid */
  .dash-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 20px;
    align-items: start;
  }
  .dash-col { display: flex; flex-direction: column; gap: 20px; }

  /* Sections */
  .dash-section {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 18px;
    box-shadow: var(--shadow-sm);
  }
  .dash-section h2 {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }
  .dash-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .dash-section-header h2 { margin-bottom: 0; }
  .dash-link {
    font-size: 11px;
    font-weight: 500;
    color: var(--accent-light);
    text-decoration: none;
  }
  .dash-link:hover { color: var(--accent); }

  /* Service health grid */
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 8px;
  }
  .svc-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: inherit;
    transition: all 0.15s ease;
  }
  .svc-card:hover {
    border-color: var(--border-hover);
    background: var(--bg-hover);
    transform: translateY(-1px);
  }
  .svc-card-top {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .svc-card-name {
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .svc-card-spark {
    height: 16px;
  }
  .svc-card-spark svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .svc-card-meta {
    font-size: 10px;
    color: var(--text-muted);
  }

  /* Status dots (shared with HUD) */
  .svc-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
  .svc-dot.healthy { background: var(--low); box-shadow: 0 0 6px rgba(34,197,94,0.4); }
  .svc-dot.degraded { background: var(--high); box-shadow: 0 0 6px rgba(249,115,22,0.4); }
  .svc-dot.down { background: var(--critical); box-shadow: 0 0 6px rgba(239,68,68,0.4); }
  .svc-dot.maintenance { background: #3b82f6; }
  .svc-dot.unknown { background: var(--text-muted); }

  /* Sparklines */
  .spark-line { fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .spark-line.green { stroke: var(--low); filter: drop-shadow(0 0 3px rgba(34,197,94,0.5)); }
  .spark-line.yellow { stroke: #EAB308; filter: drop-shadow(0 0 3px rgba(234,179,8,0.5)); }
  .spark-line.red { stroke: var(--critical); filter: drop-shadow(0 0 3px rgba(239,68,68,0.5)); }

  /* Recent incidents list */
  .recent-list {
    display: flex;
    flex-direction: column;
  }
  .recent-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: all 0.15s ease;
  }
  .recent-row:last-child { border-bottom: none; }
  .recent-row:hover { transform: translateX(2px); }
  .recent-info { flex: 1; min-width: 0; }
  .recent-title {
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .recent-meta {
    font-size: 10px;
    color: var(--text-muted);
    margin-top: 1px;
  }
  .status-pip {
    font-size: 10px;
    font-weight: 500;
    padding: 2px 6px;
    border-radius: 3px;
    font-family: var(--font-mono);
    flex-shrink: 0;
  }
  .status-pip.active { color: var(--critical); background: var(--critical-dim); }
  .status-pip.investigating { color: var(--high); background: var(--high-dim); }
  .status-pip.monitoring { color: var(--medium); background: var(--medium-dim); }
  .status-pip.resolved { color: var(--resolved); background: rgba(85,85,106,0.12); }

  /* Quick actions */
  .actions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 14px 10px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text-secondary);
