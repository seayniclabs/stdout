<script>
  // Onboarding dismiss handler
  const dismissBtn = document.getElementById('onboarding-dismiss');
  const widget = document.getElementById('onboarding-widget');
  if (dismissBtn && widget) {
    dismissBtn.addEventListener('click', async () => {
      widget.style.transition = 'opacity 200ms, max-height 300ms';
      widget.style.opacity = '0';
      widget.style.maxHeight = '0';
      widget.style.overflow = 'hidden';
      widget.style.marginBottom = '0';
      try {
        const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
        await fetch('/app/api/onboarding', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
          body: JSON.stringify({ action: 'dismiss' }),
        });
      } catch {}
      setTimeout(() => widget.remove(), 300);
    });
  }

  // Update banner dismiss (client-side only — reappears next page load)
  const dismissUpdate = document.getElementById('dismissUpdate');
  const updateBanner = document.getElementById('updateBanner');
  if (dismissUpdate && updateBanner) {
    dismissUpdate.addEventListener('click', () => {
      updateBanner.style.transition = 'opacity 200ms';
      updateBanner.style.opacity = '0';
      setTimeout(() => updateBanner.remove(), 200);
    });
  }

  // Add-ons banner dismiss
  const dismissAddons = document.getElementById('dismissAddons');
  const addonsBanner = document.getElementById('addonsBanner');
  if (dismissAddons && addonsBanner) {
    dismissAddons.addEventListener('click', async () => {
      addonsBanner.style.transition = 'opacity 200ms';
      addonsBanner.style.opacity = '0';
      try {
        await fetch('/app/api/addons/dismiss', { method: 'POST' });
      } catch {}
      setTimeout(() => addonsBanner.remove(), 200);
    });
  }
</script>

