---
export const prerender = false;
// Password reset tokens live in the store's DB. Forward any direct hits there.
const storeUrl = process.env.STORE_API_URL || 'https://store.seayniclabs.com';
const token = Astro.url.searchParams.get('token') || '';
const returnTo = encodeURIComponent('https://stdout.seayniclabs.com/app/login');
const dest = token
  ? `${storeUrl}/auth/reset-password?token=${token}&return_to=${returnTo}`
  : `${storeUrl}/auth/forgot-password?return_to=${returnTo}`;
return Astro.redirect(dest, 302);
---
