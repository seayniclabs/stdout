---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getCentralDb, centralSchema } from '../../lib/db';
import { hashPassword } from '../../lib/auth';
import { logAudit, getClientIp } from '../../lib/audit';
import { validateCsrf } from '../../middleware';
import { eq } from 'drizzle-orm';

const token = Astro.url.searchParams.get('token') || '';
let error = '';
let success = false;
let validToken = false;

// Validate token
if (token) {
  const reset = getCentralDb().select().from(centralSchema.passwordResets)
    .where(eq(centralSchema.passwordResets.token, token)).get();

  if (reset && !reset.usedAt && reset.expiresAt > new Date()) {
    validToken = true;
  }
}

if (Astro.request.method === 'POST' && validToken) {
  const form = await Astro.request.formData();
  if (!validateCsrf(form.get('_csrf') as string, Astro.cookies)) {
    error = 'Invalid form submission.';
  } else {
    const password = form.get('password') as string || '';
    const confirm = form.get('confirm') as string || '';

    if (password.length < 8) {
      error = 'Password must be at least 8 characters.';
    } else if (password !== confirm) {
      error = "Passwords don't match.";
    } else {
      const reset = getCentralDb().select().from(centralSchema.passwordResets)
        .where(eq(centralSchema.passwordResets.token, token)).get();

      if (reset && !reset.usedAt && reset.expiresAt > new Date()) {
        const passwordHash = await hashPassword(password);

        // Update password
        getCentralDb().update(centralSchema.users)
          .set({ passwordHash, updatedAt: new Date() })
          .where(eq(centralSchema.users.id, reset.userId)).run();

        // Mark token as used
        getCentralDb().update(centralSchema.passwordResets)
          .set({ usedAt: new Date() })
          .where(eq(centralSchema.passwordResets.id, reset.id)).run();

        // Clear all sessions for this user (force re-login)
        getCentralDb().delete(centralSchema.sessions)
          .where(eq(centralSchema.sessions.userId, reset.userId)).run();

        logAudit('password_reset', { userId: reset.userId, ip: getClientIp(Astro.request) });
        success = true;
      } else {
        error = 'Token is invalid or expired.';
        validToken = false;
      }
    }
  }
}

if (Astro.locals.user) return Astro.redirect('/app');
---
<Layout title="Reset Password — StdOut">
  <div class="auth-page">
    <h1>Set new password</h1>

    {success ? (
      <div class="success-msg">
        <p>Your password has been reset. You can now log in with your new password.</p>
        <a href="/app/login" class="btn btn-primary" style="width: 100%;">Log in</a>
      </div>
    ) : !validToken ? (
      <div class="auth-error" style="text-align: left;">
        This reset link is invalid or has expired. <a href="/app/forgot-password">Request a new one</a>.
      </div>
    ) : (
      <>
        {error && <div class="auth-error">{error}</div>}
        <form method="POST" class="auth-form">
          <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
          <label>
            <span>New password</span>
            <input type="password" name="password" required minlength="8" autocomplete="new-password" />
          </label>
          <label>
            <span>Confirm password</span>
            <input type="password" name="confirm" required minlength="8" autocomplete="new-password" />
          </label>
          <button type="submit">Reset password</button>
        </form>
      </>
    )}
  </div>
</Layout>

<style>
  .success-msg { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; text-align: center; }
  .success-msg p { font-size: 14px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 16px; }
</style>
