---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getCentralDb, centralSchema } from '../../lib/db';
import { hashPassword } from '../../lib/auth';
import { eq, and, isNull } from 'drizzle-orm';
import { validateCsrf } from '../../middleware';
import { logAudit, getClientIp } from '../../lib/audit';

const token = Astro.url.searchParams.get('token') || '';
let error = '';
let success = false;

if (!token) {
  error = 'Invalid or missing reset token.';
} else if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const csrfToken = form.get('_csrf') as string || '';

  if (!validateCsrf(csrfToken, Astro.cookies)) {
    error = 'Invalid form submission. Please try again.';
  } else {
    const password = form.get('password') as string || '';
    const confirm = form.get('confirm') as string || '';

    if (password.length < 8) {
      error = 'Password must be at least 8 characters.';
    } else if (password !== confirm) {
      error = "Passwords don't match.";
    } else {
      const reset = getCentralDb()
        .select()
        .from(centralSchema.passwordResets)
        .where(and(
          eq(centralSchema.passwordResets.token, token),
          isNull(centralSchema.passwordResets.usedAt),
        ))
        .get();

      if (!reset || reset.expiresAt.getTime() < Date.now()) {
        error = 'This reset link is invalid or has expired.';
      } else {
        const passwordHash = await hashPassword(password);
        const now = new Date();
        getCentralDb().update(centralSchema.users)
          .set({ passwordHash, updatedAt: now })
          .where(eq(centralSchema.users.id, reset.userId))
          .run();
        getCentralDb().update(centralSchema.passwordResets)
          .set({ usedAt: now })
          .where(eq(centralSchema.passwordResets.id, reset.id))
          .run();
        logAudit('password_reset', { userId: reset.userId, ip: getClientIp(Astro.request) });
        success = true;
      }
    }
  }
}
---
<Layout title="Reset password — StdOut">
  <div class="auth-page">
    <h1>Choose a new password</h1>

    {error && <div class="auth-error">{error}</div>}
    {success ? (
      <>
        <p class="auth-subtitle">Your password has been updated.</p>
        <p class="auth-switch"><a href="/app/login">Sign in</a></p>
      </>
    ) : token && !error ? (
      <form method="POST" class="auth-form">
        <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
        <label>
          <span>New password</span>
          <input type="password" name="password" required minlength="8" autocomplete="new-password" />
        </label>
        <label>
          <span>Confirm password</span>
          <input type="password" name="confirm" required minlength="8" autocomplete="new-password" />
        </label>
        <button type="submit">Update password</button>
      </form>
    ) : (
      <p class="auth-switch"><a href="/app/forgot-password">Request a new link</a></p>
    )}
  </div>
</Layout>
