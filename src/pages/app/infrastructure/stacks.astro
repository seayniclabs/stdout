---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { getDb, schema } from '../../../lib/db';
import { eq } from 'drizzle-orm';

const session = Astro.locals.user;
if (!session) return Astro.redirect('/app/login');

const db = getDb();

const stacks = db.select().from(schema.stacks)
  .where(eq(schema.stacks.source, 'auto'))
  .all();

const satellites = db.select().from(schema.satellites).all();

const lastDiscoveryRun = db.select().from(schema.systemState)
  .where(eq(schema.systemState.key, 'last_discovery_run'))
  .get()?.updatedAt;

const hosts = db.select().from(schema.discoveredHosts).all();
const totalEntities = hosts.length + stacks.length + satellites.length;

function timeAgo(timestamp: number): string {
  const seconds = Math.floor((Date.now() - timestamp) / 1000);
  if (seconds < 60) return 'just now';
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return `${minutes}m ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  return `${days}d ago`;
}
---

<Layout title="Infrastructure Stacks — StdOut">
  <main class="infrastructure-page">
    <div class="auto-banner">
      <div class="auto-icon">🤖</div>
      <div class="auto-content">
        <h2>Riggins is continuously monitoring your infrastructure</h2>
        <div class="auto-meta">
          <span class="highlight">{totalEntities} entities discovered</span> •
          <span class="highlight">{stacks.length} stacks auto-created</span> •
          Last scan: {lastDiscoveryRun ? timeAgo(lastDiscoveryRun) : 'Never'}
        </div>
      </div>
    </div>

    <div class="tabs">
      <a href="/app/infrastructure/discovery" class="tab">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        Discovery
      </a>
      <a href="/app/infrastructure/stacks" class="tab active">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>
        </svg>
        Stacks ({stacks.length})
      </a>
      <a href="/app/infrastructure/satellites" class="tab">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6M1 12h6m6 0h6"/>
        </svg>
        Satellites ({satellites.length})
      </a>
      <a href="/app/infrastructure/topology" class="tab">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"/><path d="M12 2v4m0 12v4M2 12h4m12 0h4"/><circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
        </svg>
        Topology Map
      </a>
    </div>

    <!-- Stacks Content -->
    {stacks.length === 0 ? (
      <div class="empty-state">
        <div class="empty-icon">📦</div>
        <h3>Stacks auto-create from discovered entities</h3>
        <p>Once Riggins discovers services, it automatically creates stack manifests (JSON definitions).</p>
      </div>
    ) : (
      <div class="stacks-grid">
        {stacks.map(stack => (
          <div class="stack-card">
            <div class="stack-header">
              <h3>{stack.name}</h3>
              <span class="auto-badge">Auto-created</span>
            </div>
            <p class="stack-description">{stack.description || 'No description'}</p>
            <div class="stack-footer">
              <span class="stack-count">{stack.serviceCount || 0} services</span>
              <a href={`/app/stacks/${stack.id}`} class="btn-text">View →</a>
            </div>
          </div>
        ))}
      </div>
    )}
  </main>
</Layout>

<style>
  .infrastructure-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 24px;
  }

  .auto-banner {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(16, 185, 129, 0.05));
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .auto-icon {
    font-size: 32px;
    flex-shrink: 0;
  }

  .auto-content h2 {
    font-size: 18px;
    margin: 0 0 4px 0;
  }

  .auto-meta {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .auto-meta .highlight {
    color: var(--success);
    font-weight: 600;
  }

  .tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0;
  }

  .tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-secondary);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .tab.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
  }

  .empty-state {
    text-align: center;
    padding: 64px 32px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .empty-icon {
    font-size: 64px;
    margin-bottom: 16px;
  }

  .empty-state h3 {
    font-size: 20px;
    margin-bottom: 8px;
  }

  .empty-state p {
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .stacks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }

  .stack-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    transition: all 0.2s ease;
  }

  .stack-card:hover {
    border-color: var(--primary);
  }

  .stack-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .stack-header h3 {
    font-size: 18px;
    margin: 0;
  }

  .auto-badge {
    padding: 4px 8px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 4px;
    color: var(--success);
    font-size: 11px;
    font-weight: 600;
  }

  .stack-description {
    color: var(--text-secondary);
    font-size: 14px;
    margin-bottom: 16px;
  }

  .stack-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .stack-count {
    font-size: 13px;
    color: var(--text-secondary);
  }

  .btn-text {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
  }

  .btn-text:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .infrastructure-page {
      padding: 16px;
    }

    .tab {
      white-space: nowrap;
    }

    .stacks-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
