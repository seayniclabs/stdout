---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { requireLicense } from '../../lib/license';
import { getDiscoveredApps } from '../../lib/discovery/passive-discovery';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login');

// License check
const licenseCheck = requireLicense();
if (!licenseCheck.valid) {
  return Astro.redirect('/app/settings?error=' + encodeURIComponent(licenseCheck.message));
}

// Get discovered applications
const apps = getDiscoveredApps();

// Group by type
const dockerApps = apps.filter(a => a.type === 'docker');
const systemdApps = apps.filter(a => a.type === 'systemd');
const processApps = apps.filter(a => a.type === 'process');
const manualApps = apps.filter(a => a.type === 'manual');
---
<Layout title="Discovery — StdOut">
  <div class="discovery-page">
    <div class="page-header">
      <div>
        <h1>Application Discovery</h1>
        <p class="subtitle">Automatically discovered infrastructure and services</p>
      </div>
      <div class="header-actions">
        <button id="scanBtn" class="btn-glass btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          Scan Now
        </button>
        <button id="addManualBtn" class="btn-glass">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          Add Manually
        </button>
      </div>
    </div>

    <div class="discovery-stats">
      <div class="stat-card">
        <div class="stat-icon docker">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <path d="M9 9h6v6H9z"/>
          </svg>
        </div>
        <div class="stat-content">
          <div class="stat-value">{dockerApps.length}</div>
          <div class="stat-label">Docker Containers</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon systemd">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 6v6l4 2"/>
          </svg>
        </div>
        <div class="stat-content">
          <div class="stat-value">{systemdApps.length}</div>
          <div class="stat-label">Systemd Services</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon process">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v20M2 12h20"/>
          </svg>
        </div>
        <div class="stat-content">
          <div class="stat-value">{processApps.length}</div>
          <div class="stat-label">Network Processes</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon manual">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12h14"/>
          </svg>
        </div>
        <div class="stat-content">
          <div class="stat-value">{manualApps.length}</div>
          <div class="stat-label">Manual Entries</div>
        </div>
      </div>
    </div>

    <div class="apps-grid">
      {dockerApps.length > 0 && (
        <div class="app-section">
          <h2>Docker Containers</h2>
          <div class="apps-list">
            {dockerApps.map(app => (
              <div class="app-card docker" data-app-id={app.id}>
                <div class="app-header">
                  <div class="app-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                    </svg>
                  </div>
                  <div class="app-info">
                    <div class="app-name">{app.name}</div>
                    <div class="app-meta">{app.metadata.image || 'Unknown image'}</div>
                  </div>
                  <div class="app-status discovered">{app.status}</div>
                </div>
                <div class="app-details">
                  <div class="detail-row">
                    <span class="detail-label">Container ID:</span>
                    <span class="detail-value">{app.metadata.containerId?.slice(0, 12)}</span>
                  </div>
                  <div class="detail-row">
                    <span class="detail-label">Type:</span>
                    <span class="detail-value">{app.metadata.appType || 'unknown'}</span>
                  </div>
                  <div class="detail-row">
                    <span class="detail-label">Log Source:</span>
                    <span class="detail-value">{app.logSource || 'not configured'}</span>
                  </div>
                </div>
                <div class="app-actions">
                  <button class="btn-sm btn-glass configure-btn" data-app-id={app.id}>Configure Logs</button>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {systemdApps.length > 0 && (
        <div class="app-section">
          <h2>Systemd Services</h2>
          <div class="apps-list">
            {systemdApps.map(app => (
              <div class="app-card systemd" data-app-id={app.id}>
                <div class="app-header">
                  <div class="app-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"/>
                      <path d="M12 6v6l4 2"/>
                    </svg>
                  </div>
                  <div class="app-info">
                    <div class="app-name">{app.name}</div>
                    <div class="app-meta">{app.metadata.description || ''}</div>
                  </div>
                  <div class="app-status discovered">{app.status}</div>
                </div>
                <div class="app-details">
                  <div class="detail-row">
                    <span class="detail-label">Service:</span>
                    <span class="detail-value">{app.metadata.serviceName}</span>
                  </div>
                  <div class="detail-row">
                    <span class="detail-label">Log Source:</span>
                    <span class="detail-value">{app.logSource || 'journalctl'}</span>
                  </div>
                </div>
                <div class="app-actions">
                  <button class="btn-sm btn-glass configure-btn" data-app-id={app.id}>Configure Logs</button>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {processApps.length > 0 && (
        <div class="app-section">
          <h2>Network Processes</h2>
          <div class="apps-list">
            {processApps.map(app => (
              <div class="app-card process" data-app-id={app.id}>
                <div class="app-header">
                  <div class="app-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 2v20M2 12h20"/>
                    </svg>
                  </div>
                  <div class="app-info">
                    <div class="app-name">{app.name}</div>
                    <div class="app-meta">Port {app.port}</div>
                  </div>
                  <div class="app-status discovered">{app.status}</div>
                </div>
                <div class="app-details">
                  <div class="detail-row">
                    <span class="detail-label">Process:</span>
                    <span class="detail-value">{app.metadata.processName}</span>
                  </div>
                  <div class="detail-row">
                    <span class="detail-label">Port:</span>
                    <span class="detail-value">{app.port}</span>
                  </div>
                </div>
                <div class="app-actions">
                  <button class="btn-sm btn-glass configure-btn" data-app-id={app.id}>Configure Logs</button>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {apps.length === 0 && (
        <div class="empty-state">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <h3>No Applications Discovered</h3>
          <p>Run a discovery scan to find Docker containers, systemd services, and network processes.</p>
          <button class="btn-glass btn-primary" onclick="document.getElementById('scanBtn').click()">
            Run Discovery Scan
          </button>
        </div>
      )}
    </div>
  </div>

  <style>
    .discovery-page {
      padding: 2rem;
      max-width: 1400px;
      margin: 0 auto;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 2rem;
    }

    .page-header h1 {
      margin: 0 0 0.5rem 0;
      font-size: 2rem;
      font-weight: 700;
    }

    .subtitle {
      margin: 0;
      color: rgba(255,255,255,0.6);
    }

    .header-actions {
      display: flex;
      gap: 1rem;
    }

    .discovery-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .stat-card {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .stat-icon {
      width: 48px;
      height: 48px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .stat-icon.docker { background: rgba(33, 150, 243, 0.2); color: #2196F3; }
    .stat-icon.systemd { background: rgba(76, 175, 80, 0.2); color: #4CAF50; }
    .stat-icon.process { background: rgba(255, 152, 0, 0.2); color: #FF9800; }
    .stat-icon.manual { background: rgba(156, 39, 176, 0.2); color: #9C27B0; }

    .stat-value {
      font-size: 2rem;
      font-weight: 700;
      line-height: 1;
    }

    .stat-label {
      font-size: 0.875rem;
      color: rgba(255,255,255,0.6);
      margin-top: 0.25rem;
    }

    .app-section {
      margin-bottom: 2rem;
    }

    .app-section h2 {
      margin: 0 0 1rem 0;
      font-size: 1.25rem;
      font-weight: 600;
    }

    .apps-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 1rem;
    }

    .app-card {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      padding: 1.5rem;
      transition: all 0.2s;
    }

    .app-card:hover {
      border-color: rgba(255,255,255,0.2);
      transform: translateY(-2px);
    }

    .app-card.docker { border-left: 3px solid #2196F3; }
    .app-card.systemd { border-left: 3px solid #4CAF50; }
    .app-card.process { border-left: 3px solid #FF9800; }
    .app-card.manual { border-left: 3px solid #9C27B0; }

    .app-header {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
      margin-bottom: 1rem;
    }

    .app-icon {
      width: 40px;
      height: 40px;
      border-radius: 8px;
      background: rgba(255,255,255,0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .app-info {
      flex: 1;
      min-width: 0;
    }

    .app-name {
      font-weight: 600;
      font-size: 1.125rem;
      margin-bottom: 0.25rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .app-meta {
      font-size: 0.875rem;
      color: rgba(255,255,255,0.6);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .app-status {
      padding: 0.25rem 0.75rem;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
    }

    .app-status.discovered {
      background: rgba(76, 175, 80, 0.2);
      color: #4CAF50;
    }

    .app-status.configuring {
      background: rgba(255, 152, 0, 0.2);
      color: #FF9800;
    }

    .app-status.active {
      background: rgba(33, 150, 243, 0.2);
      color: #2196F3;
    }

    .app-details {
      margin: 1rem 0;
      padding: 1rem;
      background: rgba(0,0,0,0.2);
      border-radius: 8px;
    }

    .detail-row {
      display: flex;
      justify-content: space-between;
      padding: 0.5rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .detail-row:last-child {
      border-bottom: none;
    }

    .detail-label {
      color: rgba(255,255,255,0.6);
      font-size: 0.875rem;
    }

    .detail-value {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.875rem;
    }

    .app-actions {
      display: flex;
      gap: 0.5rem;
    }

    .btn-sm {
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
    }

    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      color: rgba(255,255,255,0.6);
    }

    .empty-state svg {
      opacity: 0.3;
      margin-bottom: 1rem;
    }

    .empty-state h3 {
      margin: 1rem 0 0.5rem 0;
      color: rgba(255,255,255,0.8);
    }

    .empty-state p {
      margin: 0 0 2rem 0;
    }
  </style>

  <script>
    // Scan button
    document.getElementById('scanBtn')?.addEventListener('click', async () => {
      const btn = document.getElementById('scanBtn') as HTMLButtonElement;
      if (!btn) return;

      btn.disabled = true;
      btn.textContent = 'Scanning...';

      try {
        const response = await fetch('/app/api/discovery/scan', {
          method: 'POST',
        });

        if (!response.ok) throw new Error('Scan failed');

        const data = await response.json();

        // Reload page to show new discoveries
        window.location.reload();
      } catch (error) {
        console.error('Discovery scan failed:', error);
        alert('Discovery scan failed. Check console for details.');
        btn.disabled = false;
        btn.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          Scan Now
        `;
      }
    });

    // Configure buttons
    document.querySelectorAll('.configure-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const appId = (e.target as HTMLElement).getAttribute('data-app-id');
        alert(`Log configuration UI coming soon for app: ${appId}`);
      });
    });

    // Add manual button
    document.getElementById('addManualBtn')?.addEventListener('click', () => {
      alert('Manual application entry UI coming soon');
    });
  </script>
</Layout>
