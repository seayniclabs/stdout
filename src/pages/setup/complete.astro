---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
// import { getSession } from '../../lib/auth';
import { getSetupProgress, completeStep, SetupStep, getSetupConfig } from '../../lib/setup';

const session = Astro.locals.user;
if (!session) return Astro.redirect('/app/login');

const progress = await getSetupProgress();

// Complete final steps if not already done
if (progress.currentStep === SetupStep.Scanner) {
  // Skip review and windlass for now, mark them complete
  await completeStep(SetupStep.Review, { skipped: true });
  await completeStep(SetupStep.Windlass, { skipped: true });
  await completeStep(SetupStep.Complete, { completedAt: new Date().toISOString() });
}

const environmentName = await getSetupConfig('environment_name');
---

<Layout title="Setup Complete!">
  <div class="auth-page" style="max-width: 700px; text-align: center;">
    <div class="success-icon">✓</div>

    <h1 style="margin-top: 1rem;">Setup Complete!</h1>
    <p class="auth-subtitle">Your StdOut incident companion is ready</p>

    <div class="setup-summary">
      <h3>Environment: {environmentName || 'StdOut'}</h3>
      <p>Your infrastructure monitoring and incident tracking system is now active.</p>

      <div class="next-steps">
        <h4>What's Next:</h4>
        <ul>
          <li>View your discovered infrastructure at <strong>Infrastructure → Stacks</strong></li>
          <li>Create your first incident at <strong>Incidents</strong></li>
          <li>Monitor service health in <strong>HUD</strong></li>
          <li>Build your runbook in <strong>Docs</strong></li>
        </ul>
      </div>
    </div>

    <div class="setup-actions">
      <a href="/app" class="btn-primary" style="display: inline-block; padding: 0.75rem 2rem; text-decoration: none;">
        Go to Dashboard →
      </a>
    </div>
  </div>
</Layout>

<style>
  .success-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--color-success, #28a745);
    color: white;
    font-size: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 2rem auto 0;
  }

  .setup-summary {
    margin: 2rem 0;
    padding: 2rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    text-align: left;
  }

  .setup-summary h3 {
    margin-top: 0;
    color: var(--color-primary);
  }

  .next-steps {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .next-steps h4 {
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .next-steps ul {
    margin: 0;
    padding-left: 1.5rem;
    text-align: left;
  }

  .next-steps li {
    margin: 0.5rem 0;
  }

  .setup-actions {
    margin-top: 2rem;
  }
</style>
