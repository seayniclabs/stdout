---
export const prerender = false;
import Layout from '../../layouts/SetupLayout.astro';
import { getSetupProgress, completeStep, SetupStep, getSetupConfig } from '../../lib/setup';
const session = Astro.locals.user;
if (!session) return Astro.redirect('/app/login');

const progress = await getSetupProgress();

// Mark setup as complete if we're on the final step
if (progress.currentStep >= SetupStep.Complete && !progress.steps[SetupStep.Complete]?.completed) {
  await completeStep(SetupStep.Complete, { completedAt: new Date().toISOString() });
}

const environmentName = await getSetupConfig('environment_name');

// Gather setup summary data (TODO: implement stacks/containers schema)
const stacks = [];
const containers = [];
const licenseActivated = progress.steps[SetupStep.License]?.completed && !progress.steps[SetupStep.License]?.data?.skipped;
const windlassEnabled = progress.steps[SetupStep.Windlass]?.data?.enabled || false;
---

<Layout title="Setup Complete!">
  <div class="auth-page" style="max-width: 700px; text-align: center;">
    <div class="success-icon">✓</div>

    <h1 style="margin-top: 1rem;">Setup Complete!</h1>
    <p class="auth-subtitle">Your StdOut incident companion is ready</p>

    <div class="setup-summary">
      <h3>Environment: {environmentName || 'StdOut'}</h3>

      <div class="summary-grid">
        <div class="summary-item">
          <span class="summary-label">👤 Admin Account</span>
          <span class="summary-value">{session.email}</span>
        </div>

        <div class="summary-item">
          <span class="summary-label">🔑 License</span>
          <span class="summary-value">{licenseActivated ? 'Activated' : 'Not Activated'}</span>
        </div>

        <div class="summary-item">
          <span class="summary-label">📦 Infrastructure</span>
          <span class="summary-value">
            {stacks.length > 0
              ? `${stacks.length} stack(s), ${containers.length} container(s)`
              : 'No services discovered'}
          </span>
        </div>

        <div class="summary-item">
          <span class="summary-label">⏰ Windlass</span>
          <span class="summary-value">{windlassEnabled ? 'Enabled' : 'Disabled'}</span>
        </div>
      </div>

      <div class="next-steps">
        <h4>What's Next:</h4>
        <ul>
          {stacks.length > 0 ? (
            <li>View your discovered infrastructure at <strong>Infrastructure → Stacks</strong></li>
          ) : (
            <li>Add your first stack at <strong>Infrastructure → Add Stack</strong></li>
          )}
          <li>Create your first incident at <strong>Incidents</strong></li>
          <li>Monitor service health in <strong>HUD</strong></li>
          <li>Build your runbook in <strong>Docs</strong></li>
          {!licenseActivated && (
            <li>Activate your license in <strong>Settings → License</strong> to unlock Pro features</li>
          )}
        </ul>
      </div>
    </div>

    <div class="setup-actions">
      <a href="/app" class="btn-primary" style="display: inline-block; padding: 0.75rem 2rem; text-decoration: none;">
        Go to Dashboard →
      </a>
    </div>
  </div>
</Layout>

<style>
  .success-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--color-success, #28a745);
    color: white;
    font-size: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 2rem auto 0;
  }

  .setup-summary {
    margin: 2rem 0;
    padding: 2rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    text-align: left;
  }

  .setup-summary h3 {
    margin: 0 0 1.5rem 0;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-primary);
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .summary-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    background: var(--color-bg-subtle);
    border-radius: 8px;
  }

  .summary-label {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .summary-value {
    font-size: 0.875rem;
    color: var(--color-text);
    font-family: var(--font-mono);
  }

  .next-steps {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .next-steps h4 {
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .next-steps ul {
    margin: 0;
    padding-left: 1.5rem;
    text-align: left;
  }

  .next-steps li {
    margin: 0.5rem 0;
  }

  .setup-actions {
    margin-top: 2rem;
  }
</style>
