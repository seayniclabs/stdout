---
export const prerender = false;
import Layout from '../../layouts/SetupLayout.astro';
import SetupProgress from '../../components/SetupProgress.astro';
import { getSetupProgress, SetupStep, getSetupConfig } from '../../lib/setup';

const session = Astro.locals.user;
if (!session) return Astro.redirect('/app/login');

const progress = await getSetupProgress();
if (progress.currentStep !== SetupStep.Scanner) {
  if (progress.currentStep < SetupStep.Scanner) return Astro.redirect('/setup');
  return Astro.redirect('/setup/complete');
}

// Get scanner token from setup config (auto-created during account creation)
const scannerToken = await getSetupConfig('scanner_token');
console.log('[scanner] Retrieved scanner token from setup_config:', scannerToken ? (scannerToken.substring(0, 30) + '...') : 'NULL');
---

<Layout title="Discover Infrastructure">
  <div class="auth-page" style="max-width: 800px;">
    <SetupProgress currentStep={4} totalSteps={8} />

    <h1>Discover Your Infrastructure</h1>
    <p class="auth-subtitle">Scan your network to discover hosts and services</p>

    <div class="scanner-card">
      <div class="scanner-status" id="scannerStatus">
        <div class="status-icon">📡</div>
        <p class="status-text">Ready to scan</p>
      </div>

      <div class="scanner-info">
        <h3>Network Scan</h3>
        <p>Scan your local network to discover hosts and running services.</p>
        <div class="input-group" style="margin-top: 1rem;">
          <label for="subnet">Subnet to scan:</label>
          <input
            type="text"
            id="subnet"
            value="192.168.0.0/24"
            placeholder="192.168.0.0/24"
            class="form-input"
          />
          <p class="help-text">Common subnets: 192.168.0.0/24, 192.168.1.0/24, 10.0.0.0/24</p>
        </div>
      </div>

      <div class="scanner-actions">
        <button id="scanButton" class="btn-primary">
          <span id="scanButtonText">Start Network Scan</span>
        </button>
        <form method="POST" action="/setup/complete-scanner" style="display: inline;">
          <button type="submit" name="action" value="skip" class="btn-secondary">Skip for Now</button>
        </form>
      </div>

      <div id="scanProgress" class="scan-progress" style="display: none;">
        <div class="progress-bar">
          <div id="progressFill" class="progress-fill"></div>
        </div>
        <div id="scanLogs" class="scan-logs"></div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .scanner-card {
    margin: 2rem 0;
    padding: 2rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .scanner-status {
    text-align: center;
    padding: 2rem;
  }

  .status-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .status-text {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .scanner-info {
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--color-bg-subtle);
    border-radius: 8px;
  }

  .scanner-info h3 {
    margin: 0 0 1rem 0;
    font-size: 1rem;
  }

  .scanner-info ul {
    margin: 0;
    padding-left: 1.5rem;
  }

  .scanner-info li {
    margin: 0.5rem 0;
  }

  .scanner-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    justify-content: center;
  }

  .scanner-actions button {
    min-width: 200px;
  }

  .scan-progress {
    margin-top: 2rem;
  }

  .progress-bar {
    width: 100%;
    height: 8px;
    background: var(--color-bg-subtle);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .progress-fill {
    height: 100%;
    background: var(--color-primary);
    transition: width 0.3s ease;
    width: 0%;
  }

  .scan-logs {
    max-height: 200px;
    overflow-y: auto;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .scan-logs p {
    margin: 0.25rem 0;
    color: var(--color-text-muted);
  }

  .scan-logs p.success {
    color: var(--color-success);
  }

  .scan-logs p.error {
    color: var(--color-danger);
  }

  .input-group {
    margin: 1rem 0;
  }

  .input-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .form-input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-input-bg, white);
    color: var(--color-text);
    font-size: 1rem;
    font-family: var(--font-mono);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  .help-text {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>

<script>
  const scanButton = document.getElementById('scanButton');
  const subnetInput = document.getElementById('subnet');

  scanButton.addEventListener('click', async () => {
    const subnet = subnetInput.value.trim();
    if (!subnet) {
      alert('Please enter a subnet');
      return;
    }

    const scanButtonText = document.getElementById('scanButtonText');
    const scanProgress = document.getElementById('scanProgress');
    const progressFill = document.getElementById('progressFill');
    const scanLogs = document.getElementById('scanLogs');
    const statusIcon = document.querySelector('.status-icon');
    const statusText = document.querySelector('.status-text');

    // Disable button
    scanButton.disabled = true;
    scanButtonText.textContent = 'Scanning...';

    // Show progress
    scanProgress.style.display = 'block';
    statusIcon.textContent = '⏳';
    statusText.textContent = 'Scanning network...';

    // Clear previous logs
    scanLogs.innerHTML = '';

    try {
      const response = await fetch('/app/api/network/scan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ subnet }),
      });

      const reader = response.body?.getReader();
      const decoder = new TextDecoder();

      if (!reader) throw new Error('No response stream');

      let discoveredHosts = [];

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        const chunk = decoder.decode(value);
        const lines = chunk.split('\n').filter(l => l.trim());

        for (const line of lines) {
          try {
            const event = JSON.parse(line);

            if (event.type === 'progress') {
              progressFill.style.width = `${event.percent}%`;
            } else if (event.type === 'log') {
              const logEntry = document.createElement('p');
              logEntry.textContent = event.message;
              if (event.level === 'success') logEntry.className = 'success';
              if (event.level === 'error') logEntry.className = 'error';
              scanLogs.appendChild(logEntry);
              scanLogs.scrollTop = scanLogs.scrollHeight;
            } else if (event.type === 'complete') {
              discoveredHosts = event.hosts || [];
              statusIcon.textContent = '✅';
              statusText.textContent = `Found ${discoveredHosts.length} host(s)`;
              progressFill.style.width = '100%';

              // Auto-import discovered hosts
              if (discoveredHosts.length > 0) {
                const importLog = document.createElement('p');
                importLog.textContent = 'Importing discovered hosts...';
                scanLogs.appendChild(importLog);

                try {
                  const importResponse = await fetch('/app/api/network/import', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ hosts: discoveredHosts }),
                  });

                  const importResult = await importResponse.json();

                  if (importResponse.ok) {
                    const successLog = document.createElement('p');
                    successLog.className = 'success';
                    successLog.textContent = `Imported ${importResult.imported.hosts} host(s), ${importResult.imported.services} service(s)`;
                    scanLogs.appendChild(successLog);
                  }
                } catch (importError) {
                  const errorLog = document.createElement('p');
                  errorLog.className = 'error';
                  errorLog.textContent = `Import failed: ${importError.message}`;
                  scanLogs.appendChild(errorLog);
                }
              }

              // Auto-advance after 2 seconds
              setTimeout(() => {
                window.location.href = '/setup/review';
              }, 2000);
            } else if (event.type === 'error') {
              statusIcon.textContent = '⚠️';
              statusText.textContent = 'Scan failed';
              const errorLog = document.createElement('p');
              errorLog.className = 'error';
              errorLog.textContent = `Error: ${event.message}`;
              scanLogs.appendChild(errorLog);
              scanButton.disabled = false;
              scanButtonText.textContent = 'Retry Scan';
            }
          } catch (e) {
            console.error('Failed to parse event:', line, e);
          }
        }
      }
    } catch (error) {
      statusIcon.textContent = '⚠️';
      statusText.textContent = 'Scan failed';
      const errorLog = document.createElement('p');
      errorLog.className = 'error';
      errorLog.textContent = `Error: ${error.message}`;
      scanLogs.appendChild(errorLog);
      scanButton.disabled = false;
      scanButtonText.textContent = 'Retry Scan';
    }
  });
</script>
