---
export const prerender = false;
import Layout from '../../layouts/SetupLayout.astro';
import SetupProgress from '../../components/SetupProgress.astro';
import { getSetupProgress, completeStep, SetupStep } from '../../lib/setup';

const session = Astro.locals.user;
if (!session) return Astro.redirect('/app/login');

const progress = await getSetupProgress();
if (progress.currentStep !== SetupStep.Windlass) {
  if (progress.currentStep < SetupStep.Windlass) return Astro.redirect('/setup');
  return Astro.redirect('/setup/complete');
}

let enableWindlass = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  enableWindlass = form.get('enableWindlass') === 'true';

  await completeStep(SetupStep.Windlass, {
    enabled: enableWindlass,
    configuredAt: new Date().toISOString(),
  });

  return Astro.redirect('/setup/complete');
}
---

<Layout title="Configure Windlass">
  <div class="auth-page" style="max-width: 800px;">
    <SetupProgress currentStep={6} totalSteps={7} />

    <h1>Configure Windlass</h1>
    <p class="auth-subtitle">Schedule-aware Docker service management (optional)</p>

    <div class="windlass-card">
      <div class="windlass-info">
        <h3>What is Windlass?</h3>
        <p>Windlass is a schedule-aware Docker service manager that can automatically start and stop services based on your schedule. Perfect for:</p>
        <ul>
          <li><strong>Development stacks</strong> — Stop resource-heavy services outside work hours</li>
          <li><strong>Testing environments</strong> — Shut down at night, start in the morning</li>
          <li><strong>Cost optimization</strong> — Reduce power consumption for homelab servers</li>
          <li><strong>Maintenance windows</strong> — Coordinate service restarts safely</li>
        </ul>

        <div class="windlass-example">
          <h4>Example Schedule:</h4>
          <div class="schedule-item">
            <span class="schedule-time">8:00 AM</span>
            <span class="schedule-arrow">→</span>
            <span class="schedule-action">Start dev-stack (PostgreSQL, Redis, API)</span>
          </div>
          <div class="schedule-item">
            <span class="schedule-time">6:00 PM</span>
            <span class="schedule-arrow">→</span>
            <span class="schedule-action">Stop dev-stack</span>
          </div>
        </div>
      </div>

      <form method="POST" class="windlass-form">
        <div class="windlass-options">
          <label class="option-card">
            <input type="radio" name="enableWindlass" value="true" />
            <div class="option-content">
              <div class="option-icon">✓</div>
              <h4>Enable Windlass</h4>
              <p>I want schedule-aware service management. I'll configure schedules from the dashboard.</p>
            </div>
          </label>

          <label class="option-card">
            <input type="radio" name="enableWindlass" value="false" checked />
            <div class="option-content">
              <div class="option-icon">⏭</div>
              <h4>Skip for Now</h4>
              <p>I don't need scheduled service management. I can enable this later from Settings.</p>
            </div>
          </label>
        </div>

        <div class="windlass-note">
          <strong>Note:</strong> Windlass is optional. You can always enable it later from Settings → Windlass.
        </div>

        <div class="windlass-actions">
          <a href="/setup/review" class="btn-secondary">← Back to Review</a>
          <button type="submit" class="btn-primary">Continue →</button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<style>
  .windlass-card {
    margin: 2rem 0;
    padding: 2rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .windlass-info {
    margin-bottom: 2rem;
  }

  .windlass-info h3 {
    margin: 0 0 1rem 0;
    font-size: 1.25rem;
  }

  .windlass-info p {
    margin-bottom: 1rem;
    color: var(--color-text-muted);
  }

  .windlass-info ul {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .windlass-info li {
    margin: 0.5rem 0;
  }

  .windlass-example {
    margin-top: 1.5rem;
    padding: 1rem;
    background: var(--color-bg-subtle);
    border-radius: 8px;
  }

  .windlass-example h4 {
    margin: 0 0 0.75rem 0;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .schedule-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0.5rem 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .schedule-time {
    font-weight: 600;
    color: var(--color-primary);
  }

  .schedule-arrow {
    color: var(--color-text-muted);
  }

  .schedule-action {
    color: var(--color-text);
  }

  .windlass-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .windlass-options {
    display: grid;
    gap: 1rem;
  }

  .option-card {
    display: block;
    padding: 1.5rem;
    background: var(--color-bg-subtle);
    border: 2px solid var(--color-border);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .option-card:hover {
    border-color: var(--color-primary);
    background: var(--color-card-bg);
  }

  .option-card input[type="radio"] {
    display: none;
  }

  .option-card input[type="radio"]:checked + .option-content {
    opacity: 1;
  }

  .option-card input[type="radio"]:not(:checked) + .option-content {
    opacity: 0.6;
  }

  .option-card input[type="radio"]:checked ~ * {
    border-color: var(--color-primary);
  }

  .option-content {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
  }

  .option-icon {
    font-size: 2rem;
    grid-row: 1 / 3;
  }

  .option-content h4 {
    margin: 0;
    font-size: 1rem;
  }

  .option-content p {
    margin: 0.5rem 0 0 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    grid-column: 2;
  }

  .windlass-note {
    padding: 1rem;
    background: var(--color-info-bg, #d1ecf1);
    border: 1px solid var(--color-info, #0c5460);
    border-radius: 6px;
    font-size: 0.875rem;
  }

  .windlass-actions {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
  }

  .btn-secondary, .btn-primary {
    flex: 1;
    max-width: 250px;
  }
</style>
