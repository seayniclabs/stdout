---
export const prerender = false;
import Layout from '../../layouts/SetupLayout.astro';
import SetupProgress from '../../components/SetupProgress.astro';
import { getSetupProgress, completeStep, SetupStep, setSetupConfig } from '../../lib/setup';
import { getDb, schema } from '../../lib/db';
import { createSession, SESSION_COOKIE, sessionCookieOptions, hashPassword } from '../../lib/auth';
import { validateCsrf } from '../../middleware';
import { nanoid } from 'nanoid';
import { eq } from 'drizzle-orm';
import crypto from 'node:crypto';
import { logAudit, getClientIp } from '../../lib/audit';

// If user is already logged in and setup is past step 1, redirect to current step
const session = Astro.locals.user;
const progress = await getSetupProgress();

if (session && progress.currentStep > SetupStep.AdminAccount) {
  // User has an account, redirect to their current step
  if (progress.currentStep === SetupStep.Environment) return Astro.redirect('/setup/environment');
  if (progress.currentStep === SetupStep.License) return Astro.redirect('/setup/license');
  if (progress.currentStep >= SetupStep.Complete) return Astro.redirect('/app');
}

let error = '';
let emailVal = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const csrfToken = form.get('_csrf') as string || '';

  if (!validateCsrf(csrfToken, Astro.cookies)) {
    error = 'Invalid form submission. Please try again.';
  } else {
    const email = (form.get('email') as string || '').trim().toLowerCase();
    const password = form.get('password') as string || '';
    const displayName = (form.get('displayName') as string || '').trim();
    const licenseKey = (form.get('licenseKey') as string || '').trim();
    emailVal = email;

    if (!email || !password || !displayName || !licenseKey) {
      error = 'All fields are required.';
    } else if (password.length < 8) {
      error = 'Password must be at least 8 characters.';
    } else if (!licenseKey.match(/^SL-/)) {
      error = 'Invalid license key format. License keys start with SL-';
    } else {
      // Check if user already exists
      const db = getDb();
      const existingUser = db
        .select()
        .from(schema.users)
        .where(eq(schema.users.email, email))
        .get();

      if (existingUser) {
        error = 'An account with this email already exists.';
      } else {
          // Create user
          const userId = 'usr_' + nanoid(32);
          const passwordHash = await hashPassword(password);
          const now = new Date();

          db.insert(schema.users).values({
            id: userId,
            email,
            passwordHash,
            displayName,
            role: 'superadmin',
            createdAt: now,
            updatedAt: now,
          }).run();

        // Auto-create scanner token so scanner works during setup
        const rawToken = `stdout_scan_${nanoid(32)}`;
        const tokenHash = crypto.createHash('sha256').update(rawToken).digest('hex');
        const expiresAt = new Date(now.getTime() + 90 * 24 * 60 * 60 * 1000); // 90 days

        db.insert(schema.apiTokens).values({
          id: nanoid(),
          userId: userId,
          name: 'Scanner (Auto-created during setup)',
          tokenHash,
          expiresAt,
          createdAt: now,
        }).run();

        // Store raw token in setup_config so scanner can use it
        console.log('[setup] Auto-creating scanner token:', rawToken.substring(0, 30) + '...');
        await setSetupConfig('scanner_token', rawToken);
        console.log('[setup] Scanner token saved to setup_config');

        // Auto-generate environment settings (skip environment step)
        const hostname = Astro.url.hostname;
        const environmentName = `StdOut-${hostname.split('.')[0]}`;
        await setSetupConfig('environment_name', environmentName);
        await setSetupConfig('accent_color', '#F97316'); // Default orange
        await completeStep(SetupStep.Environment, { environmentName, accentColor: '#F97316' });
        console.log('[setup] Auto-generated environment:', environmentName);

        // Validate and store license key immediately
        const { verifyLicenseSignature, storeLicense } = await import('../../lib/license');
        const verifyResult = verifyLicenseSignature(licenseKey);

        if (!verifyResult.valid) {
          error = verifyResult.reason || 'Invalid license key. Please check your purchase confirmation email.';
          emailVal = email;
        } else {
          // License is valid, store it and complete setup
          storeLicense(licenseKey, email, 'self-host');
          await completeStep(SetupStep.License, {
            activated: true,
            mode: 'offline',
            edition: 'self-host',
          });
          await completeStep(SetupStep.Complete, { setupComplete: true });

          // Mark installation as complete
          const { getDb } = await import('../../lib/db');
          const { sql } = await import('drizzle-orm');
          const db = getDb();
          await db.run(sql`
            INSERT OR REPLACE INTO system_state (key, value, updated_at)
            VALUES ('installation_complete', 'true', ${Date.now()})
          `);

          console.log('[setup] License validated and activated:', licenseKey.substring(0, 10) + '...');

          // Trigger autonomous network discovery
          const { runInitialDiscovery } = await import('../../lib/observatory/initial-discovery');
          runInitialDiscovery(userId).catch(err => console.error('[setup] Initial discovery failed:', err));

          // Mark account creation step as complete
          await completeStep(SetupStep.AdminAccount, {
            userId,
            email,
            displayName,
          });

          // Create session and log in
          const sessionId = await createSession(userId);

          // Set cookie manually in redirect response to ensure it's included
          const cookieOpts = sessionCookieOptions(30 * 24 * 60 * 60);
          const cookieValue = [
            `${SESSION_COOKIE}=${sessionId}`,
            `Path=${cookieOpts.path}`,
            `Max-Age=${cookieOpts.maxAge}`,
            cookieOpts.httpOnly ? 'HttpOnly' : '',
            cookieOpts.secure ? 'Secure' : '',
            cookieOpts.sameSite ? `SameSite=${cookieOpts.sameSite}` : ''
          ].filter(Boolean).join('; ');

          // License validated, skip to dashboard
          return new Response(null, {
            status: 302,
            headers: {
              'Location': '/app',
              'Set-Cookie': cookieValue
            }
          });
        }
        }
      }
    }
  }
---

<Layout title="Install StdOut">
  <div class="auth-page" style="max-width: 600px;">
    <SetupProgress currentStep={1} totalSteps={1} />

    <h1>Welcome to StdOut</h1>
    <p class="auth-subtitle">Create your admin account and enter your license key</p>

    {error && <div class="auth-error">{error}</div>}

    <form method="POST" class="auth-form">
      <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />

      <label>
        <span>Display Name</span>
        <input
          type="text"
          name="displayName"
          placeholder="Your name"
          required
          autocomplete="name"
        />
        <span class="hint">This is how you'll appear in the system</span>
      </label>

      <label>
        <span>Email Address</span>
        <input
          type="email"
          name="email"
          value={emailVal}
          placeholder="you@example.com"
          required
          autocomplete="email"
        />
        <span class="hint">You'll use this to sign in</span>
      </label>

      <label>
        <span>Password</span>
        <input
          type="password"
          name="password"
          placeholder="At least 8 characters"
          required
          autocomplete="new-password"
          minlength="8"
          aria-describedby="password-hint"
        />
        <span class="hint" id="password-hint">Minimum 8 characters required</span>
      </label>

          <label>
        <span>License Key</span>
        <input
          type="text"
          name="licenseKey"
          placeholder="SL-XXXX-XXXX-XXXX-XXXX"
          required
          autocomplete="off"
          style="font-family: var(--font-mono);"
        />
        <span class="hint">Required to unlock Riggins AI Agent. <a href="https://store.seayniclabs.com/products/stdout-self-host" target="_blank" class="link-subtle">Purchase license →</a></span>
      </label>

      <button type="submit" class="btn-primary">Install StdOut</button>
    </form>
  </div>
</Layout>

<style>
  .auth-page {
    background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
    min-height: 100vh;
    padding: 2rem 1rem;
    animation: fadeIn 0.5s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hint {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .optional {
    font-weight: normal;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .link-subtle {
    color: var(--color-accent);
    text-decoration: none;
  }

  .link-subtle:hover {
    text-decoration: underline;
  }

  .auth-page input,
  .auth-page button {
    transition: all 0.2s ease;
  }

  .auth-page input:focus {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(249, 115, 22, 0.2);
  }

  .auth-page button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(249, 115, 22, 0.3);
  }

  .auth-page button:active:not(:disabled) {
    transform: translateY(0);
  }
</style>
