---
export const prerender = false;
import Layout from '../../layouts/SetupLayout.astro';
import SetupProgress from '../../components/SetupProgress.astro';
import { getSetupProgress, completeStep, SetupStep } from '../../lib/setup';
import { storeLicense, isValidLicenseKeyFormat } from '../../lib/license';
import { validateCsrf } from '../../middleware';

const session = Astro.locals.user;
if (!session) return Astro.redirect('/app/login');

const progress = await getSetupProgress();
if (progress.currentStep !== SetupStep.License) {
  if (progress.currentStep < SetupStep.License) return Astro.redirect('/setup');
  return Astro.redirect('/setup/scanner');
}

let error = '';
let licenseKey = '';
let validating = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const csrfToken = form.get('_csrf') as string || '';
  const action = form.get('action') as string;

  if (!validateCsrf(csrfToken, Astro.cookies)) {
    error = 'Invalid form submission. Please try again.';
  } else if (action === 'skip') {
    // User chose to skip license activation
    await completeStep(SetupStep.License, { skipped: true });
    return Astro.redirect('/setup/scanner');
  } else {
    const key = (form.get('licenseKey') as string || '').trim();
    const email = (form.get('email') as string || '').trim().toLowerCase();
    const mode = form.get('mode') as string || 'online';

    if (!key || !email) {
      error = 'License key and email are required.';
    } else if (!isValidLicenseKeyFormat(key)) {
      error = 'Invalid license key format. Expected format: XXXX-XXXX-XXXX-XXXX';
    } else {
      if (mode === 'online') {
        try {
          validating = true;
          const storeUrl = 'https://store.seayniclabs.com/api/licenses/activate';
          const controller = new AbortController();
          const timeout = setTimeout(() => controller.abort(), 15000);

          const res = await fetch(storeUrl, {
            method: 'POST',
            signal: controller.signal,
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
            },
            body: JSON.stringify({
              key,
              email,
              product: 'stdout-self-host',
              version: '1.2.0',
            }),
          });
          clearTimeout(timeout);

          if (res.status === 200) {
            const data = await res.json() as { valid: boolean; edition?: string; message?: string };
            if (data.valid) {
              storeLicense(key, email, data.edition || 'self-host');
              await completeStep(SetupStep.License, {
                activated: true,
                mode: 'online',
                edition: data.edition || 'self-host',
              });
              return Astro.redirect('/setup/scanner');
            } else {
              error = data.message || 'License validation failed.';
            }
          } else if (res.status === 401 || res.status === 404) {
            error = 'Invalid license key or email. Please check your purchase confirmation.';
          } else {
            error = 'Validation failed. Try offline mode or contact support.';
          }
        } catch (err: any) {
          if (err.name === 'AbortError') {
            error = 'Validation timed out. Your server may be offline. Try offline activation below.';
          } else {
            error = 'Network error. Try offline mode if your server has no internet access.';
          }
        }
      } else {
        // Offline mode - cryptographic signature verification
        const { verifyLicenseSignature } = await import('../../lib/license');
        const verifyResult = verifyLicenseSignature(key);

        if (!verifyResult.valid) {
          error = `Offline validation failed: ${verifyResult.reason || 'Invalid signature'}`;
        } else if (verifyResult.payload?.product === 'stdout-self-host') {
          storeLicense(key, email, 'self-host');
          await completeStep(SetupStep.License, {
            activated: true,
            mode: 'offline',
            edition: 'self-host',
          });
          return Astro.redirect('/setup/scanner');
        } else {
          error = 'This license is not valid for StdOut';
        }
      }
    }
    licenseKey = key;
  }
}
---

<Layout title="Activate License">
  <div class="auth-page" style="max-width: 600px;">
    <SetupProgress currentStep={3} totalSteps={7} />

    <h1>Activate Your License</h1>
    <p class="auth-subtitle">Enter your license key to activate StdOut</p>

    {error && <div class="auth-error">{error}</div>}

    <form method="POST" class="auth-form" id="licenseForm">
      <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
      <input type="hidden" name="mode" id="modeInput" value="online" />

      <div class="license-modes">
        <button type="button" class="mode-btn active" id="onlineBtn">
          🌐 Online Activation
        </button>
        <button type="button" class="mode-btn" id="offlineBtn">
          📴 Offline Activation
        </button>
      </div>

      <div id="onlineMode" class="activation-mode">
        <label>
          <span>License Key</span>
          <input
            type="text"
            name="licenseKey"
            value={licenseKey}
            placeholder="XXXX-XXXX-XXXX-XXXX"
            style="font-family: var(--font-mono);"
            autocomplete="off"
          />
          <span class="hint">Find this in your purchase confirmation email</span>
        </label>

        <label>
          <span>Email Address</span>
          <input
            type="email"
            name="email"
            placeholder="you@example.com"
            autocomplete="email"
          />
          <span class="hint">The email you used to purchase</span>
        </label>

        <button type="submit" class="btn-primary" id="submitBtn">
          <span id="submitText">Activate License</span>
          <span id="submitSpinner" style="display: none;">⏳ Validating...</span>
        </button>
      </div>

      <div id="offlineMode" class="activation-mode" style="display: none;">
        <div class="offline-info">
          <p><strong>Offline activation verifies your license cryptographically without internet access.</strong></p>
          <p>Your license key contains a digital signature that proves it was issued by Seaynic Labs.</p>
        </div>

        <label>
          <span>License Key</span>
          <input
            type="text"
            name="licenseKey"
            value={licenseKey}
            placeholder="XXXX-XXXX-XXXX-XXXX"
            style="font-family: var(--font-mono);"
            autocomplete="off"
          />
        </label>

        <label>
          <span>Email Address</span>
          <input
            type="email"
            name="email"
            placeholder="you@example.com"
            autocomplete="email"
          />
        </label>

        <button type="submit" class="btn-primary">
          Activate Offline
        </button>
      </div>

      <div class="skip-section">
        <button type="submit" name="action" value="skip" class="btn-secondary">
          Skip for Now
        </button>
        <p class="skip-note">You can activate your license later from Settings. StdOut requires a valid license for full functionality.</p>
      </div>
    </form>

    <div class="purchase-cta">
      <p><strong>Don't have a license?</strong></p>
      <p>Purchase StdOut Self-Hosted for $149 (one-time payment, lifetime updates)</p>
      <a href="https://store.seayniclabs.com/products/stdout-self-host" target="_blank" class="btn-secondary btn-small">
        Buy License →
      </a>
    </div>
  </div>
</Layout>

<style>
  .hint {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .license-modes {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .mode-btn {
    flex: 1;
    padding: 0.75rem;
    background: var(--color-bg-subtle);
    border: 2px solid var(--color-border);
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .mode-btn:hover {
    border-color: var(--color-primary);
  }

  .mode-btn.active {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .activation-mode {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .offline-info {
    padding: 1rem;
    background: var(--color-info-bg, #d1ecf1);
    border: 1px solid var(--color-info, #0c5460);
    border-radius: 6px;
    font-size: 0.875rem;
  }

  .offline-info p {
    margin: 0.5rem 0;
  }

  .skip-section {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .skip-note {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .purchase-cta {
    margin-top: 2rem;
    padding: 1.5rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-align: center;
  }

  .purchase-cta p {
    margin: 0.5rem 0;
    font-size: 0.875rem;
  }

  .purchase-cta p:first-child {
    font-weight: 600;
  }

  .btn-small {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    margin-top: 0.75rem;
  }
</style>

<script>
  const form = document.getElementById('licenseForm') as HTMLFormElement;
  const modeInput = document.getElementById('modeInput') as HTMLInputElement;
  const onlineBtn = document.getElementById('onlineBtn');
  const offlineBtn = document.getElementById('offlineBtn');
  const onlineMode = document.getElementById('onlineMode');
  const offlineMode = document.getElementById('offlineMode');
  const submitBtn = document.getElementById('submitBtn');
  const submitText = document.getElementById('submitText');
  const submitSpinner = document.getElementById('submitSpinner');

  onlineBtn?.addEventListener('click', () => {
    onlineBtn.classList.add('active');
    offlineBtn?.classList.remove('active');
    onlineMode!.style.display = 'flex';
    offlineMode!.style.display = 'none';
    modeInput.value = 'online';
  });

  offlineBtn?.addEventListener('click', () => {
    offlineBtn.classList.add('active');
    onlineBtn?.classList.remove('active');
    offlineMode!.style.display = 'flex';
    onlineMode!.style.display = 'none';
    modeInput.value = 'offline';
  });

  form?.addEventListener('submit', (e) => {
    const actionInput = (e.submitter as HTMLButtonElement)?.name;
    if (actionInput !== 'action' && submitBtn) {
      submitBtn.disabled = true;
      submitText!.style.display = 'none';
      submitSpinner!.style.display = 'inline';
    }
  });
</script>
