---
export const prerender = false;
import Layout from '../../layouts/SetupLayout.astro';
import SetupProgress from '../../components/SetupProgress.astro';
// import { getSession } from '../../lib/auth';
import { getSetupProgress, completeStep, SetupStep, setSetupConfig } from '../../lib/setup';
import { validateCsrf } from '../../middleware';

const session = Astro.locals.user;
if (!session) return Astro.redirect('/app/login');

const progress = await getSetupProgress();
// Allow access to environment page regardless of current step for testing
// (In production, you might want stricter flow control)

let error = '';
let environmentName = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const csrfToken = form.get('_csrf') as string || '';

  if (!validateCsrf(csrfToken, Astro.cookies)) {
    error = 'Invalid form submission. Please try again.';
  } else {
    environmentName = (form.get('environmentName') as string || '').trim();

    if (!environmentName) {
      error = 'Environment name is required.';
    } else {
      // Save environment name
      await setSetupConfig('environment_name', environmentName);

      // Mark Step 2 complete
      await completeStep(SetupStep.Environment, { environmentName });

      // AUTO-COMPLETE optional steps:
      // License is optional → skip it
      await completeStep(SetupStep.License, { skipped: true, autoSkipped: true });

      // Scanner → trigger background scan and mark as in-progress
      // The /app/api/setup/auto-scan endpoint will mark it complete when done
      try {
        await fetch(`${Astro.url.origin}/app/api/setup/auto-scan`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ subnets: [] }), // Auto-detect subnets
        });
        console.log('[setup] Background scanner triggered');
      } catch (error) {
        console.error('[setup] Failed to trigger background scanner:', error);
      }
      await completeStep(SetupStep.Scanner, {
        autoScanned: true,
        scanInProgress: true,
        triggeredAt: new Date().toISOString(),
      });

      // Review step → not needed, skip it
      await completeStep(SetupStep.Review, { skipped: true, autoSkipped: true });

      // Windlass → check if available, auto-connect or skip
      const windlassUrl = import.meta.env.WINDLASS_URL || 'http://windlass:8116';
      try {
        const windlassHealth = await fetch(`${windlassUrl}/health`, { signal: AbortSignal.timeout(2000) });
        if (windlassHealth.ok) {
          await completeStep(SetupStep.Windlass, {
            enabled: true,
            autoDetected: true,
            url: windlassUrl,
          });
          console.log('[setup] Windlass auto-detected and connected');
        } else {
          await completeStep(SetupStep.Windlass, { enabled: false, skipped: true, reason: 'not_reachable' });
        }
      } catch (error) {
        await completeStep(SetupStep.Windlass, { enabled: false, skipped: true, reason: 'not_available' });
        console.log('[setup] Windlass not available, skipping');
      }

      // Ticketing → auto-detect from env vars or use built-in
      const hasLinear = !!import.meta.env.LINEAR_API_KEY;
      const hasGitHub = !!import.meta.env.GITHUB_TOKEN;
      const hasJira = !!import.meta.env.JIRA_API_TOKEN && !!import.meta.env.JIRA_DOMAIN;
      if (hasLinear) {
        await completeStep(SetupStep.Ticketing, { ticketingSystem: 'linear', autoDetected: true });
      } else if (hasGitHub) {
        await completeStep(SetupStep.Ticketing, { ticketingSystem: 'github', autoDetected: true });
      } else if (hasJira) {
        await completeStep(SetupStep.Ticketing, { ticketingSystem: 'jira', autoDetected: true });
      } else {
        await completeStep(SetupStep.Ticketing, { ticketingSystem: 'built-in', autoDetected: true });
      }

      // Setup complete!
      await completeStep(SetupStep.Complete, { completedAt: new Date().toISOString(), autoCompleted: true });

      return Astro.redirect('/setup/complete');
    }
  }
}
---

<Layout title="Name Your Environment">
  <div class="auth-page">
    <SetupProgress currentStep={2} totalSteps={7} />

    <h1>Name Your Environment</h1>
    <p class="auth-subtitle">What should we call this StdOut installation?</p>

    {error && <div class="auth-error">{error}</div>}

    <form method="POST" class="auth-form">
      <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />

      <label>
        <span>Environment Name</span>
        <input
          type="text"
          name="environmentName"
          value={environmentName}
          placeholder="Home Lab"
          required
          autofocus
        />
        <span class="hint">Examples: "Home Lab", "Production", "Development", "Staging"</span>
      </label>

      <div class="setup-actions">
        <button type="submit" class="btn-primary">Continue →</button>
      </div>
    </form>
  </div>
</Layout>

<style>
  .hint {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .setup-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .setup-actions button {
    flex: 1;
  }
</style>
