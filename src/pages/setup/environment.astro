---
export const prerender = false;
import Layout from '../../layouts/SetupLayout.astro';
import SetupProgress from '../../components/SetupProgress.astro';
// import { getSession } from '../../lib/auth';
import { getSetupProgress, completeStep, SetupStep, setSetupConfig } from '../../lib/setup';
import { validateCsrf } from '../../middleware';

const session = Astro.locals.user;
if (!session) return Astro.redirect('/app/login');

const progress = await getSetupProgress();
// Allow access to environment page regardless of current step for testing
// (In production, you might want stricter flow control)

let error = '';
let environmentName = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const csrfToken = form.get('_csrf') as string || '';

  if (!validateCsrf(csrfToken, Astro.cookies)) {
    error = 'Invalid form submission. Please try again.';
  } else {
    environmentName = (form.get('environmentName') as string || '').trim();

    if (!environmentName) {
      error = 'Environment name is required.';
    } else {
      // Save environment name
      await setSetupConfig('environment_name', environmentName);

      // Mark Step 2 complete
      await completeStep(SetupStep.Environment, { environmentName });

      // Proceed to next step (License)
      return Astro.redirect('/setup/license');
    }
  }
}
---

<Layout title="Name Your Environment">
  <div class="auth-page">
    <SetupProgress currentStep={2} totalSteps={7} />

    <h1>Name Your Environment</h1>
    <p class="auth-subtitle">What should we call this StdOut installation?</p>

    {error && <div class="auth-error">{error}</div>}

    <form method="POST" class="auth-form">
      <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />

      <label>
        <span>Environment Name</span>
        <input
          type="text"
          name="environmentName"
          value={environmentName}
          placeholder="Home Lab"
          required
          autofocus
        />
        <span class="hint">Examples: "Home Lab", "Production", "Development", "Staging"</span>
      </label>

      <div class="setup-actions">
        <button type="submit" class="btn-primary">Continue →</button>
      </div>
    </form>
  </div>
</Layout>

<style>
  .auth-page {
    background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
    min-height: 100vh;
    padding: 2rem 1rem;
    animation: fadeIn 0.5s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .auth-page input,
  .auth-page button,
  .auth-page select {
    transition: all 0.2s ease;
  }

  .auth-page input:focus,
  .auth-page select:focus {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(249, 115, 22, 0.2);
  }

  .auth-page button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(249, 115, 22, 0.3);
  }

  .auth-page button:active:not(:disabled) {
    transform: translateY(0);
  }

  .hint {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .setup-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .setup-actions button {
    flex: 1;
  }
</style>
