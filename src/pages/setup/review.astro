---
export const prerender = false;
import Layout from '../../layouts/SetupLayout.astro';
import SetupProgress from '../../components/SetupProgress.astro';
import { getSetupProgress, completeStep, SetupStep } from '../../lib/setup';
import { getCentralDb, centralSchema } from '../../lib/db';

const session = Astro.locals.user;
if (!session) return Astro.redirect('/app/login');

const progress = await getSetupProgress();
if (progress.currentStep !== SetupStep.Review) {
  if (progress.currentStep < SetupStep.Review) return Astro.redirect('/setup');
  return Astro.redirect('/setup/windlass');
}

// Fetch discovered stacks (TODO: implement stacks/containers schema)
const stacks = [];
const containers = [];

if (Astro.request.method === 'POST') {
  await completeStep(SetupStep.Review, {
    reviewedAt: new Date().toISOString(),
    stacksCount: stacks.length,
    containersCount: containers.length,
  });
  return Astro.redirect('/setup/windlass');
}
---

<Layout title="Review Discovered Infrastructure">
  <div class="auth-page" style="max-width: 900px;">
    <SetupProgress currentStep={5} totalSteps={7} />

    <h1>Review Your Infrastructure</h1>
    <p class="auth-subtitle">
      {stacks.length === 0
        ? "No infrastructure discovered yet. You can add services manually later."
        : `Discovered ${stacks.length} stack(s) with ${containers.length} container(s)`}
    </p>

    {stacks.length > 0 ? (
      <div class="review-content">
        <div class="discovered-stacks">
          {stacks.map((stack: any) => (
            <div class="stack-card" key={stack.id}>
              <div class="stack-header">
                <h3>{stack.name}</h3>
                <span class="stack-status">{stack.status || 'unknown'}</span>
              </div>
              <div class="stack-details">
                <p><strong>Path:</strong> {stack.composePath || 'N/A'}</p>
                {stack.description && <p>{stack.description}</p>}
              </div>
              <div class="stack-containers">
                {containers.filter((c: any) => c.stackId === stack.id).map((container: any) => (
                  <div class="container-item" key={container.id}>
                    <span class="container-name">{container.name}</span>
                    <span class={`container-status status-${container.status || 'unknown'}`}>
                      {container.status || 'unknown'}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    ) : (
      <div class="empty-state">
        <div class="empty-icon">📦</div>
        <h3>No Infrastructure Discovered</h3>
        <p>Scanner didn't find any Docker containers. You can:</p>
        <ul>
          <li>Go back and run the scanner again</li>
          <li>Continue and add services manually from the dashboard</li>
          <li>Check that Docker containers are running on this host</li>
        </ul>
      </div>
    )}

    <div class="review-actions">
      <a href="/setup/scanner" class="btn-secondary">← Back to Scanner</a>
      <form method="POST" style="display: inline;">
        <button type="submit" class="btn-primary">
          {stacks.length > 0 ? 'Looks Good →' : 'Continue Anyway →'}
        </button>
      </form>
    </div>
  </div>
</Layout>

<style>
  .review-content {
    margin: 2rem 0;
  }

  .discovered-stacks {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .stack-card {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .stack-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .stack-header h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .stack-status {
    padding: 0.25rem 0.75rem;
    background: var(--color-success-bg, #d4edda);
    color: var(--color-success, #28a745);
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .stack-details {
    margin-bottom: 1rem;
  }

  .stack-details p {
    margin: 0.5rem 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .stack-containers {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .container-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem;
    background: var(--color-bg-subtle);
    border-radius: 6px;
  }

  .container-name {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .container-status {
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: capitalize;
  }

  .status-running {
    background: var(--color-success-bg, #d4edda);
    color: var(--color-success, #28a745);
  }

  .status-stopped, .status-exited {
    background: var(--color-danger-bg, #f8d7da);
    color: var(--color-danger, #dc3545);
  }

  .status-unknown {
    background: var(--color-muted-bg, #e9ecef);
    color: var(--color-text-muted, #6c757d);
  }

  .empty-state {
    text-align: center;
    padding: 3rem 2rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    margin: 2rem 0;
  }

  .empty-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .empty-state h3 {
    margin: 0 0 0.5rem 0;
  }

  .empty-state p {
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .empty-state ul {
    text-align: left;
    display: inline-block;
    margin: 0;
    padding-left: 1.5rem;
  }

  .empty-state li {
    margin: 0.5rem 0;
  }

  .review-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    justify-content: space-between;
  }

  .btn-secondary, .btn-primary {
    flex: 1;
    max-width: 250px;
  }
</style>
