---
export const prerender = false;
import Layout from '../../layouts/SetupLayout.astro';
import SetupProgress from '../../components/SetupProgress.astro';
import { getSetupProgress, completeStep, SetupStep } from '../../lib/setup';
import { getCentralDb, centralSchema } from '../../lib/db';

const session = Astro.locals.user;
if (!session) return Astro.redirect('/app/login');

const progress = await getSetupProgress();
if (progress.currentStep !== SetupStep.Review) {
  if (progress.currentStep < SetupStep.Review) return Astro.redirect('/setup');
  return Astro.redirect('/setup/windlass');
}

// Fetch discovered hosts from scanner
const db = getCentralDb();
const discoveredHosts = db
  .select()
  .from(centralSchema.discovered_hosts)
  .all();

if (Astro.request.method === 'POST') {
  await completeStep(SetupStep.Review, {
    reviewedAt: new Date().toISOString(),
    hostsCount: discoveredHosts.length,
  });
  return Astro.redirect('/setup/windlass');
}
---

<Layout title="Review Discovered Infrastructure">
  <div class="auth-page" style="max-width: 900px;">
    <SetupProgress currentStep={5} totalSteps={8} />

    <h1>Review Your Infrastructure</h1>
    <p class="auth-subtitle">
      {discoveredHosts.length === 0
        ? "No infrastructure discovered yet. You can add services manually later."
        : `Discovered ${discoveredHosts.length} host(s) on your network`}
    </p>

    {discoveredHosts.length > 0 ? (
      <div class="review-content">
        <div class="discovered-hosts">
          <h3>Network Hosts ({discoveredHosts.length})</h3>
          <div class="host-list">
            {discoveredHosts.slice(0, 10).map((host: any) => (
              <div class="host-item" key={host.id}>
                <span class="host-ip">{host.ip}</span>
                {host.hostname && <span class="host-name">{host.hostname}</span>}
              </div>
            ))}
            {discoveredHosts.length > 10 && (
              <p class="host-more">...and {discoveredHosts.length - 10} more hosts</p>
            )}
          </div>
        </div>
      </div>
    ) : (
      <div class="empty-state">
        <div class="empty-icon">📦</div>
        <h3>No Infrastructure Discovered</h3>
        <p>Scanner didn't find any network hosts. You can:</p>
        <ul>
          <li>Go back and run the scanner again</li>
          <li>Continue and add services manually from the dashboard</li>
        </ul>
      </div>
    )}

    <div class="review-actions">
      <a href="/setup/scanner" class="btn-secondary">← Back to Scanner</a>
      <form method="POST" style="display: inline;">
        <button type="submit" class="btn-primary">
          {discoveredHosts.length > 0 ? 'Looks Good →' : 'Continue Anyway →'}
        </button>
      </form>
    </div>
  </div>
</Layout>

<style>
  .review-content {
    margin: 2rem 0;
  }

  .discovered-hosts {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .discovered-hosts h3 {
    margin: 0 0 1rem 0;
    font-size: 1rem;
    color: var(--color-primary);
  }

  .host-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .host-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem;
    background: var(--color-bg-subtle);
    border-radius: 6px;
  }

  .host-ip {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text);
    min-width: 120px;
  }

  .host-name {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .host-more {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 2rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    margin: 2rem 0;
  }

  .empty-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .empty-state h3 {
    margin: 0 0 0.5rem 0;
  }

  .empty-state p {
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .empty-state ul {
    text-align: left;
    display: inline-block;
    margin: 0;
    padding-left: 1.5rem;
  }

  .empty-state li {
    margin: 0.5rem 0;
  }

  .review-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    justify-content: space-between;
  }

  .btn-secondary, .btn-primary {
    flex: 1;
    max-width: 250px;
  }
</style>
