---
import '../styles/global.css';
const user = Astro.locals.user;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="AI incident companion for solo developers and self-hosters. Log incidents, describe your stack, get AI diagnosis, build a searchable runbook." />
  <title>StdOut — You've already solved this</title>
  <meta property="og:title" content="StdOut — AI Incident Companion" />
  <meta property="og:description" content="Stop solving the same incident twice. StdOut remembers your stack, your past fixes, and helps you diagnose what's broken." />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#F97316" />
  <style>@import '../styles/fonts.css';</style>
</head>
<body>
  <!-- Nav -->
  <nav class="landing-nav">
    <a href="/" class="nav-brand">
      <span class="logo-icon">&gt;_</span>
      StdOut
    </a>
    <div class="nav-links">
      {user ? (
        <a href="/app" class="btn btn-primary btn-sm">Dashboard</a>
      ) : (
        <>
          <a href="/app/login" class="nav-link">Log in</a>
          <a href="/app/register" class="btn btn-primary btn-sm">Get started</a>
        </>
      )}
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-badge mono">AI-powered incident companion</div>
    <h1>You've already solved this.<br/><span class="hero-accent">You just don't remember.</span></h1>
    <p class="hero-sub">StdOut turns your incident history into a searchable runbook with AI diagnosis. Describe your stack once. Log what breaks. Get answers from your own past fixes — before asking the internet.</p>
    <div class="hero-cta">
      <a href="/app/register" class="btn btn-primary btn-lg">Start logging incidents</a>
      <a href="#how-it-works" class="btn btn-secondary btn-lg">See how it works</a>
    </div>
  </section>

  <!-- How it works -->
  <section class="section" id="how-it-works">
    <h2 class="section-title">How it works</h2>
    <div class="steps">
      <div class="step">
        <div class="step-num mono">01</div>
        <h3>Describe your stack</h3>
        <p>Docker containers, ports, services, dependencies — everything an on-call engineer would need to know. StdOut uses this context for smarter diagnosis.</p>
      </div>
      <div class="step">
        <div class="step-num mono">02</div>
        <h3>Log what breaks</h3>
        <p>Paste the error, describe the symptoms, tag the severity. StdOut timestamps it and links it to your stack.</p>
      </div>
      <div class="step">
        <div class="step-num mono">03</div>
        <h3>Get AI diagnosis</h3>
        <p>Claude analyzes your incident against your stack context and past resolutions. Ranked root causes, specific commands to run, logs to check.</p>
      </div>
      <div class="step">
        <div class="step-num mono">04</div>
        <h3>Record what fixed it</h3>
        <p>When you find the fix, record it. Next time the same thing breaks, StdOut finds it instantly — before the AI even runs.</p>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section">
    <h2 class="section-title">Built for people who run things</h2>
    <div class="features">
      <div class="feature card">
        <div class="feature-icon mono">&gt;_</div>
        <h3>Stack context injection</h3>
        <p>Your infrastructure description is injected into every AI diagnosis. The AI knows your nginx config, your Docker setup, your port layout.</p>
      </div>
      <div class="feature card">
        <div class="feature-icon" style="color: var(--low);">&#x1F50D;</div>
        <h3>Full-text search</h3>
        <p>FTS5-powered search across all incidents and resolutions. Find that fix from 3 months ago in seconds.</p>
      </div>
      <div class="feature card">
        <div class="feature-icon" style="color: var(--high);">&#x1F512;</div>
        <h3>Per-tenant isolation</h3>
        <p>Each user gets their own encrypted SQLite database. Your data is physically separated — not just filtered by a WHERE clause.</p>
      </div>
      <div class="feature card">
        <div class="feature-icon" style="color: var(--critical);">&#x1F4E6;</div>
        <h3>Self-host option</h3>
        <p>Don't want to send data to the cloud? Run StdOut on your own infrastructure with a one-time $49 license. Docker Compose, done.</p>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section" id="pricing">
    <h2 class="section-title">Pricing</h2>
    <div class="pricing-grid">
      <div class="price-card card">
        <h3>Free</h3>
        <div class="price mono">$0</div>
        <ul>
          <li>1 stack</li>
          <li>10 incidents/month</li>
          <li>AI diagnosis (Haiku)</li>
          <li>Full-text search</li>
        </ul>
        <a href="/app/register" class="btn btn-secondary" style="width:100%;">Get started</a>
      </div>
      <div class="price-card card featured">
        <h3>Solo</h3>
        <div class="price mono">$9<span class="price-period">/mo</span></div>
        <ul>
          <li>Unlimited stacks</li>
          <li>Unlimited incidents</li>
          <li>AI diagnosis (Sonnet)</li>
          <li>Encrypted backups</li>
          <li>JSON export</li>
        </ul>
        <a href="/app/register" class="btn btn-primary" style="width:100%;">Start free trial</a>
      </div>
      <div class="price-card card">
        <h3>Self-Host</h3>
        <div class="price mono">$49<span class="price-period"> one-time</span></div>
        <ul>
          <li>Everything in Solo</li>
          <li>Run on your infra</li>
          <li>Docker Compose package</li>
          <li>No data leaves your network</li>
        </ul>
        <a href="/app/register" class="btn btn-secondary" style="width:100%;">Coming soon</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="cta-box">
      <h2>Stop solving the same incident twice.</h2>
      <p>Your future self will thank you.</p>
      <a href="/app/register" class="btn btn-primary btn-lg">Get started — it's free</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="landing-footer">
    <div class="footer-brand">
      <span class="logo-icon" style="font-size: 14px;">&gt;_</span>
      StdOut by <a href="https://seayniclabs.com">Seaynic Labs</a>
    </div>
  </footer>
</body>
</html>

<style>
  /* Landing nav */
  .landing-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 18px;
    color: var(--text);
    text-decoration: none;
  }
  .logo-icon {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 16px;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .nav-link {
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .nav-link:hover { color: var(--text); }
  .btn-sm { padding: 7px 14px; font-size: 12px; }
  .btn-lg { padding: 12px 28px; font-size: 14px; }

  /* Hero */
  .hero {
    text-align: center;
    padding: 80px 24px 60px;
    max-width: 800px;
    margin: 0 auto;
  }
  .hero-badge {
    display: inline-block;
    font-size: 11px;
    color: var(--accent-light);
    background: var(--accent-dim);
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 24px;
    letter-spacing: 0.02em;
  }
  .hero h1 {
    font-size: clamp(28px, 5vw, 44px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }
  .hero-accent { color: var(--accent); }
  .hero-sub {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 32px;
  }
  .hero-cta {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Sections */
  .section {
    max-width: 1000px;
    margin: 0 auto;
    padding: 60px 24px;
  }
  .section-title {
    text-align: center;
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 40px;
    letter-spacing: -0.02em;
  }

  /* Steps */
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
  }
  .step {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-surface);
  }
  .step-num {
    font-size: 28px;
    font-weight: 800;
    color: var(--accent);
    margin-bottom: 12px;
    opacity: 0.6;
  }
  .step h3 {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .step p {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Features */
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .feature { text-align: center; padding: 28px 20px; }
  .feature-icon {
    font-size: 24px;
    margin-bottom: 12px;
    color: var(--accent);
  }
  .feature h3 {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .feature p {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Pricing */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    max-width: 820px;
    margin: 0 auto;
  }
  .price-card {
    text-align: center;
    padding: 32px 24px;
  }
  .price-card.featured {
    border-color: var(--accent);
    box-shadow: 0 0 30px var(--accent-dim);
  }
  .price-card h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .price {
    font-size: 36px;
    font-weight: 800;
    margin-bottom: 20px;
    color: var(--text);
  }
  .price-period {
    font-size: 14px;
    font-weight: 400;
    color: var(--text-muted);
  }
  .price-card ul {
    list-style: none;
    padding: 0;
    margin-bottom: 24px;
  }
  .price-card li {
    font-size: 13px;
    color: var(--text-secondary);
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
  }
  .price-card li:last-child { border-bottom: none; }

  /* CTA */
  .cta-section { padding: 40px 24px 80px; }
  .cta-box {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    padding: 48px 32px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .cta-box h2 {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .cta-box p {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  /* Footer */
  .landing-footer {
    text-align: center;
    padding: 24px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    color: var(--text-muted);
  }
  .footer-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  .footer-brand a { color: var(--text-secondary); }

  /* Mobile */
  @media (max-width: 600px) {
    .hero { padding: 50px 16px 40px; }
    .hero-sub { font-size: 14px; }
    .steps { grid-template-columns: 1fr; }
    .features { grid-template-columns: 1fr; }
    .pricing-grid { grid-template-columns: 1fr; }
  }
</style>
