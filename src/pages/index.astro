<script>
  const lnToggle = document.getElementById('lnToggle');
  const lnMobile = document.getElementById('lnMobile');
  if (lnToggle && lnMobile) {
    lnToggle.addEventListener('click', () => {
      const isOpen = lnMobile.classList.toggle('open');
      lnToggle.classList.toggle('active', isOpen);
      lnToggle.setAttribute('aria-expanded', String(isOpen));
    });
    lnMobile.querySelectorAll('a[href^="#"]').forEach(link => {
      link.addEventListener('click', () => {
        lnMobile.classList.remove('open');
        lnToggle.classList.remove('active');
        lnToggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  /* Staggered reveal for HUD lines */
  const hudLines = document.querySelectorAll('.hud-line');
  hudLines.forEach((line, i) => {
    const el = line as HTMLElement;
    el.style.opacity = '0';
    el.style.transform = 'translateY(4px)';
    el.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
    setTimeout(() => {
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    }, 600 + i * 200);
  });
</script>
