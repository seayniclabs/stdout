---
import '../styles/global.css';
const user = Astro.locals.user;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Self-hosted incident companion for homelab builders and solo DevOps. AI diagnosis, living runbooks, stack auto-discovery. $149 one-time, own it forever." />
  <title>StdOut — You've already solved this</title>
  <meta property="og:title" content="StdOut — Self-Hosted Incident Companion" />
  <meta property="og:description" content="Your incident memory. When something breaks at 2am, StdOut pulls up how you fixed it last time. Self-host for $149, own it forever." />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#F97316" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>@import '../styles/fonts.css';</style>
</head>
<body>
  <!-- Nav -->
  <nav class="ln">
    <a href="/" class="ln-brand">
      <img src="/logo.svg" alt="StdOut" width="28" height="28" />
      <span>StdOut</span>
    </a>
    <div class="ln-links">
      <a href="#how" class="ln-link">How it works</a>
      <a href="#features" class="ln-link">Features</a>
      <a href="#pricing" class="ln-link">Pricing</a>
      <a href="/docs/scanner" class="ln-link">Docs</a>
      {user ? (
        <a href="/app" class="btn btn-primary btn-sm">Dashboard</a>
      ) : (
        <>
          <a href="/app/login" class="ln-link">Log in</a>
          <a href="/app/register" class="btn btn-primary btn-sm">Self-Host $149</a>
        </>
      )}
    </div>
    <button class="ln-toggle" id="lnToggle" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <div class="ln-mobile" id="lnMobile">
    <a href="#how" class="ln-mobile-link">How it works</a>
    <a href="#features" class="ln-mobile-link">Features</a>
    <a href="#pricing" class="ln-mobile-link">Pricing</a>
    <a href="/docs/scanner" class="ln-mobile-link">Docs</a>
    {user ? (
      <a href="/app" class="ln-mobile-link ln-mobile-cta">Dashboard</a>
    ) : (
      <>
        <a href="/app/login" class="ln-mobile-link">Log in</a>
        <a href="/app/register" class="ln-mobile-link ln-mobile-cta">Self-Host $149</a>
      </>
    )}
  </div>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-badge mono">INCIDENT MEMORY FOR YOUR INFRASTRUCTURE</div>
    <h1>You've already solved this.<br /><span class="hero-dim">You just don't remember.</span></h1>
    <p class="hero-sub">StdOut is your incident companion. When something breaks at 2am, it pulls up how you fixed it last time &mdash; your stack, your past resolutions, your runbooks. Stop solving the same problem twice.</p>
    <div class="hero-cta">
      <a href="/app/register" class="btn btn-primary btn-lg btn-glow">Self-Host for $149</a>
      <a href="/app/register" class="btn btn-ghost">Try Free on Cloud</a>
    </div>
    <p class="hero-note mono">$149 one-time. Docker image. Your infra, your data, forever.</p>

    <!-- Scanner HUD -->
    <div class="hud">
      <div class="hud-bar">
        <div class="hud-status">
          <span class="hud-dot"></span>
          <span class="mono">SCANNING</span>
        </div>
        <span class="hud-label mono">stdout scanner v2</span>
      </div>
      <div class="hud-body mono">
        <div class="hud-line"><span class="hud-ts">00:00.12</span> Connecting to Docker socket...</div>
        <div class="hud-line"><span class="hud-ts">00:00.34</span> Discovered <span class="hud-accent">53 containers</span> across 12 compose projects</div>
        <div class="hud-line"><span class="hud-ts">00:00.51</span> Mapped 47 exposed ports, 8 networks, 3 volumes</div>
        <div class="hud-line"><span class="hud-ts">00:01.03</span> TLS cert check: 14 certs valid, <span class="hud-warn">2 expiring &lt;30d</span></div>
        <div class="hud-line"><span class="hud-ts">00:01.28</span> Network scan: 6 SNMP devices, 2 switches, 1 AP</div>
        <div class="hud-line hud-result"><span class="hud-ts">00:01.44</span> Stack fingerprint complete &mdash; <span class="hud-accent">ready for incident matching</span></div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="how" id="how">
    <h2>How it works</h2>
    <div class="pipeline">
      <div class="pipe-step">
        <div class="pipe-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" stroke="#FB923C" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
        <div class="pipe-num mono">01</div>
        <div class="pipe-label">Discover</div>
        <p>Run the scanner. It auto-discovers your Docker containers, network devices, TLS certs, and compose projects. One command, full stack map.</p>
      </div>
      <div class="pipe-connector"><div class="pipe-line"></div></div>
      <div class="pipe-step">
        <div class="pipe-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 8v4l3 3M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke="#FB923C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="pipe-num mono">02</div>
        <div class="pipe-label">Log</div>
        <p>Something breaks. Log the incident &mdash; paste the error, tag the severity. AI matches it against your resolution history. 30 seconds.</p>
      </div>
      <div class="pipe-connector"><div class="pipe-line"></div></div>
      <div class="pipe-step">
        <div class="pipe-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l.146.146A2 2 0 0116 19H8a2 2 0 01-1.414-.586l.146-.146z" stroke="#FB923C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="pipe-num mono">03</div>
        <div class="pipe-label">Diagnose</div>
        <p>AI analyzes against your specific stack context and past fixes. Ranked root causes, commands to run, logs to check. Not generic &mdash; yours.</p>
      </div>
      <div class="pipe-connector"><div class="pipe-line"></div></div>
      <div class="pipe-step">
        <div class="pipe-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="#FB923C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="pipe-num mono">04</div>
        <div class="pipe-label">Remember</div>
        <p>Record the resolution. Build your runbook. Next time it breaks, StdOut finds the fix before the AI even runs. Your knowledge compounds.</p>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="features" id="features">
    <h2>What you get</h2>
    <div class="feat-grid">
      <div class="feat">
        <div class="feat-head">
          <svg class="feat-icon" width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" stroke="#FB923C" stroke-width="2" stroke-linecap="round"/></svg>
          <h3>Stack Scanner</h3>
        </div>
        <p>Auto-discovers Docker containers, compose projects, ports, networks, TLS certs, and SNMP devices. One command maps your entire infrastructure.</p>
      </div>
      <div class="feat">
        <div class="feat-head">
          <svg class="feat-icon" width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l.146.146A2 2 0 0116 19H8a2 2 0 01-1.414-.586l.146-.146z" stroke="#FB923C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <h3>AI Diagnosis</h3>
        </div>
        <p>Claude analyzes your incident against your stack context and resolution history. Not generic answers &mdash; answers that know your infrastructure.</p>
      </div>
      <div class="feat">
        <div class="feat-head">
          <svg class="feat-icon" width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" stroke="#FB923C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <h3>Knowledge Base</h3>
        </div>
        <p>Turn resolutions into runbook pages, postmortems, and operational docs. Full-text search across everything you've ever written.</p>
      </div>
      <div class="feat">
        <div class="feat-head">
          <svg class="feat-icon" width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="1" stroke="#FB923C" stroke-width="2"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="#FB923C" stroke-width="2"/><rect x="3" y="14" width="7" height="7" rx="1" stroke="#FB923C" stroke-width="2"/><rect x="14" y="14" width="7" height="7" rx="1" stroke="#FB923C" stroke-width="2"/></svg>
          <h3>HUD Monitoring</h3>
        </div>
        <p>Uptime monitoring for every service in your stack. Auto-creates incidents on downtime. A control room for your infrastructure.</p>
      </div>
      <div class="feat">
        <div class="feat-head">
          <svg class="feat-icon" width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2h1a2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke="#FB923C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <h3>Public Status Page</h3>
        </div>
        <p>Give your users a status page that updates automatically from your HUD. No separate service, no extra config.</p>
      </div>
      <div class="feat">
        <div class="feat-head">
          <svg class="feat-icon" width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke="#FB923C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <h3>Weekly Digest</h3>
        </div>
        <p>A weekly email summarizing incidents, resolutions, and stack health. Stay on top of your infrastructure without watching a dashboard.</p>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing" id="pricing">
    <h2>Own it. Run it. Keep it.</h2>
    <p class="pricing-sub">Your infrastructure, your data. No subscription required.</p>
    <div class="price-grid">
      <div class="price-card featured">
        <div class="price-badge mono">RECOMMENDED</div>
        <div class="price-tier">Self-Hosted</div>
        <div class="price-amount mono">$149<span class="price-per"> once</span></div>
        <p class="price-desc">Your infra, your data, forever. Ships as a Docker image you deploy on your own hardware.</p>
        <div class="price-items">
          <div class="pi"><span class="pi-check">&#10003;</span> Everything &mdash; no feature gates</div>
          <div class="pi"><span class="pi-check">&#10003;</span> Docker Compose deploy</div>
          <div class="pi"><span class="pi-check">&#10003;</span> Unlimited stacks &amp; incidents</div>
          <div class="pi"><span class="pi-check">&#10003;</span> Unlimited storage</div>
          <div class="pi"><span class="pi-check">&#10003;</span> Your data stays on your network</div>
          <div class="pi"><span class="pi-check">&#10003;</span> No subscription, ever</div>
          <div class="pi"><span class="pi-check">&#10003;</span> Bring your own API key</div>
        </div>
        <a href="/app/register" class="btn btn-primary btn-glow" style="width:100%;">Get Self-Hosted</a>
      </div>
      <div class="price-card">
        <div class="price-tier">Free Cloud</div>
        <div class="price-amount mono">$0</div>
        <p class="price-desc">Try StdOut on our cloud. No credit card, no commitment.</p>
        <div class="price-items">
          <div class="pi"><span class="pi-check dim">&#10003;</span> 1 stack</div>
          <div class="pi"><span class="pi-check dim">&#10003;</span> 10 incidents / month</div>
          <div class="pi"><span class="pi-check dim">&#10003;</span> AI diagnosis</div>
          <div class="pi"><span class="pi-check dim">&#10003;</span> 100 MB knowledge base</div>
          <div class="pi"><span class="pi-check dim">&#10003;</span> Full-text search</div>
          <div class="pi"><span class="pi-check dim">&#10003;</span> Resolution matching</div>
          <div class="pi">&nbsp;</div>
        </div>
        <a href="/app/register" class="btn btn-secondary" style="width:100%;">Start Free</a>
      </div>
    </div>
    <p class="pricing-saas mono">Cloud subscriptions also available for teams that prefer managed hosting. <a href="mailto:hello@seayniclabs.com">Contact us</a></p>
  </section>

  <!-- Trust / Builder -->
  <section class="trust">
    <div class="trust-inner">
      <div class="trust-badge mono">BUILT BY A BUILDER</div>
      <h2>Built by a solo engineer who runs 53 containers on a Mac Mini.</h2>
      <p>StdOut isn't theoretical. It's the tool I built to manage my own homelab &mdash; the same infrastructure that runs production workloads, media servers, monitoring, and a dozen side projects. Every feature exists because I needed it at 2am when something broke.</p>
      <div class="trust-links">
        <a href="https://charlieseay.com" class="btn btn-ghost btn-sm">charlieseay.com</a>
        <a href="https://charlieseay.com/blog" class="btn btn-ghost btn-sm">Read the blog</a>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bottom-cta">
    <div class="cta-inner">
      <img src="/logo.svg" alt="" width="48" height="48" style="margin-bottom: 20px; opacity: 0.8;" />
      <h2>Stop solving the same incident twice.</h2>
      <p class="mono" style="color: var(--text-muted); margin-bottom: 24px;">Your future self will thank you.</p>
      <div class="cta-buttons">
        <a href="/app/register" class="btn btn-primary btn-lg btn-glow">Self-Host for $149</a>
        <a href="/app/register" class="btn btn-ghost">Or try free on cloud</a>
      </div>
    </div>
  </section>

  <footer class="lf">
    <div class="lf-links">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/docs/scanner">Docs</a>
      <a href="mailto:hello@seayniclabs.com">Contact</a>
    </div>
    <span class="mono" style="font-size: 11px; color: var(--text-muted);">StdOut by <a href="https://seayniclabs.com" style="color: var(--text-secondary);">Seaynic Labs</a></span>
  </footer>
</body>
</html>

<style>
  /* ── Nav ────────────────────────────────────── */
  .ln { display: flex; justify-content: space-between; align-items: center; padding: 14px 24px; max-width: 1100px; margin: 0 auto; }
  .ln-brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 17px; color: var(--text); text-decoration: none; }
  .ln-links { display: flex; align-items: center; gap: 20px; }
  .ln-link { font-size: 13px; color: var(--text-muted); text-decoration: none; font-family: var(--font-mono); }
  .ln-link:hover { color: var(--text); }
  .btn-sm { padding: 7px 16px; font-size: 12px; }
  .btn-lg { padding: 14px 32px; font-size: 15px; }

  /* ── Glow button ───────────────────────────── */
  .btn-glow {
    box-shadow: 0 0 20px var(--accent-glow), var(--shadow-sm);
  }
  .btn-glow:hover {
    box-shadow: 0 0 40px var(--accent-glow), 0 0 80px rgba(249, 115, 22, 0.1), var(--shadow-md);
  }

  /* ── Ghost button ──────────────────────────── */
  .btn-ghost {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    padding: 10px 20px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    font-family: var(--font-ui);
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .btn-ghost:hover {
    color: var(--text);
    border-color: var(--border-hover);
    background: var(--bg-surface);
    transform: translateY(-1px);
  }

  /* ── Hero ───────────────────────────────────── */
  .hero {
    text-align: center;
    padding: 80px 24px 60px;
    max-width: 860px;
    margin: 0 auto;
    position: relative;
  }
  .hero-badge {
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--accent-light);
    margin-bottom: 20px;
    font-weight: 600;
  }
  .hero h1 {
    font-size: clamp(30px, 5vw, 48px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }
  .hero-dim { color: var(--text-muted); }
  .hero-sub {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 32px;
  }
  .hero-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .hero-note {
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 48px;
  }

  /* ── Scanner HUD ───────────────────────────── */
  .hud {
    max-width: 600px;
    margin: 0 auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    text-align: left;
    background: var(--bg);
    box-shadow: 0 0 60px rgba(249, 115, 22, 0.06), var(--shadow-lg);
  }
  .hud-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }
  .hud-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    color: var(--accent-light);
    letter-spacing: 0.08em;
  }
  .hud-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 4px var(--accent); }
    50% { opacity: 0.5; box-shadow: 0 0 8px var(--accent-glow); }
  }
  .hud-label {
    font-size: 10px;
    color: var(--text-muted);
  }
  .hud-body {
    padding: 16px;
    font-size: 12px;
    line-height: 2;
  }
  .hud-line {
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hud-line.hud-result { color: var(--text-secondary); }
  .hud-ts {
    color: var(--text-muted);
    opacity: 0.5;
    margin-right: 12px;
    font-size: 10px;
  }
  .hud-accent { color: var(--accent-light); }
  .hud-warn { color: #EAB308; }

  /* ── Scanline animation on HUD ─────────────── */
  .hud::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-glow), transparent);
    animation: scanline 4s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes scanline {
    0% { top: 0; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }

  /* ── How it works ──────────────────────────── */
  .how {
    max-width: 900px;
    margin: 0 auto;
    padding: 80px 24px;
  }
  .how h2 {
    text-align: center;
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 48px;
    letter-spacing: -0.02em;
  }
  .pipeline {
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }
  .pipe-step {
    flex: 0 1 200px;
    padding: 0 16px;
    text-align: center;
  }
  .pipe-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--accent-dim);
    border: 1px solid rgba(249, 115, 22, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px;
  }
  .pipe-num {
    font-size: 12px;
    font-weight: 700;
    color: var(--accent);
    opacity: 0.6;
    margin-bottom: 4px;
  }
  .pipe-label {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .pipe-step p {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .pipe-connector {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    padding-top: 24px;
    width: 40px;
  }
  .pipe-line {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, var(--border), var(--accent-dim), var(--border));
  }

  /* ── Features ──────────────────────────────── */
  .features {
    max-width: 1000px;
    margin: 0 auto;
    padding: 80px 24px;
  }
  .features h2 {
    text-align: center;
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 48px;
    letter-spacing: -0.02em;
  }
  .feat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .feat {
    padding: 28px;
    background: var(--bg);
    transition: background 0.15s ease;
  }
  .feat:hover {
    background: var(--bg-surface);
  }
  .feat-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .feat h3 {
