---
import '../styles/global.css';
const user = Astro.locals.user;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="AI incident companion for developers and self-hosters. Log incidents, get AI diagnosis, build a searchable runbook and knowledge base." />
  <title>StdOut — You've already solved this</title>
  <meta property="og:title" content="StdOut — AI Incident Companion" />
  <meta property="og:description" content="Stop solving the same incident twice. StdOut remembers your stack, your past fixes, and helps you diagnose what's broken." />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#F97316" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>@import '../styles/fonts.css';</style>
</head>
<body>
  <!-- Nav -->
  <nav class="ln">
    <a href="/" class="ln-brand">
      <img src="/logo.svg" alt="StdOut" width="28" height="28" />
      <span>StdOut</span>
    </a>
    <div class="ln-links">
      <a href="#how" class="ln-link">How it works</a>
      <a href="#pricing" class="ln-link">Pricing</a>
      {user ? (
        <a href="/app" class="btn btn-primary btn-sm">Dashboard</a>
      ) : (
        <>
          <a href="/app/login" class="ln-link">Log in</a>
          <a href="/app/register" class="btn btn-primary btn-sm">Get started</a>
        </>
      )}
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-terminal">
      <div class="term-bar">
        <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
        <span class="term-title mono">stdout</span>
      </div>
      <div class="term-body mono">
        <div class="term-line"><span class="term-prompt">$</span> nginx returns 502 after deploy</div>
        <div class="term-line dim">searching 47 past incidents...</div>
        <div class="term-line dim">found 3 matching resolutions</div>
        <div class="term-line accent">root cause: upstream container restarted before health check passed</div>
        <div class="term-line accent">fix: add depends_on with service_healthy condition</div>
        <div class="term-line dim">resolution recorded 2024-11-03 &mdash; you solved this before.</div>
      </div>
    </div>
    <h1>You've already solved this.</h1>
    <p class="hero-sub">StdOut is an incident companion that knows your stack, remembers your fixes, and diagnoses what's broken — so you don't have to solve the same problem twice.</p>
    <div class="hero-cta">
      <a href="/app/register" class="btn btn-primary btn-lg">Start logging incidents</a>
      <span class="hero-note mono">Free tier. No credit card.</span>
    </div>
  </section>

  <!-- How it works -->
  <section class="how" id="how">
    <h2>Four steps. One runbook.</h2>
    <div class="pipeline">
      <div class="pipe-step">
        <div class="pipe-num mono">01</div>
        <div class="pipe-label">Describe</div>
        <p>Tell StdOut what you run. Containers, ports, services, dependencies. The AI uses this context for every diagnosis.</p>
      </div>
      <div class="pipe-arrow mono">&rarr;</div>
      <div class="pipe-step">
        <div class="pipe-num mono">02</div>
        <div class="pipe-label">Log</div>
        <p>Something breaks. Paste the error, tag the severity, link the stack. 30 seconds.</p>
      </div>
      <div class="pipe-arrow mono">&rarr;</div>
      <div class="pipe-step">
        <div class="pipe-num mono">03</div>
        <div class="pipe-label">Diagnose</div>
        <p>Claude analyzes against your stack + past fixes. Ranked root causes, commands to run, logs to check.</p>
      </div>
      <div class="pipe-arrow mono">&rarr;</div>
      <div class="pipe-step">
        <div class="pipe-num mono">04</div>
        <div class="pipe-label">Resolve</div>
        <p>Record the fix. Write it up. Next time it breaks, StdOut finds it before the AI even runs.</p>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="caps">
    <h2>What you get</h2>
    <div class="cap-grid">
      <div class="cap">
        <div class="cap-head">
          <svg class="cap-icon" width="20" height="20" viewBox="0 0 64 64" fill="none"><path d="M22 24L30 32L22 40" stroke="#FB923C" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M34 40H44" stroke="#FB923C" stroke-width="3" stroke-linecap="round"/></svg>
          <h3>AI Diagnosis</h3>
        </div>
        <p>Claude analyzes your incident against your stack context and resolution history. Not generic answers — answers that know your infrastructure.</p>
      </div>
      <div class="cap">
        <div class="cap-head">
          <svg class="cap-icon" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 7h14M3 10h10M3 13h12" stroke="#FB923C" stroke-width="1.5" stroke-linecap="round"/></svg>
          <h3>Knowledge Base</h3>
        </div>
        <p>Turn resolutions into runbook pages, post-mortems, and operational docs. Searchable, linkable, and referenced by the AI in future diagnoses.</p>
      </div>
      <div class="cap">
        <div class="cap-head">
          <svg class="cap-icon" width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7" stroke="#FB923C" stroke-width="1.5"/><path d="M10 6v4l2.5 2.5" stroke="#FB923C" stroke-width="1.5" stroke-linecap="round"/></svg>
          <h3>Full-Text Search</h3>
        </div>
        <p>FTS5-powered search across every incident, resolution, and doc you've written. Find that fix from 3 months ago in under a second.</p>
      </div>
      <div class="cap">
        <div class="cap-head">
          <svg class="cap-icon" width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="3" y="3" width="14" height="14" rx="2" stroke="#FB923C" stroke-width="1.5"/><path d="M7 7h6M7 10h4M7 13h5" stroke="#FB923C" stroke-width="1.2" stroke-linecap="round" stroke-opacity="0.6"/></svg>
          <h3>Stack Discovery</h3>
        </div>
        <p>Run a Docker sidecar scanner. It discovers your containers, ports, and networks — you review and confirm before anything is saved.</p>
      </div>
      <div class="cap">
        <div class="cap-head">
          <svg class="cap-icon" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 3v14M3 10h14" stroke="#FB923C" stroke-width="1.5" stroke-linecap="round" stroke-opacity="0.3"/><rect x="4" y="4" width="5" height="5" rx="1" stroke="#FB923C" stroke-width="1.5"/><rect x="11" y="11" width="5" height="5" rx="1" stroke="#FB923C" stroke-width="1.5"/></svg>
          <h3>Tenant Isolation</h3>
        </div>
        <p>Each user gets their own encrypted SQLite database. Physically separated data — not rows filtered by a WHERE clause.</p>
      </div>
      <div class="cap">
        <div class="cap-head">
          <svg class="cap-icon" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 15l3-3h4l3 3" stroke="#FB923C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><rect x="6" y="5" width="8" height="7" rx="1.5" stroke="#FB923C" stroke-width="1.5"/></svg>
          <h3>Self-Host</h3>
        </div>
        <p>$59 one-time. Docker Compose, your infrastructure, your data stays on your network. Same features, no subscription.</p>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing" id="pricing">
    <h2>Pricing</h2>
    <p class="pricing-sub">Free to start. Scale when you need to.</p>
    <div class="price-grid">
      <div class="price-card">
        <div class="price-tier">Free</div>
        <div class="price-amount mono">$0</div>
        <div class="price-items">
          <div class="pi">1 stack</div>
          <div class="pi">10 incidents/month</div>
          <div class="pi">AI diagnosis (Haiku)</div>
          <div class="pi">100 MB docs</div>
          <div class="pi">Full-text search</div>
        </div>
        <a href="/app/register" class="btn btn-secondary" style="width:100%;">Get started</a>
      </div>
      <div class="price-card featured">
        <div class="price-tier">Solo</div>
        <div class="price-amount mono">$12<span class="price-per">/mo</span></div>
        <div class="price-items">
          <div class="pi">Unlimited stacks</div>
          <div class="pi">Unlimited incidents</div>
          <div class="pi">AI diagnosis (Sonnet)</div>
          <div class="pi">1 GB docs + knowledge base</div>
          <div class="pi">Runbook templates</div>
          <div class="pi">Encrypted backups (3x)</div>
          <div class="pi">JSON + Markdown export</div>
        </div>
        <a href="/app/register" class="btn btn-primary" style="width:100%;">Start free trial</a>
      </div>
      <div class="price-card">
        <div class="price-tier">Team</div>
        <div class="price-amount mono">$24<span class="price-per">/mo</span></div>
        <div class="price-items">
          <div class="pi">Up to 5 users</div>
          <div class="pi">Shared stacks + docs</div>
          <div class="pi">Shared resolution history</div>
          <div class="pi">5 GB docs</div>
          <div class="pi">Everything in Solo</div>
        </div>
        <a href="/app/register" class="btn btn-secondary" style="width:100%;">Coming soon</a>
      </div>
      <div class="price-card">
        <div class="price-tier">Self-Host</div>
        <div class="price-amount mono">$59<span class="price-per"> once</span></div>
        <div class="price-items">
          <div class="pi">Everything in Solo</div>
          <div class="pi">Run on your infra</div>
          <div class="pi">Docker Compose package</div>
          <div class="pi">Unlimited storage</div>
          <div class="pi">Data never leaves your network</div>
        </div>
        <a href="/app/register" class="btn btn-secondary" style="width:100%;">Coming soon</a>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bottom-cta">
    <div class="cta-inner">
      <img src="/logo.svg" alt="" width="48" height="48" style="margin-bottom: 20px; opacity: 0.8;" />
      <h2>Stop solving the same incident twice.</h2>
      <p class="mono" style="color: var(--text-muted); margin-bottom: 24px;">Your future self will thank you.</p>
      <a href="/app/register" class="btn btn-primary btn-lg">Get started free</a>
    </div>
  </section>

  <footer class="lf">
    <span class="mono" style="font-size: 11px; color: var(--text-muted);">StdOut by <a href="https://seayniclabs.com" style="color: var(--text-secondary);">Seaynic Labs</a></span>
  </footer>
</body>
</html>

<style>
  /* Nav */
  .ln { display: flex; justify-content: space-between; align-items: center; padding: 14px 24px; max-width: 1100px; margin: 0 auto; }
  .ln-brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 17px; color: var(--text); text-decoration: none; }
  .ln-links { display: flex; align-items: center; gap: 20px; }
  .ln-link { font-size: 13px; color: var(--text-muted); text-decoration: none; font-family: var(--font-mono); }
  .ln-link:hover { color: var(--text); }
  .btn-sm { padding: 7px 16px; font-size: 12px; }
  .btn-lg { padding: 12px 28px; font-size: 14px; }

  /* Hero */
  .hero { text-align: center; padding: 60px 24px 50px; max-width: 780px; margin: 0 auto; }
  .hero h1 { font-size: clamp(26px, 4.5vw, 40px); font-weight: 800; line-height: 1.2; letter-spacing: -0.03em; margin-bottom: 16px; }
  .hero-sub { font-size: 15px; line-height: 1.7; color: var(--text-secondary); max-width: 560px; margin: 0 auto 28px; }
  .hero-cta { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .hero-note { font-size: 11px; color: var(--text-muted); }

  /* Terminal mock */
  .hero-terminal {
    max-width: 520px;
    margin: 0 auto 36px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    text-align: left;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }
  .term-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--border-hover); }
  .term-title { margin-left: auto; font-size: 10px; color: var(--text-muted); }
  .term-body { padding: 16px; font-size: 12px; line-height: 1.8; background: var(--bg); }
  .term-line { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .term-line.dim { color: var(--text-muted); }
  .term-line.accent { color: var(--accent-light); }
  .term-prompt { color: var(--accent); margin-right: 8px; }

  /* How */
  .how { max-width: 1000px; margin: 0 auto; padding: 50px 24px; }
  .how h2 { text-align: center; font-size: 22px; font-weight: 700; margin-bottom: 36px; letter-spacing: -0.02em; }
  .pipeline { display: flex; align-items: flex-start; gap: 0; justify-content: center; flex-wrap: wrap; }
  .pipe-step { flex: 0 1 200px; padding: 20px; }
  .pipe-num { font-size: 24px; font-weight: 800; color: var(--accent); opacity: 0.5; margin-bottom: 6px; }
  .pipe-label { font-size: 15px; font-weight: 700; margin-bottom: 8px; }
  .pipe-step p { font-size: 12px; color: var(--text-secondary); line-height: 1.6; }
  .pipe-arrow { color: var(--border-hover); font-size: 20px; padding-top: 28px; flex-shrink: 0; }

  /* Capabilities */
  .caps { max-width: 1000px; margin: 0 auto; padding: 50px 24px; }
  .caps h2 { text-align: center; font-size: 22px; font-weight: 700; margin-bottom: 36px; letter-spacing: -0.02em; }
  .cap-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .cap { padding: 24px; background: var(--bg); }
  .cap-head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .cap h3 { font-size: 14px; font-weight: 600; }
  .cap p { font-size: 12px; color: var(--text-secondary); line-height: 1.6; }

  /* Pricing */
  .pricing { max-width: 1000px; margin: 0 auto; padding: 50px 24px; }
  .pricing h2 { text-align: center; font-size: 22px; font-weight: 700; margin-bottom: 6px; }
  .pricing-sub { text-align: center; font-size: 13px; color: var(--text-muted); margin-bottom: 36px; }
  .price-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .price-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px 20px; text-align: center; }
  .price-card.featured { border-color: var(--accent); box-shadow: 0 0 40px rgba(249,115,22,0.08); }
  .price-tier { font-size: 14px; font-weight: 600; margin-bottom: 4px; }
  .price-amount { font-size: 32px; font-weight: 800; margin-bottom: 20px; }
  .price-per { font-size: 13px; font-weight: 400; color: var(--text-muted); }
  .price-items { margin-bottom: 24px; }
  .pi { font-size: 12px; color: var(--text-secondary); padding: 5px 0; border-bottom: 1px solid var(--border); font-family: var(--font-mono); }
  .pi:last-child { border-bottom: none; }

  /* Bottom CTA */
  .bottom-cta { padding: 50px 24px 60px; }
  .cta-inner { text-align: center; max-width: 500px; margin: 0 auto; padding: 40px 28px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-surface); }
  .cta-inner h2 { font-size: 20px; font-weight: 700; margin-bottom: 4px; }

  /* Footer */
  .lf { text-align: center; padding: 20px; border-top: 1px solid var(--border); }

  /* Mobile */
  @media (max-width: 700px) {
    .ln-link { display: none; }
    .hero { padding: 40px 16px 30px; }
    .pipeline { flex-direction: column; align-items: center; }
    .pipe-arrow { transform: rotate(90deg); padding: 8px 0; }
    .cap-grid { grid-template-columns: 1fr; }
    .price-grid { grid-template-columns: 1fr; }
    .hero-terminal { margin: 0 auto 24px; }
    .term-line { font-size: 11px; }
  }
</style>
