  .ln { display: flex; justify-content: space-between; align-items: center; padding: 14px 24px; max-width: 800px; margin: 0 auto; }
  .ln-brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 17px; color: var(--text); text-decoration: none; }
  .ln-links { display: flex; align-items: center; gap: 20px; }
  .ln-link { font-size: 13px; color: var(--text-muted); text-decoration: none; font-family: var(--font-mono); }
  .ln-link:hover { color: var(--text); }
  .ln-link.active { color: var(--accent-light); }
  .legal { max-width: 700px; margin: 0 auto; padding: 40px 24px 60px; }
  .legal h1 { font-size: 24px; font-weight: 700; margin-bottom: 4px; }
  .updated { font-size: 12px; color: var(--text-muted); margin-bottom: 32px; }
  .legal h2 { font-size: 16px; font-weight: 600; margin: 28px 0 12px; padding-top: 12px; border-top: 1px solid var(--border); }
  .legal h3 { font-size: 14px; font-weight: 600; margin: 16px 0 8px; color: var(--text-secondary); }
  .legal p { font-size: 14px; line-height: 1.7; color: var(--text-secondary); margin-bottom: 12px; }
  .legal ul { padding-left: 20px; margin-bottom: 12px; }
  .legal li { font-size: 14px; line-height: 1.7; color: var(--text-secondary); margin-bottom: 4px; }
  .legal a { color: var(--accent-light); }
  .legal code { font-family: var(--font-mono); font-size: 12px; background: var(--bg-surface); padding: 2px 6px; border-radius: 3px; }
  .legal pre { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; margin: 12px 0; overflow-x: auto; }
  .legal pre code { background: none; padding: 0; font-size: 12px; line-height: 1.7; }
  .legal table { width: 100%; border-collapse: collapse; margin: 12px 0; font-size: 13px; }
  .legal th, .legal td { text-align: left; padding: 8px 12px; border: 1px solid var(--border); }
  .legal th { background: var(--bg-surface); font-weight: 600; color: var(--text); font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }
  .legal td { color: var(--text-secondary); }
  .legal strong { color: var(--text); }
  .lf { text-align: center; padding: 20px; border-top: 1px solid var(--border); }
  .mono { font-family: var(--font-mono); }
</style>
