# Optional env for suricata-stdout-integration (copy to /etc/stdout/suricata.env).
# Referenced by deploy/suricata-stdout-integration.service (EnvironmentFile=-).

# File-tail EVE JSON (default when Suricata profile writes to shared volume).
SURICATA_EVE_PATH=/var/log/suricata/eve.json

# Redis stream mode (optional — omit SURICATA_REDIS_URL for file-tail only).
# SURICATA_REDIS_URL=redis://127.0.0.1:6379/0
# SURICATA_REDIS_MODE=stream
# SURICATA_REDIS_STREAM=eve_alerts
# SURICATA_REDIS_GROUP=stream
# SURICATA_REDIS_BLOCK_MS=2000

# Correlation (300s window, threshold 3 — matches observatory/config/correlation-rules.yaml).
SURICATA_CORRELATE_WINDOW_SEC=300
SURICATA_CORRELATE_THRESHOLD=3
SURICATA_AUTO_FIX=true
SURICATA_WINDLASS_RETRIES=3

# Suricata container interface (docker compose --profile suricata).
# Production Linux: SURICATA_IFACE=eth0 SURICATA_SIM_FALLBACK=false
# SURICATA_IFACE=eth0
# SURICATA_SIM_FALLBACK=false

# Windlass token: prefer file mount (vault: stdout/windlass → /etc/stdout/windlass.token).
# WINDLASS_TOKEN=
