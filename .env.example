# =============================================================================
# StdOut Configuration Template
# =============================================================================
#
# QUICK START:
# 1. Copy this file: cp .env.example .env
# 2. Set APP_URL (your public URL)
# 3. Set SECRET_KEY (generate with: openssl rand -base64 32)
# 4. Choose AI option (local Ollama OR cloud API)
# 5. Run: docker compose up -d
#
# DO NOT commit .env to version control - it contains secrets!

# =============================================================================
# DATABASE CONFIGURATION (Phase 1.2: PostgreSQL Abstraction Layer)
# =============================================================================

# Database Type: "sqlite" (default) or "postgres"
# SQLite:     Best for edge/SMB deployments, single instance, <100 monitors
# PostgreSQL: Best for scaling, 100+ monitors, high write volume
DATABASE_TYPE=sqlite

# SQLite Configuration (when DATABASE_TYPE=sqlite)
DB_PATH=/data/stdout.db

# PostgreSQL Configuration (when DATABASE_TYPE=postgres)
# Required when DATABASE_TYPE=postgres
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://stdout:your-password-here@localhost:5432/stdout

# PostgreSQL Password (for docker-compose.postgres.yml)
# POSTGRES_PASSWORD=your-secure-password-here

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application URL (public-facing)
APP_URL=http://localhost:8112

# Deployment Mode: "selfhost" (default) or "cloud"
STDOUT_MODE=selfhost

# Secret Key for session encryption (generate with: openssl rand -hex 32)
SECRET_KEY=<generate-32-char-random>

# Timezone for timestamps (default: America/Chicago)
TZ=America/Chicago

# =============================================================================
# AI CONFIGURATION (BYO-AI) - Choose ONE option
# =============================================================================

# OPTION 1: Local Ollama (Recommended for privacy)
# ------------------------------------------------
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Pull models:
#   ollama pull llama3.2:3b-instruct-q4_K_M    (2GB)
#   ollama pull qwen2.5:14b-instruct-q4_K_M   (9GB)
#
# Pros: Private, no API costs, runs locally
# Cons: Requires 4GB+ RAM, 10GB+ disk for models

OLLAMA_URL=http://172.17.0.1:11434
OLLAMA_HOST=http://host.docker.internal:11434

# Watcher: Fast, frequent checks (every 3-5 min)
OBSERVATORY_WATCHER_MODEL=llama3.2:3b-instruct-q4_K_M
WATCHER_MODEL=llama3.2:3b-instruct-q4_K_M

# Analyst: Deep diagnosis, less frequent
OBSERVATORY_ANALYST_MODEL=qwen2.5:14b-instruct-q4_K_M
ANALYST_MODEL=qwen2.5:14b-instruct-q4_K_M

# OPTION 2: Cloud API (Anthropic, OpenAI, etc.)
# -----------------------------------------------
# To use cloud AI instead of local Ollama:
#   1. Comment out OLLAMA_URL above
#   2. Uncomment ANTHROPIC_API_KEY or OPENAI_API_KEY below
#
# Pros: No local resources needed, latest models
# Cons: Pay per diagnosis, data leaves your network
#
# Get API keys:
#   Anthropic: https://console.anthropic.com/
#   OpenAI: https://platform.openai.com/api-keys

# Check Intervals (seconds)
CRITICAL_CHECK_INTERVAL=300   # 5 minutes
PRODUCT_CHECK_INTERVAL=600    # 10 minutes
DEFAULT_CHECK_INTERVAL=3600   # 1 hour

# =============================================================================
# INTEGRATIONS (Optional)
# =============================================================================

# Anthropic API Key (for Claude-powered features)
ANTHROPIC_API_KEY=

# Resend API Key (for email notifications)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Slack Webhook URL (for incident notifications)
SLACK_WEBHOOK_URL=
SLACK_ALERTS_CHANNEL=#alerts
SLACK_INFO_CHANNEL=#all-seaynic-labs

# Helmsman API URL (for task dispatch)
HELMSMAN_API_URL=

# =============================================================================
# WINDLASS SCHEDULER
# =============================================================================

# Windlass polling interval (seconds)
WINDLASS_INTERVAL=300

# Windlass API URL (internal)
WINDLASS_URL=http://windlass:8116

# =============================================================================
# OBSERVATORY BACKEND (Optional - only if using full observability stack)
# =============================================================================
# Enable Observatory monitoring: docker compose --profile observatory up -d

# Sentinel API Port
SENTINEL_API_PORT=8081

# Sentinel API URL (internal)
SENTINEL_API_URL=http://observatory-sentinel:8081

# Prometheus URL (internal)
PROMETHEUS_URL=http://prometheus:9090

# Loki URL (internal)
LOKI_URL=http://loki:3100

# Tempo URL (internal)
TEMPO_URL=http://tempo:3200
