# Required
APP_URL=http://localhost:8112
SECRET_KEY=<generate-32-char-random>

# Optional — email alerts (password reset, notifications)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Optional — AI diagnosis (BYOK)
ANTHROPIC_API_KEY=

# Bundled Windlass (default when using docker compose up)
WINDLASS_URL=http://windlass:8116

# Database path inside container (default in compose)
DB_PATH=/data/stdout.db
STDOUT_MODE=selfhost
