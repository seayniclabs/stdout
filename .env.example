# Required
APP_URL=http://localhost:8112
SECRET_KEY=<generate-32-char-random>

# Optional — email alerts (password reset, notifications)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Optional — AI diagnosis (BYOK)
ANTHROPIC_API_KEY=

# Bundled Windlass (default when using docker compose up)
WINDLASS_URL=http://windlass:8116

# Database path inside container (default in compose)
DB_PATH=/data/stdout.db
STDOUT_MODE=selfhost

# ===================================================================
# Observatory Configuration (Optional)
# ===================================================================
# Enable Observatory monitoring: docker compose --profile observatory up -d

# Ollama LLM Host (required for Observatory)
OLLAMA_HOST=http://host.docker.internal:11434

# LLM Models
WATCHER_MODEL=llama3.2:3b-instruct-q4_K_M
ANALYST_MODEL=qwen2.5:14b-instruct-q4_K_M

# Observatory Backend API Port
SENTINEL_API_PORT=8081
# Note: Observatory UI is at /app/observatory in the StdOut web app

# Monitoring Intervals (seconds)
CRITICAL_CHECK_INTERVAL=300      # 5 minutes for critical services
PRODUCT_CHECK_INTERVAL=600       # 10 minutes for product services
DEFAULT_CHECK_INTERVAL=3600      # 60 minutes for everything else

# Alert Channels (optional)
SLACK_WEBHOOK_URL=
SLACK_ALERTS_CHANNEL=#alerts
SLACK_INFO_CHANNEL=#all-seaynic-labs
HELMSMAN_API_URL=
